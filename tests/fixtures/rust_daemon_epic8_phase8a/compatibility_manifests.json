      "operation_families": ["llm.metadata", "llm.resolve_model", "llm.invoke"],
      "classification_summary": {
        "llm.metadata": "pure_metadata",
        "llm.resolve_model": "pure_metadata",
        "llm.invoke": "long_running_execution"
      },
      "network_policy": {"default": "deny", "llm.invoke": "provider_cli_may_network"},
      "filesystem_roots": ["cwd", "sase_home", "provider_config_home", "agent_artifacts_dir"],
