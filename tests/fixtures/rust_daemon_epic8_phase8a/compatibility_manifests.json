{
  "schema_version": 1,
  "manifest_version": "host-manifest.v1-draft",
  "required_fields": [
    "plugin_id",
    "manifest_version",
    "entry_points",
    "operation_families",
    "classification_summary",
    "network_policy",
    "filesystem_roots",
    "process_policy",
    "environment_requirements",
    "timeout_hints",
    "warm_host_eligible",
    "wasm_compatibility_notes",
    "compatibility_mode"
  ],
  "manifests": [
    {
      "plugin_id": "builtin.llm.claude",
      "manifest_version": "host-manifest.v1-draft",
      "entry_points": {"sase_llm": "claude"},
      "operation_families": ["llm.metadata", "llm.resolve_model", "llm.invoke"],
      "classification_summary": {
        "llm.metadata": "pure_metadata",
        "llm.resolve_model": "pure_metadata",
        "llm.invoke": "long_running_execution"
      },
      "network_policy": {"default": "deny", "llm.invoke": "provider_cli_may_network"},
      "filesystem_roots": ["cwd", "sase_home", "provider_config_home", "agent_artifacts_dir"],
      "process_policy": {"spawn": ["claude"], "kill_children_on_cancel": true},
      "environment_requirements": ["PATH", "HOME", "SASE_HOME", "CLAUDE_*"],
      "timeout_hints": {"metadata_ms": 1000, "invoke_default_ms": 1800000},
      "warm_host_eligible": true,
      "wasm_compatibility_notes": "Metadata is WASM-compatible; invocation depends on external CLI/process APIs.",
      "compatibility_mode": "builtin_default"
    },
