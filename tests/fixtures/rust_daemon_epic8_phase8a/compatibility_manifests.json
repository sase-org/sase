    {
      "plugin_id": "builtin.vcs.bare_git",
      "manifest_version": "host-manifest.v1-draft",
      "entry_points": {"sase_vcs": "bare_git", "sase_workspace": "bare_git"},
      "operation_families": [
        "vcs.query",
        "vcs.mutation",
        "vcs.commit_dispatch",
        "workspace.metadata",
        "workspace.resolve_ref",
        "workspace.setup",
        "workspace.submit"
      ],
      "classification_summary": {
        "vcs.query": "bounded_side_effect_query",
        "vcs.mutation": "durable_mutation",
        "vcs.commit_dispatch": "durable_mutation",
        "workspace.metadata": "pure_query",
        "workspace.resolve_ref": "bounded_side_effect_query",
        "workspace.setup": "durable_mutation",
        "workspace.submit": "durable_mutation"
      },
      "network_policy": {"default": "deny", "remote_push_or_fetch": "compatibility_mode"},
      "filesystem_roots": ["cwd", "workspace_root", "project_file_dir", "sase_home"],
      "process_policy": {"spawn": ["git"], "kill_children_on_cancel": true},
      "environment_requirements": ["PATH", "HOME", "SASE_HOME", "GIT_*"],
      "timeout_hints": {"query_ms": 10000, "mutation_ms": 120000, "setup_ms": 300000},
      "warm_host_eligible": true,
      "wasm_compatibility_notes": "Query metadata could be WASM-compatible with a Git library; current implementation shells out to git.",
      "compatibility_mode": "builtin_default"
    },
    {
      "plugin_id": "builtin.workspace.cd",
      "manifest_version": "host-manifest.v1-draft",
      "entry_points": {"sase_workspace": "cd"},
      "operation_families": ["workspace.metadata", "workspace.resolve_ref"],
      "classification_summary": {
        "workspace.metadata": "pure_metadata",
        "workspace.resolve_ref": "bounded_side_effect_query"
      },
      "network_policy": {"default": "deny"},
      "filesystem_roots": ["cwd", "declared_workspace_root"],
      "process_policy": {"spawn": [], "kill_children_on_cancel": false},
      "environment_requirements": ["HOME", "SASE_HOME"],
      "timeout_hints": {"metadata_ms": 1000, "resolve_ref_ms": 5000},
      "warm_host_eligible": true,
      "wasm_compatibility_notes": "Mostly WASM-compatible if path and config inputs are provided by the host envelope.",
      "compatibility_mode": "builtin_default"
    },
    {
      "plugin_id": "external.github",
      "manifest_version": "host-manifest.v1-draft",
      "entry_points": {
        "sase_vcs": "github",
        "sase_workspace": "github",
        "sase_config": "sase_github",
        "sase_xprompts": "sase_github"
      },
      "operation_families": [
        "vcs.query",
        "vcs.mutation",
        "vcs.commit_dispatch",
        "workspace.metadata",
        "workspace.resolve_ref",
        "workspace.submit",
        "config.resources",
        "xprompt.catalog"
      ],
      "classification_summary": {
        "vcs.query": "bounded_side_effect_query",
        "vcs.mutation": "durable_mutation",
        "vcs.commit_dispatch": "durable_mutation",
        "workspace.metadata": "pure_query",
        "workspace.resolve_ref": "bounded_side_effect_query",
        "workspace.submit": "durable_mutation",
        "config.resources": "pure_query",
        "xprompt.catalog": "pure_query"
      },
      "network_policy": {
        "default": "deny",
        "github_api_read": "required_for_vcs_get_change_body_and_reviewer_comments",
        "github_api_write": "required_for_pull_request_submit_and_abandon"
      },
      "filesystem_roots": ["cwd", "workspace_root", "project_file_dir", "sase_home", "package_resources"],
      "process_policy": {"spawn": ["git", "gh"], "kill_children_on_cancel": true},
      "environment_requirements": ["PATH", "HOME", "SASE_HOME", "GH_*", "GITHUB_*"],
      "timeout_hints": {"query_ms": 15000, "mutation_ms": 180000, "resource_catalog_ms": 5000},
      "warm_host_eligible": true,
      "wasm_compatibility_notes": "Resource catalog is WASM-compatible. VCS/workspace operations currently require git/gh process and network APIs.",
      "compatibility_mode": "external_maintained_default"
    }
  ]
}
