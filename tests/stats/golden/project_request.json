  "budget": {"timeout_ms": 30000, "max_output_bytes": 33554432},
  "projects": [{
    "key": "alpha", "label": "Alpha Project", "state": "enabled", "selection": "always",
    "index_project_names": ["Alpha Project", "a", "alpha"],
    "code_repos": [
      {"id": "linked:library", "name": "library", "kind": "linked", "path": "/work/library", "identity": "", "ref_candidates": ["refs/remotes/origin/HEAD", "HEAD"]},
      {"id": "primary:alpha", "name": "alpha", "kind": "primary", "path": "/work/alpha", "identity": "", "ref_candidates": ["refs/remotes/origin/HEAD", "HEAD"]}
    ],
    "record_repos": [
      {"id": "sidecar:agents", "name": "agents", "kind": "sidecar", "path": "/work/agents", "identity": "", "ref_candidates": ["refs/remotes/origin/HEAD", "HEAD"]},
      {"id": "sidecar:plans", "name": "plans", "kind": "sidecar", "path": "/work/plans", "identity": "", "ref_candidates": ["refs/remotes/origin/HEAD", "HEAD"]}
    ],
    "not_counted": [{"name": "foreign", "reason": "external"}, {"name": "dotfiles", "reason": "user_linked"}],
    "plan_store": {"storage": "in_tree", "repo_path": "/work/alpha", "plans_dir": "sdd", "project_filter": null}
  }]
