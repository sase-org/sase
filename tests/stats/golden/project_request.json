{
  "schema_version": 1,
  "start_ts": 100,
  "end_ts": 200,
  "now_ts": 200,
  "timezone": "UTC",
  "facets": ["code", "output", "runs"],
  "cache_dir": "/sase-home/cache/project_stats",
