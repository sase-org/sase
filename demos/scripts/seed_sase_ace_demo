write_agent() {
  local ts=$1
  local name=$2
  local role=$3
  local outcome=$4
  local cl_name=$5
  local model=$6
  local provider=$7
  local finished_at=$8
  local stopped_at=$9
  local summary=${10}
  local dir="$project_dir/artifacts/ace-run/$ts"

  mkdir -p "$dir"
  cat >"$dir/agent_meta.json" <<EOF
{
  "name": "$name",
  "changespec_name": "$cl_name",
  "cl_name": "$cl_name",
  "agent_family": "nova",
  "agent_family_role": "$role",
  "model": "$model",
  "llm_provider": "$provider",
  "vcs_provider": "git",
  "workspace_dir": "$workspace",
  "approve": false,
  "stopped_at": "$stopped_at",
  "run_started_at": "2026-07-06T13:00:00Z"
}
EOF
  cat >"$dir/done.json" <<EOF
{
  "outcome": "$outcome",
  "finished_at": $finished_at,
  "cl_name": "$cl_name",
  "project_file": "$project_file",
  "workspace_dir": "$workspace",
  "model": "$model",
  "llm_provider": "$provider",
  "vcs_provider": "git",
  "name": "$name",
  "diff_path": "$dir/diff.diff",
  "response_path": "$dir/response.md",
  "output_path": "$dir/output.log"
}
EOF
  cat >"$dir/raw_xprompt.md" <<EOF
%id $name

$summary
EOF
  cat >"$dir/response.md" <<EOF
# $name

$summary

This is deterministic demo output; no real agent was launched.
EOF
  cat >"$dir/output.log" <<EOF
[$stopped_at] $name finished with outcome=$outcome
EOF
  cat >"$dir/diff.diff" <<EOF
diff --git a/src/parser.py b/src/parser.py
--- a/src/parser.py
+++ b/src/parser.py
@@ -1 +1 @@
-$summary
+Demo diff for $name
EOF
}

write_agent \
  "20260706130000" \
  "nova--plan-0" \
  "plan" \
  "completed" \
  "nova_prompt_input" \
  "gpt-5-codex" \
  "codex" \
  "1783343100.0" \
  "2026-07-06T13:05:00Z" \
  "Planned the prompt-input demo beats and seed data."

write_agent \
  "20260706131000" \
  "nova--plan-1" \
  "plan" \
  "completed" \
  "nova_prompt_input" \
  "claude-sonnet-4-6" \
  "claude" \
  "1783343760.0" \
  "2026-07-06T13:16:00Z" \
  "Refined the tape pacing and terminal geometry."

write_agent \
  "20260706132000" \
  "nova--code" \
  "code" \
