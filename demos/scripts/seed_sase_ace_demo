#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: %s [empty-target-dir]\n' "${0##*/}" >&2
}

if [[ $# -gt 1 ]]; then
  usage
  exit 2
fi

if [[ $# -eq 0 ]]; then
  root=$(mktemp -d "${TMPDIR:-/tmp}/sase-ace-demo.XXXXXXXX")
else
  root=$1
  if [[ -e "$root" && ! -d "$root" ]]; then
    printf 'error: target exists and is not a directory: %s\n' "$root" >&2
    exit 1
  fi
  mkdir -p "$root"
  if find "$root" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    printf 'error: refusing to seed non-empty directory: %s\n' "$root" >&2
    exit 1
  fi
fi

root=$(cd "$root" && pwd -P)
demo_home="$root/home"
sase_home="$demo_home/.sase"
sase_tmpdir="$root/tmp"
workspace="$root/workspaces/nova"
bare_repo="$root/repos/nova.git"
sdd_bare_repo="$root/repos/nova--sdd.git"
project_dir="$sase_home/projects/nova"
project_file="$project_dir/nova.sase"
github_workspace="$demo_home/projects/github/acme/nova"
github_project_dir="$sase_home/projects/gh_acme__nova"
github_project_file="$github_project_dir/gh_acme__nova.sase"
github_sdd="$github_workspace/.sase/sdd"
bare_git_sdd="$workspace/.sase/sdd"
fake_github_ssh="$root/bin/fake-github-ssh"

mkdir -p \
  "$demo_home/.config/sase" \
  "$sase_home/prompt_history" \
  "$project_dir/artifacts/ace-run" \
  "$github_project_dir" \
  "$sase_tmpdir" \
  "$(dirname "$fake_github_ssh")" \
  "$(dirname "$bare_repo")" \
  "$(dirname "$github_workspace")" \
  "$workspace/.github/workflows" \
  "$workspace/examples" \
  "$workspace/sase" \
  "$workspace/src/nova/renderers" \
  "$workspace/tests" \
  "$workspace/tests/fixtures" \
  "$workspace/docs"

cat >"$demo_home/.config/sase/sase.yml" <<'YAML'
llm_provider:
  model_aliases:
    custom:
      gpt53:
        model: codex/gpt-5.3-codex
        description: Codex model used by the multi-model fan-out demo.
      flash37h:
        model: agy/gemini-3.7-flash-high
        description: Antigravity Gemini 3.7 Flash model used by the multi-model fan-out demo.

xprompts:
  add_tests:
    description: Add focused tests for a source file.
    input:
      file_path: path
    content: |
      Add focused tests for @{{ file_path }}. Cover the behavior that changed, include edge cases, and keep the test names
      readable.
  review_path:
    description: Review one file for correctness and maintainability.
    input:
      file_path: path
    content: |
      Review @{{ file_path }} for correctness, edge cases, and maintainability. Report concrete issues first.
  summarize_change:
    description: Summarize a Patch for release notes.
    input:
      patch: word
      audience: { type: word, default: developers }
    content: |
      Summarize Patch {{ patch }} for {{ audience }}. Keep it concise and mention user-visible behavior.
YAML

cat >"$workspace/README.md" <<'MARKDOWN'
# Nova

Nova is a small fictional parser service used for SASE demo recordings.
MARKDOWN

cat >"$workspace/pyproject.toml" <<'TOML'
[project]
name = "nova"
version = "0.1.0"
description = "Fictional parser service for SASE demos"
TOML

cat >"$workspace/sase/sase.yml" <<'YAML'
is_sase_managed: true
YAML

cat >"$workspace/src/nova/__init__.py" <<'PY'
"""Nova demo package."""

from nova.parser import ParsedCommand, parse_command

__all__ = ["ParsedCommand", "parse_command"]
PY

cat >"$workspace/src/nova/parser.py" <<'PY'
from dataclasses import dataclass


@dataclass(frozen=True)
class ParsedCommand:
    name: str
    args: tuple[str, ...]


def parse_command(line: str) -> ParsedCommand:
    parts = tuple(part for part in line.strip().split() if part)
    if not parts:
        raise ValueError("command line is empty")
    return ParsedCommand(name=parts[0], args=parts[1:])
PY

cat >"$workspace/src/nova/cli.py" <<'PY'
from nova.config import load_settings
from nova.parser import parse_command
from nova.renderers.summary import command_summary


def main(argv: list[str]) -> int:
    settings = load_settings()
    command = parse_command(" ".join(argv))
    print(command_summary(command, environment=settings.environment))
    return 0
PY

cat >"$workspace/src/nova/config.py" <<'PY'
from dataclasses import dataclass


@dataclass(frozen=True)
class Settings:
    environment: str = "demo"
    dry_run: bool = True


def load_settings() -> Settings:
    return Settings()
PY

cat >"$workspace/src/nova/renderers/summary.py" <<'PY'
from nova.parser import ParsedCommand


def command_summary(command: ParsedCommand, *, environment: str) -> str:
    args = " ".join(command.args) if command.args else "no args"
    return f"{environment}: dispatch {command.name} ({args})"
PY

cat >"$workspace/src/parser.py" <<'PY'
from nova.parser import ParsedCommand, parse_command

__all__ = ["ParsedCommand", "parse_command"]
PY

cat >"$workspace/src/cli.py" <<'PY'
from nova.cli import main

__all__ = ["main"]
PY

cat >"$workspace/tests/test_parser.py" <<'PY'
import pytest

from nova.parser import parse_command


def test_parse_command_splits_name_and_args() -> None:
    parsed = parse_command("deploy staging --dry-run")
    assert parsed.name == "deploy"
    assert parsed.args == ("staging", "--dry-run")


def test_parse_command_rejects_empty_input() -> None:
    with pytest.raises(ValueError):
        parse_command("   ")
PY

cat >"$workspace/tests/test_cli.py" <<'PY'
from nova.cli import main


def test_main_dispatches_command(capsys) -> None:
    assert main(["deploy", "staging"]) == 0
    assert "demo: dispatch deploy (staging)" in capsys.readouterr().out
PY

cat >"$workspace/tests/test_config.py" <<'PY'
from nova.config import load_settings


def test_load_settings_uses_demo_defaults() -> None:
    settings = load_settings()
    assert settings.environment == "demo"
    assert settings.dry_run is True
PY

cat >"$workspace/tests/fixtures/commands.txt" <<'TEXT'
deploy staging --dry-run
render summary --format markdown
validate config --strict
TEXT

cat >"$workspace/docs/prompt_input_notes.md" <<'MARKDOWN'
# Prompt Input Notes

- `#add_tests` demonstrates xprompt completion with a path input.
- `@src/nova/parser.py` demonstrates file completion rooted in the fake workspace.
MARKDOWN

cat >"$workspace/docs/architecture.md" <<'MARKDOWN'
# Nova Architecture

Nova keeps parsing, configuration, and rendering in separate modules so the demo
workspace has realistic file-completion targets.
MARKDOWN

cat >"$workspace/docs/release_checklist.md" <<'MARKDOWN'
# Release Checklist

- Run parser and CLI tests.
- Review command fixtures.
- Update prompt-input notes when demo paths change.
MARKDOWN

cat >"$workspace/examples/basic_command.txt" <<'TEXT'
deploy staging --dry-run
TEXT

cat >"$workspace/.github/workflows/ci.yml" <<'YAML'
name: CI

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: python -m pytest
YAML

git init -q --bare "$bare_repo"
git init -q "$workspace"
git -C "$workspace" checkout -q -B main
git -C "$workspace" config user.name "SASE Demo"
git -C "$workspace" config user.email "demo@example.test"
git -C "$workspace" add README.md pyproject.toml src tests docs examples .github sase
git -C "$workspace" commit -q -m "Initial demo workspace"
git -C "$workspace" remote add origin "$bare_repo"
git -C "$workspace" push -q -u origin main

# Seed a second checkout that looks exactly like a GitHub workspace to the
# sase-github plugin while remaining fully local. The hosted-looking origin is
# classification metadata only; the demo never fetches it.
git clone -q --branch main "$bare_repo" "$github_workspace"
git -C "$github_workspace" remote set-url origin git@github.com:acme/nova.git
github_head=$(git -C "$github_workspace" rev-parse HEAD)
git -C "$github_workspace" update-ref refs/remotes/origin/main "$github_head"
git -C "$github_workspace" symbolic-ref \
  refs/remotes/origin/HEAD refs/remotes/origin/main

# Current GitHub workspaces require a provider-owned SDD sidecar. Seed its
# primary clone and materialization record so agent preparation can clone it
# locally without probing GitHub.
git init -q --bare -b main "$sdd_bare_repo"
mkdir -p "$(dirname "$github_sdd")"
git clone -q "$sdd_bare_repo" "$github_sdd"
git -C "$github_sdd" config user.name "SASE Demo"
git -C "$github_sdd" config user.email "demo@example.test"
cat >"$github_sdd/README.md" <<'MARKDOWN'
# Nova SDD

Hermetic planning sidecar for the fictional Nova demo repository.
MARKDOWN
git -C "$github_sdd" add README.md
git -C "$github_sdd" commit -q -m "Initialize demo SDD sidecar"
git -C "$github_sdd" push -q -u origin main
git -C "$github_sdd" remote set-url origin git@github.com:acme/nova--sdd.git
cat >"$github_workspace/.sase/sdd-store.json" <<'JSON'
{
  "schema_version": 1,
  "storage": "separate_repo",
  "provider": "github",
  "host": "github.com",
  "repo": "acme/nova--sdd",
  "remote_url": "git@github.com:acme/nova--sdd.git",
  "discovery": "found",
  "probed_at": "2026-07-06T14:00:00Z"
}
JSON
printf '/.sase/\n' >>"$github_workspace/.git/info/exclude"

# The built-in bare-git plugin identifies any `nova` clone by repository
# basename before the managed-workspace marker fallback runs. Mirror the same
# SDD record into the older bare-git seed so that compatibility lookup still
# reaches the hermetic sidecar during GitHub workspace preparation.
mkdir -p "$(dirname "$bare_git_sdd")"
git clone -q "$sdd_bare_repo" "$bare_git_sdd"
git -C "$bare_git_sdd" remote set-url origin git@github.com:acme/nova--sdd.git
cp "$github_workspace/.sase/sdd-store.json" "$workspace/.sase/sdd-store.json"
printf '/.sase/\n' >>"$workspace/.git/info/exclude"

# Serve the one fictional GitHub remote from the local bare repository. This
# preserves the hosted-looking origin in every numbered clone, so sase-github
# remains the active VCS provider, without allowing recording-time network I/O.
cat >"$fake_github_ssh" <<EOF
#!/usr/bin/env bash
set -euo pipefail

case "\$*" in
  *"git-upload-pack 'acme/nova.git'"*) exec git-upload-pack "$bare_repo" ;;
  *"git-upload-pack 'acme/nova'"*) exec git-upload-pack "$bare_repo" ;;
  *"git-upload-pack 'acme/nova--sdd.git'"*) exec git-upload-pack "$sdd_bare_repo" ;;
  *"git-upload-pack 'acme/nova--sdd'"*) exec git-upload-pack "$sdd_bare_repo" ;;
esac

printf 'error: demo SSH transport only serves acme/nova\n' >&2
exit 1
EOF
chmod +x "$fake_github_ssh"

cat >"$demo_home/.gitconfig" <<EOF
[core]
  sshCommand = $fake_github_ssh
EOF

cat >"$project_file" <<EOF
PROJECT_NAME: nova
PROJECT_ALIASES: nova-demo
PROJECT_STATE: active
BARE_REPO_DIR: $bare_repo
WORKSPACE_DIR: $workspace
