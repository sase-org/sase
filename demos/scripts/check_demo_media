#!/usr/bin/env python3
"""Reject demo GIFs that have regressed to a nearly grayscale palette."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from PIL import Image, ImageStat


MIN_MEAN_SATURATION = 0.05
SAMPLE_COUNT = 12
SAMPLE_MAX_SIZE = (320, 180)
LEAD_IN_FRACTION = 0.20

REPO_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_GIF_DIR = REPO_ROOT / "demos" / "out"


def sample_frame_indices(frame_count: int) -> tuple[int, ...]:
    """Choose evenly spaced frames after the recording's initial lead-in."""

    if frame_count < 1:
        raise ValueError("GIF contains no frames")

    last_index = frame_count - 1
    first_index = min(last_index, int(frame_count * LEAD_IN_FRACTION))
    if first_index == last_index:
        return (last_index,)

    sample_count = min(SAMPLE_COUNT, last_index - first_index + 1)
    return tuple(
        round(first_index + offset * (last_index - first_index) / (sample_count - 1))
        for offset in range(sample_count)
    )


def mean_saturation(path: Path) -> float:
    """Return mean normalized HSV saturation across representative GIF frames."""

    with Image.open(path) as image:
        if image.format != "GIF":
            raise ValueError(f"expected GIF media, got {image.format or 'unknown'}")

        frame_saturations: list[float] = []
        for frame_index in sample_frame_indices(image.n_frames):
            image.seek(frame_index)
            frame = image.convert("RGB")
            frame.thumbnail(SAMPLE_MAX_SIZE, Image.Resampling.BOX)
            saturation = ImageStat.Stat(frame.convert("HSV")).mean[1] / 255.0
            frame_saturations.append(saturation)

    return sum(frame_saturations) / len(frame_saturations)


def default_gifs() -> list[Path]:
    """Return every final demo GIF in stable order."""

    return sorted(DEFAULT_GIF_DIR.glob("*.gif"))


def check_gifs(paths: list[Path]) -> bool:
    """Print saturation measurements and return whether every GIF is healthy."""

    if not paths:
        print(f"error: no demo GIFs found in {DEFAULT_GIF_DIR}", file=sys.stderr)
        return False

    passed = True
    for path in paths:
        try:
            saturation = mean_saturation(path)
        except (OSError, ValueError) as error:
            print(f"error: {path}: {error}", file=sys.stderr)
            passed = False
            continue

        print(
            f"[demo-color] {path.name}: mean saturation {saturation:.4f} "
            f"(minimum {MIN_MEAN_SATURATION:.4f})"
        )
        if saturation < MIN_MEAN_SATURATION:
            print(
                f"error: {path} is nearly grayscale; verify COLORTERM=truecolor "
                "and NO_COLOR is unset",
                file=sys.stderr,
            )
            passed = False

    return passed


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments."""

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "gifs",
        nargs="*",
        type=Path,
        help="GIFs to check (default: every demos/out/*.gif)",
    )
    return parser.parse_args()


def main() -> int:
    """Run the saturation guard."""

    args = parse_args()
    paths = args.gifs or default_gifs()
    return 0 if check_gifs(paths) else 1


if __name__ == "__main__":
    raise SystemExit(main())
