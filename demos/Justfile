python := absolute_path("../.venv/bin/python")

# Reject final GIFs whose representative frames have regressed to grayscale.
check:
    {{ python }} scripts/check_demo_media

# Derive every final GIF from its measured MP4 and burn captions when a
# same-named tapes/*.captions.yml sidecar exists.
postprocess:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ python }} scripts/postprocess_demo_media sase_ace_prompt_input \
        --optimized-gif ../docs/images/blog/sase_ace_prompt_input.gif \
        --optimized-width 832 --optimized-colors 64 --optimized-fps 10
    {{ python }} scripts/postprocess_demo_media sase_ace_agents_observability \
        --optimized-gif ../docs/images/blog/sase_ace_agents_observability.gif \
        --optimized-width 832 --optimized-colors 64 --optimized-fps 10 \
        --still ../docs/images/blog/agents_observability_still.png \
        --still-at 12.0s
    {{ python }} scripts/postprocess_demo_media sase_ace_prompt_history_stash \
        --optimized-gif ../docs/images/blog/sase_ace_prompt_history_stash.gif \
        --optimized-width 832 --optimized-colors 64 --optimized-fps 10
    {{ python }} scripts/postprocess_demo_media sase_ace_prs_pipeline \
        --still ../docs/images/blog/sase_ace_prs_pipeline_still.png \
        --still-at 12.0s
    {{ python }} scripts/postprocess_demo_media sase_ace_multi_model_fanout \
        --optimized-gif ../docs/images/blog/sase_ace_multi_model_fanout.gif \
        --optimized-width 832 --optimized-colors 64 --optimized-fps 10 \
