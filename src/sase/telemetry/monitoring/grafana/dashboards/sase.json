      "title": "Agent Runs/min",
      "datasource": {"type": "prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by(status) (rate(sase_agent_runs_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "lineWidth": 2,
            "showPoints": "auto",
            "stacking": {"mode": "none"}
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      }
    },
