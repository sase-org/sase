/* Textual CSS for the ace TUI */

/* Hidden class for tab switching */
.hidden {
    display: none;
}

/* Top bar (tab bar + notification indicator) */
#top-bar {
    height: auto;
    max-height: 1;
}

/* Tab bar styling */
#tab-bar {
    width: 1fr;
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#task-indicator {
    width: auto;
    content-align: right middle;
}

#llm-override-indicator {
    width: auto;
    content-align: right middle;
}

#alias-overrides-indicator {
    width: auto;
    content-align: right middle;
}

#notification-indicator {
    width: auto;
    content-align: right middle;
}

#updates-indicator {
    width: auto;
    content-align: right middle;
}

#stashed-prompts-indicator {
    width: auto;
    content-align: right middle;
}

#main-container {
    height: 1fr;
}

/* Artifacts Tab View (internal id remains changespecs) */
#changespecs-view {
    width: 100%;
    height: 100%;
}

#artifacts-subtabs {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    background: $surface;
}

#artifacts-content-switcher,
#artifacts-prs-pane,
#artifacts-commits-pane,
#artifacts-bugs-pane,
#artifacts-plans-pane {
    width: 100%;
    height: 1fr;
}

FilterBar {
    display: none;
    width: 100%;
    height: 3;
    layers: base overlay;
    background: $background;
}

FilterBar .filter-bar-row {
    layer: base;
    width: 100%;
    height: 3;
}

FilterBar .filter-bar-sigil {
    width: 3;
    height: 3;
    text-style: bold;
    content-align: center middle;
}

FilterBar .filter-bar-input {
    width: 1fr;
    height: 3;
    background: $background;
}

FilterBar .filter-bar-status {
    width: auto;
    min-width: 14;
    max-width: 40%;
    height: 3;
    padding: 0 1;
    content-align: right middle;
    text-align: right;
    text-overflow: ellipsis;
}

FilterBar .filter-bar-status.error {
    min-width: 24;
}

FilterBar .filter-bar-completion {
    display: none;
    layer: overlay;
    position: absolute;
    overlay: screen;
    offset: 3 3;
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 10;
    background: $panel;
    scrollbar-size-vertical: 1;
}

CommitFilterBar .filter-bar-sigil {
    color: #FFD700;
}

CommitFilterBar .filter-bar-input,
CommitFilterBar .filter-bar-completion {
    border: solid #FFD700;
}

CommitFilterBar .filter-bar-completion > .option-list--option-highlighted {
    color: $background;
    background: #FFD700;
    text-style: bold;
}

PlanFilterBar .filter-bar-sigil {
    color: #AF87FF;
}

PlanFilterBar .filter-bar-input,
PlanFilterBar .filter-bar-completion {
    border: solid #AF87FF;
}

PlanFilterBar .filter-bar-completion > .option-list--option-highlighted {
    color: $background;
    background: #AF87FF;
    text-style: bold;
}

#commits-info {
    width: 100%;
    height: 3;
    max-height: 3;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#commits-main {
    width: 100%;
    height: 1fr;
}

#commits-list-container {
    width: 58%;
    min-width: 48;
    height: 100%;
}

#commits-timeline {
    width: 100%;
    height: 1fr;
    border: solid #FFD700;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#commits-footer {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#commits-detail-container {
    width: 1fr;
    height: 100%;
}

#commits-detail-scroll {
    width: 100%;
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
    scrollbar-gutter: stable;
}

#commits-detail {
    width: 100%;
    height: auto;
}

.artifacts-pane-info {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    content-align: center middle;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.artifacts-placeholder-scroll {
    width: 100%;
    height: 1fr;
    padding: 2 4;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

.artifacts-placeholder-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

.artifacts-placeholder-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    padding: 1 2;
}

#artifacts-commits-pane .artifacts-placeholder-card {
    border-title-color: #FFD700;
}

#artifacts-bugs-pane .artifacts-placeholder-card {
    border-title-color: #FF5F5F;
}

#artifacts-plans-pane .artifacts-placeholder-card {
    border-title-color: #AF87FF;
}

.artifacts-placeholder-footer {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

#plans-panels {
    width: 100%;
    height: 1fr;
}

/* Artifacts Bugs pane */
#bugs-content {
    width: 100%;
    height: 1fr;
}

#plans-list-panel {
    width: 55%;
    min-width: 56;
    height: 100%;
    border: round #AF87FF;
}

#plans-status {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#plans-list {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#plans-detail-panel {
    width: 1fr;
    height: 100%;
    border: round #5F5F87;
}

#plans-detail-scroll {
    width: 100%;
    height: 1fr;
}

#plans-detail-properties,
#plans-detail {
    width: 100%;
    height: auto;
}

#plans-detail-properties {
    padding: 1 2 0 2;
}

#plans-detail {
    padding: 0 2 1 2;
}

/* Keep inline code legible under flexoki across every ACE Markdown surface. */
MarkdownBlock > .code_inline {
    background: $foreground 10%;
    color: $text;
}

#plans-hints {
    width: 100%;
    height: 1;
    max-height: 1;
    background: $surface;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#bugs-list-container {
    width: 44%;
    min-width: 42;
    max-width: 78;
    height: 100%;
    border: solid #FF5F5F;
}

#bugs-list-header {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    content-align: left middle;
}

#bugs-list {
    width: 100%;
    height: 1fr;
    padding: 0 1;
    scrollbar-gutter: stable;
}

#bugs-list-message {
    width: 100%;
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: $text-muted;
}

#bugs-detail-container {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
}

#bugs-detail-title {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 4;
    padding: 0 2;
    content-align: left middle;
}

#bugs-detail-meta {
    width: 100%;
    height: auto;
    max-height: 3;
    padding: 0 2 1 2;
}

#bugs-body-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 2;
    scrollbar-gutter: stable;
}

#bugs-body {
    width: 100%;
    height: auto;
}

#bugs-links-title {
    width: 100%;
    height: 1;
    padding: 0 2;
    color: #FF5F5F;
    text-style: bold;
}

#bugs-links {
    width: 100%;
    height: 7;
    max-height: 7;
    padding: 0 1;
    border-top: solid $secondary;
}

#bugs-footer {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    content-align: center middle;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#bead-edit-container {
    width: 76;
    max-width: 92%;
    height: 28;
    max-height: 90%;
    border: round #AF87FF;
    background: $panel;
    padding: 1 2;
}

BeadEditModal {
    align: center middle;
    background: $background 70%;
}

#bead-edit-title {
    width: 100%;
    height: 2;
    color: #AF87FF;
    text-style: bold;
    content-align: center middle;
}

.bead-edit-label {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#bead-edit-title-input {
    width: 100%;
    height: 3;
}

#bead-edit-description-input {
    width: 100%;
    height: 1fr;
    border: round #5F5F87;
}

#bead-edit-buttons {
    width: 100%;
    height: 3;
    align-horizontal: center;
    margin-top: 1;
}

#bead-edit-buttons Button {
    margin: 0 1;
}

/* Create/edit issue modal */
IssueEditModal {
    align: center middle;
}

#issue-edit-container {
    width: 86;
    height: 34;
    max-height: 90%;
    padding: 1 2;
    border: round #FF5F5F;
    background: $surface;
}

#issue-edit-title {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-align: center;
    color: #FF5F5F;
    text-style: bold;
}

.issue-edit-label {
    width: 100%;
    height: 1;
    color: $text-muted;
}

#issue-edit-title-input,
#issue-edit-labels {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#issue-edit-body {
    width: 100%;
    height: 14;
    margin-bottom: 1;
    border: solid $secondary;
}

#issue-edit-buttons {
    width: 100%;
    height: 3;
    align-horizontal: center;
}

#changespecs-view.-onboarding-active #list-container {
    display: none;
}

#changespecs-view.-onboarding-active #detail-scroll {
    display: none;
}

#list-container {
    width: 43;  /* Default, will be set programmatically */
    min-width: 43;  /* Must fit info panel text */
    max-width: 80;
    height: 100%;
}

#info-panel {
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
}

#list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

/* Ancestors/Children Panel */
#ancestors-children-panel {
    height: auto;
    max-height: 24;  /* Increased from 18 to accommodate reverted children when visible */
    padding: 0 1 1 1;
    border: solid $secondary;
    background: $surface;
}

#detail-container {
    width: 1fr;  /* Takes remaining space */
    height: 100%;
}

#search-query-panel {
    width: 100%;
    height: auto;
    max-height: 3;
    border: solid $secondary;
    padding: 0 1;
}

#detail-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#detail-panel {
    height: auto;
}

#changespec-quickstart-panel {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

.tab-quickstart-callout {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round #FFD700;
    padding: 0 1;
    margin-bottom: 1;
}

.tab-quickstart-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.tab-quickstart-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    padding: 0 1;
    margin-bottom: 1;
}

.tab-quickstart-card.-agents {
    border-title-color: #87D7FF;
}

.tab-quickstart-card.-changespecs {
    border-title-color: #00D7AF;
}

.tab-quickstart-footer {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    color: $text-muted;
    margin-top: 1;
}

#changespec-onboarding-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.changespec-onboarding-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    border-title-color: #00D7AF;
    padding: 0 1;
    margin-bottom: 1;
}

#keybinding-footer {
    dock: bottom;
    height: auto;
    min-height: 1;
    background: $surface;
    padding: 0 1;
    border-top: hkey $panel-lighten-2;
}

#keybinding-content {
    width: 1fr;
}

#keybinding-status {
    width: auto;
}

/* List panel styling */
ChangeSpecList {
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

ChangeSpecList > .option-list--option {
    padding: 0 1;
}

ChangeSpecList > .option-list--option-highlighted {
    background: $accent 25%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

/* Modal styling */
StatusModal, QueryEditModal, WorkflowSelectModal, AcceptProposalModal, AgentCleanupModal, AgentCleanupTribeModal, AgentCleanupClanModal, AgentCleanupCustomModal, StashedPromptsModal, UpdatePinnedStashModal, QuitConfirmModal, InputCollectionModal {
    align: center middle;
}

StatusModal > Container, QueryEditModal > Container, WorkflowSelectModal > Container, AcceptProposalModal > Container {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.confirm-dialog {
    align: center middle;
}

.confirm-dialog-panel {
    width: 64;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

.confirm-dialog-panel.confirm-dialog--neutral {
    border: round $primary;
}

.confirm-dialog-panel.confirm-dialog--danger {
    border: round $error;
}

.confirm-dialog-message {
    width: 100%;
    height: auto;
    text-align: center;
    margin: 1 0 0 0;
}

.confirm-dialog-subject {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text;
    margin-top: 1;
}

.confirm-dialog-subject.is-empty {
    display: none;
}

.confirm-dialog-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

.confirm-dialog-panel Button {
    margin: 0 1;
    min-width: 14;
}

AgentCleanupModal > #agent-cleanup-container {
    width: 92;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupModal #agent-cleanup-title {
    text-style: bold;
    margin-bottom: 1;
}

AgentCleanupModal #agent-cleanup-summary {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

AgentCleanupModal .agent-cleanup-summary-card {
    width: 1fr;
    min-height: 4;
    border: solid $secondary;
    padding: 0 1;
}

AgentCleanupModal #agent-cleanup-actions {
    height: auto;
}

AgentCleanupModal #agent-cleanup-list {
    height: auto;
    max-height: 20;
    border: solid $secondary;
}

AgentCleanupModal #agent-cleanup-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

AgentCleanupTribeModal > #agent-cleanup-tribe-container {
    width: 74;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupTribeModal #agent-cleanup-tribe-list {
    height: auto;
    max-height: 18;
    border: solid $secondary;
}

AgentCleanupClanModal > #agent-cleanup-clan-container {
    width: 92;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupClanModal #agent-cleanup-clan-title {
    text-style: bold;
    color: #5FD7FF;
    margin-bottom: 1;
}

AgentCleanupClanModal #agent-cleanup-clan-list {
    height: auto;
    max-height: 22;
    border: solid $secondary;
}

AgentCleanupClanModal #agent-cleanup-clan-list > .option-list--option {
    padding: 0 1;
}

AgentCleanupClanModal #agent-cleanup-clan-list > .option-list--option-highlighted {
    background: $accent 22%;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

AgentCleanupClanModal #agent-cleanup-clan-preview {
    height: auto;
    min-height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

AgentCleanupClanModal #agent-cleanup-clan-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
}

AgentCleanupCustomModal > #agent-cleanup-custom-container {
    width: 96;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupCustomModal #agent-cleanup-custom-summary {
    height: auto;
    min-height: 2;
    margin-bottom: 1;
}

AgentCleanupCustomModal #agent-cleanup-custom-list {
    height: 18;
    max-height: 18;
    border: solid $secondary;
}

AgentCleanupCustomModal #agent-cleanup-search {
    margin-top: 1;
}

/* Prompt-stash restore picker */
StashedPromptsModal > #stashed-prompts-container {
    width: 96%;
    max-width: 156;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

StashedPromptsModal > #stashed-prompts-container.-narrow {
    width: 96;
    max-width: 96%;
}

StashedPromptsModal #stashed-prompts-panels {
    width: 100%;
    height: 23;
}

StashedPromptsModal #stashed-prompts-list-panel {
    width: 6fr;
    min-width: 54;
    height: 100%;
}

StashedPromptsModal #stashed-prompts-title {
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

StashedPromptsModal #stashed-prompts-list {
    height: 18;
    max-height: 18;
    border: solid $secondary;
}

StashedPromptsModal #stashed-prompts-list,
UpdatePinnedStashModal #update-pinned-stash-list {
    text-wrap: nowrap;
    text-overflow: clip;
}

StashedPromptsModal OptionList > .option-list--option,
UpdatePinnedStashModal OptionList > .option-list--option {
    height: 1;
    padding: 0 1;
}

StashedPromptsModal #stashed-prompts-hints {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

UpdatePinnedStashModal > #update-pinned-stash-container {
    width: 96%;
    max-width: 156;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

UpdatePinnedStashModal > #update-pinned-stash-container.-narrow {
    width: 96;
    max-width: 96%;
}

UpdatePinnedStashModal #update-pinned-stash-panels {
    width: 100%;
    height: 23;
}

UpdatePinnedStashModal #update-pinned-stash-list-panel {
    width: 6fr;
    min-width: 54;
    height: 100%;
}

UpdatePinnedStashModal #update-pinned-stash-title {
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

UpdatePinnedStashModal #update-pinned-stash-list {
    height: 18;
    max-height: 18;
    border: solid $secondary;
}

UpdatePinnedStashModal #update-pinned-stash-hints {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

StashedPromptsModal PromptStashPreviewPane,
UpdatePinnedStashModal PromptStashPreviewPane {
    width: 5fr;
    min-width: 46;
    height: 100%;
    margin-left: 1;
}

StashedPromptsModal .prompt-stash-preview-label,
UpdatePinnedStashModal .prompt-stash-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 2;
    padding: 0 1;
}

StashedPromptsModal .prompt-stash-preview-scroll,
UpdatePinnedStashModal .prompt-stash-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

StashedPromptsModal .prompt-stash-preview-placeholder,
StashedPromptsModal .prompt-stash-preview-frontmatter,
StashedPromptsModal .prompt-stash-preview-body,
StashedPromptsModal .prompt-stash-preview-metadata,
UpdatePinnedStashModal .prompt-stash-preview-placeholder,
UpdatePinnedStashModal .prompt-stash-preview-frontmatter,
UpdatePinnedStashModal .prompt-stash-preview-body,
UpdatePinnedStashModal .prompt-stash-preview-metadata {
    height: auto;
}

StashedPromptsModal .prompt-stash-preview-placeholder,
UpdatePinnedStashModal .prompt-stash-preview-placeholder,
StashedPromptsModal .prompt-stash-preview-metadata,
UpdatePinnedStashModal .prompt-stash-preview-metadata {
    color: $text-muted;
}

StashedPromptsModal .prompt-stash-preview-frontmatter,
UpdatePinnedStashModal .prompt-stash-preview-frontmatter {
    border-bottom: solid $secondary;
    margin-bottom: 1;
    padding-bottom: 1;
}

StashedPromptsModal #stashed-prompts-container.-narrow PromptStashPreviewPane,
UpdatePinnedStashModal #update-pinned-stash-container.-narrow PromptStashPreviewPane {
    display: none;
}

StashedPromptsModal #stashed-prompts-container.-narrow #stashed-prompts-list-panel,
UpdatePinnedStashModal #update-pinned-stash-container.-narrow #update-pinned-stash-list-panel {
    width: 100%;
}

/* Quit confirmation with running background-task details */
QuitConfirmModal > #quit-confirm-container {
    width: 70;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: round $error;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

QuitConfirmModal #quit-confirm-summary {
    height: auto;
    margin-bottom: 1;
}

QuitConfirmModal #quit-confirm-tasks {
    height: auto;
    max-height: 16;
    border: solid $secondary;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

QuitConfirmModal .quit-confirm-task-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

QuitConfirmModal #quit-confirm-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

QuitConfirmModal Button {
    margin: 0 1;
    min-width: 20;
}

/* Revert agent commits confirmation */
ConfirmRevertAgentModal {
    align: center middle;
}

ConfirmRevertAgentModal > #revert-confirm-container {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: round $error;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

ConfirmRevertAgentModal #revert-confirm-subtitle {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

ConfirmRevertAgentModal #revert-confirm-summary {
    height: auto;
    margin-bottom: 1;
}

ConfirmRevertAgentModal #revert-confirm-repos {
    height: auto;
    max-height: 16;
    border: solid $secondary;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

ConfirmRevertAgentModal .revert-confirm-repo-card,
ConfirmRevertAgentModal .revert-confirm-blocked-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

ConfirmRevertAgentModal .revert-confirm-blocked-card {
    border-left: thick $error;
}

ConfirmRevertAgentModal .revert-confirm-caption {
    height: auto;
}

ConfirmRevertAgentModal #revert-confirm-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ConfirmRevertAgentModal Button {
    margin: 0 1;
    min-width: 18;
}

/* Workflow HITL Modal styling */
WorkflowHITLModal {
    align: center middle;
}

#hitl-container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#hitl-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#step-info {
    margin-bottom: 1;
}

#hitl-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

.hitl-section-header {
    margin-top: 1;
}

#output-content {
    margin-bottom: 1;
}

#hitl-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Branch-driven gate review workbench */
PlanApprovalModal,
CustomGateModal {
    align: center middle;
}

.gate-review-shell {
    width: 98%;
    height: 98%;
    background: $surface;
    padding: 0 1;
}

#plan-approval-container {
    border: double $primary;
}

CustomGateModal > #custom-gate-container {
    border: double $accent;
}

.gate-review-header {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

.gate-review-body {
    height: 1fr;
}

.gate-review-body > .gate-review-actions {
    dock: left;
    width: 42;
    height: 1fr;
    margin-right: 1;
}

.gate-review-actions {
    border: solid $secondary;
    padding: 0 1;
    scrollbar-gutter: stable;
}

.gate-review-section-title {
    height: auto;
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

CustomGateModal #custom-gate-notes,
CustomGateModal #custom-gate-attachments {
    height: auto;
    margin-bottom: 1;
}

.gate-review-document {
    width: 1fr;
    height: 1fr;
    border: solid $secondary;
    border-title-align: left;
    border-title-color: #87D7FF;
    padding: 0 1;
    scrollbar-gutter: stable;
}

.gate-review-footer {
    height: auto;
    color: $text-muted;
    text-align: center;
    border-top: solid $secondary;
    margin-top: 1;
}

GateBranchControls {
    height: auto;
    max-height: 18;
    border: solid $secondary;
    padding: 0 1;
    scrollbar-gutter: stable;
}

GateBranchControls .gate-singleton-row {
    height: auto;
    align-horizontal: center;
}

GateBranchControls .gate-singleton-row Button {
    min-width: 18;
    margin: 0 1;
}

GateBranchControls .gate-group,
GateBranchControls .gate-group-details {
    height: auto;
}

GateBranchControls .gate-group-expand,
GateBranchControls .gate-group-submit {
    min-width: 20;
    margin: 0 1;
}

GateBranchControls .gate-option-toggle {
    width: 100%;
    text-align: left;
}

GateBranchControls #gate-feedback-label {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

GateBranchControls #gate-feedback-input {
    margin-bottom: 1;
}

GateBranchControls.gate-branch-controls--stacked {
    width: 100%;
    height: auto;
    max-height: initial;
    border: none;
    padding: 0;
    overflow-y: hidden;
    scrollbar-gutter: auto;
}

GateBranchControls.gate-branch-controls--stacked .gate-singleton-row {
    width: 100%;
    layout: vertical;
    align-horizontal: left;
}

GateBranchControls.gate-branch-controls--stacked .gate-singleton-row Button,
GateBranchControls.gate-branch-controls--stacked .gate-group-expand,
GateBranchControls.gate-branch-controls--stacked .gate-group-submit {
    width: 100%;
    margin: 0;
}

.gate-review-cancel {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

.gate-review-shell--compact {
    width: 60;
    max-width: 96%;
    height: auto;
    max-height: 96%;
}

.gate-review-shell--compact > .gate-review-actions--compact {
    width: 100%;
    height: auto;
    max-height: 30;
}

PlanApprovalModal.-gate-review-narrow .gate-review-body > .gate-review-actions,
CustomGateModal.-gate-review-narrow .gate-review-body > .gate-review-actions {
    dock: bottom;
    width: 100%;
    height: 48%;
    margin: 1 0 0 0;
}

/* Launch Approval Modal styling */
LaunchApprovalModal {
    align: center middle;
}

#launch-approval-container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#launch-approval-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#launch-approval-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

#launch-approval-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Gate lifecycle and artifact diagnostics */
GateDebugModal {
    align: center middle;
}

GateDebugModal > #gate-debug-container {
    width: 94%;
    max-width: 180;
    height: 92%;
    border: double #a8a8a8;
    background: $surface;
    padding: 1 2;
}

GateDebugModal.kind-plan > #gate-debug-container {
    border: double #ff87d7;
}

GateDebugModal.kind-epic > #gate-debug-container {
    border: double #d787ff;
}

GateDebugModal.kind-epic_plan > #gate-debug-container {
    border: double #d787ff;
}

GateDebugModal.kind-question > #gate-debug-container {
    border: double #87d7ff;
}

GateDebugModal.kind-launch > #gate-debug-container {
    border: double #5fffff;
}

GateDebugModal.kind-custom > #gate-debug-container {
    border: double #ffaf5f;
}

GateDebugModal.kind-hitl > #gate-debug-container {
    border: double #ffd75f;
}

GateDebugModal #gate-debug-header {
    height: auto;
    text-align: center;
    padding: 0 1 1 1;
}

GateDebugModal #gate-debug-tabs {
    height: 4;
    text-align: center;
    border-top: solid $secondary;
    border-bottom: solid $secondary;
    padding: 1 0 0 0;
}

GateDebugModal #gate-debug-scroll {
    height: 1fr;
    padding: 1 2;
    scrollbar-gutter: stable;
}

GateDebugModal #gate-debug-content {
    width: 100%;
    height: auto;
}

GateDebugModal #gate-debug-footer {
    height: auto;
    color: $text-muted;
    text-align: center;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Custom Approval Modal styling */
ApproveOptionsModal {
    align: center middle;
}

#approve-options-container {
    width: 70;
    height: auto;
    max-height: 26;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#approve-options-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.approval-choice-row {
    height: 1;
    margin-bottom: 1;
    color: $text;
}

.approval-choice-row.selected {
    color: $success;
    text-style: bold;
}

#coder-prompt-display {
    margin-bottom: 1;
    color: $text-muted;
}

#coder-prompt-display.disabled {
    color: $text-disabled;
}

.approve-options-model-label {
    height: auto;
    margin-top: 1;
}

.approve-options-model-label.disabled {
    color: $text-disabled;
}

#coder-model-display {
    margin-bottom: 1;
    color: $text-muted;
}

#coder-model-display.disabled {
    color: $text-disabled;
}

#approve-options-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Auto-Approve quick-action menu styling (agents tab `a` key). Mirrors the
   ApproveOptionsModal visual language (double border, $surface background,
   $success selected-row highlight) but drives single-key instant select. */
AutoApproveModal {
    align: center middle;
}

#auto-approve-container {
    width: 56;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#auto-approve-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.auto-approve-choice-row {
    height: 1;
    color: $text;
}

.auto-approve-choice-row.selected {
    color: $success;
    text-style: bold;
}

#auto-approve-agent {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#auto-approve-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
    margin-top: 1;
}


/* Model Picker Modal styling */
ModelPickerModal {
    align: center middle;
}

#model-picker-container {
    width: 64;
    height: auto;
    max-height: 26;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#model-picker-container.alias-enabled {
    width: 84;
    max-width: 95%;
}

#model-picker-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#model-picker-filter {
    height: 3;
    margin-bottom: 1;
}

#model-picker-list {
    height: auto;
    max-height: 18;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#model-picker-container.alias-enabled #model-picker-list {
    /* Reserve a stable footer lane even in a 30-row terminal. The list stays
       scrollable, so the alias section does not expand the modal off-screen. */
    max-height: 14;
}

#model-picker-container.alias-enabled #model-picker-footer {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#model-picker-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Agent Artifact Selection Modal styling */
ArtifactFileSelectionModal {
    align: center middle;
}

#agent-artifact-files-container {
    width: 74;
    height: auto;
    max-height: 28;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#agent-artifact-files-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#agent-artifact-files-list {
    height: auto;
    max-height: 20;
}

#agent-artifact-files-hints {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Agent Neighbor Modal styling */
AgentNeighborModal {
    align: center middle;
}

#agent-neighbor-container {
    width: 78;
    max-width: 94%;
    height: auto;
    max-height: 24;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#agent-neighbor-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#agent-neighbor-list {
    height: auto;
    max-height: 18;
}

#agent-neighbor-list > .option-list--option-disabled {
    color: $text-muted;
    text-style: bold;
}

#agent-neighbor-hints {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Agent Workspace Tmux Modal styling (echoes the WORKSPACES lane accent) */
AgentWorkspaceTmuxModal {
    align: center middle;
}

#agent-workspace-tmux-container {
    width: 90;
    max-width: 94%;
    height: auto;
    max-height: 24;
    border: double #FF87D7;
    background: $surface;
    padding: 1 2;
}

#agent-workspace-tmux-title {
    text-align: center;
    text-style: bold;
    color: #FF87D7;
    height: auto;
    margin-bottom: 1;
}

#agent-workspace-tmux-list {
    height: auto;
    max-height: 16;
}

#agent-workspace-tmux-hints {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid #AF87D7;
    padding-top: 1;
}


/* Models panel styling */
ModelsPanel {
    align: center middle;
}

#models-panel-container {
    width: 110;
    max-width: 95%;
    height: auto;
    /* Full-budget: container border (2) + padding (2) + title + margin (2) +
       list cap (22) + description strip margin + height (1 + 4 = 5) + footer
       margin + border + padding + text (4) = 37.  Sized so the taller
       description strip cannot push the footer out of the modal when the alias
       list is at its 22-row cap. */
    max-height: 37;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#models-panel-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#models-panel-list {
    height: auto;
    max-height: 22;
}

#models-panel-description {
    /* Border-box height: 1 (border-top) + 1 (padding-top) + 2 content rows = 4.
       Do NOT lower this back to 2 — that leaves 0 content rows and the strip
       renders its separator/padding with the description text fully clipped.
       Fixed (not auto) so navigating j/k between aliases with different
       description lengths causes zero layout shift. */
    height: 4;
    color: $text-muted;
    text-style: italic;
    border-top: solid $secondary;
    padding-top: 1;
    margin-top: 1;
}

#models-panel-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
    margin-top: 1;
}

ProjectAliasEditorModal {
    align: center middle;
}

ProjectAliasEditorModal > Container {
    width: 72;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ProjectAliasEditorModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

ProjectAliasEditorModal #project-alias-input {
    width: 100%;
    margin: 1 0;
}

ProjectAliasEditorModal #project-alias-hint {
    color: $text-muted;
    margin-bottom: 1;
}

ProjectAliasEditorModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ProjectAliasEditorModal Button {
    margin: 0 1;
}


/* Shared Duration Choice Modal styling */
PromptSubmitChoiceModal,
JumpActionModal,
QuitOptionsModal,
SnoozeDurationModal,
_DurationPickerModal {
    align: center middle;
}

.duration-choice-container {
    width: 54;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2 1 2;
}

#snooze-container {
    width: 54;
}

#override-duration-container {
    width: 56;
}

#prompt-submit-choice-container {
    width: 62;
}

#jump-action-container {
    width: 64;
}

#quit-options-container {
    width: 70;
}

#prompt-submit-choice-title {
    width: 100%;
}

#jump-action-title {
    width: 100%;
}

#quit-options-title {
    width: 100%;
}

#jump-action-header {
    color: $text;
}

.jump-action-footer {
    color: $text-muted;
}

.duration-choice-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.duration-choice-body {
    height: auto;
}

.duration-choice-row {
    height: auto;
    padding: 0 0 0 0;
    margin-bottom: 1;
}

.duration-choice-tone-primary {
    color: $accent;
}

.duration-choice-tone-accent {
    color: $warning;
}

.duration-choice-spacer {
    height: 0;
}

.duration-choice-custom-input {
    margin-top: 0;
    width: 100%;
}

.duration-choice-custom-error {
    color: $error;
    height: auto;
    margin-top: 1;
}


/* Models Panel: exact override time */
OverrideUntilModal {
    align: center middle;
}

#override-until-container {
    width: 70;
    height: 15;
    border: double #AF87D7;
    background: $surface;
    padding: 1 2;
}

#override-until-title {
    width: 100%;
    height: 1;
    text-align: center;
    text-style: bold;
    color: #AF87D7;
    margin-bottom: 1;
}

#override-until-field {
    width: 100%;
    height: 3;
}

#override-until-field-label {
    width: 7;
    height: 3;
    color: $text-muted;
    content-align: left middle;
}

#override-until-input {
    width: 1fr;
}

#override-until-preview {
    width: 100%;
    height: 3;
    padding-left: 7;
}

#override-until-preview.until-neutral {
    color: $text-muted;
}

#override-until-preview.until-valid {
    color: #87D75F;
}

#override-until-preview.until-error {
    color: $error;
}

#override-until-footer {
    width: 100%;
    height: 3;
    text-align: center;
    color: $text-muted;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Custom Model Input Modal styling */
CustomModelInputModal {
    align: center middle;
}

#custom-model-container {
    width: 42;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#custom-model-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#custom-model-hint {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#custom-model-input {
    margin-bottom: 1;
}

#custom-model-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Mentor Review Modal styling */
MentorReviewModal {
    align: center middle;
}

#mentor-review-container {
    width: 95%;
    height: 95%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#mentor-review-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#mentor-review-panels {
    height: 1fr;
}

#mentor-side-panel {
    width: 30;
    min-width: 25;
    height: 100%;
    border-right: solid $secondary;
    padding: 0 1;
}

#mentor-main-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
}

#mentor-review-footer {
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Mentor Profile Select Modal */
MentorProfileSelectModal {
    align: center middle;
}

#mentor-profile-select-container {
    width: 50%;
    height: 40%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#mentor-profile-select-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#mentor-profile-select-list {
    height: 1fr;
    overflow-y: auto;
    padding: 0 1;
}

#mentor-profile-select-footer {
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

StatusModal OptionList {
    height: auto;
    max-height: 15;
}

QueryEditModal Input {
    width: 100%;
    margin: 1 0;
}

QueryEditModal #query-hint {
    color: $text-muted;
    width: 100%;
    margin-bottom: 1;
}

QueryEditModal #query-error {
    color: $error;
    width: 100%;
    margin-bottom: 1;
}

QueryEditModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

QueryEditModal Button {
    margin: 0 1;
}

/* Input Collection Modal styling */
InputCollectionModal #input-collection-container {
    width: 64;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

InputCollectionModal #modal-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

InputCollectionModal #input-fields {
    height: auto;
    max-height: 24;
}

InputCollectionModal .input-field-block {
    height: auto;
    margin-bottom: 1;
}

InputCollectionModal .field-header {
    color: $secondary;
    text-style: bold;
}

InputCollectionModal .field-desc {
    color: $text-muted;
}

InputCollectionModal .field-error {
    color: $error;
}

InputCollectionModal SingleLineVimTextArea {
    width: 100%;
    margin: 0;
}

InputCollectionModal #toggle-optional {
    width: 100%;
    margin-bottom: 1;
}

InputCollectionModal #button-row {
    align: center middle;
    height: auto;
    margin-top: 1;
}

InputCollectionModal #button-row Button {
    margin: 0 1;
}

/* Accept Proposal Modal styling */
AcceptProposalModal #proposals-display {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid $secondary;
}

AcceptProposalModal #help-text {
    margin: 1 0;
    color: $text-muted;
}

AcceptProposalModal Input {
    width: 100%;
    margin: 1 0;
}

AcceptProposalModal #error-message {
    height: auto;
    margin: 0;
}

AcceptProposalModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

AcceptProposalModal Button {
    margin: 0 1;
}

/* View Files and Edit Hooks Modal styling */
ViewFilesModal, EditHooksModal {
    align: center middle;
}

ViewFilesModal > Container, EditHooksModal > Container {
    width: 80;
    height: auto;
    max-height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#view-files-container, #edit-hooks-container {
    width: 100%;
}

ViewFilesModal #hints-display, EditHooksModal #hints-display {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid $secondary;
}

ViewFilesModal #hint-prompt, EditHooksModal #instructions {
    margin: 1 0 0 0;
    color: $text-muted;
}

ViewFilesModal Input, EditHooksModal Input {
    width: 100%;
    margin: 1 0;
}

ViewFilesModal #error-message, EditHooksModal #error-message {
    height: auto;
    margin: 0;
}

ViewFilesModal Horizontal, EditHooksModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ViewFilesModal Button, EditHooksModal Button {
    margin: 0 1;
}

/* Hint input bar styling */
HintInputBar {
    height: 3;
    border: solid $accent;
    background: $surface;
    padding: 0 1;
}

HintInputBar #hint-input-container {
    width: 100%;
    height: 100%;
    align: left middle;
}

HintInputBar #hint-label {
    width: auto;
    height: auto;
    text-style: bold;
    color: $primary;
    padding: 0 1 0 0;
}

HintInputBar #hint-input {
    width: 1fr;
    height: 1;
    border: none;
    background: $background;
    color: $text;
    padding: 0 1;
}

HintInputBar #hint-input:focus {
    border: none;
    background: $background;
}

HintInputBar #hint-escape-hint {
    width: auto;
    height: auto;
    color: $text-muted;
    padding: 0 0 0 1;
}

/* ===== Agents Tab Styling ===== */

#agents-view {
    width: 100%;
    height: 100%;
}

#agents-content {
    width: 100%;
    height: 1fr;
}

#agent-list-container {
    width: 60;
    height: 100%;
    layout: vertical;
}

#agents-view.-onboarding-active #agent-list-container {
    display: none;
}

#agents-content.-artifact-file-viewer-active #agent-list-container {
    display: none;
}

#agent-info-panel {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#agents-view.-onboarding-active #agent-info-panel {
    display: none;
}

#agent-list-container AgentList {
    width: 100%;
    /* Fallback only — overridden per-refresh by
       AgentDisplayMixin._apply_panel_heights, which sets either a
       cell-unit height (Fits regime) or fr weight (Overflow regime)
       based on each panel's content. */
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

#agent-list-container AgentList.agent-panel-separated {
    margin-top: 1;
}

#agent-list-container AgentList.-focused-panel {
    border: solid #FFD700;
}

#agent-list-container AgentList.-whole-panel-focus {
    /* Outlines are paint-only: unlike swapping border geometry on every j/k
       panel hop, they do not force the panel collection through layout. Keep
       the top edge unset so it cannot paint over the border title. */
    outline-left: heavy #FFD75F;
    outline-right: heavy #FFD75F;
    outline-bottom: heavy #FFD75F;
    border-title-color: #FFD75F;
}

#agent-detail-container {
    width: 1fr;
    height: 100%;
}

#agent-detail-panel {
    width: 100%;
    height: 1fr;
}

#agent-quickstart-panel {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

#agent-onboarding-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.agent-onboarding-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    border-title-color: #87D7FF;
    padding: 0 1;
    margin-bottom: 1;
}

.agent-onboarding-card.-recommend {
    border: round #AF87FF;
    border-title-color: #AF87FF;
}

#axe-onboarding-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.axe-onboarding-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    border-title-color: #FF5F5F;
    padding: 0 1;
    margin-bottom: 1;
}

#agent-detail-layout {
    width: 100%;
    height: 100%;
}

#agent-prompt-scroll,
#agent-search-scroll {
    height: 3fr;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-subtitle-align: center;
}

#agent-search-scroll {
    border: solid $accent;
    overflow-x: auto;
}

#agent-prompt-scroll.hidden,
#agent-search-scroll.hidden {
    display: none;
}

#agent-search-panel {
    width: auto;
    min-width: 100%;
    height: auto;
}

#agent-search-command {
    width: 100%;
    height: auto;
    max-height: 3;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#agent-search-command.hidden {
    display: none;
}

#agent-file-scroll {
    height: 7fr;
    border: solid green;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-title-align: left;
    border-subtitle-align: center;
}

#agent-file-scroll.hidden {
    display: none;
}

#agent-prompt-scroll.expanded {
    height: 100%;
}

#agent-search-scroll.expanded {
    height: 1fr;
}

/* Swapped layout (prompt gets priority) */
#agent-prompt-scroll.layout-priority,
#agent-search-scroll.layout-priority {
    height: 7fr;
}

#agent-file-scroll.layout-secondary {
    height: 3fr;
}

#agent-tools-scroll {
    height: 7fr;
    border: solid #87D7FF;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#agent-tools-scroll.hidden {
    display: none;
}

#agent-tools-scroll.layout-secondary {
    height: 3fr;
}

/* Agent list styling */
AgentList {
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

AgentList > .option-list--option {
    padding: 0 1;
}

AgentList > .option-list--option-highlighted {
    background: $accent 40%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

/* Prompt input bar styling (for agent workflow) */
PromptInputBar {
    height: 3;
    border: solid $accent;
    background: $surface;
    dock: bottom;
    padding: 0 1;
}

PromptInputBar #prompt-completion {
    width: 100%;
    height: auto;
    max-height: 10;
    border: solid $secondary;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #prompt-completion.hidden {
    display: none;
}

PromptInputBar #prompt-completion.jinja-diagnostics {
    max-height: 5;
}

PromptInputBar #prompt-completion.jinja-error {
    border: solid $error;
}

PromptInputBar #prompt-completion.jinja-warning {
    border: solid $warning;
}

/* The structured frontmatter panel, directly above the prompt stack. */
PromptInputBar #frontmatter-panel {
    width: 100%;
    height: auto;
    max-height: 18;
    border: round $secondary;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #frontmatter-panel.hidden {
    display: none;
}

PromptInputBar #frontmatter-panel:focus {
    border: round $accent;
}

/* Prompt `g` prefix hints, directly above the prompt stack. */
PromptInputBar #prompt-g-prefix-hints {
    width: 100%;
    height: auto;
    max-height: 13;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #prompt-g-prefix-hints.hidden {
    display: none;
}

/* Prompt Vim search command line, directly above the prompt stack. */
PromptInputBar #prompt-search-command {
    width: 100%;
    height: auto;
    max-height: 3;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #prompt-search-command.hidden {
    display: none;
}

PromptInputBar #frontmatter-rows {
    width: 100%;
    height: auto;
    max-height: 10;
    overflow-y: auto;
}

PromptInputBar #frontmatter-rows.hidden {
    display: none;
}

PromptInputBar #frontmatter-inline {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    border: round $accent;
}

PromptInputBar #frontmatter-inline.hidden {
    display: none;
}

PromptInputBar #frontmatter-raw {
    width: 100%;
    height: auto;
    max-height: 12;
    border: round $accent;
}

PromptInputBar #frontmatter-raw.hidden {
    display: none;
}

PromptInputBar #frontmatter-content {
    width: 100%;
    height: 6;
    border: round $accent;
}

PromptInputBar #frontmatter-content.hidden,
PromptInputBar #frontmatter-feedback.hidden {
    display: none;
}

PromptInputBar #frontmatter-feedback {
    width: 100%;
    height: auto;
    max-height: 4;
    color: $error;
}

/* The prompt stack: a vertical list of one-or-more prompt panes. */
PromptInputBar #prompt-stack {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

/* Shared text-area styling for every pane. */
PromptInputBar .prompt-input {
    width: 100%;
    background: $background;
    color: $text;
}

/* Vim cursor accents mirror the prompt gutter colors in
   widgets/_line_rendering.py: normal gold (#D0A215), insert cyan (#3AA99F),
   and visual magenta (#CE5D97).  These prompt-scoped component rules replace
   TextArea's default reverse-video cursor with explicit readable cells. */
PromptInputBar PromptTextArea.prompt-input.-vim-normal .text-area--cursor {
    color: #100F0F;
    background: #D0A215;
    text-style: bold;
}

PromptInputBar PromptTextArea.prompt-input.-vim-insert .text-area--cursor {
    color: #100F0F;
    background: #3AA99F;
    text-style: bold;
}

PromptInputBar PromptTextArea.prompt-input.-vim-visual .text-area--cursor {
    color: #FFFCF0;
    background: #CE5D97;
    text-style: bold;
}

/* Generalized vim cursor accents for any VimTextArea (config-tab editors,
   etc.).  Textual type selectors match base classes, so these also cover
   PromptTextArea, but the prompt-scoped rules above win there by specificity
   and set identical colors.  Same palette as widgets/_line_rendering.py. */
VimTextArea.-vim-normal .text-area--cursor {
    color: #100F0F;
    background: #D0A215;
    text-style: bold;
}

VimTextArea.-vim-insert .text-area--cursor {
    color: #100F0F;
    background: #3AA99F;
    text-style: bold;
}

VimTextArea.-vim-visual .text-area--cursor {
    color: #FFFCF0;
    background: #CE5D97;
    text-style: bold;
}

SingleLineVimTextArea {
    width: 100%;
    height: 3;
    /* Border carries the vim mode title ([INSERT] / [NORMAL] / ...). */
    border: solid $secondary;
}

/* Single-pane (solo) mode is visually identical to the pre-stack bar: the
   text area fills the bar and carries no border of its own. */
PromptInputBar .prompt-input.solo {
    height: 1fr;
    border: none;
}

PromptInputBar .prompt-input.solo:focus {
    border: none;
    background: $background;
}

/* Multi-pane mode: each pane is a quiet framed item.  A left accent bar marks
   the active pane; inactive panes dim and compact.  Clearing the base TextArea
   border first is essential: only the left accent should reserve space, so the
   panes do not read as nested cards AND do not silently reserve the top/bottom
   border rows that would shrink each pane's content by two rows. */
PromptInputBar .prompt-pane {
    border: none;
    border-left: thick $accent 30%;
    padding: 0 0 0 1;
    margin: 0;
}

PromptInputBar .prompt-pane.active {
    border-left: thick $accent;
    background: $surface;
}

PromptInputBar .prompt-pane.active:focus {
    background: $surface;
}

PromptInputBar .prompt-pane.inactive {
    background: $background;
    color: $text-muted;
}

/* Separator rows: width-aware hairline rules with centered agent labels. */
PromptInputBar .prompt-stack-separator {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-muted;
}

PromptInputBar .prompt-stack-separator.inactive {
    text-style: dim;
}

PromptInputBar .prompt-stack-separator.active {
    color: $accent;
}

PromptInputBar.feedback-mode {
    border: solid $warning;
}

/* Add-property picker for the frontmatter panel */
AddPropertyModal {
    align: center middle;
}

AddPropertyModal > Container {
    width: 76;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AddPropertyModal #modal-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

AddPropertyModal #add-property-list {
    height: auto;
    max-height: 12;
    scrollbar-gutter: stable;
}

AddPropertyModal .add-property-row {
    height: 1;
    padding: 0 1;
    color: $text;
}

AddPropertyModal .add-property-row.selected {
    background: $accent 25%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

AddPropertyModal #add-property-detail {
    height: auto;
    color: $text-muted;
    border-top: solid $secondary;
    margin-top: 1;
    padding-top: 1;
}

AddPropertyModal #add-property-footer {
    height: auto;
    text-align: center;
    color: $text-muted;
    border-top: solid $secondary;
    margin-top: 1;
    padding-top: 1;
}

/* Structured input / xprompts sub-form modals for the frontmatter panel */
XPromptWriteConflictModal {
    align: center middle;
}

XPromptWriteConflictModal > Container {
    width: 64;
    height: auto;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

XPromptWriteConflictModal #xprompt-conflict-title {
    text-style: bold;
    text-align: center;
}

XPromptWriteConflictModal #xprompt-conflict-path,
XPromptWriteConflictModal #xprompt-conflict-hints {
    color: $text-muted;
    text-align: center;
}

XPromptWriteConflictModal #xprompt-conflict-options {
    height: 5;
    margin: 1 0;
}

UnifiedXPromptSaveModal {
    align: center middle;
}

UnifiedXPromptSaveModal > Container {
    width: 94%;
    height: 86%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

UnifiedXPromptSaveModal #unified-save-title {
    text-style: bold;
    text-align: center;
    height: 1;
    margin-bottom: 1;
}

UnifiedXPromptSaveModal .unified-save-field {
    height: 3;
}

UnifiedXPromptSaveModal .unified-save-field-label {
    width: 13;
    color: $text-muted;
    padding-top: 1;
}

UnifiedXPromptSaveModal .unified-save-field Input {
    width: 1fr;
}

UnifiedXPromptSaveModal #unified-save-panels {
    height: 1fr;
}

UnifiedXPromptSaveModal #unified-save-locations-panel {
    width: 44%;
    padding-right: 1;
}

UnifiedXPromptSaveModal .unified-save-panel-title,
UnifiedXPromptSaveModal #unified-save-preview-header {
    height: 2;
    text-style: bold;
}

UnifiedXPromptSaveModal #unified-save-locations {
    height: 1fr;
    border: solid $secondary;
}

UnifiedXPromptSaveModal #unified-save-preview-panel {
    width: 56%;
    border-left: solid $secondary;
    padding-left: 1;
}

UnifiedXPromptSaveModal #unified-save-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

UnifiedXPromptSaveModal #unified-save-preview {
    height: auto;
}

UnifiedXPromptSaveModal #unified-save-verdict {
    height: 2;
    margin-top: 1;
    text-style: bold;
}

UnifiedXPromptSaveModal .unified-save-verdict-success {
    color: $success;
}

UnifiedXPromptSaveModal .unified-save-verdict-warning {
    color: $warning;
}

UnifiedXPromptSaveModal .unified-save-verdict-error {
    color: $error;
}

UnifiedXPromptSaveModal #unified-save-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
}

InputItemModal,
XPromptItemModal {
    align: center middle;
}

InputItemModal > Container,
XPromptItemModal > Container {
    width: 70;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

InputItemModal #modal-title,
XPromptItemModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

InputItemModal .input-item-field-label,
XPromptItemModal .input-item-field-label {
    color: $text-muted;
    margin-top: 1;
}

InputItemModal SingleLineVimTextArea,
XPromptItemModal SingleLineVimTextArea {
    width: 100%;
}

XPromptItemModal #xprompt-item-content {
    height: 5;
    border: solid $secondary;
}

InputItemModal #input-item-type-rule {
    color: $text-muted;
}

InputItemModal #input-item-error,
XPromptItemModal #xprompt-item-error {
    color: $error;
    margin-top: 1;
}

InputItemModal #input-item-footer,
XPromptItemModal #xprompt-item-footer {
    color: $text-muted;
    margin-top: 1;
}

/* XPrompt select modal styling */
XPromptSelectModal {
    align: center middle;
}

XPromptSelectModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptSelectModal #xprompt-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptSelectModal #xprompt-panels {
    width: 100%;
    height: 1fr;
}

XPromptSelectModal #xprompt-list-panel {
    width: 40;
    height: 100%;
}

XPromptSelectModal #xprompt-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

XPromptSelectModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

XPromptSelectModal #xprompt-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptSelectModal #xprompt-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

XPromptSelectModal #xprompt-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptSelectModal #xprompt-preview {
    height: auto;
}

XPromptSelectModal #xprompt-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Prompt history modal styling */
PromptHistoryModal {
    align: center middle;
}

PromptHistoryModal > Container {
    width: 98%;
    height: 96%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

PromptHistoryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

PromptHistoryModal #prompt-history-filter-input {
    width: 100%;
    margin-bottom: 1;
}

PromptHistoryModal #prompt-history-panels {
    width: 100%;
    height: 1fr;
}

PromptHistoryModal #prompt-history-list-panel {
    width: 2fr;
    height: 100%;
}

PromptHistoryModal #prompt-history-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

PromptHistoryModal #prompt-history-table {
    height: 1fr;
    border: solid $secondary;
}

PromptHistoryModal #prompt-history-columns {
    height: 2;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $secondary;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

PromptHistoryModal OptionList {
    height: 1fr;
    border: none;
    background: $surface;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

PromptHistoryModal OptionList > .option-list--option {
    padding: 0 1;
}

PromptHistoryModal OptionList > .option-list--option-highlighted {
    background: $accent 40%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

PromptHistoryModal #prompt-history-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

PromptHistoryModal #prompt-history-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

PromptHistoryModal #prompt-history-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

PromptHistoryModal #prompt-history-preview {
    height: auto;
}

PromptHistoryModal #prompt-history-metadata {
    height: auto;
    color: $text-muted;
}

PromptHistoryModal #prompt-history-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Command history modal styling */
CommandHistoryModal {
    align: center middle;
}

CommandHistoryModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommandHistoryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

CommandHistoryModal #command-history-header {
    color: $text-muted;
    margin-bottom: 1;
}

CommandHistoryModal #command-history-filter-input {
    width: 100%;
    margin-bottom: 1;
}

CommandHistoryModal #command-history-panels {
    width: 100%;
    height: 1fr;
}

CommandHistoryModal #command-history-list-panel {
    width: 1fr;
    height: 100%;
}

CommandHistoryModal #command-history-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

CommandHistoryModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

CommandHistoryModal #command-history-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

CommandHistoryModal #command-history-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

CommandHistoryModal #command-history-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

CommandHistoryModal #command-history-preview {
    height: auto;
}

CommandHistoryModal #command-history-metadata {
    height: auto;
    color: $text-muted;
}

CommandHistoryModal #command-history-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Hook history modal styling */
HookHistoryModal {
    align: center middle;
}

HookHistoryModal > Container {
    width: 70%;
    height: 60%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

HookHistoryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

HookHistoryModal #hook-history-filter-input {
    width: 100%;
    margin-bottom: 1;
}

HookHistoryModal #hook-history-list-panel {
    width: 100%;
    height: 1fr;
}

HookHistoryModal #hook-history-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

HookHistoryModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

HookHistoryModal #hook-history-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Axe Tab Styling ===== */

#axe-view {
    width: 100%;
    height: 100%;
}

/* Background command list container (left panel).  Width is computed
   programmatically from the widest formatted row (see
   ``BgCmdList.WidthChanged``); the values below are a fallback for the
   first paint before the widget posts its initial width event. */
#bgcmd-list-container {
    width: 35;
    min-width: 35;
    height: 100%;
}

#bgcmd-list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

/* BgCmdList styling */
BgCmdList {
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

BgCmdList > .option-list--option {
    padding: 0 1;
}

BgCmdList > .option-list--option-highlighted {
    background: $accent 25%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

#axe-container {
    width: 1fr;
    height: 100%;
}

#axe-info-panel {
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $secondary;
}

#axe-dashboard {
    width: 100%;
    height: 1fr;
}

#axe-status-section {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#axe-output-scroll {
    height: 1fr;
    overflow-y: auto;
    scrollbar-gutter: stable;
    border-top: solid $secondary;
    padding: 1 2;
}

#axe-output-section {
    height: auto;
}

/* ===== Saved Query Picker Styling ===== */

SavedQueryPickerModal {
    align: center middle;
}

SavedQueryPickerModal > #saved-query-picker-container {
    width: 82;
    max-width: 94%;
    height: auto;
    max-height: 80%;
    border: round #FFD700;
    background: $surface;
    padding: 1 2;
}

SavedQueryPickerModal #saved-query-picker-title {
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

SavedQueryPickerModal #saved-query-picker-list {
    height: auto;
    max-height: 12;
    border-top: solid #00D7AF;
    border-bottom: solid #00D7AF;
    padding: 1 0;
    scrollbar-gutter: stable;
}

SavedQueryPickerModal #saved-query-picker-list.-empty {
    display: none;
}

SavedQueryPickerModal #saved-query-picker-list > .option-list--option {
    height: 1;
    padding: 0 1;
}

SavedQueryPickerModal #saved-query-picker-list > .option-list--option-highlighted {
    background: #183A3A;
    color: $text;
    text-style: bold;
}

SavedQueryPickerModal #saved-query-picker-empty {
    height: auto;
    min-height: 5;
    content-align: center middle;
    border-top: solid #00D7AF;
    border-bottom: solid #00D7AF;
    padding: 1 2;
}

SavedQueryPickerModal #saved-query-picker-footer {
    height: auto;
    text-align: center;
    margin-top: 1;
    color: $text-muted;
}

/* ===== Help Modal Styling ===== */

HelpModal {
    align: center middle;
}

HelpModal > Container {
    width: 98%;
    height: 96%;
    border: round #00D7AF;
    background: $surface;
    padding: 1 1;
}

HelpModal #help-modal-container.-tab-changespecs {
    border: round #00D7AF;
}

HelpModal #help-modal-container.-tab-agents {
    border: round #87D7FF;
}

HelpModal #help-modal-container.-tab-axe {
    border: round #FF5F5F;
}

HelpModal #help-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

HelpModal #help-tabs {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

HelpModal #help-content-switcher {
    height: 1fr;
    border-top: solid $secondary;
    padding-top: 1;
}

HelpModal #help-keymaps-view {
    height: 1fr;
    scrollbar-gutter: stable;
}

HelpModal #help-guide-view {
    height: 1fr;
}

HelpModal .help-guide-content {
    width: 100%;
    height: 1fr;
    padding: 0 0;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

HelpModal #help-columns {
    width: 100%;
    height: auto;
}

HelpModal .help-column {
    width: 1fr;
    height: auto;
    text-wrap: nowrap;
    text-overflow: clip;
}

HelpModal #help-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Jump All Entries Modal Styling ===== */

JumpAllModal {
    align: center middle;
}

JumpAllModal > Container {
    width: 85%;
    max-width: 130;
    height: 80%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

JumpAllModal #jump-all-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

JumpAllModal #jump-all-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

JumpAllModal #jump-all-content {
    width: 100%;
    height: auto;
}

JumpAllModal #jump-all-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Recursive Fuzzy File Finder Modal (Ctrl+R) ===== */

RecursiveFileFinderModal {
    align: center middle;
}

RecursiveFileFinderModal #finder-dialog {
    width: 80%;
    max-width: 120;
    height: 70%;
    max-height: 40;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

RecursiveFileFinderModal #finder-results {
    width: 100%;
    height: 1fr;
}

RecursiveFileFinderModal #finder-query {
    width: 100%;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
    color: $text;
}

/* ===== Preview Panel Modal Styling ===== */

PreviewPanelModal {
    align: center middle;
}

PreviewPanelModal > Container {
    width: 85%;
    height: 85%;
    max-width: 150;
    max-height: 42;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

PreviewPanelModal #preview-title {
    height: auto;
    margin-bottom: 1;
}

PreviewPanelModal #preview-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    border: solid $secondary;
    padding: 0 1;
}

PreviewPanelModal #preview-content {
    width: 100%;
    height: auto;
}

PreviewPanelModal #preview-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Commit View Modal Styling ===== */

CommitViewModal {
    align: center middle;
}

CommitViewModal > Container {
    width: 85%;
    height: 85%;
    max-width: 150;
    max-height: 42;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommitViewModal #commit-view-title {
    height: auto;
    margin-bottom: 1;
}

CommitViewModal #commit-view-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    border: solid $secondary;
    padding: 0 1;
}

CommitViewModal #commit-view-content {
    width: 100%;
    height: auto;
}

CommitViewModal #commit-view-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Workspace Input Modal Styling ===== */

WorkspaceInputModal {
    align: center middle;
}

WorkspaceInputModal > Container {
    width: 50;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

WorkspaceInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

WorkspaceInputModal #workspace-hint {
    color: $text-muted;
    margin-bottom: 1;
}

WorkspaceInputModal #workspace-input {
    width: 100%;
}

/* ===== Command Input Modal Styling ===== */

CommandInputModal {
    align: center middle;
}

CommandInputModal > Container {
    width: 80;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommandInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

CommandInputModal #command-context {
    color: $text-muted;
    margin-bottom: 1;
}

CommandInputModal #command-hint {
    color: $text-muted;
    margin-bottom: 1;
}

CommandInputModal #command-input {
    width: 100%;
}

/* ===== Wait Modal Styling ===== */

WaitModal {
    align: center middle;
}

WaitModal > Container {
    width: 76;
    height: auto;
    max-height: 94%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

WaitModal #modal-title {
    text-style: bold;
}

WaitModal #wait-modal-summary {
    color: $text-muted;
}

WaitModal .wait-field-label {
    color: $secondary;
    text-style: bold;
}

WaitModal Input {
    width: 100%;
}

WaitModal #agent-completion {
    height: auto;
    max-height: 6;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

WaitModal #agent-completion > .option-list--option {
    padding: 0 1;
}

WaitModal #agent-completion > .option-list--option-highlighted {
    background: $accent 40%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

WaitModal #time-preview,
WaitModal #runners-preview {
    height: 1;
}

WaitModal #time-preview.wait-time-neutral,
WaitModal #runners-preview.wait-time-neutral {
    color: $text-muted;
}

WaitModal #time-preview.wait-time-valid,
WaitModal #runners-preview.wait-time-valid {
    color: $success;
}

WaitModal #time-preview.wait-time-error,
WaitModal #runners-preview.wait-time-error {
    color: $error;
}

WaitModal #wait-footer {
    color: $text-muted;
    text-align: center;
}

/* ===== Save Agent Group Modal Styling ===== */

SaveAgentGroupModal {
    align: center middle;
}

SaveAgentGroupModal > Container {
    width: 64;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

SaveAgentGroupModal #save-agent-group-title {
    text-style: bold;
    margin-bottom: 1;
}

SaveAgentGroupModal #save-agent-group-context {
    color: $text-muted;
    margin-bottom: 1;
}

SaveAgentGroupModal #save-agent-group-hint {
    color: $text-muted;
    margin-bottom: 1;
}

SaveAgentGroupModal #save-agent-group-name-input {
    width: 100%;
}

/* ===== Process Select Modal Styling ===== */

ProcessSelectModal {
    align: center middle;
}

ProcessSelectModal > Container {
    width: 70;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ProcessSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

ProcessSelectModal #process-hint {
    color: $text-muted;
    margin-bottom: 1;
}

ProcessSelectModal #process-list {
    height: auto;
    max-height: 15;
    border: solid $secondary;
}

/* ===== Notification Modal Styling ===== */

NotificationModal {
    align: center middle;
}

NotificationModal > Container {
    width: 95%;
    height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

NotificationModal #notification-title {
    text-style: bold;
    margin-bottom: 1;
}

NotificationModal #notification-panels {
    width: 100%;
    height: 1fr;
}

NotificationModal #notification-left {
    width: 40%;
    height: 100%;
}

NotificationModal #notification-left.image-preview {
    width: 30%;
}

NotificationModal #notification-tag-tabs {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

NotificationModal #notification-list {
    height: 1fr;
    border: solid $secondary;
    text-wrap: nowrap;
    text-overflow: clip;
}

NotificationModal #notification-empty {
    color: $text-muted;
    text-align: center;
    margin: 2 0;
}

NotificationModal #notification-right {
    width: 60%;
    height: 100%;
    margin-left: 1;
    border-left: solid $secondary;
    padding-left: 1;
}

NotificationModal #notification-right.image-preview {
    width: 70%;
}

NotificationModal #notification-file-title {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

NotificationModal #notification-file-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

NotificationModal #notification-file-content {
    height: auto;
}

NotificationModal #notification-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Zoom Panel Modal Styling ===== */

ZoomPanelModal {
    align: center middle;
}

ZoomPanelModal > #zoom-panel-container {
    width: 98%;
    height: 96%;
    border: thick $accent;
    background: $surface;
    padding: 0 1;
}

ZoomPanelModal #zoom-panel-header {
    height: 3;
    width: 100%;
    background: $accent 25%;
    margin-bottom: 1;
    padding: 0 1;
}

ZoomPanelModal #zoom-panel-title {
    width: 1fr;
    height: 100%;
    content-align: left middle;
    text-style: bold;
    color: $text;
}

ZoomPanelModal #zoom-panel-agent {
    width: auto;
    max-width: 45%;
    height: 100%;
    content-align: right middle;
    text-align: right;
}

ZoomPanelModal .zoom-scroll {
    height: 1fr;
    width: 100%;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-subtitle-align: center;
}

ZoomPanelModal #zoom-file-scroll {
    border: solid green;
}

ZoomPanelModal #zoom-file-view {
    height: 1fr;
    width: 100%;
}

ZoomPanelModal #zoom-file-view.hidden {
    display: none;
}

ZoomPanelModal #zoom-file-view > #zoom-file-scroll {
    height: 1fr;
    width: 1fr;
}

ZoomPanelModal #zoom-file-rail {
    width: 34;
    height: 1fr;
    border: solid green;
    padding: 1;
    margin-right: 1;
    color: $text;
    background: $panel;
    scrollbar-gutter: stable;
    overflow-y: auto;
}

ZoomPanelModal #zoom-file-rail.collapsed {
    display: none;
}

ZoomPanelModal #zoom-tools-scroll {
    border: solid #87D7FF;
}

ZoomPanelModal #zoom-search-scroll {
    border: solid $accent;
    overflow-x: auto;
}

ZoomPanelModal .zoom-scroll.hidden {
    display: none;
}

ZoomPanelModal #zoom-metadata-panel,
ZoomPanelModal #zoom-file-panel,
ZoomPanelModal #zoom-tools-panel,
ZoomPanelModal #zoom-search-panel {
    height: auto;
}

ZoomPanelModal #zoom-search-panel {
    width: auto;
    min-width: 100%;
}

ZoomPanelModal #zoom-search-command {
    width: 100%;
    height: auto;
    max-height: 3;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin-top: 1;
}

ZoomPanelModal #zoom-search-command.hidden {
    display: none;
}

ZoomPanelModal #zoom-panel-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Tag Input Modal Styling ===== */

TagInputModal {
    align: center middle;
}

TagInputModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

TagInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

TagInputModal #tag-name-history {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

/* Move notifications to top-right corner */
ToastRack {
    dock: top;
    align: right top;
    margin-top: 1;
    margin-bottom: 0;
}

Toast {
    width: auto;
    min-width: 44;
    max-width: 72;
}

/* ===== Runners Modal Styling ===== */

RunnersModal {
    align: center middle;
}

RunnersModal > Container {
    width: 90%;
    max-width: 200;
    height: 70%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

RunnersModal #runners-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

RunnersModal #runners-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

RunnersModal #runners-content {
    height: auto;
}

RunnersModal #runners-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== User Question Modal Styling ===== */

UserQuestionModal {
    align: center middle;
}

#user-question-container {
    width: 92%;
    max-width: 180;
    height: 88%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#user-question-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#user-question-panels {
    width: 100%;
    height: 1fr;
}

#user-question-left {
    width: 30;
    min-width: 25;
    max-width: 40;
    height: 100%;
}

#user-question-list-label {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#user-question-list {
    height: 1fr;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

#user-question-right {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    padding-left: 1;
    border-left: solid $secondary;
}

#user-question-header {
    height: auto;
    margin-bottom: 1;
}

#user-question-text-scroll {
    height: auto;
    max-height: 40%;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

#user-question-text {
    height: auto;
}

#user-question-options {
    height: 1fr;
    border: solid $secondary;
    scrollbar-gutter: stable;
    text-wrap: wrap;
    text-overflow: clip;
}

#user-question-other-input {
    width: 100%;
    margin-top: 1;
}

#user-question-global-input {
    width: 100%;
    margin-top: 1;
}

#user-question-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Dismissed agent (revive) modal styling */
DismissedAgentSelectModal {
    align: center middle;
}

DismissedAgentSelectModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

DismissedAgentSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

DismissedAgentSelectModal #dismissed-filter {
    width: 100%;
    margin-bottom: 1;
}

DismissedAgentSelectModal #dismissed-agent-panels {
    width: 100%;
    height: 1fr;
}

DismissedAgentSelectModal #dismissed-agent-list-panel {
    width: 45%;
    height: 100%;
}

DismissedAgentSelectModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

DismissedAgentSelectModal #dismissed-agent-preview-panel {
    width: 55%;
    height: 100%;
    margin-left: 1;
}

DismissedAgentSelectModal #dismissed-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 1;
}

DismissedAgentSelectModal #dismissed-preview-metadata {
    height: auto;
}

DismissedAgentSelectModal #dismissed-preview-content {
    height: auto;
    color: $text-muted;
}

DismissedAgentSelectModal #dismissed-agent-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Saved dismissed-agent group revival modal styling */
SavedAgentGroupRevivalModal {
    align: center middle;
}

SavedAgentGroupRevivalModal > Container {
    width: 92%;
    height: 82%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

SavedAgentGroupRevivalModal #saved-agent-group-title {
    text-style: bold;
    margin-bottom: 1;
}

SavedAgentGroupRevivalModal #saved-agent-group-panels {
    width: 100%;
    height: 1fr;
}

SavedAgentGroupRevivalModal #saved-agent-group-list-panel {
    width: 50%;
    height: 100%;
}

SavedAgentGroupRevivalModal #saved-agent-group-preview-panel {
    width: 50%;
    height: 100%;
    margin-left: 1;
}

SavedAgentGroupRevivalModal #saved-agent-group-list-heading,
SavedAgentGroupRevivalModal #saved-agent-group-preview-heading {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

SavedAgentGroupRevivalModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

SavedAgentGroupRevivalModal #saved-agent-group-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 1;
    scrollbar-gutter: stable;
}

SavedAgentGroupRevivalModal #saved-agent-group-preview {
    height: auto;
    text-wrap: wrap;
}

SavedAgentGroupRevivalModal #saved-agent-group-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Config Center modal styling (config editor + xprompt browser) */
ConfigCenterModal {
    align: center middle;
}

ConfigCenterModal > Container {
    width: 95%;
    height: 90%;
    /* Bright aqua frame (matches the header gradient's first stop in
       config_center_modal.py) for a vivid, highly visible panel border. */
    border: thick #2BE7C7;
    background: $surface;
    padding: 1 2;
}

/* Title + underline colors come from the per-character aurora gradient built
   in config_center_modal.py; only layout is styled here. */
ConfigCenterModal #config-center-title {
    width: 100%;
    text-style: bold;
    text-align: center;
    height: 1;
    margin-bottom: 0;
}

ConfigCenterModal #config-center-title-underline {
    width: 100%;
    text-align: center;
    height: 1;
    margin-bottom: 1;
}

ConfigCenterModal #config-center-tabs {
    width: 100%;
    height: 1;
    margin-bottom: 0;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal #config-center-tab-description {
    width: 100%;
    height: 1;
    margin: 0;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal #config-center-divider {
    width: 100%;
    height: 1;
    margin: 0;
    color: #444444;
}

ConfigCenterModal #config-center-switcher {
    width: 100%;
    height: 1fr;
}

ConfigCenterModal #admin-center-home {
    width: 100%;
    height: 100%;
    align: center middle;
    overflow-y: auto;
    overflow-x: hidden;
}

ConfigCenterModal #admin-center-home-hero {
    width: auto;
    height: auto;
    margin-bottom: 2;
}

ConfigCenterModal #admin-center-home-lead {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-bottom: 1;
}

ConfigCenterModal #admin-center-home-card {
    width: auto;
    height: auto;
    border: round #5F5F87;
    padding: 1 2;
}

ConfigCenterModal .admin-center-home-row {
    max-width: 100%;
    height: 1;
    background: transparent;
}

ConfigCenterModal .admin-center-home-row:hover {
    background: #29293A;
}

ConfigCenterModal .admin-center-home-row-key {
    width: 3;
    height: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal .admin-center-home-row-label {
    width: 10;
    height: 1;
    margin-left: 2;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal .admin-center-home-row-description {
    width: 1fr;
    height: 1;
    color: #C6C6C6;
    margin-left: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal .admin-center-home-row:hover > .admin-center-home-row-description {
    color: #FFFFFF;
}

ConfigCenterModal #admin-center-home-hint {
    width: 100%;
    height: 1;
    color: #777777;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-top: 1;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-hero {
    margin-bottom: 0;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-lead {
    margin-bottom: 0;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-card {
    border: none;
    padding: 0;
}

ConfigCenterModal #admin-center-home.-compact .admin-center-home-row-key {
    width: 1;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-hint {
    margin-top: 0;
}

ConfigCenterModal ConfigPane,
ConfigCenterModal TasksPane,
ConfigCenterModal LogsPane,
ConfigCenterModal ProjectsPane,
ConfigCenterModal StatisticsPane,
ConfigCenterModal PluginsBrowserPane,
ConfigCenterModal XPromptBrowserPane {
    width: 100%;
    height: 100%;
}

/* Statistics tab: historical numeric views with an inline range editor */
StatisticsPane #statistics-title {
    width: 100%;
    height: 1;
    text-style: bold;
    text-align: center;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-range {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-views {
    width: 100%;
    height: 1;
    text-align: center;
}

StatisticsPane #statistics-custom-range {
    width: 100%;
    height: 3;
    border: tall #FF87D7;
    padding: 0 1;
}

StatisticsPane #statistics-tiles {
    width: 100%;
    height: 6;
}

StatisticsPane .statistics-tile {
    width: 1fr;
    height: 6;
}

StatisticsPane #statistics-body-scroll {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    scrollbar-color: #FF87D7;
    scrollbar-background: #222222;
}

StatisticsPane #statistics-body {
    width: 100%;
    height: auto;
    min-height: 100%;
}

StatisticsPane #statistics-hints {
    width: 100%;
    height: 1;
    color: $text-muted;
    text-align: center;
}

/* Tasks tab: live background-task monitor */
TasksPane #tasks-pane-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

TasksPane #tasks-panels {
    width: 100%;
    height: 1fr;
}

TasksPane #tasks-list-panel {
    width: 40%;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

TasksPane #tasks-list {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
}

TasksPane #tasks-output-panel {
    width: 60%;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
    margin-left: 1;
}

TasksPane #tasks-output-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

TasksPane #tasks-output-content {
    width: 100%;
    height: auto;
}

TasksPane .config-region-header {
    text-style: bold;
    color: $text-muted;
    height: 1;
}

TasksPane #tasks-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Logs tab: canonical log source browser */
LogsPane #logs-pane-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

LogsPane #logs-panels {
    width: 100%;
    height: 1fr;
}

LogsPane #logs-source-panel {
    width: 38;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

LogsPane #log-source-list {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
    scrollbar-gutter: stable;
}

LogsPane #logs-detail-panel {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
    margin-left: 1;
}

LogsPane #log-detail-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

LogsPane #log-detail {
    width: 100%;
    height: auto;
}

LogsPane .config-region-header {
    text-style: bold;
    color: $text-muted;
    height: 1;
}

LogsPane #logs-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Projects tab: projects / repos / workspaces inventory manager */
ProjectsPane #projects-subtabs {
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-bottom: 1;
}

ProjectsPane #projects-subtab-switcher,
ProjectsPane #projects-subtab-projects,
ProjectsPane #projects-subtab-repos,
ProjectsPane #projects-subtab-workspaces {
    width: 100%;
    height: 1fr;
}

ProjectsPane #projects-summary,
ProjectsPane #repos-summary,
ProjectsPane #workspaces-summary {
    height: auto;
    color: $text-muted;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 1;
}

ProjectsPane #projects-filter,
ProjectsPane #repos-filter,
ProjectsPane #workspaces-filter {
    height: 3;
    margin-bottom: 1;
}

ProjectsPane #projects-box,
ProjectsPane #repos-box,
ProjectsPane #workspaces-box {
    height: 1fr;
    min-height: 7;
    border: solid $secondary;
    padding: 0 1;
}

ProjectsPane #projects-columns,
ProjectsPane #repos-columns,
ProjectsPane #workspaces-columns {
    height: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

ProjectsPane #projects-list,
ProjectsPane #repos-list,
ProjectsPane #workspaces-list {
    height: 1fr;
    border: none;
    padding: 0;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: clip;
}

ProjectsPane #projects-detail-scroll,
ProjectsPane #repos-detail-scroll,
ProjectsPane #workspaces-detail-scroll {
    height: 30%;
    min-height: 5;
    border: solid $secondary;
    scrollbar-gutter: stable;
    padding: 0 1;
    margin-top: 1;
}

ProjectsPane #projects-detail,
ProjectsPane #repos-detail,
ProjectsPane #workspaces-detail {
    height: auto;
}

ProjectsPane #projects-hints,
ProjectsPane #repos-hints,
ProjectsPane #workspaces-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Config tab: schema-driven read-only browser (Phase 4) */
ConfigPane #config-pane-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

ConfigPane #config-pane-panels {
    width: 100%;
    height: 1fr;
}

ConfigPane #config-source-rail {
    width: 32;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

ConfigPane #config-source-scroll {
    width: 100%;
    height: 1fr;
}

ConfigPane #config-field-tree {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
    margin: 0 1;
    padding: 0 1;
}

ConfigPane #config-filter-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

ConfigPane #config-field-status {
    width: 100%;
    height: auto;
    color: $text-muted;
}

ConfigPane #config-tree {
    width: 100%;
    height: 1fr;
    background: transparent;
}

ConfigPane #config-detail {
    width: 40%;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

ConfigPane #config-detail-scroll {
    width: 100%;
    height: 1fr;
}

ConfigPane #config-detail-body {
    width: 100%;
    height: auto;
}

ConfigPane .config-region-header {
    text-style: bold;
    color: $text-muted;
    height: 1;
}

ConfigPane #config-pane-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Config edit modal (Phase 5: scope / typed editor / preview / write) */
ConfigEditModal {
    align: center middle;
}

ConfigEditModal > Container {
    width: 84;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

/* Near-fullscreen when a multiline editor or the preview needs room. */
ConfigEditModal.-expanded > Container {
    width: 95%;
    height: 95%;
    max-height: 95%;
}

ConfigEditModal #config-edit-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

ConfigEditModal #config-edit-info {
    height: auto;
    /* Keep future info rows from starving the editor and hints. */
    max-height: 14;
    color: $text-muted;
    margin-bottom: 1;
}

ConfigEditModal #config-edit-scope {
    height: auto;
    border: solid $secondary;
    padding: 0 1;
}

ConfigEditModal #config-edit-banner {
    height: auto;
    margin-top: 1;
}

ConfigEditModal #config-edit-value {
    height: auto;
    margin-top: 1;
    border: solid $secondary;
    padding: 0 1;
}

ConfigEditModal #config-edit-input {
    margin-top: 1;
}

ConfigEditModal #config-edit-textarea {
    width: 100%;
    height: 8;
    margin-top: 1;
    border: solid $secondary;
}

ConfigEditModal.-expanded #config-edit-textarea {
    height: 1fr;
}

ConfigEditModal #config-edit-error {
    height: auto;
    margin-top: 1;
}

ConfigEditModal #config-edit-preview-scroll {
    width: 100%;
    height: auto;
    max-height: 24;
    margin-top: 1;
}

ConfigEditModal.-expanded #config-edit-preview-scroll {
    height: 1fr;
    max-height: 100%;
}

ConfigEditModal #config-edit-preview {
    width: 100%;
    height: auto;
}

ConfigEditModal #config-edit-hints {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

/* Models panel — persistent alias edit preview/confirm (sase-5e Phase 3) */
AliasEditPreviewModal {
    align: center middle;
}

AliasEditPreviewModal #alias-edit-container {
    width: 84;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AliasEditPreviewModal #alias-edit-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

AliasEditPreviewModal #alias-edit-preview-scroll {
    width: 100%;
    height: auto;
    max-height: 24;
}

AliasEditPreviewModal #alias-edit-preview {
    width: 100%;
    height: auto;
}

AliasEditPreviewModal #alias-edit-hints {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

_OverlayNameModal {
    align: center middle;
}

_OverlayNameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

_OverlayNameModal #overlay-name-title {
    text-style: bold;
    margin-bottom: 1;
}

_OverlayNameModal #overlay-name-help {
    color: $text-muted;
}

_OverlayNameModal #overlay-name-input {
    margin-top: 1;
}

_OverlayNameModal #overlay-name-hints {
    color: $text-muted;
    margin-top: 1;
}

/* Updates tab: Core / Plugins / Agent CLIs */
PluginsBrowserPane #updates-subtabs {
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-bottom: 1;
}

PluginsBrowserPane #updates-subtab-switcher,
PluginsBrowserPane #updates-subtab-core,
PluginsBrowserPane #updates-subtab-plugins,
PluginsBrowserPane #updates-subtab-agent-clis {
    width: 100%;
    height: 1fr;
}

PluginsBrowserPane #updates-current-banner {
    width: 100%;
    height: auto;
}

PluginsBrowserPane #sase-core-versions {
    width: 100%;
    height: auto;
}

PluginsBrowserPane #updates-core-hints,
PluginsBrowserPane #agent-clis-hints {
    width: 100%;
    height: 1;
    color: $text-muted;
    text-align: center;
}

PluginsBrowserPane #updates-core-hints {
    dock: bottom;
}

PluginsBrowserPane #plugins-summary {
    width: 100%;
    height: auto;
    text-style: bold;
}

PluginsBrowserPane #plugins-filter-input {
    width: 100%;
    margin-bottom: 1;
}

PluginsBrowserPane #plugins-panels {
    width: 100%;
    height: 1fr;
}

PluginsBrowserPane #plugins-list-panel {
    width: 52;
    height: 100%;
}

PluginsBrowserPane #plugins-status {
    width: 100%;
    height: auto;
    color: $text-muted;
}

PluginsBrowserPane OptionList {
    height: 1fr;
    border: solid $secondary;
}

PluginsBrowserPane #plugins-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

PluginsBrowserPane #plugins-detail-scroll {
    height: 1fr;
}

PluginsBrowserPane #plugins-detail {
    width: 100%;
    height: auto;
    color: $text;
}

PluginsBrowserPane #plugins-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
}

PluginsBrowserPane #agent-clis-summary {
    width: 100%;
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

PluginsBrowserPane #agent-clis-panels {
    width: 100%;
    height: 1fr;
}

PluginsBrowserPane #agent-clis-list-panel {
    width: 58;
    height: 100%;
}

PluginsBrowserPane #agent-clis-status {
    width: 100%;
    height: auto;
    color: $text-muted;
}

PluginsBrowserPane #agent-clis-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

PluginsBrowserPane #agent-clis-detail-scroll {
    height: 1fr;
}

PluginsBrowserPane #agent-clis-detail {
    width: 100%;
    height: auto;
    color: $text;
}

/* Plugins install/update confirm-preview modal (Phase 4, reused Phase 5) */
PluginActionConfirmModal > #plugin-action-container {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

PluginActionConfirmModal.has-commits > #plugin-action-container {
    width: 100;
    max-width: 95%;
}

PluginActionConfirmModal.has-scrollable-commits > #plugin-action-container {
    height: 32;
    max-height: 95%;
}

PluginActionConfirmModal #plugin-action-preview {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

PluginActionConfirmModal #plugin-action-commits {
    width: 100%;
    height: auto;
    max-height: 40vh;
    margin-bottom: 1;
    padding: 0 1;
    border: round $primary;
    border-subtitle-align: right;
}

PluginActionConfirmModal.has-scrollable-commits #plugin-action-commits {
    height: 1fr;
}

PluginActionConfirmModal #plugin-action-commits-body {
    width: 100%;
    height: auto;
}

PluginActionConfirmModal #plugin-action-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

PluginActionConfirmModal Button {
    margin: 0 1;
}

/* XPrompts tab (migrated XPrompt Browser body) */
XPromptBrowserPane #browser-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptBrowserPane #browser-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptBrowserPane #browser-panels {
    width: 100%;
    height: 1fr;
}

XPromptBrowserPane #browser-list-panel {
    width: 40;
    height: 100%;
}

XPromptBrowserPane OptionList {
    height: 1fr;
    border: solid $secondary;
}

XPromptBrowserPane #browser-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptBrowserPane #browser-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptBrowserPane #browser-preview {
    height: auto;
}

XPromptBrowserPane #browser-meta {
    height: auto;
    padding: 1 1 0 1;
    max-height: 8;
}

XPromptBrowserPane #browser-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Agent Run Log modal styling */
AgentRunLogModal {
    align: center middle;
}

AgentRunLogModal > Container {
    width: 92%;
    height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentRunLogModal #agent-log-title {
    text-style: bold;
    margin-bottom: 1;
}

AgentRunLogModal #agent-log-panels {
    width: 100%;
    height: 1fr;
}

AgentRunLogModal #agent-log-list-panel {
    width: 42;
    height: 100%;
}

AgentRunLogModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

AgentRunLogModal #agent-log-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

AgentRunLogModal #agent-log-detail-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

AgentRunLogModal #agent-log-detail {
    height: auto;
}

AgentRunLogModal #agent-log-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Add xprompt modal styling */
AddXPromptModal {
    align: center middle;
}

AddXPromptModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AddXPromptModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

AddXPromptModal #add-xprompt-hint {
    color: $text-muted;
    margin-bottom: 1;
}

AddXPromptModal #add-xprompt-input {
    width: 100%;
}

/* XPrompt filename input modal styling */
XPromptFilenameModal {
    align: center middle;
}

XPromptFilenameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptFilenameModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptFilenameModal #filename-dir-label {
    color: #87D7FF;
    margin-bottom: 0;
}

XPromptFilenameModal #filename-hint {
    color: $text-muted;
    margin-bottom: 1;
}

XPromptFilenameModal #filename-input {
    width: 100%;
}

XPromptFilenameModal #filename-error {
    color: $error;
    margin-top: 1;
}

/* XPrompt location selector modal styling */
XPromptLocationModal {
    align: center middle;
}

XPromptLocationModal > Container {
    width: 92%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptLocationModal #location-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptLocationModal #location-hint {
    color: $text-muted;
    margin-bottom: 1;
}

XPromptLocationModal #location-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptLocationModal #location-panels {
    width: 100%;
    height: 1fr;
}

XPromptLocationModal #location-list-panel {
    width: 52;
    height: 100%;
}

XPromptLocationModal #location-list {
    height: 1fr;
    border: solid $secondary;
}

XPromptLocationModal #location-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptLocationModal #location-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptLocationModal #location-preview {
    height: auto;
}

XPromptLocationModal #location-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Local xprompt name modal (gX / Ctrl+G X) styling */
LocalXPromptNameModal {
    align: center middle;
}

LocalXPromptNameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

LocalXPromptNameModal #local-xprompt-name-title {
    text-style: bold;
    margin-bottom: 1;
}

LocalXPromptNameModal #local-xprompt-name-hint {
    color: $text-muted;
    margin-bottom: 1;
}

LocalXPromptNameModal #local-xprompt-name-input {
    width: 100%;
}

LocalXPromptNameModal #local-xprompt-name-note {
    color: #87D7FF;
    margin-top: 1;
}

LocalXPromptNameModal #local-xprompt-name-error {
    color: $error;
    margin-top: 1;
}

/* XPrompt config entry modal styling */
XPromptConfigEntryModal {
    align: center middle;
}

XPromptConfigEntryModal > Container {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptConfigEntryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptConfigEntryModal #config-entry-file-label {
    color: #87D7FF;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-name-label {
    color: $text-muted;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-name-input {
    width: 100%;
}

XPromptConfigEntryModal #config-entry-phase-label {
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-input-input {
    width: 100%;
}

XPromptConfigEntryModal #config-entry-inputs-display {
    margin-top: 1;
}

XPromptConfigEntryModal #config-entry-error {
    color: $error;
    margin-top: 1;
}

XPromptConfigEntryModal #config-entry-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Command Palette Modal Styling ===== */

CommandPaletteModal {
    align: center middle;
}

CommandPaletteModal > Container {
    width: 75%;
    max-width: 110;
    height: 70%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

CommandPaletteModal #command-palette-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

CommandPaletteModal #command-palette-filter-input {
    width: 100%;
}

CommandPaletteModal #command-palette-input-hint {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

CommandPaletteModal #command-palette-list {
    height: 1fr;
    border: solid $secondary;
}

CommandPaletteModal #command-palette-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
    border: solid $secondary;
}

CommandPaletteModal #command-palette-footer {
    layout: horizontal;
    width: 100%;
    height: 1;
    margin-top: 1;
}

CommandPaletteModal #command-palette-hints {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-align: left;
}

CommandPaletteModal #command-palette-position {
    width: auto;
    height: 1;
    color: $text-muted;
    text-align: right;
}

/* ===== Project Select Modal (@) Styling ===== */

ProjectSelectModal {
    align: center middle;
}

ProjectSelectModal #project-select-container {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

ProjectSelectModal #project-select-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

ProjectSelectModal #filter-input {
    width: 100%;
}

ProjectSelectModal #project-select-hint {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

ProjectSelectModal #selection-list {
    height: auto;
    max-height: 20;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

ProjectSelectModal #project-select-empty {
    height: auto;
    min-height: 3;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    border: solid $secondary;
}

ProjectSelectModal #project-select-footer {
    text-align: center;
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

/* ===== Projects Inventory Project Picker Styling ===== */

InventoryProjectPicker {
    align: center middle;
}

InventoryProjectPicker #inventory-project-picker-container {
    width: 78;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: double #FFAF5F;
    background: $surface;
    padding: 1 2;
}

InventoryProjectPicker #inventory-project-picker-title {
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

InventoryProjectPicker #inventory-project-picker-filter {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

InventoryProjectPicker #inventory-project-picker-list {
    height: auto;
    max-height: 18;
    border: solid $secondary;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

InventoryProjectPicker #inventory-project-picker-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}
