/* ===== Axe Tab Styling ===== */

#axe-view {
    width: 100%;
    height: 100%;
}

/* Background command list container (left panel).  Width is computed
   programmatically from the widest formatted row (see
   ``BgCmdList.WidthChanged``); the values below are a fallback for the
   first paint before the widget posts its initial width event. */
#bgcmd-list-container {
    width: 35;
    min-width: 35;
    height: 100%;
}

#bgcmd-list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

/* BgCmdList styling */
BgCmdList {
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

BgCmdList > .option-list--option {
    padding: 0 1;
}

BgCmdList > .option-list--option-highlighted {
    background: $accent 25%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

#axe-container {
    width: 1fr;
    height: 100%;
}

#axe-info-panel {
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $secondary;
}

#axe-dashboard {
    width: 100%;
    height: 1fr;
}

#axe-status-section {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#axe-description-banner {
    height: auto;
    max-height: 50%;
    padding: 0 1;
    background: $surface;
}

#axe-output-scroll {
    height: 1fr;
    overflow-y: auto;
    scrollbar-gutter: stable;
    border-top: solid $secondary;
    padding: 1 2;
}

#axe-output-section {
    height: auto;
}

/* ===== Saved Query Picker Styling ===== */

SavedQueryPickerModal {
    align: center middle;
}

SavedQueryPickerModal > #saved-query-picker-container {
    width: 82;
    max-width: 94%;
    height: auto;
    max-height: 80%;
    border: round #FFD700;
    background: $surface;
    padding: 1 2;
}

SavedQueryPickerModal #saved-query-picker-title {
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

SavedQueryPickerModal #saved-query-picker-list {
    height: auto;
    max-height: 12;
    border-top: solid #00D7AF;
    border-bottom: solid #00D7AF;
    padding: 1 0;
    scrollbar-gutter: stable;
}

SavedQueryPickerModal #saved-query-picker-list.-empty {
    display: none;
}

SavedQueryPickerModal #saved-query-picker-list > .option-list--option {
    height: 1;
    padding: 0 1;
}

SavedQueryPickerModal #saved-query-picker-list > .option-list--option-highlighted {
    background: #183A3A;
    color: $text;
    text-style: bold;
}

SavedQueryPickerModal #saved-query-picker-empty {
    height: auto;
    min-height: 5;
    content-align: center middle;
    border-top: solid #00D7AF;
    border-bottom: solid #00D7AF;
    padding: 1 2;
}

SavedQueryPickerModal #saved-query-picker-footer {
    height: auto;
    text-align: center;
    margin-top: 1;
    color: $text-muted;
}

/* ===== Help Modal Styling ===== */

HelpModal {
    align: center middle;
}

HelpModal > Container {
    width: 98%;
    height: 96%;
    border: round #00D7AF;
    background: $surface;
    padding: 1 1;
}

HelpModal #help-modal-container.-tab-patches {
    border: round #00D7AF;
}

HelpModal #help-modal-container.-tab-agents {
    border: round #87D7FF;
}

HelpModal #help-modal-container.-tab-axe {
    border: round #FF5F5F;
}

HelpModal #help-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

HelpModal #help-tabs {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

HelpModal #help-content-switcher {
    height: 1fr;
    border-top: solid $secondary;
    padding-top: 1;
}

HelpModal #help-keymaps-view {
    height: 1fr;
}

HelpModal #help-keymaps-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

HelpModal #help-guide-view {
    height: 1fr;
}

HelpModal .help-guide-content {
    width: 100%;
    height: 1fr;
    padding: 0 0;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

HelpModal #help-filter-bar {
    height: 1;
    layout: horizontal;
    margin-bottom: 1;
    display: none;
}

HelpModal #help-filter-prompt {
    width: 2;
    color: #FFD700;
}

HelpModal #help-modal-container.-tab-patches #help-filter-prompt {
    color: #00D7AF;
}

HelpModal #help-modal-container.-tab-agents #help-filter-prompt {
    color: #87D7FF;
}

HelpModal #help-modal-container.-tab-axe #help-filter-prompt {
    color: #FF5F5F;
}

HelpModal #help-filter-input {
    width: 1fr;
    border: none;
    background: transparent;
    padding: 0;
    height: 1;
}

HelpModal #help-filter-status {
    width: auto;
    color: $text-muted;
    text-align: right;
}

HelpModal #help-filter-empty {
    display: none;
    height: auto;
    content-align: center middle;
    color: $text-muted;
    padding: 2 0;
}

HelpModal #help-columns {
    width: 100%;
    height: auto;
}

HelpModal .help-column {
    width: 1fr;
    height: auto;
    text-wrap: nowrap;
    text-overflow: clip;
}

HelpModal #help-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Jump All Entries Modal Styling ===== */

JumpAllModal {
    align: center middle;
}

JumpAllModal > Container {
    width: 85%;
    max-width: 130;
    height: 80%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

JumpAllModal #jump-all-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

JumpAllModal #jump-all-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

JumpAllModal #jump-all-content {
    width: 100%;
    height: auto;
}

JumpAllModal #jump-all-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Recursive Fuzzy File Finder Modal (Ctrl+R) ===== */

RecursiveFileFinderModal {
    align: center middle;
}

RecursiveFileFinderModal #finder-dialog {
    width: 80%;
    max-width: 120;
    height: 70%;
    max-height: 40;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

RecursiveFileFinderModal #finder-results {
    width: 100%;
    height: 1fr;
}

RecursiveFileFinderModal #finder-query {
    width: 100%;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
    color: $text;
}

/* ===== Preview Panel Modal Styling ===== */

PreviewPanelModal {
    align: center middle;
}

PreviewPanelModal > Container {
    width: 96%;
    height: 85%;
    max-width: 150;
    max-height: 42;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

PreviewPanelModal #preview-title {
    height: auto;
    margin-bottom: 1;
}

PreviewPanelModal #preview-properties {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    padding: 0 1;
    border-top: solid $secondary;
    border-bottom: solid $secondary;
}

PreviewPanelModal #preview-properties-view {
    width: 100%;
    height: auto;
}

PreviewPanelModal #preview-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    border: solid $secondary;
    padding: 0 1;
}

PreviewPanelModal #preview-content {
    width: 100%;
    height: auto;
}

PreviewPanelModal #preview-rendered {
    width: 100%;
    height: auto;
    padding: 0 1 1 1;
}

PreviewPanelModal #preview-search-input {
    height: 3;
    margin-top: 1;
    border: tall $accent;
}

PreviewPanelModal #preview-footer {
    text-align: center;
    color: $text-muted;
    height: 3;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ===== Glossary Preview Modal Styling ===== */

GlossaryPreviewModal {
    align: center middle;
}

GlossaryPreviewModal > Container {
    width: auto;
    max-width: 84;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

GlossaryPreviewModal #glossary-preview-title {
    height: auto;
    margin-bottom: 1;
}

GlossaryPreviewModal #glossary-preview-scroll {
    height: auto;
    max-height: 100%;
    scrollbar-gutter: stable;
    border: solid $secondary;
    padding: 0 1;
}

GlossaryPreviewModal #glossary-preview-definition {
    width: 100%;
    height: auto;
    padding: 0 1 0 1;
}

GlossaryPreviewModal #glossary-preview-meta {
    width: 100%;
    height: auto;
    padding: 0 1;
}

GlossaryPreviewModal #glossary-preview-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ===== Notification Report Modal Styling ===== */

ReportModal {
    align: center middle;
}

ReportModal > Container {
    width: 85%;
    height: 85%;
    max-width: 150;
    max-height: 42;
    border: thick #D7AF87;
    background: $surface;
    padding: 1 2;
}

ReportModal #report-title {
    height: auto;
    margin-bottom: 1;
}

ReportModal #report-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    border: solid $secondary;
    padding: 0 1;
}

ReportModal #report-content {
    width: 100%;
    height: auto;
}

ReportModal #report-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Word Definition Modal Styling ===== */

WordDefinitionModal {
    align: center middle;
}

WordDefinitionModal > Container {
    width: 85%;
    height: 85%;
    max-width: 150;
    max-height: 42;
    border: thick #5FD7AF;
    background: $surface;
    padding: 1 2;
}

WordDefinitionModal #word-definition-title {
    height: auto;
    margin-bottom: 1;
}

WordDefinitionModal #word-definition-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    border: solid #5FD7AF;
    padding: 0 1;
}

WordDefinitionModal #word-definition-content {
    width: 100%;
    height: auto;
}

WordDefinitionModal #word-definition-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid #5FD7AF;
    padding-top: 1;
}

/* ===== Spellcheck Panel Modal Styling ===== */

SpellcheckPanelModal {
    align: center middle;
}

SpellcheckPanelModal > Container {
    width: 56;
    height: auto;
    max-height: 20;
    border: double #FF8787;
    background: $surface;
    padding: 1 2;
}

SpellcheckPanelModal #spellcheck-title {
    height: auto;
    margin-bottom: 1;
}

SpellcheckPanelModal .spellcheck-choice-row {
    height: 1;
    color: $text;
}

SpellcheckPanelModal .spellcheck-choice-row.selected {
    color: #FF8787;
    text-style: bold;
    background: $boost;
}

SpellcheckPanelModal .spellcheck-empty-row {
    height: 1;
    color: $text-muted;
    text-style: italic;
}

SpellcheckPanelModal #spellcheck-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid #FF8787;
    padding-top: 1;
}

/* ===== Commit View Modal Styling ===== */

CommitViewModal {
    align: center middle;
}

CommitViewModal > Container {
    width: 85%;
    height: 85%;
    max-width: 150;
    max-height: 42;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommitViewModal #commit-view-title {
    height: auto;
    margin-bottom: 1;
}

CommitViewModal #commit-view-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
    border: solid $secondary;
    padding: 0 1;
}

CommitViewModal #commit-view-content {
    width: 100%;
    height: auto;
}

CommitViewModal #commit-view-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Workspace Input Modal Styling ===== */

WorkspaceInputModal {
    align: center middle;
}

WorkspaceInputModal > Container {
    width: 50;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

WorkspaceInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

WorkspaceInputModal #workspace-hint {
    color: $text-muted;
    margin-bottom: 1;
}

WorkspaceInputModal #workspace-input {
    width: 100%;
}

/* ===== Command Input Modal Styling ===== */

CommandInputModal {
    align: center middle;
}

CommandInputModal > Container {
    width: 80;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommandInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

CommandInputModal #command-context {
    color: $text-muted;
    margin-bottom: 1;
}

CommandInputModal #command-hint {
    color: $text-muted;
    margin-bottom: 1;
}

CommandInputModal #command-input {
    width: 100%;
}

/* ===== Wait Modal Styling ===== */

WaitModal {
    align: center middle;
}

WaitModal > Container {
    width: 76;
    height: auto;
    max-height: 100%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

WaitModal #modal-title {
    text-style: bold;
}

WaitModal #wait-modal-summary {
    color: $text-muted;
}

WaitModal .wait-field-label {
    color: $secondary;
    text-style: bold;
}

WaitModal Input {
    width: 100%;
}

WaitModal #agent-completion,
WaitModal #bead-completion {
    height: auto;
    max-height: 6;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

WaitModal #agent-completion > .option-list--option,
WaitModal #bead-completion > .option-list--option {
    padding: 0 1;
}

WaitModal #agent-completion > .option-list--option-highlighted,
WaitModal #bead-completion > .option-list--option-highlighted {
    background: $accent 40%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

WaitModal #time-preview,
WaitModal #runners-preview,
WaitModal #priority-preview,
WaitModal #beads-preview {
    height: 1;
}

WaitModal #time-preview.wait-time-neutral,
WaitModal #runners-preview.wait-time-neutral,
WaitModal #priority-preview.wait-time-neutral,
WaitModal #beads-preview.wait-time-neutral {
    color: $text-muted;
}

WaitModal #time-preview.wait-time-valid,
WaitModal #runners-preview.wait-time-valid,
WaitModal #priority-preview.wait-time-valid,
WaitModal #beads-preview.wait-time-valid {
    color: $success;
}

WaitModal #time-preview.wait-time-error,
WaitModal #runners-preview.wait-time-error,
WaitModal #priority-preview.wait-time-error,
WaitModal #beads-preview.wait-time-error {
    color: $error;
}

WaitModal #wait-footer {
    color: $text-muted;
    text-align: center;
}

/* ===== Save Agent Group Modal Styling ===== */

SaveAgentGroupModal {
    align: center middle;
}

SaveAgentGroupModal > Container {
    width: 64;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

SaveAgentGroupModal #save-agent-group-title {
    text-style: bold;
    margin-bottom: 1;
}

SaveAgentGroupModal #save-agent-group-context {
    color: $text-muted;
    margin-bottom: 1;
}

SaveAgentGroupModal #save-agent-group-hint {
    color: $text-muted;
    margin-bottom: 1;
}

SaveAgentGroupModal #save-agent-group-name-input {
    width: 100%;
}

/* ===== Process Select Modal Styling ===== */

ProcessSelectModal {
    align: center middle;
}

ProcessSelectModal > Container {
    width: 70;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ProcessSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

ProcessSelectModal #process-hint {
    color: $text-muted;
    margin-bottom: 1;
}

ProcessSelectModal #process-list {
    height: auto;
    max-height: 15;
    border: solid $secondary;
}

/* ===== Notification Modal Styling ===== */

NotificationModal {
    align: center middle;
}

NotificationModal > Container {
    width: 95%;
    height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

NotificationModal #notification-title {
    text-style: bold;
    margin-bottom: 1;
}

NotificationModal #notification-panels {
    width: 100%;
    height: 1fr;
}

NotificationModal #notification-left {
    width: 40%;
    height: 100%;
}

NotificationModal #notification-left.image-preview {
    width: 30%;
}

NotificationModal #notification-tag-tabs {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

NotificationModal #notification-list {
    height: 1fr;
    border: solid $secondary;
    text-wrap: nowrap;
    text-overflow: clip;
}

NotificationModal #notification-empty {
    color: $text-muted;
    text-align: center;
    margin: 2 0;
}

NotificationModal #notification-right {
    width: 60%;
    height: 100%;
    margin-left: 1;
    border-left: solid $secondary;
    padding-left: 1;
}

NotificationModal #notification-right.image-preview {
    width: 70%;
}

NotificationModal #notification-file-title {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

NotificationModal #notification-sent-at {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

NotificationModal #notification-snooze-status {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

NotificationModal #notification-file-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

NotificationModal #notification-file-content {
    height: auto;
}

NotificationModal #notification-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Zoom Panel Modal Styling ===== */

ZoomPanelModal {
    align: center middle;
}

ZoomPanelModal > #zoom-panel-container {
    width: 98%;
    height: 96%;
    border: thick $accent;
    background: $surface;
    padding: 0 1;
}

ZoomPanelModal #zoom-panel-header {
    height: 3;
    width: 100%;
    background: $accent 25%;
    margin-bottom: 1;
    padding: 0 1;
}

ZoomPanelModal #zoom-panel-title {
    width: 1fr;
    height: 100%;
    content-align: left middle;
    text-style: bold;
    color: $text;
}

ZoomPanelModal #zoom-panel-agent {
    width: auto;
    max-width: 45%;
    height: 100%;
    content-align: right middle;
    text-align: right;
}

ZoomPanelModal .zoom-scroll {
    height: 1fr;
    width: 100%;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-subtitle-align: center;
}

ZoomPanelModal #zoom-file-scroll {
    border: solid green;
}

ZoomPanelModal #zoom-file-view {
    height: 1fr;
    width: 100%;
}

ZoomPanelModal #zoom-file-view.hidden {
    display: none;
}

ZoomPanelModal #zoom-file-view > #zoom-file-scroll {
    height: 1fr;
    width: 1fr;
}

ZoomPanelModal #zoom-file-rail {
    width: 34;
    height: 1fr;
    border: solid green;
    padding: 1;
    margin-right: 1;
    color: $text;
    background: $panel;
    scrollbar-gutter: stable;
    overflow-y: auto;
}

ZoomPanelModal #zoom-file-rail.collapsed {
    display: none;
}

ZoomPanelModal #zoom-tools-scroll {
    border: solid #87D7FF;
}

ZoomPanelModal #zoom-search-scroll {
    border: solid $accent;
    overflow-x: auto;
}

ZoomPanelModal .zoom-scroll.hidden {
    display: none;
}

ZoomPanelModal #zoom-metadata-panel,
ZoomPanelModal #zoom-file-panel,
ZoomPanelModal #zoom-tools-panel,
ZoomPanelModal #zoom-search-panel {
    height: auto;
}

ZoomPanelModal #zoom-search-panel {
    width: auto;
    min-width: 100%;
}

ZoomPanelModal #zoom-search-command {
    width: 100%;
    height: auto;
    max-height: 3;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin-top: 1;
}

ZoomPanelModal #zoom-search-command.hidden {
    display: none;
}

ZoomPanelModal #zoom-panel-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Tag Input Modal Styling ===== */

TagInputModal {
    align: center middle;
}

TagInputModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

TagInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

TagInputModal #tag-name-history {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

/* Move notifications to top-right corner */
ToastRack {
    dock: top;
    align: right top;
    margin-top: 1;
    margin-bottom: 0;
}

Toast {
    width: auto;
    min-width: 44;
    max-width: 72;
}

/* ===== Runners Modal Styling ===== */

RunnersModal {
    align: center middle;
}

RunnersModal > Container {
    width: 90%;
    max-width: 200;
    height: 70%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

RunnersModal #runners-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

RunnersModal #runners-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

RunnersModal #runners-content {
    height: auto;
}

RunnersModal #runners-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== User Question Modal Styling ===== */

UserQuestionModal {
    align: center middle;
}

#user-question-container {
    width: 92%;
    max-width: 180;
    height: 88%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#user-question-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#user-question-panels {
    width: 100%;
    height: 1fr;
}

#user-question-left {
    width: 30;
    min-width: 25;
    max-width: 40;
    height: 100%;
}

#user-question-list-label {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#user-question-list {
    height: 1fr;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

#user-question-right {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    padding-left: 1;
    border-left: solid $secondary;
}

#user-question-header {
    height: auto;
    margin-bottom: 1;
}

#user-question-text-scroll {
    height: auto;
    max-height: 40%;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

#user-question-text {
    height: auto;
}

#user-question-options {
    height: 1fr;
    border: solid $secondary;
    scrollbar-gutter: stable;
    text-wrap: wrap;
    text-overflow: clip;
}

#user-question-other-input {
    width: 100%;
    margin-top: 1;
}

#user-question-global-input {
    width: 100%;
    margin-top: 1;
}

#user-question-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Dismissed agent (revive) modal styling */
DismissedAgentSelectModal {
    align: center middle;
}

DismissedAgentSelectModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

DismissedAgentSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

DismissedAgentSelectModal #dismissed-filter {
    width: 100%;
    margin-bottom: 1;
}

DismissedAgentSelectModal #dismissed-agent-panels {
    width: 100%;
    height: 1fr;
}

DismissedAgentSelectModal #dismissed-agent-list-panel {
    width: 45%;
    height: 100%;
}

DismissedAgentSelectModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

DismissedAgentSelectModal #dismissed-agent-preview-panel {
    width: 55%;
    height: 100%;
    margin-left: 1;
}

DismissedAgentSelectModal #dismissed-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 1;
}

DismissedAgentSelectModal #dismissed-preview-metadata {
    height: auto;
}

DismissedAgentSelectModal #dismissed-preview-content {
    height: auto;
    color: $text-muted;
}

DismissedAgentSelectModal #dismissed-agent-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Saved dismissed-agent group revival modal styling */
SavedAgentGroupRevivalModal {
    align: center middle;
}

SavedAgentGroupRevivalModal > Container {
    width: 92%;
    height: 82%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

SavedAgentGroupRevivalModal #saved-agent-group-title {
    text-style: bold;
    margin-bottom: 1;
}

SavedAgentGroupRevivalModal #saved-agent-group-panels {
    width: 100%;
    height: 1fr;
}

SavedAgentGroupRevivalModal #saved-agent-group-list-panel {
    width: 50%;
    height: 100%;
}

SavedAgentGroupRevivalModal #saved-agent-group-preview-panel {
    width: 50%;
    height: 100%;
    margin-left: 1;
}

SavedAgentGroupRevivalModal #saved-agent-group-list-heading,
SavedAgentGroupRevivalModal #saved-agent-group-preview-heading {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

SavedAgentGroupRevivalModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

SavedAgentGroupRevivalModal #saved-agent-group-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 1;
    scrollbar-gutter: stable;
}

SavedAgentGroupRevivalModal #saved-agent-group-preview {
    height: auto;
    text-wrap: wrap;
}

SavedAgentGroupRevivalModal #saved-agent-group-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Config Center modal styling (config editor + xprompt browser) */
ConfigCenterModal {
    align: center middle;
}

ConfigCenterModal > Container {
    width: 95%;
    height: 90%;
    /* Bright aqua frame (matches the header gradient's first stop in
       config_center_modal.py) for a vivid, highly visible panel border. */
    border: thick #2BE7C7;
    background: $surface;
    padding: 1 2;
}

/* Title + underline colors come from the per-character aurora gradient built
   in config_center_modal.py; only layout is styled here. */
ConfigCenterModal #config-center-title {
    width: 100%;
    text-style: bold;
    text-align: center;
    height: 1;
    margin-bottom: 0;
}

ConfigCenterModal #config-center-title-underline {
    width: 100%;
    text-align: center;
    height: 1;
    margin-bottom: 1;
}

ConfigCenterModal #config-center-tabs {
    width: 100%;
    height: 1;
    margin-bottom: 0;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal #config-center-tab-description {
    width: 100%;
    height: 1;
    margin: 0;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal #config-center-divider {
    width: 100%;
    height: 1;
    margin: 0;
    color: #444444;
}

ConfigCenterModal #config-center-switcher {
    width: 100%;
    height: 1fr;
}

ConfigCenterModal #config-center-footer {
    width: 100%;
    height: 1;
    margin: 0;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal #admin-center-home {
    width: 100%;
    height: 100%;
    align: center middle;
    overflow-y: auto;
    overflow-x: hidden;
}

ConfigCenterModal #admin-center-home-hero {
    width: auto;
    height: auto;
    margin-bottom: 2;
}

ConfigCenterModal #admin-center-home-lead {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-bottom: 1;
}

ConfigCenterModal #admin-center-home-card {
    width: auto;
    height: auto;
    border: round #5F5F87;
    padding: 1 2;
}

ConfigCenterModal .admin-center-home-row {
    max-width: 100%;
    height: 1;
    background: transparent;
}

ConfigCenterModal .admin-center-home-row:hover {
    background: #29293A;
}

ConfigCenterModal .admin-center-home-row-key {
    width: 3;
    height: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal .admin-center-home-row-label {
    width: 10;
    height: 1;
    margin-left: 2;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal .admin-center-home-row-description {
    width: 1fr;
    height: 1;
    color: #C6C6C6;
    margin-left: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

ConfigCenterModal .admin-center-home-row:hover > .admin-center-home-row-description {
    color: #FFFFFF;
}

ConfigCenterModal #admin-center-home-hint {
    width: 100%;
    height: 1;
    color: #777777;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-top: 1;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-hero {
    margin-bottom: 0;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-lead {
    margin-bottom: 0;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-card {
    border: none;
    padding: 0;
}

ConfigCenterModal #admin-center-home.-compact .admin-center-home-row-key {
    width: 1;
}

ConfigCenterModal #admin-center-home.-compact #admin-center-home-hint {
    margin-top: 0;
}

ConfigCenterModal ConfigPane,
ConfigCenterModal ProcsPane,
ConfigCenterModal LogsPane,
ConfigCenterModal ProjectsPane,
ConfigCenterModal StatisticsPane,
ConfigCenterModal PluginsBrowserPane,
ConfigCenterModal XPromptBrowserPane {
    width: 100%;
    height: 100%;
}

/* Statistics tab: historical numeric views with an inline range editor */
StatisticsPane #statistics-heading {
    width: 100%;
    height: 1;
}

StatisticsPane #statistics-title {
    width: 1fr;
    height: 1;
    text-style: bold;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-status {
    width: auto;
    height: 1;
    margin-left: 1;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-views {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-description {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-scope {
    width: 100%;
    height: 1;
}

StatisticsPane .statistics-scope-part {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

StatisticsPane #statistics-scope-range {
    width: 2fr;
}

StatisticsPane #statistics-custom-range {
    width: 100%;
    height: 3;
    border: tall #FF87D7;
    padding: 0 1;
}

StatisticsPane #statistics-tiles {
    width: 100%;
    height: 6;
}

StatisticsPane .statistics-tile {
    width: 1fr;
    height: 6;
}

StatisticsPane .statistics-tile:hover {
    background: #29293A;
}

StatisticsPane #statistics-body-scroll {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    scrollbar-color: #FF87D7;
    scrollbar-background: #222222;
}

StatisticsPane #statistics-body {
    width: 100%;
    height: auto;
    min-height: 100%;
}

StatisticsPane #statistics-hints {
    width: 100%;
    height: 1;
    color: $text-muted;
    text-align: center;
}

StatisticsXPromptPickerModal {
    align: center middle;
}

StatisticsXPromptPickerModal #statistics-xprompt-picker-container {
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: double #FF87D7;
    background: $surface;
    padding: 1 2;
}

StatisticsXPromptPickerModal #statistics-xprompt-picker-title {
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

StatisticsXPromptPickerModal #statistics-xprompt-picker-filter {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

StatisticsXPromptPickerModal #statistics-xprompt-picker-list {
    height: auto;
    max-height: 18;
    border: solid $secondary;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

StatisticsXPromptPickerModal #statistics-xprompt-picker-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Contextual Statistics reference built from the pane's loaded state. */
StatisticsHelpModal {
    align: center middle;
}

StatisticsHelpModal > #statistics-help-container {
    width: 94%;
    max-width: 150;
    height: 92%;
    border: double #FF87D7;
    background: $surface;
    padding: 1 2;
}

StatisticsHelpModal #statistics-help-title {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    text-align: center;
}

StatisticsHelpModal #statistics-help-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

StatisticsHelpModal #statistics-help-content {
    width: 100%;
    height: auto;
}

StatisticsHelpModal #statistics-help-footer {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-top: 1;
    border-top: solid $secondary;
    color: $text-muted;
    text-align: center;
}

/* Tasks tab: live background-task monitor */
ProcsPane #procs-pane-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

ProcsPane #procs-panels {
    width: 100%;
    height: 1fr;
}

ProcsPane #procs-list-panel {
    width: 40%;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

ProcsPane #procs-list {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
}

ProcsPane #procs-output-panel {
    width: 60%;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
    margin-left: 1;
}

ProcsPane #procs-output-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

ProcsPane #procs-output-content {
    width: 100%;
    height: auto;
}

ProcsPane .config-region-header {
    text-style: bold;
    color: $text-muted;
    height: 1;
}

ProcsPane #procs-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Logs tab: canonical log source browser */
LogsPane #logs-pane-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

LogsPane #logs-panels {
    width: 100%;
    height: 1fr;
}

LogsPane #logs-source-panel {
    width: 38;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

LogsPane #log-source-list {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
    scrollbar-gutter: stable;
}

LogsPane #logs-detail-panel {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
    margin-left: 1;
}

LogsPane #log-detail-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

LogsPane #log-detail {
    width: 100%;
    height: auto;
}

LogsPane .config-region-header {
    text-style: bold;
    color: $text-muted;
    height: 1;
}

LogsPane #logs-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Projects tab: projects / repos / workspaces inventory manager */
ProjectsPane #projects-subtabs {
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-bottom: 1;
}

ProjectsPane #projects-subtab-switcher,
ProjectsPane #projects-subtab-projects,
ProjectsPane #projects-subtab-repos,
ProjectsPane #projects-subtab-workspaces {
    width: 100%;
    height: 1fr;
}

ProjectsPane #projects-summary,
ProjectsPane #repos-summary,
ProjectsPane #workspaces-summary {
    height: auto;
    color: $text-muted;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 1;
}

ProjectsPane #projects-filter,
ProjectsPane #repos-filter,
ProjectsPane #workspaces-filter {
    height: 3;
    margin-bottom: 1;
}

ProjectsPane #projects-box,
ProjectsPane #repos-box,
ProjectsPane #workspaces-box {
    height: 1fr;
    min-height: 7;
    border: solid $secondary;
    padding: 0 1;
}

ProjectsPane #projects-columns,
ProjectsPane #repos-columns,
ProjectsPane #workspaces-columns {
    height: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

ProjectsPane #projects-list,
ProjectsPane #repos-list,
ProjectsPane #workspaces-list {
    height: 1fr;
    border: none;
    padding: 0;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: clip;
}

ProjectsPane #projects-detail-scroll,
ProjectsPane #repos-detail-scroll,
ProjectsPane #workspaces-detail-scroll {
    height: 30%;
    min-height: 5;
    border: solid $secondary;
    scrollbar-gutter: stable;
    padding: 0 1;
    margin-top: 1;
}

ProjectsPane #projects-detail,
ProjectsPane #repos-detail,
ProjectsPane #workspaces-detail {
    height: auto;
}

ProjectsPane #projects-hints,
ProjectsPane #repos-hints,
ProjectsPane #workspaces-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Config tab: schema-driven read-only browser (Phase 4) */
ConfigPane #config-pane-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

ConfigPane #config-pane-panels {
    width: 100%;
    height: 1fr;
}

ConfigPane #config-source-rail {
    width: 32;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

ConfigPane #config-source-scroll {
    width: 100%;
    height: 1fr;
}

ConfigPane #config-field-tree {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
    margin: 0 1;
    padding: 0 1;
}

ConfigPane #config-filter-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

ConfigPane #config-field-status {
    width: 100%;
    height: auto;
    color: $text-muted;
}

ConfigPane #config-tree {
    width: 100%;
    height: 1fr;
    background: transparent;
}

ConfigPane #config-detail {
    width: 40%;
    height: 100%;
    border: solid $secondary;
    padding: 0 1;
}

ConfigPane #config-detail-scroll {
    width: 100%;
    height: 1fr;
}

ConfigPane #config-detail-body {
    width: 100%;
    height: auto;
}

ConfigPane .config-region-header {
    text-style: bold;
    color: $text-muted;
    height: 1;
}

ConfigPane #config-pane-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Config edit modal (Phase 5: scope / typed editor / preview / write) */
ConfigEditModal {
    align: center middle;
}

ConfigEditModal > Container {
    width: 84;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

/* Near-fullscreen when a multiline editor or the preview needs room. */
ConfigEditModal.-expanded > Container {
    width: 95%;
    height: 95%;
    max-height: 95%;
}

ConfigEditModal #config-edit-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

ConfigEditModal #config-edit-info {
    height: auto;
    /* Keep future info rows from starving the editor and hints. */
    max-height: 14;
    color: $text-muted;
    margin-bottom: 1;
}

ConfigEditModal #config-edit-scope {
    height: auto;
    border: solid $secondary;
    padding: 0 1;
}

ConfigEditModal #config-edit-banner {
    height: auto;
    margin-top: 1;
}

ConfigEditModal #config-edit-value {
    height: auto;
    margin-top: 1;
    border: solid $secondary;
    padding: 0 1;
}

ConfigEditModal #config-edit-input {
    margin-top: 1;
}

ConfigEditModal #config-edit-textarea {
    width: 100%;
    height: 8;
    margin-top: 1;
    border: solid $secondary;
}

ConfigEditModal.-expanded #config-edit-textarea {
    height: 1fr;
}

ConfigEditModal #config-edit-error {
    height: auto;
    margin-top: 1;
}

ConfigEditModal #config-edit-preview-scroll {
    width: 100%;
    height: auto;
    max-height: 24;
    margin-top: 1;
}

ConfigEditModal.-expanded #config-edit-preview-scroll {
    height: 1fr;
    max-height: 100%;
}

ConfigEditModal #config-edit-preview {
    width: 100%;
    height: auto;
}

ConfigEditModal #config-edit-hints {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

/* Reusable AXE lumberjack/chop schema editor. */
AxeEntryEditorModal {
    align: center middle;
}

AxeEntryEditorModal > #axe-editor-container {
    width: 96%;
    max-width: 112;
    height: auto;
    max-height: 94%;
    border: thick #D7A85B;
    background: $surface;
    padding: 1 2;
}

AxeEntryEditorModal #axe-editor-title {
    height: 1;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal #axe-editor-meta {
    width: 100%;
    height: 1;
}

AxeEntryEditorModal #axe-editor-run-status {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal #axe-editor-scope-row {
    width: auto;
    height: 1;
    overflow-x: hidden;
}

AxeEntryEditorModal #axe-editor-scope-label {
    width: auto;
    height: 1;
    color: #B87333;
    text-style: bold;
    margin-right: 1;
}

AxeEntryEditorModal .axe-editor-scope-chip {
    width: auto;
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

AxeEntryEditorModal .axe-editor-scope-chip.active {
    color: #100F0F;
    background: #F0C674;
    text-style: bold;
}

AxeEntryEditorModal #axe-editor-context {
    width: 100%;
    height: auto;
    min-height: 1;
    border-bottom: solid #B87333;
    padding-bottom: 1;
}

AxeEntryEditorModal #axe-editor-warning {
    width: 1fr;
    height: auto;
    max-height: 2;
    text-wrap: wrap;
}

AxeEntryEditorModal #axe-editor-scope-path {
    width: 42;
    height: 1;
    color: $text-muted;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal #axe-editor-sheet {
    width: 100%;
    height: auto;
    max-height: 17;
    padding-top: 1;
}

AxeEntryEditorModal .axe-editor-group-header {
    height: 1;
    color: #B87333;
    text-style: bold;
}

AxeEntryEditorModal #axe-editor-advanced-header {
    margin-top: 1;
}

AxeEntryEditorModal .axe-editor-field {
    width: 100%;
    height: 1;
    padding: 0 1;
}

AxeEntryEditorModal .axe-editor-field.selected {
    background: #F0C674 12%;
    border-left: thick #F0C674;
    padding: 0 1 0 0;
}

AxeEntryEditorModal .axe-editor-field.invalid {
    background: #FF8787 8%;
}

AxeEntryEditorModal .axe-editor-field.editing.multiline {
    height: 6;
}

AxeEntryEditorModal .axe-editor-field-name {
    width: 18;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal .axe-editor-field-value-cell {
    width: 1fr;
    height: 100%;
    padding: 0;
}

AxeEntryEditorModal .axe-editor-field-value {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal .axe-editor-field-badge {
    width: 18;
    height: 1;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal .axe-editor-cell-editor {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
    background: #F0C674 6%;
}

AxeEntryEditorModal .axe-editor-cell-textarea {
    width: 100%;
    height: 6;
    min-height: 6;
}

AxeEntryEditorModal #axe-editor-dock {
    width: 100%;
    height: 6;
    border-top: solid #B87333;
    border-bottom: solid #B87333;
    padding: 0 1;
}

AxeEntryEditorModal #axe-editor-dock-header {
    height: 1;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal #axe-editor-dock-description {
    height: 2;
    color: $text;
    text-wrap: wrap;
}

AxeEntryEditorModal #axe-editor-dock-values {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal #axe-editor-status {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal #axe-editor-preview-scroll {
    width: 100%;
    height: auto;
    max-height: 24;
    padding-top: 1;
}

AxeEntryEditorModal #axe-editor-preview {
    width: 100%;
    height: auto;
}

AxeEntryEditorModal #axe-editor-hints {
    height: 2;
    color: $text-muted;
    text-align: center;
    border-top: solid #B87333;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

AxeEntryEditorModal.-narrow > #axe-editor-container {
    width: 98%;
    max-width: 98%;
    height: auto;
    max-height: 96%;
    padding: 0 1;
}

AxeEntryEditorModal.-narrow #axe-editor-run-status {
    width: 1fr;
}

AxeEntryEditorModal.-narrow #axe-editor-scope-path {
    width: 45%;
}

AxeEntryEditorModal.-narrow .axe-editor-field-name {
    width: 14;
}

AxeEntryEditorModal.-narrow .axe-editor-field-badge {
    display: none;
}

AxeEntryEditorModal.-narrow #axe-editor-dock {
    height: 7;
}

AxeEntryEditorModal.-narrow #axe-editor-dock-description {
    height: 3;
}

/* Models panel — persistent alias edit preview/confirm (sase-5e Phase 3) */
AliasEditPreviewModal,
DefaultEffortEditPreviewModal,
RunnerLimitEditPreviewModal {
    align: center middle;
}

AliasEditPreviewModal #alias-edit-container,
DefaultEffortEditPreviewModal #alias-edit-container,
RunnerLimitEditPreviewModal #alias-edit-container {
    width: 84;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AliasEditPreviewModal #alias-edit-title,
DefaultEffortEditPreviewModal #alias-edit-title,
RunnerLimitEditPreviewModal #alias-edit-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

AliasEditPreviewModal #alias-edit-preview-scroll,
DefaultEffortEditPreviewModal #alias-edit-preview-scroll,
RunnerLimitEditPreviewModal #alias-edit-preview-scroll {
    width: 100%;
    height: auto;
    max-height: 24;
}

AliasEditPreviewModal #alias-edit-preview,
DefaultEffortEditPreviewModal #alias-edit-preview,
RunnerLimitEditPreviewModal #alias-edit-preview {
    width: 100%;
    height: auto;
}

AliasEditPreviewModal #alias-edit-hints,
DefaultEffortEditPreviewModal #alias-edit-hints,
RunnerLimitEditPreviewModal #alias-edit-hints {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

_OverlayNameModal {
    align: center middle;
}

_OverlayNameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

_OverlayNameModal #overlay-name-title {
    text-style: bold;
    margin-bottom: 1;
}

_OverlayNameModal #overlay-name-help {
    color: $text-muted;
}

_OverlayNameModal #overlay-name-input {
    margin-top: 1;
}

_OverlayNameModal #overlay-name-hints {
    color: $text-muted;
    margin-top: 1;
}

/* Updates tab: Core / Plugins / Agent CLIs */
PluginsBrowserPane #updates-subtabs {
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    margin-bottom: 1;
}

PluginsBrowserPane #updates-subtab-switcher,
PluginsBrowserPane #updates-subtab-core,
PluginsBrowserPane #updates-subtab-plugins,
PluginsBrowserPane #updates-subtab-agent-clis {
    width: 100%;
    height: 1fr;
}

PluginsBrowserPane #updates-current-banner {
    width: 100%;
    height: auto;
}

PluginsBrowserPane #sase-core-versions {
    width: 100%;
    height: auto;
}

PluginsBrowserPane #updates-core-hints,
PluginsBrowserPane #agent-clis-hints {
    width: 100%;
    height: 1;
    color: $text-muted;
    text-align: center;
}

PluginsBrowserPane #updates-core-hints {
    dock: bottom;
}

PluginsBrowserPane #plugins-summary {
    width: 100%;
    height: auto;
    text-style: bold;
}

PluginsBrowserPane #plugins-filter-input {
    width: 100%;
    margin-bottom: 1;
}

PluginsBrowserPane #plugins-panels {
    width: 100%;
    height: 1fr;
}

PluginsBrowserPane #plugins-list-panel {
    width: 52;
    height: 100%;
}

PluginsBrowserPane #plugins-status {
    width: 100%;
    height: auto;
    color: $text-muted;
}

PluginsBrowserPane OptionList {
    height: 1fr;
    border: solid $secondary;
}

PluginsBrowserPane #plugins-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

PluginsBrowserPane #plugins-detail-scroll {
    height: 1fr;
}

PluginsBrowserPane #plugins-detail {
    width: 100%;
    height: auto;
    color: $text;
}

PluginsBrowserPane #plugins-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
}

PluginsBrowserPane #agent-clis-summary {
    width: 100%;
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

PluginsBrowserPane #agent-clis-panels {
    width: 100%;
    height: 1fr;
}

PluginsBrowserPane #agent-clis-list-panel {
    width: 58;
    height: 100%;
}

PluginsBrowserPane #agent-clis-status {
    width: 100%;
    height: auto;
    color: $text-muted;
}

PluginsBrowserPane #agent-clis-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

PluginsBrowserPane #agent-clis-detail-scroll {
    height: 1fr;
}

PluginsBrowserPane #agent-clis-detail {
    width: 100%;
    height: auto;
    color: $text;
}

PluginsBrowserPane #agent-clis-history {
    width: 100%;
    height: auto;
    color: $text;
    margin-top: 1;
}

/* Plugins install/update confirm-preview modal (Phase 4, reused Phase 5) */
PluginActionConfirmModal > #plugin-action-container {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

PluginActionConfirmModal.has-commits > #plugin-action-container {
    width: 100;
    max-width: 95%;
}

PluginActionConfirmModal.has-sections > #plugin-action-container {
    width: 110;
    max-width: 95%;
    max-height: 90%;
}

PluginActionConfirmModal.has-scrollable-commits > #plugin-action-container {
    height: 32;
    max-height: 95%;
}

PluginActionConfirmModal.has-scrollable-preview > #plugin-action-container {
    height: 90%;
    max-height: 90%;
}

PluginActionConfirmModal #plugin-action-preview-scroll {
    width: 100%;
    height: auto;
    max-height: 70vh;
    margin-bottom: 1;
    padding: 0 1;
    border: round $accent;
    border-subtitle-align: right;
}

PluginActionConfirmModal #plugin-action-container.confirm-dialog--danger #plugin-action-preview-scroll {
    border: round $error;
}

PluginActionConfirmModal.has-scrollable-preview #plugin-action-preview-scroll {
    height: 1fr;
}

PluginActionConfirmModal #plugin-action-preview {
    width: 100%;
    height: auto;
}

PluginActionConfirmModal #plugin-action-commits {
    width: 100%;
    height: auto;
    max-height: 40vh;
    margin-bottom: 1;
    padding: 0 1;
    border: round $primary;
    border-subtitle-align: right;
}

PluginActionConfirmModal.has-scrollable-commits #plugin-action-commits {
    height: 1fr;
}

PluginActionConfirmModal #plugin-action-commits-body {
    width: 100%;
    height: auto;
}

PluginActionConfirmModal #plugin-action-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

PluginActionConfirmModal Button {
    margin: 0 1;
}

/* XPrompts tab (migrated XPrompt Browser body) */
XPromptBrowserPane #browser-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptBrowserPane #browser-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptBrowserPane #browser-panels {
    width: 100%;
    height: 1fr;
}

XPromptBrowserPane #browser-list-panel {
    width: 40;
    height: 100%;
}

XPromptBrowserPane OptionList {
    height: 1fr;
    border: solid $secondary;
}

XPromptBrowserPane #browser-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptBrowserPane #browser-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptBrowserPane #browser-preview {
    height: auto;
}

XPromptBrowserPane #browser-meta {
    height: auto;
    padding: 1 1 0 1;
    max-height: 8;
}

XPromptBrowserPane #browser-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Agent Run Log modal styling */
AgentRunLogModal {
    align: center middle;
}

AgentRunLogModal > Container {
    width: 92%;
    height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentRunLogModal #agent-log-title {
    text-style: bold;
    margin-bottom: 1;
}

AgentRunLogModal #agent-log-panels {
    width: 100%;
    height: 1fr;
}

AgentRunLogModal #agent-log-list-panel {
    width: 42;
    height: 100%;
}

AgentRunLogModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

AgentRunLogModal #agent-log-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

AgentRunLogModal #agent-log-detail-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

AgentRunLogModal #agent-log-detail {
    height: auto;
}

AgentRunLogModal #agent-log-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Add xprompt modal styling */
AddXPromptModal {
    align: center middle;
}

AddXPromptModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AddXPromptModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

AddXPromptModal #add-xprompt-hint {
    color: $text-muted;
    margin-bottom: 1;
}

AddXPromptModal #add-xprompt-input {
    width: 100%;
}

/* XPrompt filename input modal styling */
XPromptFilenameModal {
    align: center middle;
}

XPromptFilenameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptFilenameModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptFilenameModal #filename-dir-label {
    color: #87D7FF;
    margin-bottom: 0;
}

XPromptFilenameModal #filename-hint {
    color: $text-muted;
    margin-bottom: 1;
}

XPromptFilenameModal #filename-input {
    width: 100%;
}

XPromptFilenameModal #filename-error {
    color: $error;
    margin-top: 1;
}

/* XPrompt location selector modal styling */
XPromptLocationModal {
    align: center middle;
}

XPromptLocationModal > Container {
    width: 92%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptLocationModal #location-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptLocationModal #location-hint {
    color: $text-muted;
    margin-bottom: 1;
}

XPromptLocationModal #location-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptLocationModal #location-panels {
    width: 100%;
    height: 1fr;
}

XPromptLocationModal #location-list-panel {
    width: 52;
    height: 100%;
}

XPromptLocationModal #location-list {
    height: 1fr;
    border: solid $secondary;
}

XPromptLocationModal #location-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptLocationModal #location-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptLocationModal #location-preview {
    height: auto;
}

XPromptLocationModal #location-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Local xprompt name modal (gX / Ctrl+G X) styling */
LocalXPromptNameModal {
    align: center middle;
}

LocalXPromptNameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

LocalXPromptNameModal #local-xprompt-name-title {
    text-style: bold;
    margin-bottom: 1;
}

LocalXPromptNameModal #local-xprompt-name-hint {
    color: $text-muted;
    margin-bottom: 1;
}

LocalXPromptNameModal #local-xprompt-name-input {
    width: 100%;
}

LocalXPromptNameModal #local-xprompt-name-note {
    color: #87D7FF;
    margin-top: 1;
}

LocalXPromptNameModal #local-xprompt-name-error {
    color: $error;
    margin-top: 1;
}

/* XPrompt config entry modal styling */
XPromptConfigEntryModal {
    align: center middle;
}

XPromptConfigEntryModal > Container {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptConfigEntryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptConfigEntryModal #config-entry-file-label {
    color: #87D7FF;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-name-label {
    color: $text-muted;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-name-input {
    width: 100%;
}

XPromptConfigEntryModal #config-entry-phase-label {
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-input-input {
    width: 100%;
}

XPromptConfigEntryModal #config-entry-inputs-display {
    margin-top: 1;
}

XPromptConfigEntryModal #config-entry-error {
    color: $error;
    margin-top: 1;
}

XPromptConfigEntryModal #config-entry-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Command Palette Modal Styling ===== */

CommandPaletteModal {
    align: center middle;
}

CommandPaletteModal > Container {
    width: 75%;
    max-width: 110;
    height: 70%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

CommandPaletteModal #command-palette-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

CommandPaletteModal #command-palette-filter-input {
    width: 100%;
}

CommandPaletteModal #command-palette-input-hint {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

CommandPaletteModal #command-palette-list {
    height: 1fr;
    border: solid $secondary;
}

CommandPaletteModal #command-palette-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
    border: solid $secondary;
}

CommandPaletteModal #command-palette-footer {
    layout: horizontal;
    width: 100%;
    height: 1;
    margin-top: 1;
}

CommandPaletteModal #command-palette-hints {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-align: left;
}

CommandPaletteModal #command-palette-position {
    width: auto;
    height: 1;
    color: $text-muted;
    text-align: right;
}

/* ===== Copy As Modal Styling ===== */

CopyAsModal {
    align: center middle;
}

CopyAsModal > #copy-as-container {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 82%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

CopyAsModal #copy-as-title {
    height: 1;
    text-align: center;
    text-style: bold;
    color: $accent;
}

CopyAsModal #copy-as-subtitle {
    height: 1;
    margin-bottom: 1;
    text-align: center;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

CopyAsModal #copy-as-list {
    height: auto;
    max-height: 24;
    border: solid $secondary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    scrollbar-gutter: stable;
}

CopyAsModal #copy-as-footer {
    height: 1;
    margin-top: 1;
    text-align: center;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

CopyAsModal.-narrow > #copy-as-container {
    width: 94%;
    max-height: 90%;
    padding: 1;
}

CopyAsModal.-narrow #copy-as-list {
    max-height: 14;
}

CopyAsModal.-narrow #copy-as-footer {
    margin-top: 0;
}

/* ===== Project Select Modal (@) Styling ===== */

ProjectSelectModal {
    align: center middle;
}

ProjectSelectModal #project-select-container {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

ProjectSelectModal #project-select-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

ProjectSelectModal #filter-input {
    width: 100%;
}

ProjectSelectModal #project-select-hint {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

ProjectSelectModal #selection-list {
    height: auto;
    max-height: 20;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

ProjectSelectModal #project-select-empty {
    height: auto;
    min-height: 3;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    border: solid $secondary;
}

ProjectSelectModal #project-select-footer {
    text-align: center;
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

/* ===== Projects Inventory Project Picker Styling ===== */

InventoryProjectPicker {
    align: center middle;
}

InventoryProjectPicker #inventory-project-picker-container {
    width: 78;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: double #FFAF5F;
    background: $surface;
    padding: 1 2;
}

InventoryProjectPicker #inventory-project-picker-title {
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

InventoryProjectPicker #inventory-project-picker-filter {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

InventoryProjectPicker #inventory-project-picker-list {
    height: auto;
    max-height: 18;
    border: solid $secondary;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

InventoryProjectPicker #inventory-project-picker-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Clipboard Fallback Modal Styling ===== */

CopyFallbackModal {
    align: center middle;
}

CopyFallbackModal #copy-fallback-container {
    width: 80%;
    max-width: 110;
    height: 75%;
    border: double $warning;
    background: $surface;
    padding: 1 2;
}

CopyFallbackModal #copy-fallback-title {
    height: auto;
    text-align: center;
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

CopyFallbackModal #copy-fallback-text {
    height: 1fr;
    border: solid $secondary;
}

CopyFallbackModal #copy-fallback-footer {
    height: 1;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}
