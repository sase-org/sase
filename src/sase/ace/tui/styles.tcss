/* Textual CSS for the ace TUI */

/* Hidden class for tab switching */
.hidden {
    display: none;
}

/* Top bar (tab bar + notification indicator) */
#top-bar {
    height: auto;
    max-height: 1;
}

/* Tab bar styling */
#tab-bar {
    width: 1fr;
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#proc-indicator {
    width: auto;
    content-align: right middle;
}

#llm-override-indicator {
    width: auto;
    content-align: right middle;
}

#alias-overrides-indicator {
    width: auto;
    content-align: right middle;
}

#notification-indicator {
    width: auto;
    content-align: right middle;
}

#updates-indicator {
    width: auto;
    content-align: right middle;
}

#agents-sync-indicator {
    width: auto;
    content-align: right middle;
}

#stashed-prompts-indicator {
    width: auto;
    content-align: right middle;
}

#main-container {
    height: 1fr;
}

/* Artifacts Tab View (internal id remains patches) */
#artifacts-view {
    width: 100%;
    height: 100%;
}

#artifacts-header {
    width: 100%;
    height: 1;
    background: $surface;
}

#artifacts-subtabs {
    width: 1fr;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    background: $surface;
}

/* Equal widths keep the centered tab strip optically centered. */
#artifacts-split-spacer,
#artifacts-split-badge {
    width: 8;
    height: 1;
}

#artifacts-split-badge {
    padding: 0 1;
    text-align: center;
    background: $surface;
}

#artifacts-content-switcher,
#artifacts-patches-pane,
#artifacts-stitches-pane,
#artifacts-beads-pane,
#artifacts-files-view,
#artifacts-files-content-switcher {
    width: 100%;
    height: 1fr;
}

#artifacts-files-subtabs {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: clip;
    background: $surface;
}

FilterBar {
    display: none;
    width: 100%;
    height: 3;
    layers: base overlay;
    background: $background;
}

FilterBar .filter-bar-row {
    layer: base;
    width: 100%;
    height: 3;
}

FilterBar .filter-bar-sigil {
    width: 3;
    height: 3;
    text-style: bold;
    content-align: center middle;
}

FilterBar .filter-bar-input {
    width: 1fr;
    height: 3;
    background: $background;
}

FilterBar .filter-bar-status {
    width: auto;
    min-width: 14;
    max-width: 40%;
    height: 3;
    padding: 0 1;
    content-align: right middle;
    text-align: right;
    text-overflow: ellipsis;
}

FilterBar .filter-bar-status.error {
    min-width: 24;
}

FilterBar .filter-bar-completion {
    display: none;
    layer: overlay;
    position: absolute;
    overlay: screen;
    offset: 3 3;
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 10;
    background: $panel;
    scrollbar-size-vertical: 1;
}

CommitFilterBar .filter-bar-sigil {
    color: #FFD700;
}

CommitFilterBar {
    display: block;
    height: 3;
    min-height: 3;
}

CommitFilterBar .filter-bar-input,
CommitFilterBar .filter-bar-completion {
    border: solid #FFD700;
}

CommitFilterBar .filter-bar-status {
    min-width: 0;
}

CommitFilterBar .filter-bar-status.error {
    min-width: 24;
}

CommitFilterBar .filter-bar-completion > .option-list--option-highlighted {
    color: $background;
    background: #FFD700;
    text-style: bold;
}

PlanFilterBar .filter-bar-sigil {
    color: #AF87FF;
}

PlanFilterBar .filter-bar-input,
PlanFilterBar .filter-bar-completion {
    border: solid #AF87FF;
}

PlanFilterBar .filter-bar-completion > .option-list--option-highlighted {
    color: $background;
    background: #AF87FF;
    text-style: bold;
}

FileFilterBar .filter-bar-sigil {
    color: #FFAF5F;
}

FileFilterBar .filter-bar-input,
FileFilterBar .filter-bar-completion {
    border: solid #FFAF5F;
}

FileFilterBar .filter-bar-completion > .option-list--option-highlighted {
    color: $background;
    background: #FFAF5F;
    text-style: bold;
}

#stitches-info {
    width: 100%;
    height: 3;
    max-height: 3;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#stitches-info-header {
    width: 100%;
    height: 1;
    max-height: 1;
    background: transparent;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#stitches-legend-row {
    width: 100%;
    height: 2;
    max-height: 2;
}

#stitches-position {
    width: auto;
    height: 1;
    max-height: 1;
    background: transparent;
    text-wrap: nowrap;
}

#stitches-legend {
    width: 1fr;
    height: 2;
    max-height: 2;
    background: transparent;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#stitches-main {
    width: 100%;
    height: 1fr;
}

#stitches-list-container {
    width: 50%;
    min-width: 44;
    height: 100%;
}

#stitches-timeline {
    width: 100%;
    height: 1fr;
    border: solid #FFD700;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#stitches-footer {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#stitches-detail-container {
    width: 1fr;
    height: 100%;
}

#stitches-detail-scroll {
    width: 100%;
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
    scrollbar-gutter: stable;
}

#stitches-detail {
    width: 100%;
    height: auto;
}

.artifacts-pane-info {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    content-align: center middle;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.artifacts-placeholder-scroll {
    width: 100%;
    height: 1fr;
    padding: 2 4;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

.artifacts-placeholder-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

.artifacts-placeholder-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    padding: 1 2;
}

#artifacts-stitches-pane .artifacts-placeholder-card {
    border-title-color: #FFD700;
}

#artifacts-beads-pane .artifacts-placeholder-card {
    border-title-color: #D787FF;
}

#artifacts-plans-pane,
#artifacts-beads-pane,
.artifacts-documents-pane {
    width: 100%;
    height: 100%;
}

#artifacts-files-pane {
    width: 100%;
    height: 100%;
}

.artifacts-placeholder-footer {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

#plans-panels {
    width: 100%;
    height: 1fr;
}

#beads-panels {
    width: 100%;
    height: 1fr;
}

/* Artifacts Bugs pane */
#bugs-content {
    width: 100%;
    height: 1fr;
}

#plans-list-panel {
    width: 50%;
    min-width: 44;
    height: 100%;
    border: round #AF87FF;
}

#beads-list-panel {
    width: 50%;
    min-width: 44;
    height: 100%;
    border: round #D787FF;
}

#plans-status {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#beads-status {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#plans-list {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#beads-list {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#plans-detail-panel {
    width: 1fr;
    height: 100%;
    border: round #5F5F87;
}

#beads-detail-panel {
    width: 1fr;
    height: 100%;
    border: round #5F5F87;
}

#plans-detail-scroll {
    width: 100%;
    height: 1fr;
}

/* The gutter must stay reserved: the Created property value fills the content
   width exactly, so an auto scrollbar would narrow it, wrap it onto a second
   line, grow the content by that line, and keep the scrollbar -- two stable
   layouts for the same bead. */
#beads-detail-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

#plans-detail-properties,
#plans-detail,
#beads-detail-properties,
#beads-detail {
    width: 100%;
    height: auto;
}

#plans-detail-properties {
    padding: 1 2 0 2;
}

#beads-detail-properties {
    padding: 1 2 0 2;
}

#plans-detail {
    padding: 0 2 1 2;
}

#beads-detail {
    padding: 0 2 1 2;
}

/* Keep inline code legible under flexoki across every ACE Markdown surface. */
MarkdownBlock > .code_inline {
    background: $foreground 10%;
    color: $text;
}

#plans-hints {
    width: 100%;
    height: 1;
    max-height: 1;
    background: $surface;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#beads-hints {
    width: 100%;
    height: 1;
    max-height: 1;
    background: $surface;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#files-panels {
    width: 100%;
    height: 1fr;
}

#files-list-panel {
    width: 50%;
    min-width: 44;
    height: 100%;
    border: round #FFAF5F;
}

/* Shared Artifacts split modes. Floors intentionally use min-width only. */
ArtifactsView.-split-narrow #stitches-list-container {
    width: 30%;
    min-width: 34;
}

ArtifactsView.-split-even #stitches-list-container {
    width: 50%;
    min-width: 44;
}

ArtifactsView.-split-wide #stitches-list-container {
    width: 70%;
    min-width: 48;
}

ArtifactsView.-split-narrow #plans-list-panel {
    width: 30%;
    min-width: 34;
}

ArtifactsView.-split-even #plans-list-panel {
    width: 50%;
    min-width: 44;
}

ArtifactsView.-split-wide #plans-list-panel {
    width: 70%;
    min-width: 56;
}

ArtifactsView.-split-narrow #beads-list-panel {
    width: 30%;
    min-width: 34;
}

ArtifactsView.-split-even #beads-list-panel {
    width: 50%;
    min-width: 44;
}

ArtifactsView.-split-wide #beads-list-panel {
    width: 70%;
    min-width: 56;
}

ArtifactsView.-split-narrow #files-list-panel {
    width: 30%;
    min-width: 34;
}

ArtifactsView.-split-even #files-list-panel {
    width: 50%;
    min-width: 44;
}

ArtifactsView.-split-wide #files-list-panel {
    width: 70%;
    min-width: 56;
}

#files-status {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#files-list {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#files-list > .option-list--option-highlighted {
    background: #FFAF5F 30%;
}

#files-empty {
    width: 100%;
    height: 1fr;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
}

#files-detail-panel {
    width: 1fr;
    height: 100%;
    border: round #5F5F87;
}

#files-detail-scroll {
    width: 100%;
    height: 1fr;
}

#files-detail {
    width: 100%;
    height: auto;
    padding: 1 2;
}

#files-hints {
    width: 100%;
    height: 1;
    max-height: 1;
    background: $surface;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#bugs-list-container {
    width: 44%;
    min-width: 42;
    max-width: 78;
    height: 100%;
    border: solid #FF5F5F;
}

#bugs-list-header {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    content-align: left middle;
}

#bugs-list {
    width: 100%;
    height: 1fr;
    padding: 0 1;
    scrollbar-gutter: stable;
}

#bugs-list-message {
    width: 100%;
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: $text-muted;
}

#bugs-detail-container {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
}

#bugs-detail-title {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 4;
    padding: 0 2;
    content-align: left middle;
}

#bugs-detail-meta {
    width: 100%;
    height: auto;
    max-height: 3;
    padding: 0 2 1 2;
}

#bugs-body-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 2;
    scrollbar-gutter: stable;
}

#bugs-body {
    width: 100%;
    height: auto;
}

#bugs-links-title {
    width: 100%;
    height: 1;
    padding: 0 2;
    color: #FF5F5F;
    text-style: bold;
}

#bugs-links {
    width: 100%;
    height: 7;
    max-height: 7;
    padding: 0 1;
    border-top: solid $secondary;
}

#bugs-footer {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    content-align: center middle;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.bead-modal-container {
    width: 76;
    max-width: 92%;
    height: 36;
    max-height: 90%;
    border: round #D787FF;
    background: $panel;
    padding: 1 2;
}

BeadEditorModal,
BeadNoteModal,
BeadCreateModal,
BeadCloseModal {
    align: center middle;
    background: $background 70%;
}

.bead-modal-container.small {
    height: 18;
}

.bead-modal-title {
    width: 100%;
    height: 2;
    color: #D787FF;
    text-style: bold;
    content-align: center middle;
}

.bead-modal-fields {
    height: 1fr;
}

.bead-modal-label {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#bead-editor-description,
#bead-editor-notes,
#bead-create-description,
#bead-close-note,
#bead-note-text {
    width: 100%;
    height: 6;
    border: round #5F5F87;
}

.bead-modal-warning {
    width: 100%;
    height: auto;
    color: #FFAF5F;
    margin-bottom: 1;
}

.bead-modal-buttons {
    width: 100%;
    height: 3;
    align-horizontal: center;
    margin-top: 1;
}

.bead-modal-buttons Button {
    margin: 0 1;
}

/* Create/edit issue modal */
IssueEditModal {
    align: center middle;
}

#issue-edit-container {
    width: 86;
    height: 34;
    max-height: 90%;
    padding: 1 2;
    border: round #FF5F5F;
    background: $surface;
}

#issue-edit-title {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-align: center;
    color: #FF5F5F;
    text-style: bold;
}

.issue-edit-label {
    width: 100%;
    height: 1;
    color: $text-muted;
}

#issue-edit-title-input,
#issue-edit-labels {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#issue-edit-body {
    width: 100%;
    height: 14;
    margin-bottom: 1;
    border: solid $secondary;
}

#issue-edit-buttons {
    width: 100%;
    height: 3;
    align-horizontal: center;
}

#artifacts-view.-onboarding-active #list-container {
    display: none;
}

#artifacts-view.-onboarding-active #detail-scroll {
    display: none;
}

#list-container {
    width: 43;  /* Default, will be set programmatically */
    min-width: 43;  /* Must fit info panel text */
    max-width: 80;
    height: 100%;
}

#info-panel {
    height: 2;
    max-height: 2;
    padding: 0 1;
    background: $surface;
}

#list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

/* Ancestors/Children Panel */
#ancestors-children-panel {
    height: auto;
    max-height: 24;  /* Increased from 18 to accommodate reverted children when visible */
    padding: 0 1 1 1;
    border: solid $secondary;
    background: $surface;
}

#detail-container {
    width: 1fr;  /* Takes remaining space */
    height: 100%;
}

#search-query-panel {
    width: 100%;
    height: auto;
    max-height: 3;
    border: solid $secondary;
    padding: 0 1;
}

#detail-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#detail-panel {
    height: auto;
}

#patch-quickstart-panel {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

.tab-quickstart-callout {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round #FFD700;
    padding: 0 1;
    margin-bottom: 1;
}

.tab-quickstart-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.tab-quickstart-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    padding: 0 1;
    margin-bottom: 1;
}

.tab-quickstart-card.-agents {
    border-title-color: #87D7FF;
}

.tab-quickstart-card.-patches {
    border-title-color: #00D7AF;
}

.tab-quickstart-footer {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    color: $text-muted;
    margin-top: 1;
}

#patch-onboarding-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.patch-onboarding-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    border-title-color: #00D7AF;
    padding: 0 1;
    margin-bottom: 1;
}

#keybinding-footer {
    dock: bottom;
    height: auto;
    min-height: 1;
    background: $surface;
    padding: 0 1;
    border-top: hkey $panel-lighten-2;
}

#keybinding-content {
    width: 1fr;
}

#keybinding-status {
    width: auto;
}

/* List panel styling */
PatchList {
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

PatchList > .option-list--option {
    padding: 0 1;
}

PatchList > .option-list--option-highlighted {
    background: $accent 25%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

/* Modal styling */
StatusModal, QueryEditModal, WorkflowSelectModal, AcceptProposalModal, AgentCleanupModal, AgentCleanupTribeModal, AgentCleanupClanModal, AgentCleanupCustomModal, StashedPromptsModal, UpdatePinnedStashModal, QuitConfirmModal, InputCollectionModal {
    align: center middle;
}

StatusModal > Container, QueryEditModal > Container, WorkflowSelectModal > Container, AcceptProposalModal > Container {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.confirm-dialog {
    align: center middle;
}

.confirm-dialog-panel {
    width: 64;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

.confirm-dialog-panel.confirm-dialog--neutral {
    border: round $primary;
}

.confirm-dialog-panel.confirm-dialog--danger {
    border: round $error;
}

.confirm-dialog-message {
    width: 100%;
    height: auto;
    text-align: center;
    margin: 1 0 0 0;
}

.confirm-dialog-subject {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text;
    margin-top: 1;
}

.confirm-dialog-subject.is-empty {
    display: none;
}

.confirm-dialog-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

.confirm-dialog-panel Button {
    margin: 0 1;
    min-width: 14;
}

.post-write-actions-list {
    width: 100%;
    height: auto;
    margin-top: 1;
}

AgentCleanupModal > #agent-cleanup-container {
    width: 92;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupModal #agent-cleanup-title {
    text-style: bold;
    margin-bottom: 1;
}

AgentCleanupModal #agent-cleanup-summary {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

AgentCleanupModal .agent-cleanup-summary-card {
    width: 1fr;
    min-height: 4;
    border: solid $secondary;
    padding: 0 1;
}

AgentCleanupModal #agent-cleanup-actions {
    height: auto;
}

AgentCleanupModal #agent-cleanup-list {
    height: auto;
    max-height: 20;
    border: solid $secondary;
}

AgentCleanupModal #agent-cleanup-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

AgentCleanupTribeModal > #agent-cleanup-tribe-container {
    width: 74;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupTribeModal #agent-cleanup-tribe-list {
    height: auto;
    max-height: 18;
    border: solid $secondary;
}

AgentCleanupClanModal > #agent-cleanup-clan-container {
    width: 92;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupClanModal #agent-cleanup-clan-title {
    text-style: bold;
    color: #5FD7FF;
    margin-bottom: 1;
}

AgentCleanupClanModal #agent-cleanup-clan-list {
    height: auto;
    max-height: 22;
    border: solid $secondary;
}

AgentCleanupClanModal #agent-cleanup-clan-list > .option-list--option {
    padding: 0 1;
}

AgentCleanupClanModal #agent-cleanup-clan-list > .option-list--option-highlighted {
    background: $accent 22%;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

AgentCleanupClanModal #agent-cleanup-clan-preview {
    height: auto;
    min-height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

AgentCleanupClanModal #agent-cleanup-clan-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
}

AgentCleanupCustomModal > #agent-cleanup-custom-container {
    width: 96;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentCleanupCustomModal #agent-cleanup-custom-summary {
    height: auto;
    min-height: 2;
    margin-bottom: 1;
}

AgentCleanupCustomModal #agent-cleanup-custom-list {
    height: 18;
    max-height: 18;
    border: solid $secondary;
}

AgentCleanupCustomModal #agent-cleanup-search {
    margin-top: 1;
}

/* Prompt-stash restore picker */
StashedPromptsModal > #stashed-prompts-container {
    width: 96%;
    max-width: 156;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

StashedPromptsModal > #stashed-prompts-container.-narrow {
    width: 96;
    max-width: 96%;
}

StashedPromptsModal #stashed-prompts-panels {
    width: 100%;
    height: 23;
}

StashedPromptsModal #stashed-prompts-list-panel {
    width: 6fr;
    min-width: 54;
    height: 100%;
}

StashedPromptsModal #stashed-prompts-title {
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

StashedPromptsModal #stashed-prompts-list {
    height: 18;
    max-height: 18;
    border: solid $secondary;
}

StashedPromptsModal #stashed-prompts-list,
UpdatePinnedStashModal #update-pinned-stash-list {
    text-wrap: nowrap;
    text-overflow: clip;
}

StashedPromptsModal OptionList > .option-list--option,
UpdatePinnedStashModal OptionList > .option-list--option {
    height: 1;
    padding: 0 1;
}

StashedPromptsModal #stashed-prompts-hints {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

UpdatePinnedStashModal > #update-pinned-stash-container {
    width: 96%;
    max-width: 156;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

UpdatePinnedStashModal > #update-pinned-stash-container.-narrow {
    width: 96;
    max-width: 96%;
}

UpdatePinnedStashModal #update-pinned-stash-panels {
    width: 100%;
    height: 23;
}

UpdatePinnedStashModal #update-pinned-stash-list-panel {
    width: 6fr;
    min-width: 54;
    height: 100%;
}

UpdatePinnedStashModal #update-pinned-stash-title {
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

UpdatePinnedStashModal #update-pinned-stash-list {
    height: 18;
    max-height: 18;
    border: solid $secondary;
}

UpdatePinnedStashModal #update-pinned-stash-hints {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

StashedPromptsModal PromptStashPreviewPane,
UpdatePinnedStashModal PromptStashPreviewPane {
    width: 5fr;
    min-width: 46;
    height: 100%;
    margin-left: 1;
}

StashedPromptsModal .prompt-stash-preview-label,
UpdatePinnedStashModal .prompt-stash-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 2;
    padding: 0 1;
}

StashedPromptsModal .prompt-stash-preview-scroll,
UpdatePinnedStashModal .prompt-stash-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

StashedPromptsModal .prompt-stash-preview-placeholder,
StashedPromptsModal .prompt-stash-preview-frontmatter,
StashedPromptsModal .prompt-stash-preview-body,
StashedPromptsModal .prompt-stash-preview-metadata,
UpdatePinnedStashModal .prompt-stash-preview-placeholder,
UpdatePinnedStashModal .prompt-stash-preview-frontmatter,
UpdatePinnedStashModal .prompt-stash-preview-body,
UpdatePinnedStashModal .prompt-stash-preview-metadata {
    height: auto;
}

StashedPromptsModal .prompt-stash-preview-placeholder,
UpdatePinnedStashModal .prompt-stash-preview-placeholder,
StashedPromptsModal .prompt-stash-preview-metadata,
UpdatePinnedStashModal .prompt-stash-preview-metadata {
    color: $text-muted;
}

StashedPromptsModal .prompt-stash-preview-frontmatter,
UpdatePinnedStashModal .prompt-stash-preview-frontmatter {
    border-bottom: solid $secondary;
    margin-bottom: 1;
    padding-bottom: 1;
}

StashedPromptsModal #stashed-prompts-container.-narrow PromptStashPreviewPane,
UpdatePinnedStashModal #update-pinned-stash-container.-narrow PromptStashPreviewPane {
    display: none;
}

StashedPromptsModal #stashed-prompts-container.-narrow #stashed-prompts-list-panel,
UpdatePinnedStashModal #update-pinned-stash-container.-narrow #update-pinned-stash-list-panel {
    width: 100%;
}

/* Quit confirmation with running background-task details */
QuitConfirmModal > #quit-confirm-container {
    width: 70;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: round $error;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

QuitConfirmModal #quit-confirm-summary {
    height: auto;
    margin-bottom: 1;
}

QuitConfirmModal #quit-confirm-procs {
    height: auto;
    max-height: 16;
    border: solid $secondary;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

QuitConfirmModal .quit-confirm-proc-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

QuitConfirmModal #quit-confirm-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

QuitConfirmModal Button {
    margin: 0 1;
    min-width: 20;
}

/* Revert agent commits confirmation */
ConfirmRevertAgentModal {
    align: center middle;
}

ConfirmRevertAgentModal > #revert-confirm-container {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 88%;
    border: round $error;
    background: $surface;
    padding: 1 2;
    border-subtitle-align: center;
}

ConfirmRevertAgentModal #revert-confirm-subtitle {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

ConfirmRevertAgentModal #revert-confirm-summary {
    height: auto;
    margin-bottom: 1;
}

ConfirmRevertAgentModal #revert-confirm-repos {
    height: auto;
    max-height: 16;
    border: solid $secondary;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

ConfirmRevertAgentModal .revert-confirm-repo-card,
ConfirmRevertAgentModal .revert-confirm-blocked-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

ConfirmRevertAgentModal .revert-confirm-blocked-card {
    border-left: thick $error;
}

ConfirmRevertAgentModal .revert-confirm-caption {
    height: auto;
}

ConfirmRevertAgentModal #revert-confirm-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ConfirmRevertAgentModal Button {
    margin: 0 1;
    min-width: 18;
}

/* Workflow HITL Modal styling */
WorkflowHITLModal {
    align: center middle;
}

#hitl-container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#hitl-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#step-info {
    margin-bottom: 1;
}

#hitl-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

.hitl-section-header {
    margin-top: 1;
}

#output-content {
    margin-bottom: 1;
}

#hitl-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Branch-driven gate review workbench */
PlanApprovalModal,
CustomGateModal {
    align: center middle;
}

.gate-review-shell {
    width: 98%;
    height: 98%;
    background: $surface;
    padding: 0 1;
}

#plan-approval-container {
    border: double $primary;
}

CustomGateModal > #custom-gate-container {
    border: double $accent;
}

.gate-review-header {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

.gate-review-body {
    height: 1fr;
}

.gate-review-body > .gate-review-actions {
    dock: left;
    width: 42;
    height: 1fr;
    margin-right: 1;
}

.gate-review-actions {
    border: solid $secondary;
    padding: 0 1;
    scrollbar-gutter: stable;
}

.gate-review-section-title {
    height: auto;
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.gate-review-origin {
    height: auto;
    margin-bottom: 1;
}

CustomGateModal #custom-gate-notes,
CustomGateModal #custom-gate-attachments {
    height: auto;
    margin-bottom: 1;
}

.gate-review-document {
    width: 1fr;
    height: 1fr;
    border: solid $secondary;
    border-title-align: left;
    border-title-color: #87D7FF;
    padding: 0 1;
    scrollbar-gutter: stable;
}

.gate-review-footer {
    height: auto;
    color: $text-muted;
    text-align: center;
    border-top: solid $secondary;
    margin-top: 1;
}

GateBranchControls {
    height: auto;
    max-height: 18;
    border: solid $secondary;
    padding: 0 1;
    scrollbar-gutter: stable;
}

GateBranchControls .gate-singleton-row {
    height: auto;
    align-horizontal: center;
}

GateBranchControls .gate-singleton-row Button {
    min-width: 18;
    margin: 0 1;
}

GateBranchControls .gate-group,
GateBranchControls .gate-group-details {
    height: auto;
}

GateBranchControls .gate-group-expand,
GateBranchControls .gate-group-submit {
    min-width: 20;
    margin: 0 1;
}

GateBranchControls .gate-option-toggle {
    width: 100%;
    text-align: left;
}

GateBranchControls #gate-feedback-label {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

GateBranchControls #gate-feedback-input {
    margin-bottom: 1;
}

GateBranchControls .gate-branch-inputs {
    height: auto;
    margin-top: 1;
}

GateBranchControls .gate-input-conflict {
    color: $error;
}

GateBranchControls TypedInputForm {
    height: auto;
}

GateBranchControls TypedInputForm Button {
    width: 100%;
    text-align: left;
    color: $text-muted;
    border: round $secondary;
}

GateBranchControls .gate-branch-inputs TextArea {
    height: 6;
}

GateBranchControls.gate-branch-controls--stacked {
    width: 100%;
    height: auto;
    max-height: initial;
    border: none;
    padding: 0;
    overflow-y: hidden;
    scrollbar-gutter: auto;
}

GateBranchControls.gate-branch-controls--stacked .gate-singleton-row {
    width: 100%;
    layout: vertical;
    align-horizontal: left;
}

GateBranchControls.gate-branch-controls--stacked .gate-singleton-row Button,
GateBranchControls.gate-branch-controls--stacked .gate-group-expand,
GateBranchControls.gate-branch-controls--stacked .gate-group-submit {
    width: 100%;
    margin: 0;
}

GateActionControls {
    height: auto;
    margin-bottom: 1;
}

GateActionControls .gate-action {
    width: 100%;
    margin: 0;
    text-align: left;
}

GateActionControls .gate-action-description {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

GateActionControls .gate-draft-banner {
    height: auto;
    border: solid $warning;
    padding: 0 1;
    margin-top: 1;
}

GateActionOutputModal {
    align: center middle;
}

GateActionOutputModal > #gate-action-output-container {
    width: 90%;
    height: 85%;
    background: $surface;
    border: double $accent;
    padding: 0 1;
}

GateRetryModal {
    align: center middle;
}

GateRetryModal > .gate-retry-dialog {
    width: 72;
    height: auto;
    background: $surface;
    border: double $warning;
    padding: 1 2;
}

GateRetryModal #gate-retry-summary {
    height: auto;
    margin: 1 0;
}

GateRetryModal #gate-retry-buttons {
    height: auto;
    align-horizontal: center;
}

GateRetryModal #gate-retry-buttons Button {
    margin: 0 1;
}

.gate-review-cancel {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

.gate-review-shell--compact {
    width: 60;
    max-width: 96%;
    height: auto;
    max-height: 96%;
}

.gate-review-shell--compact > .gate-review-actions--compact {
    width: 100%;
    height: auto;
    max-height: 30;
}

PlanApprovalModal.-gate-review-narrow .gate-review-body > .gate-review-actions,
CustomGateModal.-gate-review-narrow .gate-review-body > .gate-review-actions {
    dock: bottom;
    width: 100%;
    height: 48%;
    margin: 1 0 0 0;
}

/* Launch Approval Modal styling */
LaunchApprovalModal {
    align: center middle;
}

#launch-approval-container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#launch-approval-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#launch-approval-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

#launch-approval-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Gate lifecycle and artifact diagnostics */
GateDebugModal {
    align: center middle;
}

GateDebugModal > #gate-debug-container {
    width: 94%;
    max-width: 180;
    height: 92%;
    border: double #a8a8a8;
    background: $surface;
    padding: 1 2;
}

GateDebugModal.kind-plan > #gate-debug-container {
    border: double #ff87d7;
}

GateDebugModal.kind-epic > #gate-debug-container {
    border: double #d787ff;
}

GateDebugModal.kind-epic_plan > #gate-debug-container {
    border: double #d787ff;
}

GateDebugModal.kind-question > #gate-debug-container {
    border: double #87d7ff;
}

GateDebugModal.kind-launch > #gate-debug-container {
    border: double #5fffff;
}

GateDebugModal.kind-task_triage > #gate-debug-container {
    border: double #d787ff;
}

GateDebugModal.kind-custom > #gate-debug-container {
    border: double #ffaf5f;
}

GateDebugModal.kind-hitl > #gate-debug-container {
    border: double #ffd75f;
}

GateDebugModal #gate-debug-header {
    height: auto;
    text-align: center;
    padding: 0 1 1 1;
}

GateDebugModal #gate-debug-tabs {
    height: 4;
    text-align: center;
    border-top: solid $secondary;
    border-bottom: solid $secondary;
    padding: 1 0 0 0;
}

GateDebugModal #gate-debug-scroll {
    height: 1fr;
    padding: 1 2;
    scrollbar-gutter: stable;
}

GateDebugModal #gate-debug-content {
    width: 100%;
    height: auto;
}

GateDebugModal #gate-debug-footer {
    height: auto;
    color: $text-muted;
    text-align: center;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Custom Approval Modal styling */
ApproveOptionsModal {
    align: center middle;
}

#approve-options-container {
    width: 70;
    height: auto;
    max-height: 26;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#approve-options-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.approval-choice-row {
    height: 1;
    margin-bottom: 1;
    color: $text;
}

.approval-choice-row.selected {
    color: $success;
    text-style: bold;
}

#coder-prompt-display {
    margin-bottom: 1;
    color: $text-muted;
}

#coder-prompt-display.disabled {
    color: $text-disabled;
}

.approve-options-model-label {
    height: auto;
    margin-top: 1;
}

.approve-options-model-label.disabled {
    color: $text-disabled;
}

#coder-model-display {
    margin-bottom: 1;
    color: $text-muted;
}

#coder-model-display.disabled {
    color: $text-disabled;
}

#approve-options-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Auto-Approve quick-action menu styling (agents tab `a` key). Mirrors the
   ApproveOptionsModal visual language (double border, $surface background,
   $success selected-row highlight) but drives single-key instant select. */
AutoApproveModal {
    align: center middle;
}

#auto-approve-container {
    width: 56;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#auto-approve-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.auto-approve-choice-row {
    height: 1;
    color: $text;
}

.auto-approve-choice-row.selected {
    color: $success;
    text-style: bold;
}

#auto-approve-agent {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#auto-approve-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
    margin-top: 1;
}


/* Model Picker Modal styling */
ModelPickerModal {
    align: center middle;
}

#model-picker-container {
    width: 64;
    height: auto;
    max-height: 26;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#model-picker-container.alias-enabled {
    width: 84;
    max-width: 95%;
}

#model-picker-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#model-picker-filter {
    height: 3;
    margin-bottom: 1;
}

#model-picker-list {
    height: auto;
    max-height: 18;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#model-picker-container.alias-enabled #model-picker-list {
    /* Reserve a stable footer lane even in a 30-row terminal. The list stays
       scrollable, so the alias section does not expand the modal off-screen. */
    max-height: 14;
}

#model-picker-container.alias-enabled #model-picker-footer {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#model-picker-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Agent Artifact Selection Modal styling */
ArtifactFileSelectionModal {
    align: center middle;
}

#agent-artifact-files-container {
    width: 74;
    height: auto;
    max-height: 28;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#agent-artifact-files-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#agent-artifact-files-list {
    height: auto;
    max-height: 20;
}

#agent-artifact-files-hints {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Agent Neighbor Modal styling */
AgentNeighborModal {
    align: center middle;
}

#agent-neighbor-container {
    width: 78;
    max-width: 94%;
    height: auto;
    max-height: 24;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#agent-neighbor-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#agent-neighbor-list {
    height: auto;
    max-height: 18;
}

#agent-neighbor-list > .option-list--option-disabled {
    color: $text-muted;
    text-style: bold;
}

#agent-neighbor-hints {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Agent Workspace Tmux Modal styling (echoes the WORKSPACES lane accent) */
AgentWorkspaceTmuxModal {
    align: center middle;
}

#agent-workspace-tmux-container {
    width: 90;
    max-width: 94%;
    height: auto;
    max-height: 24;
    border: double #FF87D7;
    background: $surface;
    padding: 1 2;
}

#agent-workspace-tmux-title {
    text-align: center;
    text-style: bold;
    color: #FF87D7;
    height: auto;
    margin-bottom: 1;
}

#agent-workspace-tmux-list {
    height: auto;
    max-height: 16;
}

#agent-workspace-tmux-hints {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid #AF87D7;
    padding-top: 1;
}


/* Models panel styling */
ModelsPanel {
    align: center middle;
}

#models-panel-container {
    width: 110;
    max-width: 95%;
    height: auto;
    /* Full-budget: container border (2) + padding (2) + title + margin (2) +
       list cap (22) + description strip margin + height (1 + 4 = 5) + footer
       margin + border + padding + text (5) = 39.  Sized so the three-line
       launch-control title and two-line footer plus the taller
       description strip cannot push the footer out of the modal when the alias
       list is at its 22-row cap. */
    max-height: 39;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#models-panel-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#models-panel-list {
    height: auto;
    max-height: 22;
}

#models-panel-description {
    /* Border-box height: 1 (border-top) + 1 (padding-top) + 2 content rows = 4.
       Do NOT lower this back to 2 — that leaves 0 content rows and the strip
       renders its separator/padding with the description text fully clipped.
       Fixed (not auto) so navigating j/k between aliases with different
       description lengths causes zero layout shift. */
    height: 4;
    color: $text-muted;
    text-style: italic;
    border-top: solid $secondary;
    padding-top: 1;
    margin-top: 1;
}

#models-panel-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
    margin-top: 1;
}

/* Models panel — global default-effort single-key cards */
DefaultEffortActionModal,
DefaultEffortLevelModal {
    align: center middle;
}

#default-effort-action-container,
#default-effort-level-container {
    width: 70;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    border: double #AF87D7;
    background: $surface;
    padding: 1 2;
}

#default-effort-level-container {
    width: 62;
}

#default-effort-action-title,
#default-effort-level-title {
    width: 100%;
    height: auto;
    text-align: center;
    text-style: bold;
    color: #AF87FF;
    margin-bottom: 1;
}

#default-effort-action-status {
    width: 100%;
    height: auto;
    border: solid $secondary;
    padding: 1 2;
    margin-bottom: 1;
}

#default-effort-action-choices,
#default-effort-level-list {
    height: auto;
}

#default-effort-level-list {
    max-height: 10;
    margin-bottom: 1;
}

.default-effort-action-row {
    height: auto;
    margin-bottom: 1;
}

#default-effort-action-note,
#default-effort-level-note,
#default-effort-level-subtitle {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.default-effort-level-row {
    height: 1;
}

#default-effort-action-footer,
#default-effort-level-footer {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text-muted;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Models panel — global runner-limit action and value cards */
RunnerLimitActionModal,
RunnerLimitValueModal {
    align: center middle;
}

#runner-limit-action-container,
#runner-limit-value-container {
    width: 72;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    border: double cyan;
    background: $surface;
    padding: 1 2;
}

#runner-limit-value-container {
    width: 58;
}

#runner-limit-action-title,
#runner-limit-value-title {
    width: 100%;
    height: auto;
    text-align: center;
    text-style: bold;
    color: cyan;
    margin-bottom: 1;
}

#runner-limit-action-status {
    width: 100%;
    height: auto;
    border: solid $secondary;
    padding: 1 2;
    margin-bottom: 1;
}

#runner-limit-action-choices {
    height: auto;
}

.runner-limit-action-row {
    height: auto;
    margin-bottom: 1;
}

#runner-limit-action-note,
#runner-limit-value-subtitle,
#runner-limit-value-constraints {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#runner-limit-value-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: tall cyan;
    text-style: bold;
}

#runner-limit-value-error {
    width: 100%;
    height: 1;
    color: $warning;
    margin-bottom: 1;
}

#runner-limit-action-footer,
#runner-limit-value-footer {
    width: 100%;
    height: auto;
    text-align: center;
    color: $text-muted;
    border-top: solid $secondary;
    padding-top: 1;
}

ProjectAliasEditorModal {
    align: center middle;
}

ProjectAliasEditorModal > Container {
    width: 72;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ProjectAliasEditorModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

ProjectAliasEditorModal #project-alias-input {
    width: 100%;
    margin: 1 0;
}

ProjectAliasEditorModal #project-alias-hint {
    color: $text-muted;
    margin-bottom: 1;
}

ProjectAliasEditorModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ProjectAliasEditorModal Button {
    margin: 0 1;
}


/* Shared Duration Choice Modal styling */
PromptSubmitChoiceModal,
JumpActionModal,
QuitOptionsModal,
SnoozeDurationModal,
_DurationPickerModal {
    align: center middle;
}

.duration-choice-container {
    width: 54;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2 1 2;
}

#snooze-container {
    width: 54;
}

#override-duration-container {
    width: 56;
}

#prompt-submit-choice-container {
    width: 62;
}

#jump-action-container {
    width: 64;
}

#quit-options-container {
    width: 70;
}

#prompt-submit-choice-title {
    width: 100%;
}

#jump-action-title {
    width: 100%;
}

#quit-options-title {
    width: 100%;
}

#jump-action-header {
    color: $text;
}

.jump-action-footer {
    color: $text-muted;
}

.duration-choice-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

.duration-choice-body {
    height: auto;
}

.duration-choice-row {
    height: auto;
    padding: 0 0 0 0;
    margin-bottom: 1;
}

.duration-choice-tone-primary {
    color: $accent;
}

.duration-choice-tone-accent {
    color: $warning;
}

.duration-choice-spacer {
    height: 0;
}

.duration-choice-custom-input {
    margin-top: 0;
    width: 100%;
}

.duration-choice-annotation-input {
    margin-top: 0;
    margin-bottom: 1;
    width: 100%;
}

.duration-choice-custom-error {
    color: $error;
    height: auto;
    margin-top: 1;
}


/* Models Panel: exact override time */
OverrideUntilModal {
    align: center middle;
}

#override-until-container {
    width: 70;
    height: 15;
    border: double #AF87D7;
    background: $surface;
    padding: 1 2;
}

#override-until-title {
    width: 100%;
    height: 1;
    text-align: center;
    text-style: bold;
    color: #AF87D7;
    margin-bottom: 1;
}

#override-until-field {
    width: 100%;
    height: 3;
}

#override-until-field-label {
    width: 7;
    height: 3;
    color: $text-muted;
    content-align: left middle;
}

#override-until-input {
    width: 1fr;
}

#override-until-preview {
    width: 100%;
    height: 3;
    padding-left: 7;
}

#override-until-preview.until-neutral {
    color: $text-muted;
}

#override-until-preview.until-valid {
    color: #87D75F;
}

#override-until-preview.until-error {
    color: $error;
}

#override-until-footer {
    width: 100%;
    height: 3;
    text-align: center;
    color: $text-muted;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Custom Model Input Modal styling */
CustomModelInputModal {
    align: center middle;
}

#custom-model-container {
    width: 42;
    height: auto;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#custom-model-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#custom-model-hint {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#custom-model-input {
    margin-bottom: 1;
}

#custom-model-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Mentor Review Modal styling */
MentorReviewModal {
    align: center middle;
}

#mentor-review-container {
    width: 95%;
    height: 95%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#mentor-review-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#mentor-review-panels {
    height: 1fr;
}

#mentor-side-panel {
    width: 30;
    min-width: 25;
    height: 100%;
    border-right: solid $secondary;
    padding: 0 1;
}

#mentor-main-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
}

#mentor-review-footer {
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Mentor Profile Select Modal */
MentorProfileSelectModal {
    align: center middle;
}

#mentor-profile-select-container {
    width: 50%;
    height: 40%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#mentor-profile-select-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#mentor-profile-select-list {
    height: 1fr;
    overflow-y: auto;
    padding: 0 1;
}

#mentor-profile-select-footer {
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

StatusModal OptionList {
    height: auto;
    max-height: 15;
}

QueryEditModal Input {
    width: 100%;
    margin: 1 0;
}

QueryEditModal #query-hint {
    color: $text-muted;
    width: 100%;
    margin-bottom: 1;
}

QueryEditModal #query-error {
    color: $error;
    width: 100%;
    margin-bottom: 1;
}

QueryEditModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

QueryEditModal Button {
    margin: 0 1;
}

/* Input Collection Modal styling */
InputCollectionModal #input-collection-container {
    width: 64;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

InputCollectionModal #modal-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
}

InputCollectionModal #modal-subtitle {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}

InputCollectionModal #input-fields {
    height: auto;
    max-height: 24;
}

InputCollectionModal .input-section-header {
    color: $text-muted;
    text-style: bold;
    margin: 1 0 0 0;
}

/* Shared by every TypedInputForm host (InputCollectionModal and the ACE gate
   modals), not just InputCollectionModal. */
.input-field-block {
    height: auto;
    margin-bottom: 1;
}

InputCollectionModal .placeholder-heading {
    height: auto;
}

InputCollectionModal .placeholder-header {
    width: 1fr;
}

InputCollectionModal .placeholder-occurrences {
    width: auto;
    color: $text-muted;
    text-style: bold;
}

InputCollectionModal .placeholder-context {
    color: $text-muted;
}

InputCollectionModal .placeholder-literal {
    width: 100%;
    color: $text-muted;
    padding: 0 1;
}

InputCollectionModal .placeholder-field-block.literal .placeholder-heading,
InputCollectionModal .placeholder-field-block.literal .placeholder-context {
    opacity: 55%;
}

/* Shared by every TypedInputForm host, same reason as .input-field-block. */
.field-header {
    color: $secondary;
    text-style: bold;
}

.field-desc {
    color: $text-muted;
}

.field-error {
    color: $error;
}

InputCollectionModal SingleLineVimTextArea {
    width: 100%;
    height: auto;
    margin: 0;
}

InputCollectionModal #toggle-optional {
    width: 100%;
    margin-bottom: 1;
}

InputCollectionModal #filled-status {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

InputCollectionModal #input-collection-hint {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

InputCollectionModal #button-row {
    align: center middle;
    height: auto;
    margin-top: 0;
}

InputCollectionModal #button-row Button {
    margin: 0 1;
}

/* Accept Proposal Modal styling */
AcceptProposalModal #proposals-display {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid $secondary;
}

AcceptProposalModal #help-text {
    margin: 1 0;
    color: $text-muted;
}

AcceptProposalModal Input {
    width: 100%;
    margin: 1 0;
}

AcceptProposalModal #error-message {
    height: auto;
    margin: 0;
}

AcceptProposalModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

AcceptProposalModal Button {
    margin: 0 1;
}

/* View Files and Edit Hooks Modal styling */
ViewFilesModal, EditHooksModal {
    align: center middle;
}

ViewFilesModal > Container, EditHooksModal > Container {
    width: 80;
    height: auto;
    max-height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#view-files-container, #edit-hooks-container {
    width: 100%;
}

ViewFilesModal #hints-display, EditHooksModal #hints-display {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid $secondary;
}

ViewFilesModal #hint-prompt, EditHooksModal #instructions {
    margin: 1 0 0 0;
    color: $text-muted;
}

ViewFilesModal Input, EditHooksModal Input {
    width: 100%;
    margin: 1 0;
}

ViewFilesModal #error-message, EditHooksModal #error-message {
    height: auto;
    margin: 0;
}

ViewFilesModal Horizontal, EditHooksModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ViewFilesModal Button, EditHooksModal Button {
    margin: 0 1;
}

/* Hint input bar styling */
HintInputBar {
    height: 3;
    border: solid $accent;
    background: $surface;
    padding: 0 1;
}

HintInputBar #hint-input-container {
    width: 100%;
    height: 100%;
    align: left middle;
}

HintInputBar #hint-label {
    width: auto;
    height: auto;
    text-style: bold;
    color: $primary;
    padding: 0 1 0 0;
}

HintInputBar #hint-input {
    width: 1fr;
    height: 1;
    border: none;
    background: $background;
    color: $text;
    padding: 0 1;
}

HintInputBar #hint-input:focus {
    border: none;
    background: $background;
}

HintInputBar #hint-escape-hint {
    width: auto;
    height: auto;
    color: $text-muted;
    padding: 0 0 0 1;
}

/* ===== Agents Tab Styling ===== */

#agents-view {
    width: 100%;
    height: 100%;
}

#agents-content {
    width: 100%;
    height: 1fr;
}

#agent-list-container {
    width: 60;
    height: 100%;
    layout: vertical;
}

#agents-view.-onboarding-active #agent-list-container {
    display: none;
}

#agents-content.-artifact-file-viewer-active #agent-list-container {
    display: none;
}

#agent-info-panel {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#agents-view.-onboarding-active #agent-info-panel {
    display: none;
}

#agent-list-container AgentList {
    width: 100%;
    /* Fallback only — overridden per-refresh by
       AgentDisplayMixin._apply_panel_heights, which sets either a
       cell-unit height (Fits regime) or fr weight (Overflow regime)
       based on each panel's content. */
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

#agent-list-container AgentList.agent-panel-separated {
    margin-top: 1;
}

#agent-list-container AgentList.-focused-panel {
    border: solid #FFD700;
}

#agent-list-container AgentList.-whole-panel-focus {
    /* Outlines are paint-only: unlike swapping border geometry on every j/k
       panel hop, they do not force the panel collection through layout. Keep
       the top edge unset so it cannot paint over the border title. */
    outline-left: heavy #FFD75F;
    outline-right: heavy #FFD75F;
    outline-bottom: heavy #FFD75F;
    border-title-color: #FFD75F;
}

#agent-detail-container {
    width: 1fr;
    height: 100%;
}

#agent-detail-panel {
    width: 100%;
    height: 1fr;
}

#agent-quickstart-panel {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    align-horizontal: center;
    scrollbar-gutter: stable;
}

#agent-onboarding-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.agent-onboarding-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    border-title-color: #87D7FF;
    padding: 0 1;
    margin-bottom: 1;
}

.agent-onboarding-card.-recommend {
    border: round #AF87FF;
    border-title-color: #AF87FF;
}

#axe-onboarding-hero {
    width: 100%;
    max-width: 90;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

.axe-onboarding-card {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $secondary;
    border-title-color: #FF5F5F;
    padding: 0 1;
    margin-bottom: 1;
}

#agent-detail-layout {
    width: 100%;
    height: 100%;
}

#agent-prompt-scroll,
#agent-search-scroll {
    height: 3fr;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-subtitle-align: center;
}

#agent-search-scroll {
    border: solid $accent;
    overflow-x: auto;
}

#agent-prompt-scroll.hidden,
#agent-search-scroll.hidden {
    display: none;
}

#agent-search-panel {
    width: auto;
    min-width: 100%;
    height: auto;
}

#agent-search-command {
    width: 100%;
    height: auto;
    max-height: 3;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#agent-search-command.hidden {
    display: none;
}

#agent-file-scroll {
    height: 7fr;
    border: solid green;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-title-align: left;
    border-subtitle-align: center;
}

#agent-file-scroll.hidden {
    display: none;
}

#agent-prompt-scroll.expanded {
    height: 100%;
}

#agent-search-scroll.expanded {
    height: 1fr;
}

/* Swapped layout (prompt gets priority) */
#agent-prompt-scroll.layout-priority,
#agent-search-scroll.layout-priority {
    height: 7fr;
}

#agent-file-scroll.layout-secondary {
    height: 3fr;
}

#agent-tools-scroll {
    height: 7fr;
    border: solid #87D7FF;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#agent-tools-scroll.hidden {
    display: none;
}

#agent-tools-scroll.layout-secondary {
    height: 3fr;
}

/* Agent list styling */
AgentList {
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: clip;
}

AgentList > .option-list--option {
    padding: 0 1;
}

AgentList > .option-list--option-highlighted {
    background: $accent 40%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

/* Prompt input bar styling (for agent workflow) */
PromptInputBar {
    height: 3;
    border: solid $accent;
    background: $surface;
    dock: bottom;
    padding: 0 1;
}

PromptInputBar.xprompt-target {
    border: double $secondary;
}

PromptInputBar.xprompt-target.dirty,
PromptInputBar.xprompt-target.stale {
    border: double $warning;
}

PromptInputBar.xprompt-target.readonly {
    border: double $foreground 50%;
}

PromptInputBar.snippet-mode.snippet-safe {
    border: double $primary;
}

PromptInputBar.snippet-mode.snippet-dirty {
    border: double $warning;
}

PromptInputBar #prompt-completion {
    width: 100%;
    height: auto;
    max-height: 10;
    border: solid $secondary;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #prompt-completion.hidden {
    display: none;
}

PromptInputBar #prompt-completion.jinja-diagnostics {
    max-height: 5;
}

PromptInputBar #prompt-completion.jinja-error {
    border: solid $error;
}

PromptInputBar #prompt-completion.jinja-warning {
    border: solid $warning;
}

/* The structured frontmatter panel, directly above the prompt stack. */
PromptInputBar #frontmatter-panel {
    /* Keep border, margin, and max-height in sync with
       _PANEL_BORDER_ROWS, _PANEL_BOTTOM_MARGIN, and _PANEL_MAX_HEIGHT. */
    width: 100%;
    height: auto;
    max-height: 18;
    border: round $secondary;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #frontmatter-panel.hidden {
    display: none;
}

PromptInputBar #frontmatter-panel:focus {
    border: round $accent;
}

PromptInputBar.xprompt-target #frontmatter-panel {
    border: round $secondary;
}

PromptInputBar.xprompt-target.dirty #frontmatter-panel,
PromptInputBar.xprompt-target.stale #frontmatter-panel {
    border: round $warning;
}

PromptInputBar.xprompt-target.readonly #frontmatter-panel {
    border: round $foreground 50%;
}

PromptInputBar.xprompt-target #frontmatter-panel:focus {
    border: round $secondary;
}

PromptInputBar.xprompt-target.dirty #frontmatter-panel:focus,
PromptInputBar.xprompt-target.stale #frontmatter-panel:focus {
    border: round $warning;
}

PromptInputBar.xprompt-target.readonly #frontmatter-panel:focus {
    border: round $foreground 50%;
}

/* Prompt `g` prefix hints, directly above the prompt stack. */
PromptInputBar #prompt-g-prefix-hints {
    width: 100%;
    height: auto;
    max-height: 13;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #prompt-g-prefix-hints.hidden {
    display: none;
}

/* Prompt Vim search command line, directly above the prompt stack. */
PromptInputBar #prompt-search-command {
    width: 100%;
    height: auto;
    max-height: 3;
    border: round $accent;
    background: $panel;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptInputBar #prompt-search-command.hidden {
    display: none;
}

PromptInputBar #frontmatter-rows {
    /* Keep max-height in sync with _ROWS_MAX_HEIGHT. */
    width: 100%;
    height: auto;
    max-height: 10;
    overflow-y: auto;
}

PromptInputBar #frontmatter-rows.hidden {
    display: none;
}

PromptInputBar #frontmatter-inline {
    /* Keep height + top margin in sync with _INLINE_ROWS. */
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    border: round $accent;
}

PromptInputBar #frontmatter-inline.hidden {
    display: none;
}

PromptInputBar #frontmatter-raw {
    /* Keep max-height in sync with _RAW_MAX_HEIGHT. */
    width: 100%;
    height: auto;
    max-height: 12;
    border: round $accent;
}

PromptInputBar #frontmatter-raw.hidden {
    display: none;
}

PromptInputBar #frontmatter-content {
    /* Keep height in sync with _CONTENT_ROWS. */
    width: 100%;
    height: 6;
    border: round $accent;
}

PromptInputBar #frontmatter-content.hidden,
PromptInputBar #frontmatter-feedback.hidden {
    display: none;
}

PromptInputBar #frontmatter-feedback {
    /* Keep max-height in sync with _FEEDBACK_MAX_HEIGHT. */
    width: 100%;
    height: auto;
    max-height: 4;
}

/* The prompt stack: a vertical list of one-or-more prompt panes. */
PromptInputBar #prompt-stack {
    width: 100%;
    height: 1fr;
    min-height: 1;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

/* Shared text-area styling for every pane. */
PromptInputBar .prompt-input {
    width: 100%;
    background: $background;
    color: $text;
}

/* Vim cursor accents mirror the prompt gutter colors in
   widgets/_line_rendering.py: normal gold (#D0A215), insert cyan (#3AA99F),
   and visual magenta (#CE5D97).  These prompt-scoped component rules replace
   TextArea's default reverse-video cursor with explicit readable cells. */
PromptInputBar PromptTextArea.prompt-input.-vim-normal .text-area--cursor {
    color: #100F0F;
    background: #D0A215;
    text-style: bold;
}

PromptInputBar PromptTextArea.prompt-input.-vim-insert .text-area--cursor {
    color: #100F0F;
    background: #3AA99F;
    text-style: bold;
}

PromptInputBar PromptTextArea.prompt-input.-vim-visual .text-area--cursor {
    color: #FFFCF0;
    background: #CE5D97;
    text-style: bold;
}

/* Generalized vim cursor accents for any VimTextArea (config-tab editors,
   etc.).  Textual type selectors match base classes, so these also cover
   PromptTextArea, but the prompt-scoped rules above win there by specificity
   and set identical colors.  Same palette as widgets/_line_rendering.py. */
VimTextArea.-vim-normal .text-area--cursor {
    color: #100F0F;
    background: #D0A215;
    text-style: bold;
}

VimTextArea.-vim-insert .text-area--cursor {
    color: #100F0F;
    background: #3AA99F;
    text-style: bold;
}

VimTextArea.-vim-visual .text-area--cursor {
    color: #FFFCF0;
    background: #CE5D97;
    text-style: bold;
}

SingleLineVimTextArea {
    width: 100%;
    height: 3;
    scrollbar-size: 0 0;
    /* Border carries the vim mode title ([INSERT] / [NORMAL] / ...). */
    border: solid $secondary;
}

TypedInputForm {
    height: auto;
    border: none;
    padding: 0;
    margin: 0;
}

/* Single-pane (solo) mode is visually identical to the pre-stack bar: the
   text area fills the bar and carries no border of its own. */
PromptInputBar .prompt-input.solo {
    height: 1fr;
    border: none;
}

PromptInputBar .prompt-input.solo:focus {
    border: none;
    background: $background;
}

/* Multi-pane mode encodes pane kind with hue ($accent for agents, $primary for
   snippets) and focus with border weight (thick active, vkey parked).  Keep
   these colors fully opaque: low-alpha theme colors flattened over the dark
   prompt background can downgrade to xterm-256 slots 16-21, which base16-style
   terminal palettes commonly remap.  Clearing the base TextArea border first
   is essential: only the left accent should reserve space, so the panes do not
   read as nested cards AND do not silently reserve the top/bottom border rows
   that would shrink each pane's content by two rows. */
PromptInputBar .prompt-pane {
    border: none;
    border-left: vkey $accent;
    padding: 0 0 0 1;
    margin: 0;
}

PromptInputBar .prompt-pane.active {
    border-left: thick $accent;
    background: $surface;
}

PromptInputBar .prompt-pane.active:focus {
    background: $surface;
}

PromptInputBar .prompt-pane.inactive {
    border-left: vkey $accent;
    background: $background;
    color: $text-muted;
}

/* The pinned snippet pane keeps the same fill as its agent-pane peer.  Its
   fully opaque $primary accent identifies it without changing highlighting. */
PromptInputBar .prompt-pane.snippet-target.active,
PromptInputBar .prompt-pane.snippet-target.active:focus {
    border-left: thick $primary;
}

PromptInputBar .prompt-pane.snippet-target.inactive {
    border-left: vkey $primary;
}

/* Separator rows: width-aware hairline rules with centered agent labels. */
PromptInputBar .prompt-stack-separator {
    width: 100%;
    height: 1;
    text-align: center;
    color: $text-muted;
}

PromptInputBar .prompt-stack-separator.inactive {
    text-style: dim;
}

PromptInputBar .prompt-stack-separator.active {
    color: $accent;
}

/* The snippet pane's separator reads as a labeled title bar, not a centered
   agent rule, and keeps the same $primary accent in both active/inactive
   states -- only the chip's bold/dim weight (set in Python) changes. */
PromptInputBar .prompt-stack-separator.snippet {
    color: $primary;
}

PromptInputBar .prompt-stack-separator.snippet.snippet-dirty {
    color: $warning;
}

PromptInputBar.feedback-mode {
    border: solid $warning;
}

/* Add-property picker for the frontmatter panel */
AddPropertyModal {
    align: center middle;
}

AddPropertyModal > Container {
    width: 76;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AddPropertyModal #modal-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

AddPropertyModal #add-property-list {
    height: auto;
    max-height: 12;
    scrollbar-gutter: stable;
}

AddPropertyModal .add-property-row {
    height: 1;
    padding: 0 1;
    color: $text;
}

AddPropertyModal .add-property-row.selected {
    background: $accent 25%;
    text-style: bold;
    border-left: thick $accent;
    padding: 0 1 0 0;
}

AddPropertyModal #add-property-detail {
    height: auto;
    color: $text-muted;
    border-top: solid $secondary;
    margin-top: 1;
    padding-top: 1;
}

AddPropertyModal #add-property-footer {
    height: auto;
    text-align: center;
    color: $text-muted;
    border-top: solid $secondary;
    margin-top: 1;
    padding-top: 1;
}

/* Generic schema-property picker. The legacy AddPropertyModal keeps the
   selectors above so its visual snapshots remain byte-for-byte stable. */
PropertyPickerModal.-generic {
    align: center middle;
}

PropertyPickerModal.-generic > Container {
    width: 76;
    height: auto;
    max-height: 80%;
    border: thick #D7A85B;
    background: $surface;
    padding: 1 2;
}

PropertyPickerModal.-generic #modal-title {
    text-align: center;
    text-style: bold;
    color: #F0C674;
    margin-bottom: 1;
}

PropertyPickerModal.-generic #property-picker-guidance {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

PropertyPickerModal.-generic #property-picker-list {
    height: auto;
    max-height: 12;
    scrollbar-gutter: stable;
}

PropertyPickerModal.-generic .property-picker-row {
    height: 1;
    padding: 0 1;
}

PropertyPickerModal.-generic .property-picker-row.selected {
    background: #B87333 25%;
    border-left: thick #D7A85B;
    padding: 0 1 0 0;
}

PropertyPickerModal.-generic #property-picker-detail,
PropertyPickerModal.-generic #property-picker-footer {
    height: auto;
    color: $text-muted;
    border-top: solid #B87333;
    margin-top: 1;
    padding-top: 1;
}

PropertyPickerModal.-generic #property-picker-footer {
    text-align: center;
}

PropertyPickerModal.-generic #axe-add-guidance,
PropertyPickerModal.-generic #axe-parent-guidance,
PropertyPickerModal.-generic #axe-script-guidance {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

PropertyPickerModal.-generic #axe-add-list,
PropertyPickerModal.-generic #axe-parent-list,
PropertyPickerModal.-generic #axe-script-list {
    height: auto;
    max-height: 12;
    scrollbar-gutter: stable;
}

PropertyPickerModal.-generic #axe-add-detail,
PropertyPickerModal.-generic #axe-add-footer,
PropertyPickerModal.-generic #axe-parent-detail,
PropertyPickerModal.-generic #axe-parent-footer,
PropertyPickerModal.-generic #axe-script-detail,
PropertyPickerModal.-generic #axe-script-footer {
    height: auto;
    color: $text-muted;
    border-top: solid #B87333;
    margin-top: 1;
    padding-top: 1;
}

PropertyPickerModal.-generic #axe-add-footer,
PropertyPickerModal.-generic #axe-parent-footer,
PropertyPickerModal.-generic #axe-script-footer {
    text-align: center;
}

AxeNewEntryIdentityModal {
