/* Textual CSS for the ace TUI */

/* Hidden class for tab switching */
.hidden {
    display: none;
}

/* Top bar (tab bar + notification indicator) */
#top-bar {
    height: auto;
    max-height: 1;
}

/* Tab bar styling */
#tab-bar {
    width: 1fr;
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#task-indicator {
    width: auto;
    content-align: right middle;
}

#inactive-indicator {
    width: auto;
    content-align: right middle;
}

#notification-indicator {
    width: auto;
    content-align: right middle;
}

#main-container {
    height: 1fr;
}

/* ChangeSpecs Tab View */
#changespecs-view {
    width: 100%;
    height: 100%;
}

#list-container {
    width: 43;  /* Default, will be set programmatically */
    min-width: 43;  /* Must fit info panel text */
    max-width: 80;
    height: 100%;
}

#info-panel {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

/* Ancestors/Children Panel */
#ancestors-children-panel {
    height: auto;
    max-height: 24;  /* Increased from 18 to accommodate reverted children when visible */
    padding: 0 1 1 1;
    border: solid $secondary;
    background: $surface;
}

#detail-container {
    width: 1fr;  /* Takes remaining space */
    height: 100%;
}

#search-query-panel {
    width: 100%;
    height: auto;
    max-height: 3;
    border: solid $secondary;
    padding: 0 1;
}

#detail-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#detail-panel {
    height: auto;
}

#keybinding-footer {
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 5;
    background: $surface;
    padding: 0 1;
}

#keybinding-content {
    width: 1fr;
}

#keybinding-status {
    width: auto;
}

/* List panel styling */
ChangeSpecList {
    scrollbar-gutter: stable;
}

ChangeSpecList > .option-list--option {
    padding: 0 1;
}

ChangeSpecList > .option-list--option-highlighted {
    background: $accent;
}

/* Modal styling */
StatusModal, QueryEditModal, WorkflowSelectModal, AcceptProposalModal, ConfirmKillModal, ConfirmDismissAllModal {
    align: center middle;
}

StatusModal > Container, QueryEditModal > Container, WorkflowSelectModal > Container, AcceptProposalModal > Container, ConfirmKillModal > Container, ConfirmDismissAllModal > Container {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

/* Workflow HITL Modal styling */
WorkflowHITLModal {
    align: center middle;
}

#hitl-container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#hitl-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#step-info {
    margin-bottom: 1;
}

#hitl-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

.hitl-section-header {
    margin-top: 1;
}

#output-content {
    margin-bottom: 1;
}

#hitl-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Plan Approval Modal styling */
PlanApprovalModal {
    align: center middle;
}

#plan-approval-container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#plan-approval-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#plan-approval-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

#plan-approval-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}


/* Mentor Review Modal styling */
MentorReviewModal {
    align: center middle;
}

#mentor-review-container {
    width: 95%;
    height: 95%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#mentor-review-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#mentor-review-panels {
    height: 1fr;
}

#mentor-side-panel {
    width: 30;
    min-width: 25;
    height: 100%;
    border-right: solid $secondary;
    padding: 0 1;
}

#mentor-main-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
}

#mentor-review-footer {
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Mentor Profile Select Modal */
MentorProfileSelectModal {
    align: center middle;
}

#mentor-profile-select-container {
    width: 50%;
    height: 40%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#mentor-profile-select-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#mentor-profile-select-list {
    height: 1fr;
    overflow-y: auto;
    padding: 0 1;
}

#mentor-profile-select-footer {
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Confirm Kill / Dismiss All Modal styling */
ConfirmKillModal #confirm-message,
ConfirmDismissAllModal #confirm-message {
    margin: 1 0;
}

ConfirmKillModal Horizontal,
ConfirmDismissAllModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ConfirmKillModal Button,
ConfirmDismissAllModal Button {
    margin: 0 1;
}

StatusModal OptionList {
    height: auto;
    max-height: 15;
}

QueryEditModal Input {
    width: 100%;
    margin: 1 0;
}

QueryEditModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

QueryEditModal Button {
    margin: 0 1;
}

/* Accept Proposal Modal styling */
AcceptProposalModal #proposals-display {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid $secondary;
}

AcceptProposalModal #help-text {
    margin: 1 0;
    color: $text-muted;
}

AcceptProposalModal Input {
    width: 100%;
    margin: 1 0;
}

AcceptProposalModal #error-message {
    height: auto;
    margin: 0;
}

AcceptProposalModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

AcceptProposalModal Button {
    margin: 0 1;
}

/* View Files and Edit Hooks Modal styling */
ViewFilesModal, EditHooksModal {
    align: center middle;
}

ViewFilesModal > Container, EditHooksModal > Container {
    width: 80;
    height: auto;
    max-height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#view-files-container, #edit-hooks-container {
    width: 100%;
}

ViewFilesModal #hints-display, EditHooksModal #hints-display {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid $secondary;
}

ViewFilesModal #hint-prompt, EditHooksModal #instructions {
    margin: 1 0 0 0;
    color: $text-muted;
}

ViewFilesModal Input, EditHooksModal Input {
    width: 100%;
    margin: 1 0;
}

ViewFilesModal #error-message, EditHooksModal #error-message {
    height: auto;
    margin: 0;
}

ViewFilesModal Horizontal, EditHooksModal Horizontal {
    align: center middle;
    height: auto;
    margin-top: 1;
}

ViewFilesModal Button, EditHooksModal Button {
    margin: 0 1;
}

/* Hint input bar styling */
HintInputBar {
    height: 3;
    border: solid $accent;
    background: $surface;
    padding: 0 1;
}

HintInputBar #hint-input-container {
    width: 100%;
    height: 100%;
    align: left middle;
}

HintInputBar #hint-label {
    width: auto;
    height: auto;
    text-style: bold;
    color: $primary;
    padding: 0 1 0 0;
}

HintInputBar #hint-input {
    width: 1fr;
    height: 1;
    border: none;
    background: $background;
    color: $text;
    padding: 0 1;
}

HintInputBar #hint-input:focus {
    border: none;
    background: $background;
}

HintInputBar #hint-escape-hint {
    width: auto;
    height: auto;
    color: $text-muted;
    padding: 0 0 0 1;
}

/* ===== Agents Tab Styling ===== */

#agents-view {
    width: 100%;
    height: 100%;
}

#agents-content {
    width: 100%;
    height: 1fr;
}

#agent-list-container {
    width: 40;  /* Default, will be set programmatically */
    min-width: 40;
    max-width: 70;
    height: 100%;
}

#agent-info-panel {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#agent-list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

#agent-detail-container {
    width: 1fr;
    height: 100%;
}

#agent-detail-panel {
    width: 100%;
    height: 1fr;
}

/* Pinned agents panel (bottom-left) */
#pinned-panel-container {
    width: 100%;
    height: auto;
    max-height: 12;
    border: solid #5F5F87;
    border-title-align: left;
    border-title-color: #AF87D7;
}

#pinned-panel-container.panel-active {
    border: solid #AF87D7;
}

#pinned-list-panel {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 10;
}

/* Focus state styling for main agent list */
#agent-list-panel.panel-inactive {
    border: solid #5F5F87;
}

#agent-detail-layout {
    width: 100%;
    height: 100%;
}

#agent-prompt-scroll {
    height: 3fr;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-subtitle-align: center;
}

#agent-file-scroll {
    height: 7fr;
    border: solid green;
    padding: 1 2;
    scrollbar-gutter: stable;
    border-subtitle-align: center;
}

#agent-file-scroll.hidden {
    display: none;
}

#agent-prompt-scroll.expanded {
    height: 100%;
}

/* Swapped layout (prompt gets priority) */
#agent-prompt-scroll.layout-priority {
    height: 7fr;
}

#agent-file-scroll.layout-secondary {
    height: 3fr;
}

#agent-thinking-scroll {
    height: 7fr;
    border: solid #af87d7;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#agent-thinking-scroll.hidden {
    display: none;
}

#agent-thinking-scroll.layout-secondary {
    height: 3fr;
}

/* Agent list styling */
AgentList {
    scrollbar-gutter: stable;
}

AgentList > .option-list--option {
    padding: 0 1;
}

AgentList > .option-list--option-highlighted {
    background: $accent;
}

/* Prompt input bar styling (for agent workflow) */
PromptInputBar {
    height: 3;
    border: solid $accent;
    background: $surface;
    dock: bottom;
}

PromptInputBar #prompt-input {
    width: 100%;
    height: 100%;
    border: none;
    background: $background;
    color: $text;
}

PromptInputBar #prompt-input:focus {
    border: none;
    background: $background;
}

PromptInputBar.feedback-mode {
    border: solid $warning;
}

/* XPrompt select modal styling */
XPromptSelectModal {
    align: center middle;
}

XPromptSelectModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptSelectModal #xprompt-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptSelectModal #xprompt-panels {
    width: 100%;
    height: 1fr;
}

XPromptSelectModal #xprompt-list-panel {
    width: 40;
    height: 100%;
}

XPromptSelectModal #xprompt-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

XPromptSelectModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

XPromptSelectModal #xprompt-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptSelectModal #xprompt-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

XPromptSelectModal #xprompt-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptSelectModal #xprompt-preview {
    height: auto;
}

XPromptSelectModal #xprompt-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Prompt history modal styling */
PromptHistoryModal {
    align: center middle;
}

PromptHistoryModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

PromptHistoryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

PromptHistoryModal #prompt-history-header {
    color: $text-muted;
    margin-bottom: 1;
}

PromptHistoryModal #prompt-history-filter-input {
    width: 100%;
    margin-bottom: 1;
}

PromptHistoryModal #prompt-history-panels {
    width: 100%;
    height: 1fr;
}

PromptHistoryModal #prompt-history-list-panel {
    width: 1fr;
    height: 100%;
}

PromptHistoryModal #prompt-history-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

PromptHistoryModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

PromptHistoryModal #prompt-history-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

PromptHistoryModal #prompt-history-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

PromptHistoryModal #prompt-history-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

PromptHistoryModal #prompt-history-preview {
    height: auto;
}

PromptHistoryModal #prompt-history-metadata {
    height: auto;
    color: $text-muted;
}

PromptHistoryModal #prompt-history-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Command history modal styling */
CommandHistoryModal {
    align: center middle;
}

CommandHistoryModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommandHistoryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

CommandHistoryModal #command-history-header {
    color: $text-muted;
    margin-bottom: 1;
}

CommandHistoryModal #command-history-filter-input {
    width: 100%;
    margin-bottom: 1;
}

CommandHistoryModal #command-history-panels {
    width: 100%;
    height: 1fr;
}

CommandHistoryModal #command-history-list-panel {
    width: 1fr;
    height: 100%;
}

CommandHistoryModal #command-history-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

CommandHistoryModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

CommandHistoryModal #command-history-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

CommandHistoryModal #command-history-preview-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

CommandHistoryModal #command-history-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

CommandHistoryModal #command-history-preview {
    height: auto;
}

CommandHistoryModal #command-history-metadata {
    height: auto;
    color: $text-muted;
}

CommandHistoryModal #command-history-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Hook history modal styling */
HookHistoryModal {
    align: center middle;
}

HookHistoryModal > Container {
    width: 70%;
    height: 60%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

HookHistoryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

HookHistoryModal #hook-history-filter-input {
    width: 100%;
    margin-bottom: 1;
}

HookHistoryModal #hook-history-list-panel {
    width: 100%;
    height: 1fr;
}

HookHistoryModal #hook-history-list-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

HookHistoryModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

HookHistoryModal #hook-history-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Axe Tab Styling ===== */

#axe-view {
    width: 100%;
    height: 100%;
}

/* Background command list container (left panel) */
#bgcmd-list-container {
    width: 35;
    min-width: 30;
    max-width: 50;
    height: 100%;
}

#bgcmd-list-panel {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

/* BgCmdList styling */
BgCmdList {
    scrollbar-gutter: stable;
}

BgCmdList > .option-list--option {
    padding: 0 1;
}

BgCmdList > .option-list--option-highlighted {
    background: $accent;
}

#axe-container {
    width: 1fr;
    height: 100%;
}

#axe-info-panel {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $secondary;
}

#axe-dashboard {
    width: 100%;
    height: 1fr;
}

#axe-status-section {
    height: auto;
    max-height: 1;
    padding: 0 1;
    background: $surface;
}

#axe-output-scroll {
    height: 1fr;
    overflow-y: auto;
    scrollbar-gutter: stable;
    border-top: solid $secondary;
    padding: 1 2;
}

#axe-output-section {
    height: auto;
}

/* ===== Help Modal Styling ===== */

HelpModal {
    align: center middle;
}

HelpModal > Container {
    width: 90%;
    max-width: 150;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

HelpModal #help-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

HelpModal #help-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

HelpModal #help-columns {
    width: 100%;
    height: auto;
}

HelpModal .help-column {
    width: 1fr;
    height: auto;
}

HelpModal #help-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Activity Modal Styling ===== */

ActivityModal {
    align: center middle;
}

ActivityModal > Container {
    width: 80;
    height: 85%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

ActivityModal #activity-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

ActivityModal #activity-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

ActivityModal #activity-content {
    width: 100%;
    height: auto;
}

ActivityModal #activity-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== Workspace Input Modal Styling ===== */

WorkspaceInputModal {
    align: center middle;
}

WorkspaceInputModal > Container {
    width: 50;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

WorkspaceInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

WorkspaceInputModal #workspace-hint {
    color: $text-muted;
    margin-bottom: 1;
}

WorkspaceInputModal #workspace-input {
    width: 100%;
}

/* ===== Command Input Modal Styling ===== */

CommandInputModal {
    align: center middle;
}

CommandInputModal > Container {
    width: 80;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CommandInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

CommandInputModal #command-context {
    color: $text-muted;
    margin-bottom: 1;
}

CommandInputModal #command-hint {
    color: $text-muted;
    margin-bottom: 1;
}

CommandInputModal #command-input {
    width: 100%;
}

/* ===== Process Select Modal Styling ===== */

ProcessSelectModal {
    align: center middle;
}

ProcessSelectModal > Container {
    width: 70;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ProcessSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

ProcessSelectModal #process-hint {
    color: $text-muted;
    margin-bottom: 1;
}

ProcessSelectModal #process-list {
    height: auto;
    max-height: 15;
    border: solid $secondary;
}

/* ===== Notification Modal Styling ===== */

NotificationModal {
    align: center middle;
}

NotificationModal > Container {
    width: 95%;
    height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

NotificationModal #notification-title {
    text-style: bold;
    margin-bottom: 1;
}

NotificationModal #notification-panels {
    width: 100%;
    height: 1fr;
}

NotificationModal #notification-left {
    width: 40%;
    height: 100%;
}

NotificationModal #notification-list {
    height: 1fr;
    border: solid $secondary;
}

NotificationModal #notification-empty {
    color: $text-muted;
    text-align: center;
    margin: 2 0;
}

NotificationModal #notification-right {
    width: 60%;
    height: 100%;
    margin-left: 1;
    border-left: solid $secondary;
    padding-left: 1;
}

NotificationModal #notification-file-title {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

NotificationModal #notification-file-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

NotificationModal #notification-file-content {
    height: auto;
}

NotificationModal #notification-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* ===== Tag Input Modal Styling ===== */

TagInputModal {
    align: center middle;
}

TagInputModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

TagInputModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

TagInputModal #tag-name-history {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

/* Move notifications to top-right corner */
ToastRack {
    dock: top;
    align: right top;
    margin-top: 1;
    margin-bottom: 0;
}

/* ===== Runners Modal Styling ===== */

RunnersModal {
    align: center middle;
}

RunnersModal > Container {
    width: 90%;
    max-width: 200;
    height: 70%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

RunnersModal #runners-title {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

RunnersModal #runners-content-scroll {
    height: 1fr;
    scrollbar-gutter: stable;
}

RunnersModal #runners-content {
    height: auto;
}

RunnersModal #runners-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* ===== User Question Modal Styling ===== */

UserQuestionModal {
    align: center middle;
}

#user-question-container {
    width: 92%;
    max-width: 180;
    height: 88%;
    border: double $primary;
    background: $surface;
    padding: 1 2;
}

#user-question-title {
    text-align: center;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#user-question-panels {
    width: 100%;
    height: 1fr;
}

#user-question-left {
    width: 30;
    min-width: 25;
    max-width: 40;
    height: 100%;
}

#user-question-list-label {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#user-question-list {
    height: 1fr;
    border: solid $secondary;
    scrollbar-gutter: stable;
}

#user-question-right {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    padding-left: 1;
    border-left: solid $secondary;
}

#user-question-header {
    height: auto;
    margin-bottom: 1;
}

#user-question-text-scroll {
    height: auto;
    max-height: 40%;
    border: solid $secondary;
    padding: 1 2;
    scrollbar-gutter: stable;
    margin-bottom: 1;
}

#user-question-text {
    height: auto;
}

#user-question-options {
    height: 1fr;
    border: solid $secondary;
    scrollbar-gutter: stable;
    text-wrap: wrap;
    text-overflow: clip;
}

#user-question-other-input {
    width: 100%;
    margin-top: 1;
}

#user-question-global-input {
    width: 100%;
    margin-top: 1;
}

#user-question-footer {
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
    border-top: solid $secondary;
    padding-top: 1;
}

/* Dismissed agent (revive) modal styling */
DismissedAgentSelectModal {
    align: center middle;
}

DismissedAgentSelectModal > Container {
    width: 90%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

DismissedAgentSelectModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

DismissedAgentSelectModal #dismissed-filter {
    width: 100%;
    margin-bottom: 1;
}

DismissedAgentSelectModal #dismissed-agent-panels {
    width: 100%;
    height: 1fr;
}

DismissedAgentSelectModal #dismissed-agent-list-panel {
    width: 45%;
    height: 100%;
}

DismissedAgentSelectModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

DismissedAgentSelectModal #dismissed-agent-preview-panel {
    width: 55%;
    height: 100%;
    margin-left: 1;
}

DismissedAgentSelectModal #dismissed-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 1 1;
}

DismissedAgentSelectModal #dismissed-preview-metadata {
    height: auto;
}

DismissedAgentSelectModal #dismissed-preview-content {
    height: auto;
    color: $text-muted;
}

DismissedAgentSelectModal #dismissed-agent-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* XPrompt browser modal styling */
XPromptBrowserModal {
    align: center middle;
}

XPromptBrowserModal > Container {
    width: 92%;
    height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptBrowserModal #browser-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptBrowserModal #browser-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptBrowserModal #browser-panels {
    width: 100%;
    height: 1fr;
}

XPromptBrowserModal #browser-list-panel {
    width: 40;
    height: 100%;
}

XPromptBrowserModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

XPromptBrowserModal #browser-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptBrowserModal #browser-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptBrowserModal #browser-preview {
    height: auto;
}

XPromptBrowserModal #browser-meta {
    height: auto;
    padding: 1 1 0 1;
    max-height: 8;
}

XPromptBrowserModal #browser-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Agent Run Log modal styling */
AgentRunLogModal {
    align: center middle;
}

AgentRunLogModal > Container {
    width: 92%;
    height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AgentRunLogModal #agent-log-title {
    text-style: bold;
    margin-bottom: 1;
}

AgentRunLogModal #agent-log-panels {
    width: 100%;
    height: 1fr;
}

AgentRunLogModal #agent-log-list-panel {
    width: 42;
    height: 100%;
}

AgentRunLogModal OptionList {
    height: 1fr;
    border: solid $secondary;
}

AgentRunLogModal #agent-log-detail-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

AgentRunLogModal #agent-log-detail-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

AgentRunLogModal #agent-log-detail {
    height: auto;
}

AgentRunLogModal #agent-log-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* Add xprompt modal styling */
AddXPromptModal {
    align: center middle;
}

AddXPromptModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

AddXPromptModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

AddXPromptModal #add-xprompt-hint {
    color: $text-muted;
    margin-bottom: 1;
}

AddXPromptModal #add-xprompt-input {
    width: 100%;
}

/* XPrompt filename input modal styling */
XPromptFilenameModal {
    align: center middle;
}

XPromptFilenameModal > Container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptFilenameModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptFilenameModal #filename-dir-label {
    color: #87D7FF;
    margin-bottom: 0;
}

XPromptFilenameModal #filename-hint {
    color: $text-muted;
    margin-bottom: 1;
}

XPromptFilenameModal #filename-input {
    width: 100%;
}

XPromptFilenameModal #filename-error {
    color: $error;
    margin-top: 1;
}

/* XPrompt location selector modal styling */
XPromptLocationModal {
    align: center middle;
}

XPromptLocationModal > Container {
    width: 92%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptLocationModal #location-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptLocationModal #location-hint {
    color: $text-muted;
    margin-bottom: 1;
}

XPromptLocationModal #location-filter-input {
    width: 100%;
    margin-bottom: 1;
}

XPromptLocationModal #location-panels {
    width: 100%;
    height: 1fr;
}

XPromptLocationModal #location-list-panel {
    width: 52;
    height: 100%;
}

XPromptLocationModal #location-list {
    height: 1fr;
    border: solid $secondary;
}

XPromptLocationModal #location-preview-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

XPromptLocationModal #location-preview-scroll {
    height: 1fr;
    border: solid $secondary;
    padding: 0 1;
}

XPromptLocationModal #location-preview {
    height: auto;
}

XPromptLocationModal #location-hints {
    height: 1;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

/* XPrompt config entry modal styling */
XPromptConfigEntryModal {
    align: center middle;
}

XPromptConfigEntryModal > Container {
    width: 70;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

XPromptConfigEntryModal #modal-title {
    text-style: bold;
    margin-bottom: 1;
}

XPromptConfigEntryModal #config-entry-file-label {
    color: #87D7FF;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-name-label {
    color: $text-muted;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-name-input {
    width: 100%;
}

XPromptConfigEntryModal #config-entry-phase-label {
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 0;
}

XPromptConfigEntryModal #config-entry-input-input {
    width: 100%;
}

XPromptConfigEntryModal #config-entry-inputs-display {
    margin-top: 1;
}

XPromptConfigEntryModal #config-entry-error {
