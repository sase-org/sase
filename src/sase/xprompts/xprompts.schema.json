{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SASE XPrompt Collection",
  "description": "Schema for xprompts.yml files that define reusable xprompt templates. Each top-level key is an xprompt name; values are either a content string or an object with input/content.",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      {
        "type": "string",
        "description": "Simple string content (e.g., an alias to another xprompt like '#gh:sase')"
      },
      {
        "type": "object",
        "description": "Structured xprompt with optional input parameters and content template",
        "required": ["content"],
        "additionalProperties": false,
        "properties": {
          "input": {
            "description": "Input argument definitions (object shorthand or array)",
            "oneOf": [
              {
                "type": "object",
                "description": "Object shorthand: { argName: type } or { argName: { type, default } }",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Type shorthand (e.g., 'text', 'word')",
                      "enum": ["word", "line", "text", "path", "int", "integer", "float", "bool", "boolean", "string"]
                    },
                    {
                      "type": "object",
                      "description": "Full definition with type and default",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["word", "line", "text", "path", "int", "integer", "float", "bool", "boolean", "string"]
                        },
                        "default": {
                          "description": "Default value if argument is not provided"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "array",
                "description": "List of input argument definitions",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The argument name"
                    },
                    "type": {
                      "type": "string",
                      "description": "The expected type of the argument value",
                      "enum": ["word", "line", "text", "path", "int", "integer", "float", "bool", "boolean", "string"],
                      "default": "line"
                    },
                    "default": {
                      "description": "Default value if argument is not provided (null means required)"
                    }
                  }
                }
              }
            ]
          },
          "content": {
            "type": "string",
            "description": "Template content with Jinja2 placeholders"
          }
        }
      }
    ]
  }
}
