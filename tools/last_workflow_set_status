#!/usr/bin/env python3
"""Report the status of the last fully-completed GitHub Actions workflow set.

Phases 1-3: CLI parsing, ``gh`` boundary, default-branch detection, run-set
selection (sort, latest-attempt dedup, SHA grouping, terminal-status
filtering, ``--require`` filtering), pass/fail summary output, and per-run
failure diagnostics (job/step summaries, check-run annotations, log tails).
See ``sdd/epics/202605/last_workflow_set_status_tool.md``.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from collections.abc import Callable, Iterable, Sequence
from dataclasses import asdict, dataclass, field


EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_CONFIG_ERROR = 2
EXIT_NO_COMPLETE_SET = 3


DEFAULT_LIMIT = 50
DEFAULT_TAIL = 50
DEFAULT_EVENTS = ("push",)


PASS_CONCLUSIONS = frozenset({"success", "skipped", "neutral"})
NON_TERMINAL_STATUSES = frozenset(
    {"queued", "in_progress", "waiting", "requested", "pending"}
)
RUN_LIST_JSON_FIELDS = (
    "databaseId",
    "workflowName",
    "workflowDatabaseId",
    "headSha",
    "headBranch",
    "status",
    "conclusion",
    "createdAt",
    "updatedAt",
    "event",
    "attempt",
    "displayTitle",
    "url",
)


class GhError(Exception):
    """Base class for all GhClient failures.

    Carries an exit code so the CLI layer can surface a user-friendly message
    without re-classifying every error type.
    """

    def __init__(self, message: str, *, exit_code: int = EXIT_CONFIG_ERROR) -> None:
        super().__init__(message)
        self.exit_code = exit_code


class GhMissingError(GhError):
    """``gh`` executable could not be located on PATH."""


class GhCommandError(GhError):
    """A ``gh`` invocation exited non-zero."""

    def __init__(
        self,
        argv: Sequence[str],
        returncode: int,
        stderr: str,
    ) -> None:
        joined = " ".join(argv)
        message = (
            f"`{joined}` failed with exit code {returncode}."
            f"{' stderr: ' + stderr.strip() if stderr.strip() else ''}"
        )
        super().__init__(message)
        self.argv = list(argv)
        self.returncode = returncode
        self.stderr = stderr


class GhJsonError(GhError):
    """``gh`` produced output that could not be decoded as JSON."""


@dataclass
class GhClient:
    """Boundary around the ``gh`` CLI.

    The CLI layer only ever talks to GitHub through this object. Tests replace
    the ``runner`` callable with a fixture so subprocess execution is fully
    controlled.
    """

    repo: str | None = None
    executable: str = "gh"
    runner: (
        Callable[[Sequence[str], dict[str, str] | None], subprocess.CompletedProcess[str]]
        | None
    ) = None

    def _resolve_executable(self) -> str:
        path = shutil.which(self.executable)
        if path is None:
            raise GhMissingError(
                f"`{self.executable}` was not found on PATH. Install GitHub CLI"
                " from https://cli.github.com/ and run `gh auth login`.",
            )
        return path

    def _run(
        self, args: Sequence[str], env_overrides: dict[str, str] | None = None
    ) -> subprocess.CompletedProcess[str]:
        argv = [self._resolve_executable(), *args]
        if self.runner is not None:
            return self.runner(argv, env_overrides)
        env: dict[str, str] | None = None
        if env_overrides:
            env = {**os.environ, **env_overrides}
        return subprocess.run(
            argv,
            capture_output=True,
            text=True,
            check=False,
            env=env,
        )

    def _gh_args(
        self, args: Sequence[str], *, attach_repo: bool
    ) -> tuple[list[str], dict[str, str] | None]:
        """Build the ``gh`` argv and any environment overrides.

        ``gh api`` does not accept ``--repo``; explicit repo selection for that
        subcommand is communicated through the ``GH_REPO`` environment variable
        instead, which the same placeholder-substitution path inside ``gh``
        honors.
        """
        result = list(args)
        env_overrides: dict[str, str] | None = None
        if attach_repo and self.repo is not None:
            if result and result[0] == "api":
                env_overrides = {"GH_REPO": self.repo}
            else:
                result += ["--repo", self.repo]
        return result, env_overrides

    def run_text(self, args: Sequence[str], *, attach_repo: bool = True) -> str:
        """Invoke ``gh`` and return decoded stdout.

        Raises :class:`GhCommandError` on a non-zero exit and
        :class:`GhMissingError` if ``gh`` is not installed.
        """
        full_args, env_overrides = self._gh_args(args, attach_repo=attach_repo)
        completed = self._run(full_args, env_overrides)
        if completed.returncode != 0:
            raise GhCommandError(
                ["gh", *full_args], completed.returncode, completed.stderr or ""
            )
        return completed.stdout or ""

    def run_json(self, args: Sequence[str], *, attach_repo: bool = True) -> object:
        """Invoke ``gh`` and decode stdout as JSON."""
        stdout = self.run_text(args, attach_repo=attach_repo)
        try:
            return json.loads(stdout)
        except json.JSONDecodeError as exc:
            preview = stdout[:200].replace("\n", " ")
            raise GhJsonError(
                "`gh` returned output that is not valid JSON"
                f" (json error: {exc.msg}; first 200 chars: {preview!r})."
            ) from exc

    def default_branch(self) -> str:
        """Return the default branch reported by ``gh repo view``.

        ``gh --jq`` emits the selected value as raw text (not JSON), so the
        response is consumed via :meth:`run_text` and trimmed of trailing
        whitespace.
        """
        stdout = self.run_text(
            [
                "repo",
                "view",
                "--json",
                "defaultBranchRef",
                "--jq",
                ".defaultBranchRef.name",
            ]
        )
        name = stdout.strip()
        if not name:
            raise GhError(
                "`gh repo view` did not return a default branch name."
            )
        return name

    def list_runs(
        self,
        *,
        branch: str,
        events: Sequence[str],
        limit: int,
    ) -> list["WorkflowRun"]:
        """Fetch recent workflow runs and return parsed :class:`WorkflowRun`s.

        ``--event`` is repeatable on ``gh run list``; one fetch per event keeps
        the implementation straightforward and matches what the design doc
        recommends. Results across events are concatenated.
        """
        runs: list[WorkflowRun] = []
        for event in events:
            payload = self.run_json(
                [
                    "run",
                    "list",
                    "--branch",
                    branch,
                    "--event",
                    event,
                    "--limit",
                    str(limit),
                    "--json",
                    ",".join(RUN_LIST_JSON_FIELDS),
                ]
            )
            runs.extend(parse_runs(payload))
        return runs

    def list_jobs(self, run_id: int) -> list["Job"]:
        """Fetch the jobs (and their steps) for ``run_id``."""
        payload = self.run_json(
            ["run", "view", str(run_id), "--json", "jobs"]
        )
        return parse_jobs(payload)

    def list_sha_check_runs(self, sha: str) -> list["CheckRun"]:
        """Fetch check-runs for ``sha`` via the GitHub REST API.

        ``gh api`` fills in the ``{owner}``/``{repo}`` placeholders using
        the resolved repo context. When :attr:`repo` is set explicitly,
        :meth:`_gh_args` exposes it through the ``GH_REPO`` environment
        variable (``gh api`` does not accept ``--repo``).
        """
        payload = self.run_json(
            [
                "api",
                f"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs",
            ]
        )
        return parse_check_runs(payload)

    def list_check_run_annotations(
        self, check_run: "CheckRun"
    ) -> list["Annotation"]:
        """Fetch annotations for a single check-run."""
        payload = self.run_json(
            [
                "api",
                f"repos/{{owner}}/{{repo}}/check-runs/"
                f"{check_run.check_run_id}/annotations",
            ]
        )
        return parse_annotations(payload, check_run=check_run)

    def fetch_failed_log(self, run_id: int) -> str:
        """Fetch the failed-step log for ``run_id`` as text."""
        return self.run_text(
            ["run", "view", str(run_id), "--log-failed"]
        )


@dataclass
class CliConfig:
    """Parsed, validated CLI configuration."""

    repo: str | None
    branch: str | None
    limit: int
    tail: int
    events: tuple[str, ...]
    require: tuple[str, ...]
    json_output: bool


@dataclass(frozen=True)
class WorkflowRun:
    """A single GitHub Actions workflow run row from ``gh run list``."""

    database_id: int
    workflow_name: str
    workflow_database_id: int
    head_sha: str
    head_branch: str
    status: str
    conclusion: str
    created_at: str
    updated_at: str
    event: str
    attempt: int
    display_title: str
    url: str

    @property
    def passed(self) -> bool:
        return self.conclusion in PASS_CONCLUSIONS

    @property
    def is_terminal(self) -> bool:
        return self.status not in NON_TERMINAL_STATUSES


@dataclass(frozen=True)
class RunSet:
    """A complete set of workflow runs sharing one ``head_sha``."""

    head_sha: str
    head_branch: str
    display_title: str
    created_at: str
    runs: tuple[WorkflowRun, ...] = field(default_factory=tuple)

    @property
    def passed(self) -> bool:
        return all(run.passed for run in self.runs)

    @property
    def failed_runs(self) -> tuple[WorkflowRun, ...]:
        return tuple(run for run in self.runs if not run.passed)


@dataclass(frozen=True)
class JobStep:
    """A single step inside a workflow Job."""

    name: str
    status: str
    conclusion: str
    number: int


@dataclass(frozen=True)
class Job:
    """A job belonging to a workflow run (as reported by ``gh run view``)."""

    database_id: int
    name: str
    status: str
    conclusion: str
    url: str
    steps: tuple[JobStep, ...] = ()

    @property
    def passed(self) -> bool:
        return self.conclusion in PASS_CONCLUSIONS

    @property
    def failed_steps(self) -> tuple[JobStep, ...]:
        return tuple(
            s for s in self.steps
            if s.conclusion and s.conclusion not in PASS_CONCLUSIONS
        )


@dataclass(frozen=True)
class CheckRun:
    """A check-run summary attached to a commit SHA."""

    check_run_id: int
    name: str
    status: str
    conclusion: str

    @property
    def passed(self) -> bool:
        return self.conclusion in PASS_CONCLUSIONS

    @property
    def is_terminal(self) -> bool:
        return self.status not in NON_TERMINAL_STATUSES


@dataclass(frozen=True)
class Annotation:
    """A check-run annotation pinned to a file or job."""

    check_run_id: int
    check_run_name: str
    path: str
    start_line: int
    end_line: int
    annotation_level: str
    title: str
    message: str


# Sentinel values for :class:`RunDiagnostics.source`.
DIAG_SOURCE_ANNOTATIONS = "annotations"
DIAG_SOURCE_LOGS = "logs"
DIAG_SOURCE_JOBS_ONLY = "jobs_only"
DIAG_SOURCE_NONE = "none"


@dataclass(frozen=True)
class RunDiagnostics:
    """Failure detail collected for a single failed workflow run."""

    run: WorkflowRun
    failed_jobs: tuple[Job, ...] = ()
    annotations: tuple[Annotation, ...] = ()
    log_tail: tuple[str, ...] = ()
    log_error: str = ""
    source: str = DIAG_SOURCE_NONE


def _coerce_str(value: object) -> str:
    if value is None:
        return ""
    return str(value)


def _coerce_int(value: object, *, default: int = 0) -> int:
    if isinstance(value, bool):
        return int(value)
    if isinstance(value, int):
        return value
    if isinstance(value, str) and value.strip():
        try:
            return int(value)
        except ValueError:
            return default
    return default


def parse_runs(payload: object) -> list[WorkflowRun]:
    """Convert the JSON payload from ``gh run list`` into typed runs.

    Skips entries that lack the minimal identifying fields rather than
    failing the whole report — ``gh`` is generally well-behaved but this keeps
    the tool robust against schema drift.
    """
    if not isinstance(payload, list):
        raise GhJsonError(
            "`gh run list` did not return a JSON array of runs."
        )
    out: list[WorkflowRun] = []
    for entry in payload:
        if not isinstance(entry, dict):
            continue
        database_id = _coerce_int(entry.get("databaseId"))
        workflow_database_id = _coerce_int(entry.get("workflowDatabaseId"))
        head_sha = _coerce_str(entry.get("headSha"))
        if database_id == 0 or workflow_database_id == 0 or not head_sha:
            continue
        out.append(
            WorkflowRun(
                database_id=database_id,
                workflow_name=_coerce_str(entry.get("workflowName")),
                workflow_database_id=workflow_database_id,
                head_sha=head_sha,
                head_branch=_coerce_str(entry.get("headBranch")),
                status=_coerce_str(entry.get("status")),
                conclusion=_coerce_str(entry.get("conclusion")),
                created_at=_coerce_str(entry.get("createdAt")),
                updated_at=_coerce_str(entry.get("updatedAt")),
                event=_coerce_str(entry.get("event")),
                attempt=_coerce_int(entry.get("attempt"), default=1),
                display_title=_coerce_str(entry.get("displayTitle")),
                url=_coerce_str(entry.get("url")),
            )
        )
    return out


def parse_jobs(payload: object) -> list[Job]:
    """Convert a ``gh run view --json jobs`` payload into typed jobs."""
    if isinstance(payload, dict):
        payload = payload.get("jobs")
    if not isinstance(payload, list):
        raise GhJsonError(
            "`gh run view --json jobs` did not return a list of jobs."
        )
    out: list[Job] = []
    for entry in payload:
        if not isinstance(entry, dict):
            continue
        steps_raw = entry.get("steps") or []
        steps: list[JobStep] = []
        if isinstance(steps_raw, list):
            for step in steps_raw:
                if not isinstance(step, dict):
                    continue
                steps.append(
                    JobStep(
                        name=_coerce_str(step.get("name")),
                        status=_coerce_str(step.get("status")),
                        conclusion=_coerce_str(step.get("conclusion")),
                        number=_coerce_int(step.get("number")),
                    )
                )
        out.append(
            Job(
                database_id=_coerce_int(entry.get("databaseId")),
                name=_coerce_str(entry.get("name")),
                status=_coerce_str(entry.get("status")),
                conclusion=_coerce_str(entry.get("conclusion")),
                url=_coerce_str(entry.get("url")),
                steps=tuple(steps),
            )
        )
    return out


def parse_check_runs(payload: object) -> list[CheckRun]:
    """Convert the ``/commits/{sha}/check-runs`` payload into typed runs."""
    if isinstance(payload, dict):
        payload = payload.get("check_runs")
    if not isinstance(payload, list):
        raise GhJsonError(
            "check-runs response did not contain a 'check_runs' array."
        )
    out: list[CheckRun] = []
    for entry in payload:
        if not isinstance(entry, dict):
            continue
        check_run_id = _coerce_int(entry.get("id"))
        if check_run_id == 0:
            continue
        out.append(
            CheckRun(
                check_run_id=check_run_id,
                name=_coerce_str(entry.get("name")),
                status=_coerce_str(entry.get("status")),
                conclusion=_coerce_str(entry.get("conclusion")),
            )
        )
    return out


def parse_annotations(
    payload: object, *, check_run: CheckRun
) -> list[Annotation]:
    """Convert the ``/check-runs/{id}/annotations`` payload into typed rows."""
    if not isinstance(payload, list):
        return []
    out: list[Annotation] = []
    for entry in payload:
        if not isinstance(entry, dict):
            continue
        out.append(
            Annotation(
                check_run_id=check_run.check_run_id,
                check_run_name=check_run.name,
                path=_coerce_str(entry.get("path")),
                start_line=_coerce_int(entry.get("start_line")),
                end_line=_coerce_int(entry.get("end_line")),
                annotation_level=_coerce_str(entry.get("annotation_level")),
                title=_coerce_str(entry.get("title")),
                message=_coerce_str(entry.get("message")),
            )
        )
    return out


def dedup_runs(runs: Iterable[WorkflowRun]) -> list[WorkflowRun]:
    """Collapse multiple attempts of the same ``(workflow, sha)`` pair.

    Keep the highest ``attempt``; tie-break on ``updated_at`` (newest wins).
    """
    best: dict[tuple[int, str], WorkflowRun] = {}
    for run in runs:
        key = (run.workflow_database_id, run.head_sha)
        prior = best.get(key)
        if prior is None:
            best[key] = run
            continue
        if run.attempt > prior.attempt:
            best[key] = run
        elif run.attempt == prior.attempt and run.updated_at > prior.updated_at:
            best[key] = run
    return list(best.values())


def group_by_sha(runs: Sequence[WorkflowRun]) -> list[tuple[str, list[WorkflowRun]]]:
    """Group runs by ``head_sha`` in newest-first order.

    Newest is determined by the maximum ``created_at`` within each group;
    runs inside a group are also sorted newest-first for stable output.
    """
    buckets: dict[str, list[WorkflowRun]] = {}
    for run in runs:
        buckets.setdefault(run.head_sha, []).append(run)
    sortable: list[tuple[str, str, list[WorkflowRun]]] = []
    for sha, group in buckets.items():
        group.sort(key=lambda r: r.created_at, reverse=True)
        newest = group[0].created_at if group else ""
        sortable.append((newest, sha, group))
    sortable.sort(key=lambda item: item[0], reverse=True)
    return [(sha, group) for _, sha, group in sortable]


@dataclass
class SelectionResult:
    """Outcome of :func:`select_run_set`."""

    run_set: RunSet | None
    skipped_incomplete: int = 0
    skipped_missing_required: int = 0


def select_run_set(
    runs: Iterable[WorkflowRun],
    *,
    require: Sequence[str] = (),
) -> SelectionResult:
    """Pick the newest fully-completed SHA group from ``runs``."""
    deduped = dedup_runs(runs)
    groups = group_by_sha(deduped)
    required = {name for name in require if name}
    skipped_incomplete = 0
    skipped_missing_required = 0
    for sha, group in groups:
        if any(not run.is_terminal for run in group):
            skipped_incomplete += 1
            continue
        if required:
            present = {run.workflow_name for run in group}
            if not required.issubset(present):
                skipped_missing_required += 1
                continue
        first = group[0]
        run_set = RunSet(
            head_sha=sha,
            head_branch=first.head_branch,
            display_title=first.display_title,
            created_at=first.created_at,
            runs=tuple(group),
        )
        return SelectionResult(
            run_set=run_set,
            skipped_incomplete=skipped_incomplete,
            skipped_missing_required=skipped_missing_required,
        )
    return SelectionResult(
        run_set=None,
        skipped_incomplete=skipped_incomplete,
        skipped_missing_required=skipped_missing_required,
    )


def _diagnose_run(
    client: "GhClient",
    run: WorkflowRun,
    *,
    failed_check_runs_by_name: dict[str, CheckRun],
    tail: int,
) -> RunDiagnostics:
    """Collect diagnostics for one failed workflow run.

    Order of preference for surface text:

    1. Annotations on failed check-runs whose name matches a failed job.
    2. The last ``tail`` lines of ``gh run view --log-failed``.
    3. The job/step summary alone, when neither of the above produces output.
    """
    try:
        jobs = client.list_jobs(run.database_id)
    except GhError:
        jobs = []
    failed_jobs = tuple(j for j in jobs if not j.passed)

    annotations: list[Annotation] = []
    seen_check_runs: set[int] = set()
    for job in failed_jobs:
        cr = failed_check_runs_by_name.get(job.name)
        if cr is None or cr.check_run_id in seen_check_runs:
            continue
        seen_check_runs.add(cr.check_run_id)
        try:
            annotations.extend(client.list_check_run_annotations(cr))
        except GhError:
            continue

    if annotations:
        return RunDiagnostics(
            run=run,
            failed_jobs=failed_jobs,
            annotations=tuple(annotations),
            source=DIAG_SOURCE_ANNOTATIONS,
        )

    log_text = ""
    log_error = ""
    # The log endpoint is unavailable for some terminal states (notably
    # ``cancelled``); attempt it once and treat any failure as terminal.
    try:
        log_text = client.fetch_failed_log(run.database_id)
    except GhError as exc:
        log_error = str(exc)

    log_tail: tuple[str, ...] = ()
    if log_text.strip():
        lines = log_text.splitlines()
        if tail > 0:
            lines = lines[-tail:]
        log_tail = tuple(lines)

    if log_tail:
        source = DIAG_SOURCE_LOGS
    elif failed_jobs:
        source = DIAG_SOURCE_JOBS_ONLY
    else:
        source = DIAG_SOURCE_NONE

    return RunDiagnostics(
        run=run,
        failed_jobs=failed_jobs,
        annotations=(),
        log_tail=log_tail,
        log_error=log_error,
        source=source,
    )


def gather_failure_diagnostics(
    client: "GhClient",
    run_set: RunSet,
    *,
    tail: int,
) -> tuple[RunDiagnostics, ...]:
    """Build :class:`RunDiagnostics` for every failed run in ``run_set``."""
    failed_runs = run_set.failed_runs
    if not failed_runs:
        return ()

    try:
        sha_check_runs = client.list_sha_check_runs(run_set.head_sha)
    except GhError:
        sha_check_runs = []

    failed_check_runs_by_name: dict[str, CheckRun] = {}
    for cr in sha_check_runs:
        if cr.is_terminal and not cr.passed:
            failed_check_runs_by_name.setdefault(cr.name, cr)

    return tuple(
        _diagnose_run(
            client,
            run,
            failed_check_runs_by_name=failed_check_runs_by_name,
            tail=tail,
        )
        for run in failed_runs
    )


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="last_workflow_set_status",
        description=(
            "Report the newest fully-completed set of GitHub Actions workflow"
            " runs on a branch and whether every workflow in that set passed."
        ),
    )
    parser.add_argument(
        "-r",
        "--repo",
        default=None,
        help="GitHub repository in OWNER/NAME form. Defaults to the repo of"
        " the current working directory as resolved by `gh`.",
    )
    parser.add_argument(
        "-b",
        "--branch",
        default=None,
        help="Branch to inspect. Defaults to the repository default branch.",
    )
    parser.add_argument(
        "-l",
        "--limit",
        type=int,
        default=DEFAULT_LIMIT,
        help=f"Maximum number of runs to fetch from `gh run list`."
        f" Default: {DEFAULT_LIMIT}.",
    )
    parser.add_argument(
        "-t",
        "--tail",
        type=int,
        default=DEFAULT_TAIL,
        help=f"Number of log lines to keep when tailing failed-run logs."
        f" Default: {DEFAULT_TAIL}.",
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="events",
        action="append",
        default=None,
        help="Workflow trigger event to include (repeatable). Default: push.",
    )
    parser.add_argument(
        "-R",
        "--require",
        default="",
        help="Comma-separated workflow names that must appear in the selected"
        " set for it to count as complete. Default: empty (use whichever"
        " workflows ran for the selected SHA).",
    )
    parser.add_argument(
        "-j",
        "--json",
        dest="json_output",
        action="store_true",
        help="Emit machine-readable JSON instead of human-readable text.",
    )
    return parser


def _parse_require(raw: str) -> tuple[str, ...]:
    return tuple(name.strip() for name in raw.split(",") if name.strip())


def parse_args(argv: Sequence[str]) -> CliConfig:
    """Parse ``argv`` into a :class:`CliConfig`.

    Raises ``SystemExit`` via argparse on malformed input. Additional
    semantic validation (positive integers, etc.) is enforced here.
    """
    parser = _build_parser()
    namespace = parser.parse_args(list(argv))

    if namespace.limit <= 0:
        parser.error("--limit must be a positive integer.")
    if namespace.tail <= 0:
        parser.error("--tail must be a positive integer.")
    if namespace.repo is not None and "/" not in namespace.repo:
        parser.error("--repo must be in OWNER/NAME form.")

    events = tuple(namespace.events) if namespace.events else DEFAULT_EVENTS

    return CliConfig(
        repo=namespace.repo,
        branch=namespace.branch,
        limit=namespace.limit,
        tail=namespace.tail,
        events=events,
        require=_parse_require(namespace.require),
        json_output=bool(namespace.json_output),
    )


def resolve_branch(config: CliConfig, client: GhClient) -> str:
    """Resolve the branch to inspect, falling back to ``gh``'s default."""
    if config.branch:
        return config.branch
    return client.default_branch()


def _short_sha(sha: str) -> str:
    return sha[:7] if sha else "<unknown>"


def _format_diagnostic_block(diag: RunDiagnostics) -> list[str]:
    """Render the failure-detail block for one :class:`RunDiagnostics`."""
    lines: list[str] = [
        f"---- {diag.run.workflow_name} (failure detail) ----",
    ]
    for job in diag.failed_jobs:
        conclusion = job.conclusion or "<unknown>"
        lines.append(f"  job: {job.name} ({conclusion})")
        if job.url:
            lines.append(f"    url: {job.url}")
        for step in job.failed_steps:
            step_conclusion = step.conclusion or "<unknown>"
            lines.append(
                f"    step {step.number}: {step.name} ({step_conclusion})"
            )
    if diag.source == DIAG_SOURCE_ANNOTATIONS and diag.annotations:
        lines.append(
            "  annotations for failed check-runs on this SHA:"
        )
        for ann in diag.annotations:
            loc = ann.path or "<unknown>"
            if ann.start_line:
                loc += f":{ann.start_line}"
            heading = ann.title or ann.annotation_level or "annotation"
            lines.append(
                f"    [{ann.check_run_name}] {loc} — {heading}"
            )
            if ann.message:
                for ml in ann.message.splitlines():
                    lines.append(f"      {ml}")
    elif diag.source == DIAG_SOURCE_LOGS and diag.log_tail:
        lines.append(
            f"  log tail (last {len(diag.log_tail)} line(s)):"
        )
        for log_line in diag.log_tail:
            lines.append(f"    {log_line}")
    elif diag.source == DIAG_SOURCE_JOBS_ONLY:
        if diag.log_error:
            lines.append(f"  log unavailable: {diag.log_error}")
        else:
            lines.append(
                "  (no annotations or log output; jobs above are the only"
                " diagnostic available)"
            )
    elif diag.source == DIAG_SOURCE_NONE:
        if diag.log_error:
            lines.append(f"  log unavailable: {diag.log_error}")
        else:
            lines.append("  (no diagnostic detail available)")
    return lines


def format_human(
    result: SelectionResult,
    *,
    branch: str,
    diagnostics: Sequence[RunDiagnostics] = (),
) -> str:
    """Render the selection outcome as terminal-friendly text."""
    run_set = result.run_set
    if run_set is None:
        lines = [
            f"No fully-completed workflow set found on branch {branch!r}.",
        ]
        if result.skipped_incomplete:
            lines.append(
                f"  Skipped {result.skipped_incomplete} SHA(s) with"
                " in-progress runs."
            )
        if result.skipped_missing_required:
            lines.append(
                f"  Skipped {result.skipped_missing_required} SHA(s)"
                " missing required workflow(s)."
            )
        lines.append("Try increasing --limit to fetch more history.")
        return "\n".join(lines)

    failed = run_set.failed_runs
    total = len(run_set.runs)
    lines = [
        f"branch:  {branch}",
        f"sha:     {_short_sha(run_set.head_sha)} ({run_set.head_sha})",
    ]
    if run_set.display_title:
        lines.append(f"title:   {run_set.display_title}")
    if run_set.created_at:
        lines.append(f"created: {run_set.created_at}")
    lines.append(f"runs:    {total}")
    lines.append("")
    if not failed:
        lines.append(f"All {total} workflow(s) passed.")
    else:
        lines.append(
            f"FAIL: {len(failed)} of {total} workflow(s) did not pass."
        )
    lines.append("")
    for run in run_set.runs:
        marker = "PASS" if run.passed else "FAIL"
        conclusion = run.conclusion or "<unknown>"
        line = f"  [{marker}] {run.workflow_name} ({conclusion})"
        if run.url:
            line += f" — {run.url}"
        lines.append(line)

    if diagnostics:
        diag_by_run = {d.run.database_id: d for d in diagnostics}
        for run in failed:
            diag = diag_by_run.get(run.database_id)
            if diag is None:
                continue
            lines.append("")
            lines.extend(_format_diagnostic_block(diag))
    return "\n".join(lines)


def _diagnostic_to_dict(diag: RunDiagnostics) -> dict[str, object]:
    return {
        "run": asdict(diag.run),
        "source": diag.source,
        "failed_jobs": [asdict(j) for j in diag.failed_jobs],
        "annotations": [asdict(a) for a in diag.annotations],
        "log_tail": list(diag.log_tail),
        "log_error": diag.log_error,
    }


def format_json(
    result: SelectionResult,
    *,
    branch: str,
    diagnostics: Sequence[RunDiagnostics] = (),
) -> str:
    """Render the selection outcome as JSON."""
    run_set = result.run_set
    if run_set is None:
        payload: dict[str, object] = {
            "branch": branch,
            "ok": False,
            "run_set": None,
            "diagnostics": [],
            "skipped_incomplete": result.skipped_incomplete,
            "skipped_missing_required": result.skipped_missing_required,
        }
        return json.dumps(payload, indent=2, sort_keys=True)
    payload = {
        "branch": branch,
        "ok": run_set.passed,
        "run_set": {
            "head_sha": run_set.head_sha,
            "head_branch": run_set.head_branch,
            "display_title": run_set.display_title,
            "created_at": run_set.created_at,
            "runs": [asdict(run) for run in run_set.runs],
        },
        "diagnostics": [_diagnostic_to_dict(d) for d in diagnostics],
        "skipped_incomplete": result.skipped_incomplete,
        "skipped_missing_required": result.skipped_missing_required,
    }
    return json.dumps(payload, indent=2, sort_keys=True)


def main(argv: Sequence[str] | None = None) -> int:
    """CLI entrypoint. Returns the process exit code."""
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    try:
        config = parse_args(raw_argv)
    except SystemExit as exc:
        return int(exc.code) if isinstance(exc.code, int) else EXIT_CONFIG_ERROR

    client = GhClient(repo=config.repo)
    try:
        branch = resolve_branch(config, client)
        runs = client.list_runs(
            branch=branch,
            events=config.events,
            limit=config.limit,
        )
    except GhError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return exc.exit_code

    result = select_run_set(runs, require=config.require)

    diagnostics: tuple[RunDiagnostics, ...] = ()
    if result.run_set is not None and result.run_set.failed_runs:
        diagnostics = gather_failure_diagnostics(
            client, result.run_set, tail=config.tail
        )

    if config.json_output:
        print(format_json(result, branch=branch, diagnostics=diagnostics))
    else:
        print(format_human(result, branch=branch, diagnostics=diagnostics))

    if result.run_set is None:
        return EXIT_NO_COMPLETE_SET
    return EXIT_PASS if result.run_set.passed else EXIT_FAIL


if __name__ == "__main__":
    raise SystemExit(main())
