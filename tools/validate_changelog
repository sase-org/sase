#!/usr/bin/env python3
"""Validate that CHANGELOG.md contains only release-please sections."""

from __future__ import annotations

import re
import sys
from pathlib import Path


CHANGELOG = Path(__file__).resolve().parents[1] / "CHANGELOG.md"
VERSION_HEADING = re.compile(
    r"^## \[\d+\.\d+\.\d+\]"
    r"\(https://github\.com/sase-org/sase/compare/"
    r"v\d+\.\d+\.\d+\.\.\.v\d+\.\d+\.\d+\)"
    r" \(\d{4}-\d{2}-\d{2}\)$"
)
EDITING_GUIDANCE = (
    "CHANGELOG.md is generated by release-please from conventional commit "
    "messages; describe the change in the commit subject/body instead of "
    "editing this file."
)


def _error(line_number: int, line: str) -> None:
    print(
        f"[validate_changelog] CHANGELOG.md:{line_number}: invalid heading "
        f"{line!r}. {EDITING_GUIDANCE}",
        file=sys.stderr,
    )


def _is_allowed_heading(line: str) -> bool:
    if VERSION_HEADING.fullmatch(line):
        return True
    return line.startswith("### ") and not line.startswith("#### ")


def validate_changelog(changelog: Path = CHANGELOG) -> bool:
    lines = changelog.read_text(encoding="utf-8").splitlines()
    first_line = lines[0] if lines else "<missing>"
    if first_line != "# Changelog":
        _error(1, first_line)
        return False

    inside_fence = False
    for line_number, line in enumerate(lines[1:], start=2):
        if line.strip().startswith("```"):
            inside_fence = not inside_fence
            continue
        if inside_fence or not line.startswith("#"):
            continue
        if not _is_allowed_heading(line):
            _error(line_number, line)
            return False

    return True


def main() -> int:
    return 0 if validate_changelog() else 1


if __name__ == "__main__":
    raise SystemExit(main())
