#!/usr/bin/env python3
"""Prequential replay over typed prompt history for next-word prediction.

This is a measurement tool, not a gate: it warms the Rust replay evaluator
on the oldest share of typed history rows, scores every word-boundary
position of each later row (or every K-th row with ``--score-every K``),
then prints aggregate-only accuracy, coverage, precision,
keystroke-savings, run-length, latency, and memory tables by cohort. No
prompt text is printed. Use the tables to calibrate the confidence
presets in ``sase_core::prompt_prediction``. ``--bench`` instead compiles
real history once and times production ``predict`` / ``rank_prefix`` over
sampled prefixes, printing compile, corpus-size, and latency aggregates.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from rich.console import Console
    from rich.table import Table


REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from sase.core.prompt_prediction_facade import (  # noqa: E402
    evaluate_prompt_prediction_replay,
)
from sase.core.prompt_prediction_wire import (  # noqa: E402
    PromptPredictionReplayCohort,
    PromptPredictionReplayGateMetrics,
    PromptPredictionReplayMidwordCohort,
    PromptPredictionReplayMidwordMetrics,
    PromptPredictionReplayMidwordPreset,
    PromptPredictionReplayOptions,
    PromptPredictionReplayReport,
)
from sase.history.prompt_prediction_archive import (  # noqa: E402
    build_archive_prediction_rows,
)
from sase.history.prompt_prediction_rows import (  # noqa: E402
    build_prompt_prediction_project_resolver,
    build_prompt_prediction_rows,
)
from sase.history.prompt_word_deletions import (  # noqa: E402
    load_deleted_prompt_words,
)

_PRESETS = ("cautious", "balanced", "eager")


def _parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--confidence",
        choices=_PRESETS,
        default="balanced",
        help="preset driving the gated table (default: balanced)",
    )
    parser.add_argument(
        "--sweep",
        action="store_true",
        help="also print the threshold-grid sweep table",
    )
    parser.add_argument(
        "--sources",
        default="history",
        help="comma-separated replay sources from history[,archive] "
        "(default: history; archive appends the pruned cross-machine "
        "prompt-archive rows at full weight, an upper bound on the "
        "production 0.25 weight)",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="print the full aggregate-only report as JSON instead of tables",
    )
    parser.add_argument(
        "--score-every",
        type=int,
        default=1,
        metavar="K",
        help="score only every K-th post-warm row (default: 1, every row). "
        "Every row still joins the corpus, so the selection is deterministic; "
        "use the same K to compare history against history,archive.",
    )
    parser.add_argument(
        "--bench",
        action="store_true",
        help="measure production predict/rank_prefix latency on real "
        "history instead of running the prequential replay: compile real "
        "history, then time the production model over sampled non-blocked "
        "prefixes, both the default menu request and the TUI's zero-row "
        "ghost-only request (aggregates only, never prompt text)",
    )
    parser.add_argument(
        "--bench-samples",
        type=int,
        default=300,
        help="prefixes to sample for --bench (default: 300)",
    )
    parser.add_argument(
        "--midword",
        action="store_true",
        help="also print the mid-word completion tables (per preset and "
        "per typed-prefix length k=1..4): coverage, precision of the "
        "completed word, and keystroke savings. Calibrate "
        "min_prefix_chars against these tables.",
    )
    return parser.parse_args(argv)


def _check_sources(sources: str) -> list[str]:
    names = [name.strip().lower() for name in sources.split(",") if name.strip()]
    if not names or any(name not in ("history", "archive") for name in names):
        print(
            f"error: --sources must draw from history[,archive], got {sources!r}",
            file=sys.stderr,
        )
        raise SystemExit(2)
    if "archive" in names and "history" not in names:
        print(
            "error: --sources archive requires history "
            "(the archive is a background source, not a standalone corpus)",
            file=sys.stderr,
        )
        raise SystemExit(2)
    return names


def _preset_metrics(
    report: PromptPredictionReplayReport, preset: str
) -> PromptPredictionReplayGateMetrics:
    return {
        "cautious": report.cautious,
        "balanced": report.balanced,
        "eager": report.eager,
    }[preset]


def _cohort_preset(
    report_cohort: PromptPredictionReplayCohort, preset: str
) -> PromptPredictionReplayGateMetrics:
    return {
        "cautious": report_cohort.cautious,
        "balanced": report_cohort.balanced,
        "eager": report_cohort.eager,
    }[preset]


def _format_precision(precision: float | None) -> str:
    return "n/a" if precision is None else f"{precision:.1%}"


def _print_tables(
    report: PromptPredictionReplayReport, preset: str, sweep: bool
) -> None:
    from rich.console import Console
    from rich.table import Table

    console = Console()
    console.print(
        f"[bold]prompt prediction replay[/bold] "
        f"rows={report.rows_total} typed={report.rows_typed} "
        f"warmed={report.rows_warmed} scored={report.rows_scored} "
        f"positions={report.positions_total}"
    )

    accuracy = Table(title="accuracy by cohort (ungated top-1 / top-3)")
    accuracy.add_column("cohort")
    accuracy.add_column("positions", justify="right")
    accuracy.add_column("top-1", justify="right")
    accuracy.add_column("top-3", justify="right")
    for cohort in report.cohorts:
        accuracy.add_row(
            cohort.cohort,
            f"{cohort.positions}",
            f"{cohort.top1:.1%}",
            f"{cohort.top3:.1%}",
        )
    accuracy.add_row(
        "all",
        f"{report.positions_total}",
        f"{report.overall_top1:.1%}",
        f"{report.overall_top3:.1%}",
        end_section=True,
    )
    console.print(accuracy)

    overall = _preset_metrics(report, preset)
    gated = Table(title=f"gated metrics by cohort ({preset})")
    gated.add_column("cohort")
    gated.add_column("coverage", justify="right")
    gated.add_column("precision", justify="right")
    gated.add_column("savings", justify="right")
    gated.add_column("run mean", justify="right")
    gated.add_column("run p95", justify="right")
    gated.add_column("run max", justify="right")
    for cohort in report.cohorts:
        metrics = _cohort_preset(cohort, preset)
        gated.add_row(
            cohort.cohort,
            f"{metrics.coverage:.1%}",
            _format_precision(metrics.precision),
            f"{metrics.savings:.1%}",
            f"{metrics.run_mean:.1f}",
            f"{metrics.run_p95:.0f}",
            f"{metrics.run_max}",
        )
    gated.add_row(
        "all",
        f"{overall.coverage:.1%}",
        _format_precision(overall.precision),
        f"{overall.savings:.1%}",
        f"{overall.run_mean:.1f}",
        f"{overall.run_p95:.0f}",
        f"{overall.run_max}",
        end_section=True,
    )
    console.print(gated)

    cost = Table(title="latency and memory")
    cost.add_column("metric")
    cost.add_column("value", justify="right")
    cost.add_row("predict p50", f"{report.latency_us_p50} us")
    cost.add_row("predict p95", f"{report.latency_us_p95} us")
    cost.add_row("corpus bytes", f"{report.corpus_bytes / 1_048_576:.2f} MB")
    cost.add_row("corpus rows", f"{report.corpus_rows_used}")
    cost.add_row("corpus contexts", f"{report.corpus_contexts}")
    console.print(cost)

    if sweep:
        ranked = sorted(
            (
                point
                for point in report.sweep
                if point.precision is not None
            ),
            key=lambda point: (point.precision or 0.0, point.coverage),
        )
        table = Table(
            title="threshold sweep (top 20 by precision, then coverage)"
        )
        table.add_column("min_p", justify="right")
        table.add_column("min_margin", justify="right")
        table.add_column("min_support", justify="right")
        table.add_column("coverage", justify="right")
        table.add_column("precision", justify="right")
        table.add_column("novel cov", justify="right")
        table.add_column("novel prec", justify="right")
        for point in ranked[-20:]:
            table.add_row(
                f"{point.min_p:.2f}",
                f"{point.min_margin:.2f}",
                f"{point.min_support}",
                f"{point.coverage:.1%}",
                _format_precision(point.precision),
                f"{point.novel_coverage:.1%}",
                _format_precision(point.novel_precision),
            )
        console.print(table)


def _print_midword_tables(report: PromptPredictionReplayReport) -> None:
    from rich.console import Console
    from rich.table import Table

    console = Console()
    midword: list[PromptPredictionReplayMidwordPreset] | None = report.midword
    if not midword:
        console.print(
            "[bold]mid-word completion[/bold] not reported by this core "
            "(rebuild sase_core_rs past the mid-word replay)"
        )
        return
    for preset in midword:
        _print_midword_preset(console, preset)


def _print_midword_preset(
    console: Console, preset: PromptPredictionReplayMidwordPreset
) -> None:
    from rich.console import Console
    from rich.table import Table

    table = Table(title=f"mid-word completion ({preset.preset})")
    table.add_column("k", justify="right")
    table.add_column("trials", justify="right")
    table.add_column("coverage", justify="right")
    table.add_column("precision", justify="right")
    table.add_column("savings", justify="right")
    for cell in preset.by_k:
        _add_midword_row(table, cell)
    console.print(table)
    cohorts = Table(title=f"mid-word precision by cohort ({preset.preset})")
    cohorts.add_column("cohort")
    for cell in preset.by_k:
        cohorts.add_column(f"k={cell.k}", justify="right")
    for cohort in preset.cohorts:
        _add_midword_cohort_row(cohorts, cohort)
    console.print(cohorts)


def _add_midword_row(
    table: Table, cell: PromptPredictionReplayMidwordMetrics
) -> None:
    from rich.table import Table  # noqa: F811 (annotation-only reference)

    table.add_row(
        f"{cell.k}",
        f"{cell.positions}",
        f"{cell.coverage:.1%}",
        _format_precision(cell.precision),
        f"{cell.savings:.1%}",
    )


def _add_midword_cohort_row(
    cohorts: Table, cohort: PromptPredictionReplayMidwordCohort
) -> None:
    cohorts.add_row(
        cohort.cohort,
        *[_format_precision(cell.precision) for cell in cohort.by_k],
    )


def _percentile(sorted_ms: list[float], pct: float) -> float:
    if not sorted_ms:
        return 0.0
    index = min(int(len(sorted_ms) * pct / 100), len(sorted_ms) - 1)
    return sorted_ms[index]


def _run_bench(args: argparse.Namespace) -> int:
    """Compile real history and time production predict/rank_prefix."""
    from sase.core.prompt_prediction_facade import (
        PromptPredictionCorpus,
        PromptPredictionModel,
    )
    from sase.core.prompt_prediction_wire import (
        PromptPredictionCorpusOptions,
        PromptPredictionModelConfig,
        PromptPredictionRequest,
        PromptPrefixRankRequest,
    )

    resolver = build_prompt_prediction_project_resolver()
    rows = build_prompt_prediction_rows(resolve_project=resolver.resolve)
    excluded = sorted(load_deleted_prompt_words())
    options = PromptPredictionCorpusOptions(
        now_epoch=int(time.time()),
        excluded_words=excluded,
    )
    started = time.perf_counter()
    corpus = PromptPredictionCorpus.compile(rows, options)
    compile_ms = (time.perf_counter() - started) * 1000.0
    stats = corpus.stats()
    model = PromptPredictionModel.compose(
        [(corpus, "history", 1.0)], PromptPredictionModelConfig()
    )
    # Deterministic word-boundary prefixes across the history window.
    typed = [row for row in rows if (row.origin or "") != "generated"]
    want = max(1, args.bench_samples)
    step = max(1, len(typed) // want)
    predict_ms: list[float] = []
    ghost_ms: list[float] = []
    rank_ms: list[float] = []
    # Draft-length buckets (characters of the request text, which is the
    # per-request draft): per bucket, the boundary ghost-only request and
    # the mid-word typing-path request that phase midword-autosuggest
    # sends per keystroke.
    _BUCKETS = (1_000, 4_000, 10_000, 20_000)
    bucket_ghost: dict[int, list[float]] = {cap: [] for cap in _BUCKETS}
    bucket_typing: dict[int, list[float]] = {cap: [] for cap in _BUCKETS}
    blocked = 0
    confident = 0
    sampled = 0
    truncated = 0
    for row in typed[::step][:want]:
        words = row.text.split()
        if len(words) < 4:
            continue
        cut = max(1, len(words) * 2 // 3)
        text = " ".join(words[:cut])
        if len(text) > 20_000:
            text = text[:20_000]
            truncated += 1
        bucket = next(cap for cap in _BUCKETS if len(text) <= cap)
        request = PromptPredictionRequest(
            text_before_cursor=text,
            project=row.project,
        )
        sampled += 1
        query_started = time.perf_counter()
        result = model.predict(request)
        elapsed_ms = (time.perf_counter() - query_started) * 1000.0
        if result.blocked_reason is not None:
            blocked += 1
            continue
        predict_ms.append(elapsed_ms)
        if result.confident:
            confident += 1
        # The TUI's ghost-only paths request zero menu rows: same gate and
        # ghost, no per-row continuation previews.
        ghost_request = PromptPredictionRequest(
            text_before_cursor=text,
            project=row.project,
            limit=0,
        )
        ghost_started = time.perf_counter()
        model.predict(ghost_request)
        ghost_elapsed = (time.perf_counter() - ghost_started) * 1000.0
        ghost_ms.append(ghost_elapsed)
        bucket_ghost[bucket].append(ghost_elapsed)
        # The mid-word typing-path request: zero menu rows with
        # current-word completion on. Sampled texts end in a full word, so
        # this exercises detection plus the restricted gate and gated
        # continuation, representative of per-keystroke cost.
        typing_request = PromptPredictionRequest(
            text_before_cursor=text,
            project=row.project,
            limit=0,
            complete_current_word=True,
        )
        typing_started = time.perf_counter()
        model.predict(typing_request)
        typing_elapsed = (time.perf_counter() - typing_started) * 1000.0
        bucket_typing[bucket].append(typing_elapsed)
        # Rank the current word on every fourth sample: truncate the last
        # word to a 3-letter prefix when it is long enough to complete.
        if sampled % 4 == 0 and len(words[cut - 1]) >= 4:
            last = words[cut - 1]
            rank_request = PromptPrefixRankRequest(
                text_before_word=" ".join(words[: cut - 1])
                + (" " if cut > 1 else ""),
                prefix=last[:3],
                project=row.project,
            )
            rank_started = time.perf_counter()
            model.rank_prefix(rank_request)
            rank_ms.append((time.perf_counter() - rank_started) * 1000.0)
    predict_ms.sort()
    ghost_ms.sort()
    rank_ms.sort()
    per_1k = (
        compile_ms / stats.rows_used * 1000.0 if stats.rows_used else 0.0
    )
    print(
        "prompt prediction bench (production predict on real history)\n"
        f"rows_total={len(rows)} rows_used={stats.rows_used} "
        f"tokens={stats.tokens} contexts={stats.contexts} "
        f"successor_entries={stats.successor_entries}\n"
        f"compile_ms={compile_ms:.1f} per_1k_ms={per_1k:.1f} "
        f"approx_mb={stats.approx_bytes / 1_048_576:.2f}\n"
        f"sampled={sampled} blocked={blocked} "
        f"confident={confident} truncated_20k={truncated}\n"
        f"predict_p50_ms={_percentile(predict_ms, 50):.3f} "
        f"predict_p95_ms={_percentile(predict_ms, 95):.3f} "
        f"predict_max_ms={max(predict_ms, default=0.0):.3f}\n"
        f"ghost_p50_ms={_percentile(ghost_ms, 50):.3f} "
        f"ghost_p95_ms={_percentile(ghost_ms, 95):.3f} "
        f"ghost_max_ms={max(ghost_ms, default=0.0):.3f}\n"
        f"rank_prefix_n={len(rank_ms)} "
        f"rank_p50_ms={_percentile(rank_ms, 50):.3f} "
        f"rank_p95_ms={_percentile(rank_ms, 95):.3f} "
        f"rank_max_ms={max(rank_ms, default=0.0):.3f}"
    )
    # Draft-length buckets: p50/p95 per bucket for the ghost-only and the
    # typing-path request. The sync threshold is the largest bucket whose
    # typing-path p95 stays within 1 ms; with no qualifying bucket the
    # smallest bucket holds.
    threshold = _BUCKETS[0]
    for cap in _BUCKETS:
        bucket_ghost[cap].sort()
        bucket_typing[cap].sort()
        typing_p95 = _percentile(bucket_typing[cap], 95)
        print(
            f"draft_bucket<={cap} "
            f"n={len(bucket_typing[cap])} "
            f"ghost_p50_ms={_percentile(bucket_ghost[cap], 50):.3f} "
            f"ghost_p95_ms={_percentile(bucket_ghost[cap], 95):.3f} "
            f"typing_p50_ms={_percentile(bucket_typing[cap], 50):.3f} "
            f"typing_p95_ms={typing_p95:.3f}"
        )
        if bucket_typing[cap] and typing_p95 <= 1.0:
            threshold = cap
    print(
        "sync_threshold recommendation: "
        f"NEXT_WORD_SYNC_MAX_DRAFT_CHARS={threshold}"
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv)
    if args.bench:
        return _run_bench(args)
    names = _check_sources(args.sources)
    resolver = build_prompt_prediction_project_resolver()
    rows = build_prompt_prediction_rows(resolve_project=resolver.resolve)
    if "archive" in names:
        # The archive joins the replay with its real epochs, so prequential
        # order treats older archived prompts as background: prompts typed
        # on one machine predict prompts typed later on another, which is
        # exactly the cross-machine value being measured. This runs the
        # archive at full weight with no singleton pruning, so it is an
        # upper bound on the production source (weight 0.25, pruned).
        rows = rows + build_archive_prediction_rows(
            history_texts=[row.text for row in rows],
        )
    if args.score_every < 1:
        print(
            f"error: --score-every must be >= 1, got {args.score_every}",
            file=sys.stderr,
        )
        raise SystemExit(2)
    options = PromptPredictionReplayOptions(
        now_epoch=int(time.time()),
        excluded_words=sorted(load_deleted_prompt_words()),
        score_every=args.score_every,
    )
    report = evaluate_prompt_prediction_replay(rows, options)
    if args.json:
        print(
            json.dumps(
                {
                    "schema_version": report.schema_version,
                    "rows_total": report.rows_total,
                    "rows_typed": report.rows_typed,
                    "rows_warmed": report.rows_warmed,
                    "rows_scored": report.rows_scored,
                    "positions_total": report.positions_total,
                    "overall_top1": report.overall_top1,
                    "overall_top3": report.overall_top3,
                    "cautious": vars(report.cautious),
                    "balanced": vars(report.balanced),
                    "eager": vars(report.eager),
                    "midword": None
                    if report.midword is None
                    else [
                        {
                            "preset": preset.preset,
                            "by_k": [vars(cell) for cell in preset.by_k],
                            "cohorts": [
                                {
                                    "cohort": cohort.cohort,
                                    "by_k": [
                                        vars(cell)
                                        for cell in cohort.by_k
                                    ],
                                }
                                for cohort in preset.cohorts
                            ],
                        }
                        for preset in report.midword
                    ],
                    "cohorts": [
                        {
                            "cohort": cohort.cohort,
                            "positions": cohort.positions,
                            "top1": cohort.top1,
                            "top3": cohort.top3,
                            "cautious": vars(cohort.cautious),
                            "balanced": vars(cohort.balanced),
                            "eager": vars(cohort.eager),
                        }
                        for cohort in report.cohorts
                    ],
                    "sweep": [vars(point) for point in report.sweep],
                    "latency_us_p50": report.latency_us_p50,
                    "latency_us_p95": report.latency_us_p95,
                    "corpus_bytes": report.corpus_bytes,
                    "corpus_rows_used": report.corpus_rows_used,
                    "corpus_contexts": report.corpus_contexts,
                },
                indent=2,
            )
        )
        return 0
    _print_tables(report, args.confidence, args.sweep)
    if args.midword:
        _print_midword_tables(report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
