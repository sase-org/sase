def _write_manifest_diff(
    expected_path: Path,
    actual_path: Path,
    *,
    artifact_dir: Path,
) -> tuple[Path | None, tuple[int, int, int, int] | None]:
    try:
        from tests.ace.tui.visual._png_diff_comparison import diff_pngs
    except Exception:
        return None, None
    try:
        _summary, diff = diff_pngs(expected_path.read_bytes(), actual_path.read_bytes())
    except Exception:
        return None, None
    target = artifact_dir / "diff.png"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(diff)
    return target, _diff_bounding_box(diff)


def _assign_update_groups(
    records: Sequence[FailureRecord],
) -> list[FailureRecord]:
    groups: dict[tuple[Any, ...], list[FailureRecord]] = defaultdict(list)
    for record in records:
        if record.kind != "updated" or record.diff_path is None:
            continue
        diff = _resolve_repo_path(record.diff_path, record.source_file)
        if diff is None or not diff.is_file():
            continue
        signature = (
            record.expected_size,
            record.actual_size,
            hashlib.sha256(diff.read_bytes()).hexdigest(),
        )
        groups[signature].append(record)
    group_ids: dict[FailureRecord, tuple[str, int]] = {}
    for index, signature in enumerate(sorted(groups, key=repr), start=1):
        members = sorted(groups[signature], key=lambda item: item.expected_repo_path)
        for member in members:
            group_ids[member] = (f"group-{index}", len(members))
    updated: list[FailureRecord] = []
    for record in records:
        group = group_ids.get(record)
        if group is None:
            updated.append(record)
        else:
            updated.append(
                replace(record, group_id=group[0], group_size=group[1])
            )
    return updated


def _write_contact_sheet(
    records: Sequence[FailureRecord],
    output_dir: Path,
    repo_root: Path,
) -> str | None:
    representatives: list[FailureRecord] = []
    seen: set[str] = set()
    for record in records:
        if record.group_id is None or record.group_id in seen:
            continue
        representatives.append(record)
        seen.add(record.group_id)
    if not representatives:
        return None
    try:
        from PIL import Image, ImageDraw
    except Exception:
        return None
    thumbs = []
    for record in representatives:
        image_path = None
        if record.diff_path is not None:
            image_path = _resolve_repo_path(record.diff_path, record.source_file)
        if image_path is None or not image_path.is_file():
            continue
        with Image.open(image_path) as image:
            thumb = image.convert("RGBA")
            thumb.thumbnail((220, 160))
            thumbs.append((record, thumb.copy()))
    if not thumbs:
        return None
    cell_w = 260
    cell_h = 205
    cols = min(3, len(thumbs))
    rows = (len(thumbs) + cols - 1) // cols
    sheet = Image.new("RGBA", (cols * cell_w, rows * cell_h), (255, 255, 255, 255))
    draw = ImageDraw.Draw(sheet)
    for index, (record, thumb) in enumerate(thumbs):
        col = index % cols
        row = index // cols
        x = col * cell_w + 20
        y = row * cell_h + 20
        sheet.alpha_composite(thumb, (x, y))
        draw.text((x, y + 165), record.group_id or "group", fill=(30, 30, 30, 255))
    target = output_dir / CONTACT_SHEET_NAME
    target.parent.mkdir(parents=True, exist_ok=True)
    sheet.convert("RGB").save(target, format="PNG")
    return _path_ref(target, repo_root)


def _manifest_report_metadata(
    manifest: dict[str, Any],
    records: Sequence[FailureRecord],
    output_dir: Path,
    repo_root: Path,
    *,
    contact_sheet_path: str | None,
) -> dict[str, Any]:
    groups: dict[str, list[FailureRecord]] = defaultdict(list)
    for record in records:
        if record.group_id is not None:
            groups[record.group_id].append(record)
    return {
        "output_dir": _path_ref(output_dir, repo_root),
        "html": _path_ref(output_dir / HTML_REPORT_NAME, repo_root),
        "summary": _path_ref(output_dir / SUMMARY_NAME, repo_root),
        "annotations": _path_ref(output_dir / ANNOTATIONS_NAME, repo_root),
        "manifest_jsonl": _path_ref(output_dir / MANIFEST_NAME, repo_root),
        "contact_sheet": contact_sheet_path,
        "record_count": len(records),
        "groups": [
            {
                "id": group_id,
                "size": len(members),
                "representative": sorted(
                    member.expected_repo_path for member in members
                )[0],
                "members": sorted(member.expected_repo_path for member in members),
                "bounding_box": (
                    list(members[0].bounding_box)
                    if members and members[0].bounding_box is not None
                    else None
                ),
            }
            for group_id, members in sorted(groups.items())
        ],
        "run_id": manifest.get("run_id"),
        "status": manifest.get("status"),
        "mode": manifest.get("mode"),
    }


def _run_summary_lines(manifest: dict[str, Any]) -> tuple[str, ...]:
    counts_raw = manifest.get("counts")
    counts: Mapping[str, Any] = counts_raw if isinstance(counts_raw, dict) else {}
    parts = [
        f"run_id: {manifest.get('run_id', '')}",
        f"mode/status: {manifest.get('mode', '')}/{manifest.get('status', '')}",
        f"scope: {manifest.get('requested_scope', '')}",
        "counts: "
        f"created={counts.get('created', 0)} "
        f"updated={counts.get('updated', 0)} "
        f"unchanged={counts.get('unchanged', 0)} "
        f"stale={counts.get('stale', 0)}",
        f"manifest: {manifest.get('manifest_path', '')}",
    ]
    dirty = manifest.get("dirty_before")
    if isinstance(dirty, list) and dirty:
        parts.append("dirty-before: " + ", ".join(str(item) for item in dirty))
    errors = manifest.get("errors")
    if isinstance(errors, list) and errors:
        parts.append("errors: " + "; ".join(str(item) for item in errors))
    return tuple(parts)


