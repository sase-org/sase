#!/usr/bin/env python3
"""Render the sase's TUI PNG visual snapshot failure report.

Consumes ``failure.json`` sidecars written by
``tests/ace/tui/visual/png_diff.py`` and produces:

* ``visual-failure-report.html`` - self-contained HTML with embedded PNG/SVG
* ``summary.md`` - compact GitHub job-summary table
* ``annotations.sh`` - shell script of escaped workflow-command annotations
* ``manifest.jsonl`` - aggregate JSONL view of all failure records
"""

from __future__ import annotations

import argparse
import base64
from collections import defaultdict
import html
import hashlib
import json
import shutil
import sys
from collections.abc import Iterable, Mapping, Sequence
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any


DEFAULT_ARTIFACT_ROOT = Path(".pytest_cache/sase-visual")
DEFAULT_OUTPUT_DIR = Path(".pytest_cache/sase-visual-report")
HTML_REPORT_NAME = "visual-failure-report.html"
SUMMARY_NAME = "summary.md"
ANNOTATIONS_NAME = "annotations.sh"
MANIFEST_NAME = "manifest.jsonl"
CONTACT_SHEET_NAME = "contact-sheet.png"
MAINTENANCE_REPORT_TITLE = "sase's TUI PNG screenshot changes"
FAILURE_REPORT_TITLE = "sase's TUI PNG snapshot failures"
MAINTENANCE_ACTIONABLE_KINDS = frozenset({"created", "updated", "stale"})


@dataclass(frozen=True)
class FailureRecord:
    """Visual report metadata loaded from a failure sidecar or run manifest."""

    node_id: str
    snapshot: str
    kind: str
    expected_repo_path: str
    actual_path: str | None
    summary_path: str | None
    test_file: str | None
    test_line: int | None
    expected_path: str | None
    diff_path: str | None
    source_svg_path: str | None
    expected_size: tuple[int, int] | None
    actual_size: tuple[int, int] | None
    changed_pixels: int | None
    total_pixels: int | None
    changed_ratio: float | None
    source_file: Path
    anchor_prefix: str = "failure"
    group_id: str | None = None
    group_size: int | None = None
    bounding_box: tuple[int, int, int, int] | None = None
    notes: tuple[str, ...] = ()

    @property
    def anchor(self) -> str:
        return f"{self.anchor_prefix}-{_slug(self.node_id)}-{_slug(self.snapshot)}"


@dataclass(frozen=True)
class RenderContext:
    """Inputs that depend on the surrounding CI environment."""

    repo: str | None
    sha: str | None
    report_url: str | None


@dataclass(frozen=True)
class ManifestReport:
    """Records plus run-level context derived from a maintenance manifest."""

    records: tuple[FailureRecord, ...]
    title: str
    empty_message: str
    run_summary: tuple[str, ...]
    contact_sheet_path: str | None
    metadata: dict[str, Any]


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Render the sase's TUI PNG visual snapshot failure report from "
            "failure.json sidecars."
        )
    )
    parser.add_argument(
        "--artifact-root",
        type=Path,
        default=DEFAULT_ARTIFACT_ROOT,
        help=(
            "Directory containing per-failure subtrees with failure.json "
            "sidecars (default: %(default)s)."
        ),
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=None,
        help=(
            "Versioned tools/fix_tui_screenshots run manifest to render. "
            "When set, failure.json sidecars are not scanned."
        ),
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=DEFAULT_OUTPUT_DIR,
        help="Directory to write report files into (default: %(default)s).",
    )
    parser.add_argument(
        "--repo",
        default=None,
        help=(
            "GitHub repository in 'owner/name' form. Used to link the "
            "committed expected golden."
        ),
    )
    parser.add_argument(
        "--sha",
        default=None,
        help="Git commit SHA to anchor expected-image blob URLs against.",
    )
    parser.add_argument(
        "--report-url",
        default=None,
        help=(
            "URL where the uploaded HTML report will be served. When "
            "provided, summary actual/diff links resolve to "
            "${report_url}#<anchor>; otherwise they are bare fragments."
        ),
    )
    parser.add_argument(
        "--repo-root",
        type=Path,
        default=None,
        help=(
            "Repository root for resolving manifest-relative paths. By default "
            "the root is inferred from the manifest run_dir."
        ),
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(list(argv) if argv is not None else sys.argv[1:])
    context = RenderContext(
        repo=args.repo, sha=args.sha, report_url=args.report_url
    )
    artifact_root: Path = args.artifact_root
    output_dir: Path = args.output_dir

    if args.manifest is not None:
        write_outputs_from_manifest(
            args.manifest,
            output_dir=output_dir,
            context=context,
            repo_root=args.repo_root,
        )
        return 0

    records = list(discover_records(artifact_root))
    write_outputs(records, output_dir=output_dir, context=context)
    return 0


def discover_records(artifact_root: Path) -> Iterable[FailureRecord]:
    """Yield ``FailureRecord`` instances under *artifact_root*."""
    if not artifact_root.exists():
        return
    for path in sorted(artifact_root.rglob("failure.json")):
        yield load_record(path)


def load_record(path: Path) -> FailureRecord:
    """Load a single ``failure.json`` sidecar into a ``FailureRecord``."""
    data: dict[str, Any] = json.loads(path.read_text())
    expected_size = _as_size(data.get("expected_size"))
    actual_size = _as_size(data.get("actual_size"))
    return FailureRecord(
        node_id=str(data["node_id"]),
        snapshot=str(data["snapshot"]),
        kind=str(data["kind"]),
        expected_repo_path=str(data["expected_repo_path"]),
        actual_path=str(data["actual_path"]),
        summary_path=str(data["summary_path"]),
        test_file=_as_optional_str(data.get("test_file")),
        test_line=_as_optional_int(data.get("test_line")),
        expected_path=_as_optional_str(data.get("expected_path")),
        diff_path=_as_optional_str(data.get("diff_path")),
        source_svg_path=_as_optional_str(data.get("source_svg_path")),
        expected_size=expected_size,
        actual_size=actual_size,
        changed_pixels=_as_optional_int(data.get("changed_pixels")),
        total_pixels=_as_optional_int(data.get("total_pixels")),
        changed_ratio=_as_optional_float(data.get("changed_ratio")),
        source_file=path,
    )


def write_outputs(
    records: Sequence[FailureRecord],
    *,
    output_dir: Path,
    context: RenderContext,
    title: str = FAILURE_REPORT_TITLE,
    empty_message: str = "No failures recorded.",
    html_empty_message: str = "No sase's TUI PNG snapshot failures were recorded.",
    run_summary: Sequence[str] = (),
    contact_sheet_path: str | None = None,
) -> None:
    """Write the four report files into *output_dir*."""
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / HTML_REPORT_NAME).write_text(
        render_html(
            records,
            context=context,
            title=title,
            empty_message=html_empty_message,
            run_summary=run_summary,
            contact_sheet_path=contact_sheet_path,
        )
    )
    (output_dir / SUMMARY_NAME).write_text(
        render_summary(
            records,
            context=context,
            title=title,
            empty_message=empty_message,
            run_summary=run_summary,
            contact_sheet_path=contact_sheet_path,
        )
    )
    (output_dir / ANNOTATIONS_NAME).write_text(
        render_annotations(records)
    )
    (output_dir / MANIFEST_NAME).write_text(
        render_manifest(records)
    )


def render_html(
    records: Sequence[FailureRecord],
    *,
    context: RenderContext,
    title: str = FAILURE_REPORT_TITLE,
    empty_message: str = "No sase's TUI PNG snapshot failures were recorded.",
    run_summary: Sequence[str] = (),
    contact_sheet_path: str | None = None,
) -> str:
    """Render the self-contained HTML report."""
    body_parts: list[str] = []
    if run_summary:
        body_parts.append(_render_run_summary_html(run_summary))
    if contact_sheet_path is not None:
        body_parts.append(_render_contact_sheet_html(contact_sheet_path, Path.cwd()))
    if not records:
        body_parts.append(f'<p class="empty">{html.escape(empty_message, quote=False)}</p>')
    else:
        body_parts.append(
            f'<p class="count">{len(records)} visual record(s).</p>'
        )
        group_summary = _render_group_summary_html(records)
        if group_summary:
            body_parts.append(group_summary)
        for record in records:
            body_parts.append(_render_html_section(record, context=context))

    body = "\n".join(body_parts)
    return _HTML_TEMPLATE.format(title=html.escape(title, quote=False), body=body)


def _render_html_section(
    record: FailureRecord,
    *,
    context: RenderContext,
) -> str:
    title = html.escape(record.snapshot)
    node = html.escape(record.node_id)
    anchor = html.escape(record.anchor)
    location = _format_location(record)
    expected_link = _format_expected_link_html(record, context=context)
    stats = _format_stats_html(record)
    group = _format_group_html(record)
    notes = _format_notes_html(record)
    bbox = _format_bbox_html(record)

    image_blocks = []
    diff_block = _image_block("diff", record.diff_path, record.source_file)
    expected_block = _image_block(
        _expected_image_label(record), record.expected_path, record.source_file
    )
    actual_block = _image_block(
        _actual_image_label(record), record.actual_path, record.source_file
    )
    if diff_block is not None:
        image_blocks.append(diff_block)
    if expected_block is not None:
        image_blocks.append(expected_block)
    if actual_block is not None:
        image_blocks.append(actual_block)
    images_html = "\n".join(image_blocks)

    svg_block = _svg_block(record)

    return (
        f'<section class="failure" id="{anchor}">\n'
        f'<h2><a href="#{anchor}">{title}</a></h2>\n'
        f'<p class="meta"><span class="kind">{html.escape(record.kind)}</span> '
        f'<span class="node">{node}</span></p>\n'
        f'{location}'
        f'{expected_link}'
        f'{stats}'
        f'{group}'
        f'{bbox}'
        f'{notes}'
        f'<div class="images">{images_html}</div>\n'
        f'{svg_block}'
        f'</section>'
    )


def _expected_image_label(record: FailureRecord) -> str:
    if record.kind == "stale":
        return "previous"
    return "expected"


def _actual_image_label(record: FailureRecord) -> str:
    if record.kind in {"created", "updated"}:
        return "candidate"
    return "actual"


def _image_block(label: str, repo_path: str | None, source_file: Path) -> str | None:
    if repo_path is None:
        return None
    data_uri = _data_uri_for(repo_path, source_file)
    if data_uri is None:
        return (
            f'<figure class="img img-{label}">'
            f'<figcaption>{html.escape(label)}</figcaption>'
            f'<p class="missing">file not found: '
            f'{html.escape(repo_path)}</p>'
            f'</figure>'
        )
    return (
        f'<figure class="img img-{label}">'
        f'<figcaption>{html.escape(label)}</figcaption>'
        f'<img alt="{html.escape(label)}" src="{data_uri}" />'
        f'</figure>'
    )


def _svg_block(record: FailureRecord) -> str:
    if record.source_svg_path is None:
        return ""
    svg_text = _read_text_or_none(record.source_svg_path, record.source_file)
    if svg_text is None:
        return (
            '<details class="svg"><summary>actual.svg</summary>'
            '<p class="missing">file not found: '
            f'{html.escape(record.source_svg_path)}</p>'
            '</details>\n'
        )
    return (
        '<details class="svg"><summary>actual.svg</summary>'
        f'<pre><code>{html.escape(svg_text)}</code></pre>'
        '</details>\n'
    )


def _format_location(record: FailureRecord) -> str:
    if record.test_file is None:
        return ""
    line = (
        f":{record.test_line}" if record.test_line is not None else ""
    )
    return (
        f'<p class="location">{html.escape(record.test_file)}{html.escape(line)}</p>\n'
    )


def _format_expected_link_html(
    record: FailureRecord,
    *,
    context: RenderContext,
) -> str:
    href = expected_blob_url(record.expected_repo_path, context)
    text = html.escape(record.expected_repo_path)
    if href is None:
        return f'<p class="expected-path">expected: {text}</p>\n'
    return (
        f'<p class="expected-path">expected: '
        f'<a href="{html.escape(href)}">{text}</a></p>\n'
    )


def _format_stats_html(record: FailureRecord) -> str:
    if record.changed_pixels is None or record.total_pixels is None:
        return ""
    ratio = record.changed_ratio if record.changed_ratio is not None else 0.0
    return (
        f'<p class="stats">changed pixels: '
        f'{record.changed_pixels}/{record.total_pixels} ({ratio:.6%})</p>\n'
    )


def _format_group_html(record: FailureRecord) -> str:
    if record.group_id is None:
        return ""
    size = f" · {record.group_size} member(s)" if record.group_size else ""
    return (
        f'<p class="group">update group: '
        f'{html.escape(record.group_id)}{html.escape(size)}</p>\n'
    )


def _format_bbox_html(record: FailureRecord) -> str:
    if record.bounding_box is None:
        return ""
    left, top, right, bottom = record.bounding_box
    return (
        '<p class="bbox">changed bounds: '
        f'x={left}..{right}, y={top}..{bottom}</p>\n'
    )


def _format_notes_html(record: FailureRecord) -> str:
    if not record.notes:
        return ""
    items = "".join(f"<li>{html.escape(note)}</li>" for note in record.notes)
    return f'<ul class="notes">{items}</ul>\n'


def _render_run_summary_html(lines: Sequence[str]) -> str:
    items = "".join(f"<li>{html.escape(line)}</li>" for line in lines)
    return f'<section class="run-summary"><h2>Run</h2><ul>{items}</ul></section>'


def _render_group_summary_html(records: Sequence[FailureRecord]) -> str:
    grouped: dict[str, list[FailureRecord]] = defaultdict(list)
    for record in records:
        if record.group_id is not None:
            grouped[record.group_id].append(record)
    if not grouped:
        return ""
    parts = ['<section class="groups"><h2>Update Groups</h2><ul>']
    for group_id in sorted(grouped):
        members = sorted(grouped[group_id], key=lambda record: record.expected_repo_path)
        representative = members[0]
        bbox = (
            ""
            if representative.bounding_box is None
            else " bounds="
            + html.escape(",".join(str(value) for value in representative.bounding_box))
        )
        parts.append(
            "<li>"
            f"{html.escape(group_id)}: {len(members)} member(s), "
            f"representative {html.escape(representative.expected_repo_path)}"
            f"{bbox}"
            "</li>"
        )
    parts.append("</ul></section>")
    return "\n".join(parts)


def _render_contact_sheet_html(repo_path: str, source_file: Path) -> str:
    data_uri = _data_uri_for(repo_path, source_file)
    if data_uri is None:
        return ""
    return (
        '<section class="contact-sheet"><h2>Representative Contact Sheet</h2>'
        f'<img alt="representative contact sheet" src="{data_uri}" />'
        '</section>'
    )


def render_summary(
    records: Sequence[FailureRecord],
    *,
    context: RenderContext,
    title: str = FAILURE_REPORT_TITLE,
    empty_message: str = "No failures recorded.",
    run_summary: Sequence[str] = (),
    contact_sheet_path: str | None = None,
) -> str:
    """Render the compact ``summary.md`` GitHub job summary."""
    lines: list[str] = [f"# {title}", ""]
    if run_summary:
        lines.extend(f"- {line}" for line in run_summary)
        lines.append("")
    if contact_sheet_path is not None:
        lines.append(f"Representative contact sheet: `{_md_text(contact_sheet_path)}`")
        lines.append("")
    if not records:
        lines.append(empty_message)
        lines.append("")
        return "\n".join(lines)

    lines.append(f"{len(records)} visual record(s).")
    lines.append("")
    lines.append(
        "| Snapshot | Kind | Test | Golden | Candidate | Diff | Group |"
    )
    lines.append(
        "| --- | --- | --- | --- | --- | --- | --- |"
    )
    for record in records:
        snapshot = _md_text(record.snapshot)
        kind = _md_text(record.kind)
        test = _format_md_test(record)
        expected = _format_md_expected(record, context=context)
        actual = _format_md_anchor_link("actual", record, context=context)
        diff = (
            _format_md_anchor_link("diff", record, context=context)
            if record.diff_path is not None
            else "—"
        )
        group = _md_text(record.group_id or "—")
        lines.append(
            f"| {snapshot} | {kind} | {test} | {expected} | {actual} | "
            f"{diff} | {group} |"
        )
    lines.append("")
    return "\n".join(lines)


def _format_md_test(record: FailureRecord) -> str:
    if record.test_file is None:
        return _md_text(record.node_id)
    if record.test_line is None:
        return f"`{_md_text(record.test_file)}`"
    return f"`{_md_text(record.test_file)}:{record.test_line}`"


def _format_md_expected(
    record: FailureRecord, *, context: RenderContext
) -> str:
    href = expected_blob_url(record.expected_repo_path, context)
    text = _md_text(record.expected_repo_path)
    if href is None:
        return f"`{text}`"
    return f"[`{text}`]({href})"


def _format_md_anchor_link(
    label: str, record: FailureRecord, *, context: RenderContext
) -> str:
    if label == "actual" and record.actual_path is None:
        return "—"
    anchor = record.anchor
    if context.report_url:
        href = f"{context.report_url}#{anchor}"
    else:
        href = f"#{anchor}"
    return f"[{label}]({href})"


def expected_blob_url(
    expected_repo_path: str, context: RenderContext
) -> str | None:
    """Build the GitHub blob URL for the committed expected golden."""
    if not context.repo or not context.sha:
        return None
    return (
        f"https://github.com/{context.repo}/blob/{context.sha}/"
        f"{expected_repo_path}"
    )


def render_annotations(records: Sequence[FailureRecord]) -> str:
    """Render the ``annotations.sh`` workflow-command script."""
    lines: list[str] = ["#!/usr/bin/env bash", "set -euo pipefail", ""]
    if not records:
        return "\n".join(lines) + "\n"
    for record in records:
        lines.append(_annotation_line(record))
    return "\n".join(lines) + "\n"


def _annotation_line(record: FailureRecord) -> str:
    properties: list[str] = []
    if record.test_file is not None:
        properties.append(f"file={_escape_property(record.test_file)}")
    if record.test_line is not None:
        properties.append(f"line={record.test_line}")
    title = _annotation_title(record)
    properties.append(f"title={_escape_property(title)}")
    message = _annotation_message(record)
    prefix = "::error " + ",".join(properties)
    return f"echo '{_shell_escape(prefix + '::' + _escape_data(message))}'"


def _annotation_title(record: FailureRecord) -> str:
    if record.kind == "created":
        return "sase's TUI PNG snapshot created"
    if record.kind == "updated":
        return "sase's TUI PNG snapshot updated"
    if record.kind == "stale":
        return "sase's TUI PNG snapshot stale"
    if record.kind == "missing_golden":
        return "sase's TUI PNG snapshot missing golden"
    return "sase's TUI PNG snapshot mismatch"


def _annotation_message(record: FailureRecord) -> str:
    parts = [f"{record.snapshot}: {record.kind}"]
    if (
        record.changed_pixels is not None
        and record.total_pixels is not None
    ):
        ratio = (
            record.changed_ratio if record.changed_ratio is not None else 0.0
        )
        parts.append(
            f"changed pixels {record.changed_pixels}/{record.total_pixels} "
            f"({ratio:.6%})"
        )
    if record.group_id is not None:
        parts.append(f"group={record.group_id}")
    parts.append(f"expected={record.expected_repo_path}")
    return " | ".join(parts)


def render_manifest(records: Sequence[FailureRecord]) -> str:
    """Render the JSONL manifest aggregating all failure records."""
    lines: list[str] = []
    for record in records:
        payload: dict[str, Any] = {
            "node_id": record.node_id,
            "snapshot": record.snapshot,
            "kind": record.kind,
            "expected_repo_path": record.expected_repo_path,
            "actual_path": record.actual_path,
            "summary_path": record.summary_path,
            "test_file": record.test_file,
            "test_line": record.test_line,
            "anchor": record.anchor,
        }
        if record.expected_path is not None:
            payload["expected_path"] = record.expected_path
        if record.diff_path is not None:
            payload["diff_path"] = record.diff_path
        if record.source_svg_path is not None:
            payload["source_svg_path"] = record.source_svg_path
        if record.expected_size is not None:
            payload["expected_size"] = list(record.expected_size)
        if record.actual_size is not None:
            payload["actual_size"] = list(record.actual_size)
        if record.changed_pixels is not None:
            payload["changed_pixels"] = record.changed_pixels
        if record.total_pixels is not None:
            payload["total_pixels"] = record.total_pixels
        if record.changed_ratio is not None:
            payload["changed_ratio"] = record.changed_ratio
        if record.group_id is not None:
            payload["group_id"] = record.group_id
        if record.group_size is not None:
            payload["group_size"] = record.group_size
        if record.bounding_box is not None:
            payload["bounding_box"] = list(record.bounding_box)
        if record.notes:
            payload["notes"] = list(record.notes)
        lines.append(json.dumps(payload, sort_keys=True))
    return "\n".join(lines) + ("\n" if lines else "")


# ---------------------------------------------------------------------------
# tools/fix_tui_screenshots manifest input
# ---------------------------------------------------------------------------


def write_outputs_from_manifest(
    manifest_path: Path,
    *,
    output_dir: Path,
    context: RenderContext,
    repo_root: Path | None = None,
) -> dict[str, Any]:
    """Write report outputs for a versioned screenshot-maintenance manifest."""
    output_dir.mkdir(parents=True, exist_ok=True)
    report = load_manifest_report(
        manifest_path,
        output_dir=output_dir,
        repo_root=repo_root,
    )
    write_outputs(
        report.records,
        output_dir=output_dir,
        context=context,
        title=report.title,
        empty_message=report.empty_message,
        html_empty_message=report.empty_message,
        run_summary=report.run_summary,
        contact_sheet_path=report.contact_sheet_path,
    )
    return report.metadata


def load_manifest_report(
    manifest_path: Path,
    *,
    output_dir: Path,
    repo_root: Path | None = None,
) -> ManifestReport:
    """Return normalized report data from a screenshot-maintenance manifest."""
    raw = json.loads(manifest_path.read_text(encoding="utf-8"))
    if not isinstance(raw, dict):
        raise ValueError(f"manifest is not an object: {manifest_path}")
    root = _repo_root_for_manifest(manifest_path, raw, repo_root)
    records = _records_from_manifest(raw, manifest_path, output_dir, root)
    records = _assign_update_groups(records)
    contact_sheet = _write_contact_sheet(records, output_dir, root)
    metadata = _manifest_report_metadata(
        raw,
        records,
        output_dir,
        root,
        contact_sheet_path=contact_sheet,
    )
    return ManifestReport(
        records=tuple(records),
        title=MAINTENANCE_REPORT_TITLE,
        empty_message="No screenshot changes recorded.",
        run_summary=_run_summary_lines(raw),
        contact_sheet_path=contact_sheet,
        metadata=metadata,
    )


def _records_from_manifest(
    manifest: dict[str, Any],
    manifest_path: Path,
    output_dir: Path,
    repo_root: Path,
) -> list[FailureRecord]:
    records: list[FailureRecord] = []
    run_dir = _manifest_path(manifest.get("run_dir"), repo_root)
    capture_dir = _manifest_path(manifest.get("capture_dir"), repo_root)
    changes = manifest.get("changes")
    if not isinstance(changes, list):
        raise ValueError("manifest changes must be a list")
    for change in changes:
        if not isinstance(change, dict):
            continue
        kind = str(change.get("kind", ""))
        if kind not in MAINTENANCE_ACTIONABLE_KINDS:
            continue
        path = str(change.get("path", ""))
        if not path:
            continue
        snapshot = str(change.get("snapshot_name") or Path(path).stem)
        node_id = _as_optional_str(change.get("node_id")) or f"{kind}:{path}"
        artifact_dir = output_dir / "images" / _slug(f"{kind}-{path}")
        expected_path = _copy_manifest_expected(
            change,
            repo_root=repo_root,
            run_dir=run_dir,
            artifact_dir=artifact_dir,
        )
        actual_path = _copy_manifest_candidate(
            change,
            capture_dir=capture_dir,
            artifact_dir=artifact_dir,
        )
        source_svg_path = _copy_manifest_svg(
            change,
            capture_dir=capture_dir,
            artifact_dir=artifact_dir,
        )
        diff_path = None
        bounding_box = None
        notes = list(_notes_for_change(kind))
        if kind == "updated" and expected_path is not None and actual_path is not None:
            diff_path, bounding_box = _write_manifest_diff(
                expected_path,
                actual_path,
                artifact_dir=artifact_dir,
            )
            if diff_path is None:
                notes.append("diff image unavailable")
        records.append(
            FailureRecord(
                node_id=node_id,
                snapshot=snapshot,
                kind=kind,
                expected_repo_path=path,
                actual_path=_path_ref(actual_path, repo_root),
                summary_path=None,
                test_file=_as_optional_str(change.get("test_file"))
                or _as_optional_str(change.get("source_file")),
                test_line=_as_optional_int(change.get("test_line"))
                or _as_optional_int(change.get("source_line")),
                expected_path=_path_ref(expected_path, repo_root),
                diff_path=_path_ref(diff_path, repo_root),
                source_svg_path=_path_ref(source_svg_path, repo_root),
                expected_size=_size_from_change(change, "baseline"),
                actual_size=_size_from_change(change, "candidate"),
                changed_pixels=_as_optional_int(change.get("changed_pixels")),
                total_pixels=_as_optional_int(change.get("total_pixels")),
                changed_ratio=_ratio_from_change(change),
                source_file=manifest_path,
                anchor_prefix="change",
                bounding_box=bounding_box,
                notes=tuple(notes),
            )
        )
    return records


def _copy_manifest_expected(
    change: dict[str, Any],
    *,
    repo_root: Path,
    run_dir: Path,
    artifact_dir: Path,
) -> Path | None:
    kind = str(change.get("kind", ""))
    if kind not in {"updated", "stale"}:
        return None
    relative = str(change.get("path", ""))
    candidates = [run_dir / "baseline" / relative, repo_root / relative]
    source = next((path for path in candidates if path.is_file()), None)
    if source is None:
        return None
    target = artifact_dir / "expected.png"
    _copy_file(source, target)
    return target


def _copy_manifest_candidate(
    change: dict[str, Any],
    *,
    capture_dir: Path,
    artifact_dir: Path,
) -> Path | None:
    relpath = _as_optional_str(change.get("candidate_png_relpath"))
    if relpath is None:
        return None
    source = capture_dir / relpath
    if not source.is_file():
        return None
    target = artifact_dir / "actual.png"
    _copy_file(source, target)
    return target


def _copy_manifest_svg(
