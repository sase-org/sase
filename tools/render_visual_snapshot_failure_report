def _data_uri_for(repo_path: str, source_file: Path) -> str | None:
    target = _resolve_repo_path(repo_path, source_file)
    if target is None or not target.exists():
        return None
    encoded = base64.b64encode(target.read_bytes()).decode("ascii")
    return f"data:image/png;base64,{encoded}"


def _read_text_or_none(repo_path: str, source_file: Path) -> str | None:
    target = _resolve_repo_path(repo_path, source_file)
    if target is None or not target.exists():
        return None
    return target.read_text()


def _repo_root_for_manifest(
    manifest_path: Path,
    manifest: dict[str, Any],
    repo_root: Path | None,
) -> Path:
    if repo_root is not None:
        return repo_root.resolve()
    run_dir = manifest.get("run_dir")
    if isinstance(run_dir, str) and run_dir:
        parts = Path(run_dir).parts
        parent = manifest_path.resolve().parent
        if len(parts) <= len(parent.parts):
            try:
                return parent.parents[len(parts) - 1]
            except IndexError:
                pass
    return Path.cwd().resolve()


def _manifest_path(value: Any, repo_root: Path) -> Path:
    if not isinstance(value, str) or not value:
        return repo_root
    path = Path(value)
    return path if path.is_absolute() else repo_root / path


def _path_ref(path: Path | None, repo_root: Path) -> str | None:
    if path is None:
        return None
    try:
        return path.resolve().relative_to(repo_root.resolve()).as_posix()
    except ValueError:
        return path.as_posix()


def _copy_file(source: Path, target: Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)


def _notes_for_change(kind: str) -> tuple[str, ...]:
    if kind == "created":
        return ("no baseline image existed at run start",)
    if kind == "stale":
        return ("no producing assertion was captured in the full inventory",)
    return ()


def _size_from_change(change: dict[str, Any], prefix: str) -> tuple[int, int] | None:
    width = _as_optional_int(change.get(f"{prefix}_width"))
    height = _as_optional_int(change.get(f"{prefix}_height"))
    if width is None or height is None:
        return None
    return width, height


def _ratio_from_change(change: dict[str, Any]) -> float | None:
    changed = _as_optional_int(change.get("changed_pixels"))
    total = _as_optional_int(change.get("total_pixels"))
    if changed is None or total is None or total == 0:
        return None
    return changed / total


def _diff_bounding_box(diff_png: bytes) -> tuple[int, int, int, int] | None:
    try:
        from io import BytesIO

        from PIL import Image
    except Exception:
        return None
    try:
        with Image.open(BytesIO(diff_png)) as image:
            alpha = image.convert("RGBA").getchannel("A")
            bbox = alpha.getbbox()
    except Exception:
        return None
    if bbox is None:
        return None
    left, top, right, bottom = bbox
    return left, top, right - 1, bottom - 1


def _resolve_repo_path(repo_path: str, source_file: Path) -> Path | None:
    """Locate the on-disk file referenced by *repo_path*.

    Records store paths relative to the repo root, but the renderer may
    be pointed at an arbitrary artifact tree. We try the path as-is and
    then walk upward from the sidecar location to find a matching root.
    """
    candidate = Path(repo_path)
    if candidate.is_absolute() and candidate.exists():
        return candidate
    cwd_candidate = Path.cwd() / candidate
    if cwd_candidate.exists():
        return cwd_candidate
    parent = source_file.parent
    while True:
        guess = parent / candidate
        if guess.exists():
            return guess
        if parent.parent == parent:
            return None
        parent = parent.parent


def _slug(value: str) -> str:
    chars = [char if char.isalnum() or char in "._-" else "_" for char in value]
    slug = "".join(chars).strip("._-")
    return slug or "snapshot"


def _as_size(value: Any) -> tuple[int, int] | None:
    if value is None:
        return None
    if not isinstance(value, list) or len(value) != 2:
        return None
    return int(value[0]), int(value[1])


def _as_optional_str(value: Any) -> str | None:
    return None if value is None else str(value)


def _as_optional_int(value: Any) -> int | None:
    return None if value is None else int(value)


def _as_optional_float(value: Any) -> float | None:
    return None if value is None else float(value)


def _md_text(value: str) -> str:
    return value.replace("|", r"\|").replace("\n", " ")


def _escape_property(value: str) -> str:
    return (
        value.replace("%", "%25")
        .replace("\r", "%0D")
        .replace("\n", "%0A")
        .replace(":", "%3A")
        .replace(",", "%2C")
    )


def _escape_data(value: str) -> str:
    return (
        value.replace("%", "%25")
        .replace("\r", "%0D")
        .replace("\n", "%0A")
    )


def _shell_escape(value: str) -> str:
    return value.replace("'", "'\\''")


