def _error(message: str) -> None:
    print(f"[validate_sase_core_rs] {message}", file=sys.stderr)


def _load_extension() -> ModuleType | None:
    try:
        return importlib.import_module("sase_core_rs")
    except Exception as exc:
        _error(f"cannot import sase_core_rs: {exc}")
        return None


def _validate_bindings(module: ModuleType) -> bool:
    missing = [
        name for name in REQUIRED_BINDINGS if not callable(getattr(module, name, None))
    ]
    if missing:
        _error("missing required binding(s): " + ", ".join(missing))
        return False
    return True


def _validate_artifact_ref_schemas(module: ModuleType) -> bool:
    expected = {
        "artifact_ref_wire_schema_version": 5,
        "artifact_ref_context_wire_schema_version": 2,
        "artifact_ref_list_resolution_wire_schema_version": 2,
        "artifact_ref_path_filter_wire_schema_version": 1,
        "artifact_ref_file_index_wire_schema_version": 1,
    }
    valid = True
    for binding_name, expected_version in expected.items():
        try:
            actual_version = int(getattr(module, binding_name)())
        except Exception as exc:
            _error(f"{binding_name}() probe failed: {exc}")
            valid = False
            continue
        if actual_version != expected_version:
            _error(
                f"{binding_name}() returned stale schema: "
                f"got {actual_version}, expected {expected_version}"
            )
            valid = False
    return valid


