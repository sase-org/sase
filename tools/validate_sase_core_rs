def _error(message: str) -> None:
    print(f"[validate_sase_core_rs] {message}", file=sys.stderr)


def _load_extension() -> ModuleType | None:
    try:
        return importlib.import_module("sase_core_rs")
    except Exception as exc:
        _error(f"cannot import sase_core_rs: {exc}")
        return None


def _validate_bindings(module: ModuleType) -> bool:
    missing = [
        name for name in REQUIRED_BINDINGS if not callable(getattr(module, name, None))
    ]
    if missing:
        _error("missing required binding(s): " + ", ".join(missing))
        return False
    return True


def _scan_probe_options() -> dict[str, Any]:
    return {
        "include_prompt_step_markers": False,
        "include_raw_prompt_snippets": False,
        "max_prompt_snippet_bytes": 200,
        "only_workflow_dirs": [],
    }


def _validate_scalar_plan_timestamp(module: ModuleType) -> bool:
    timestamp = "2026-04-27T11:05:00Z"
    artifact_timestamp = "20260427110500"
    with tempfile.TemporaryDirectory(prefix="sase-core-rs-probe-") as tmp:
        projects_root = Path(tmp) / "projects"
        project_dir = projects_root / "probe"
        artifact_dir = project_dir / "artifacts" / "ace-run" / artifact_timestamp
        artifact_dir.mkdir(parents=True)
        (project_dir / "probe.sase").write_text("", encoding="utf-8")
        (artifact_dir / "agent_meta.json").write_text(
            json.dumps(
                {
                    "name": "probe",
                    "plan": True,
                    "plan_submitted_at": timestamp,
                }
            ),
            encoding="utf-8",
        )

        try:
            snapshot = module.scan_agent_artifacts(
                str(projects_root),
                _scan_probe_options(),
            )
        except Exception as exc:
            _error(f"scan_agent_artifacts probe failed: {exc}")
            return False

    if not isinstance(snapshot, dict):
        _error("scan_agent_artifacts probe returned a non-dict payload")
        return False
    if snapshot.get("schema_version") != 4:
        _error(
            "scan_agent_artifacts probe returned stale schema: "
            f"got {snapshot.get('schema_version')!r}, expected 4"
        )
        return False

    records = snapshot.get("records")
    if not isinstance(records, list):
        _error("scan_agent_artifacts probe payload has no records list")
        return False

    matches = [
        r
        for r in records
        if isinstance(r, dict) and r.get("timestamp") == artifact_timestamp
    ]
    if len(matches) != 1:
        _error(
            "scan_agent_artifacts probe did not return exactly one record "
            f"for timestamp {artifact_timestamp}"
        )
        return False

    agent_meta = matches[0].get("agent_meta")
    if not isinstance(agent_meta, dict):
        _error("scan_agent_artifacts probe record has no agent_meta dict")
        return False

    actual = agent_meta.get("plan_submitted_at")
    if actual != [timestamp]:
        _error(
            "scan_agent_artifacts probe did not normalize scalar "
            f"plan_submitted_at to a list: got {actual!r}"
        )
        return False

    return True


def _validate_agent_stats_work_schema(module: ModuleType) -> bool:
    with tempfile.TemporaryDirectory(prefix="sase-core-rs-stats-probe-") as tmp:
        root = Path(tmp)
        projects_root = root / "projects"
        projects_root.mkdir()
        index_path = root / "agent_artifact_index.sqlite"
        try:
            module.rebuild_agent_artifact_index(
                str(index_path),
                str(projects_root),
                _scan_probe_options(),
            )
            payload = module.agent_stats_query_runs(
                str(index_path),
                {
                    "start_ts": 1,
                    "end_ts": 2,
                    "runtime_group_by": "project",
                    "project": None,
                    "work_top_n": 1,
                },
            )
        except Exception as exc:
            _error(f"agent statistics work-schema probe failed: {exc}")
            return False

    if not isinstance(payload, dict):
        _error("agent statistics work-schema probe returned a non-dict payload")
        return False
    if payload.get("schema_version") != 5:
        _error(
            "agent statistics work-schema probe requires schema version 5: "
            f"got {payload.get('schema_version')!r}"
        )
        return False
    work = payload.get("work")
    if not isinstance(work, dict):
        _error("agent statistics work-schema probe payload has no work dict")
        return False
    if not isinstance(work.get("projects"), list) or not isinstance(
        work.get("changespecs"), list
    ):
        _error("agent statistics work-schema probe payload has invalid work rows")
        return False
    xprompts = payload.get("xprompts")
    if not isinstance(xprompts, dict) or not isinstance(xprompts.get("rows"), list):
        _error("agent statistics xprompt-schema probe payload has invalid xprompts")
        return False
    runners = payload.get("runners")
    runner_counters = (
        "lanes_counted",
        "lanes_without_end_skipped",
        "user_hidden_skipped",
    )
    if not isinstance(runners, dict) or any(
        not isinstance(runners.get(field), int) for field in runner_counters
    ):
        _error("agent statistics runner-schema probe payload has invalid counters")
        return False
    return True


def _validate_saved_group_wire_fields(module: ModuleType) -> bool:
    payload = {
        "schema_version": 2,
        "group_id": "wire-probe",
        "created_at": "2026-05-27T12:00:00Z",
        "source": "marked_agents",
        "title": "1 agent in cl",
        "name": "Probe group",
        "agent_count": 1,
        "top_level_agent_count": 1,
        "status_counts": {"DONE": 1},
        "project_names": ["proj"],
        "cl_names": ["cl"],
        "agent_refs": [
            {
                "agent_type": "run",
                "cl_name": "cl",
                "raw_suffix": "ts-1",
                "tribe": "backend",
            }
        ],
    }
    with tempfile.TemporaryDirectory(prefix="sase-core-rs-group-probe-") as tmp:
        try:
            saved = module.save_dismissed_agent_group(tmp, payload)
            page = module.list_dismissed_agent_groups(tmp, 20, None)
            loaded = module.load_dismissed_agent_group(tmp, "wire-probe")
            revived = module.mark_dismissed_agent_group_revived(
                tmp, "wire-probe", "2026-05-27T13:00:00Z"
            )
        except Exception as exc:
            _error(f"saved-group archive probe failed: {exc}")
            return False

    records = [saved, loaded, revived]
    if not all(isinstance(record, dict) for record in records):
        _error("saved-group archive probe returned a non-dict record")
        return False
    if not isinstance(page, dict) or not isinstance(page.get("groups"), list):
        _error("saved-group archive list probe returned an invalid page")
        return False
    page_groups = page["groups"]
    if not all(isinstance(record, dict) for record in page_groups):
        _error("saved-group archive list probe returned a non-dict summary")
        return False
    records.extend(page_groups)
    for record in records:
        if record.get("name") != "Probe group":
            _error(
                "saved-group archive probe did not preserve group name: "
                f"got {record.get('name')!r}"
            )
            return False
    refs = loaded.get("agent_refs") if isinstance(loaded, dict) else None
    first_ref = refs[0] if isinstance(refs, list) and refs else None
    if (
        not isinstance(first_ref, dict)
        or first_ref.get("tribe") != "backend"
        or "tag" in first_ref
    ):
        _error(
            "saved-group archive probe did not preserve canonical agent ref tribe: "
            f"got {first_ref!r}"
        )
        return False
    return True


def _validate_project_lifecycle_contract(module: ModuleType) -> bool:
    lifecycle = module.read_project_lifecycle_from_content(
        "PROJECT_STATE: disabled\nNAME: demo\n"
    )
    if not isinstance(lifecycle, dict):
        _error("project lifecycle probe returned a non-dict payload")
        return False
    if lifecycle.get("state") != "disabled" or lifecycle.get("explicit") is not True:
        _error(
            "project lifecycle probe did not accept canonical disabled state: "
            f"got {lifecycle!r}"
        )
        return False

    updated = module.apply_project_lifecycle_update(
        "WORKSPACE_DIR: /tmp\nNAME: demo\n",
        "disabled",
    )
    if updated != "WORKSPACE_DIR: /tmp\nPROJECT_STATE: disabled\nNAME: demo\n":
        _error(
            "project lifecycle update probe did not write canonical disabled "
            f"state: got {updated!r}"
        )
        return False

    aliases_updated = module.apply_project_aliases_update(
        "WORKSPACE_DIR: /tmp\nRUNNING:\n\nNAME: demo\n",
        ["docs", "bob"],
    )
    if (
        aliases_updated
        != "WORKSPACE_DIR: /tmp\nPROJECT_ALIASES: bob, docs\nRUNNING:\n\nNAME: demo\n"
    ):
        _error(
            "project alias update probe did not write canonical aliases: "
            f"got {aliases_updated!r}"
        )
        return False

    with tempfile.TemporaryDirectory(prefix="sase-core-rs-lifecycle-probe-") as tmp:
        root = Path(tmp)
        projects_root = root / "projects"
        enabled_workspace = root / "enabled-workspace"
        disabled_workspace = root / "disabled-workspace"
        enabled_workspace.mkdir()
        disabled_workspace.mkdir()

        enabled_dir = projects_root / "enabled"
        disabled_dir = projects_root / "disabled"
        enabled_dir.mkdir(parents=True)
        disabled_dir.mkdir(parents=True)
        (enabled_dir / "enabled.sase").write_text(
            "PROJECT_ALIASES: bob, docs\n"
            "BARE_REPO_DIR: /tmp/enabled.git\n"
            f"WORKSPACE_DIR: {enabled_workspace}\n"
            "NAME: enabled\n",
            encoding="utf-8",
        )
        (disabled_dir / "disabled.sase").write_text(
            f"PROJECT_STATE: disabled\nWORKSPACE_DIR: {disabled_workspace}\n"
            "NAME: disabled\n",
            encoding="utf-8",
        )
        (projects_root / "telemetry-only").mkdir()

        records = module.list_project_records(
            str(projects_root), ["enabled"], False, True
        )

    if not isinstance(records, list):
        _error("project lifecycle record probe returned a non-list payload")
        return False
    project_names = [
        record.get("project_name") for record in records if isinstance(record, dict)
    ]
    if project_names != ["enabled"]:
        _error(
            "project lifecycle record probe did not filter non-project/disabled records: "
            f"got {project_names!r}"
        )
        return False
    first_record = records[0] if records and isinstance(records[0], dict) else None
    aliases = first_record.get("aliases") if isinstance(first_record, dict) else None
    if aliases != ["bob", "docs"]:
        _error(
            f"project lifecycle record probe did not preserve aliases: got {aliases!r}"
        )
        return False
    if first_record.get("is_project") is not True:
        _error("project lifecycle record probe did not classify a true project")
        return False
    if first_record.get("vcs_kind") != "git":
        _error(
            "project lifecycle record probe did not derive git vcs_kind: "
            f"got {first_record.get('vcs_kind')!r}"
        )
        return False

    return True


def _load_version_validator() -> ModuleType:
    """Load `tools/validate_sase_core_rs_version` to reuse its specifier parsing.

    That script has no `.py` suffix, so it cannot be `import`-ed normally.
    """
    script = Path(__file__).resolve().with_name("validate_sase_core_rs_version")
    loader = SourceFileLoader("validate_sase_core_rs_version_lib", str(script))
    spec = importlib.util.spec_from_file_location(
        "validate_sase_core_rs_version_lib", script, loader=loader
    )
    assert spec is not None
    assert spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _validate_installed_version(
    *,
    pyproject: Path,
    sase_core_dir: Path | None,
) -> bool:
    version_validator = _load_version_validator()
    try:
        installed_raw = importlib.metadata.version(DISTRIBUTION_NAME)
    except importlib.metadata.PackageNotFoundError:
        _error(f"{DISTRIBUTION_NAME} is not installed")
        return False

    try:
        installed = version_validator._parse_version(
            installed_raw, "installed sase-core-rs distribution"
        )
        specifier = version_validator._read_dependency_specifier(pyproject)
        minimum = version_validator._inclusive_minimum(
            version_validator._parse_specifier(specifier)
        )
    except version_validator.ValidationError as exc:
        _error(str(exc))
        return False

    if version_validator._compare_versions(installed, minimum) < 0:
        _error(
            f"installed {DISTRIBUTION_NAME} distribution version {installed.raw} is "
            f"behind sase's {DISTRIBUTION_NAME}{specifier} floor in {pyproject}. "
            "Rebuild the extension: run `just install`."
        )
        return False

    if sase_core_dir is not None and (sase_core_dir / "Cargo.toml").is_file():
        try:
            source_version = version_validator._read_source_version(sase_core_dir)
        except version_validator.ValidationError as exc:
            _error(str(exc))
            return False
        if version_validator._compare_versions(installed, source_version) != 0:
            _error(
                f"installed {DISTRIBUTION_NAME} distribution version {installed.raw} "
                f"disagrees with the {sase_core_dir / 'Cargo.toml'} checkout version "
                f"{source_version.raw}; the checkout moved and the extension was not "
                "rebuilt. Run `just install`."
            )
            return False

    return True


def _parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--sase-core-dir",
        type=Path,
        default=None,
        help=(
            "path to a local sase-core checkout; when given and it has a "
            "Cargo.toml, also fail if the installed sase-core-rs distribution "
            "version disagrees with the checkout's [workspace.package] version"
        ),
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    namespace = _parse_args(argv)
    if not _validate_installed_version(
        pyproject=DEFAULT_PYPROJECT, sase_core_dir=namespace.sase_core_dir
    ):
        return 1
    module = _load_extension()
    if module is None:
        return 1
    if not _validate_bindings(module):
        return 1
    if not _validate_scalar_plan_timestamp(module):
        return 1
    if not _validate_agent_stats_work_schema(module):
        return 1
    if not _validate_saved_group_wire_fields(module):
        return 1
    if not _validate_project_lifecycle_contract(module):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
