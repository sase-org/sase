#!/usr/bin/env python3
"""Validate that the installed ``sase_core_rs`` wheel matches this checkout.

Limitation: the installed-version check below can only catch *release-boundary*
skew. Between core releases the Cargo workspace version does not move, so a
checkout advanced to an unreleased core commit still reads as the same version
and this check will not notice. Bead ``sase-bh`` hit exactly that blind spot
from the other side and concluded that version metadata cannot distinguish
the two cores; feature detection has to probe behavior instead. That remains
true here too — this check does not replace the binding-name and wire-schema
probes below it, it only catches the skew a version number *can* see.
"""

from __future__ import annotations

