def _proc_from_outcome(outcome: Any, binding_name: str) -> dict[str, Any] | None:
    if not isinstance(outcome, dict):
        _error(f"{binding_name} probe returned a non-dict payload")
        return None
    if outcome.get("schema_version") != 3:
        _error(
            f"{binding_name} probe returned stale schema: "
            f"got {outcome.get('schema_version')!r}, expected 3"
        )
        return None
    proc = outcome.get("proc")
    if not isinstance(proc, dict):
        _error(f"{binding_name} probe payload has no proc dict")
        return None
    if proc.get("schema_version") != 3:
        _error(
            f"{binding_name} probe returned stale proc schema: "
            f"got {proc.get('schema_version')!r}, expected 3"
        )
        return None
    return proc


def _expect_proc_fields(
    proc: dict[str, Any], binding_name: str, expected: dict[str, Any]
) -> bool:
    mismatches = [
        f"{name}={proc.get(name)!r} (expected {value!r})"
        for name, value in expected.items()
        if proc.get(name) != value
    ]
    if mismatches:
        _error(
            f"{binding_name} probe returned stale proc fields: " + "; ".join(mismatches)
        )
        return False
    return True


def _call_proc_lifecycle_binding(
    module: ModuleType, binding_name: str, *args: Any
) -> Any | None:
    binding = getattr(module, binding_name, None)
    if not callable(binding):
        _error(f"{binding_name} binding missing; cannot probe proc lifecycle")
        return None
    try:
        return binding(*args)
    except Exception as exc:
        _error(f"{binding_name} probe failed: {exc}")
        return None


def _validate_proc_lifecycle_contract(module: ModuleType) -> bool:
    """Exercise the schema-v3 proc-shell lifecycle used by the Python service."""
    with tempfile.TemporaryDirectory(
        prefix="sase-core-rs-proc-lifecycle-probe-"
    ) as tmp:
        store = Path(tmp) / "procs.jsonl"
        reserve = _call_proc_lifecycle_binding(
            module,
            "reserve_proc",
            str(store),
            _proc_lifecycle_probe_reserve(),
            10,
        )
        proc = _proc_from_outcome(reserve, "reserve_proc")
        if proc is None or not isinstance(reserve, dict):
            return False
        valid = True
        if reserve.get("reserved") is not True or reserve.get("replayed") is not False:
            _error(
                "reserve_proc probe did not report a fresh reservation: "
                f"reserved={reserve.get('reserved')!r}, replayed={reserve.get('replayed')!r}"
            )
            valid = False
        valid &= _expect_proc_fields(
            proc,
            "reserve_proc",
            {
                "status": "pending",
                "phase": "reserved",
                "lifecycle": "proc-shell",
                "reserved_by": "validate_sase_core_rs",
                "reserved_at": "2026-08-15T00:00:00Z",
                "request_fingerprint": "validator-fingerprint",
            },
        )

        claim = _call_proc_lifecycle_binding(
            module,
            "claim_proc_supervisor",
            str(store),
            {
                "proc_id": "validator-proc",
                "supervisor_id": "validator-supervisor",
                "claimed_at": "2026-08-15T00:00:01Z",
                "pid": 123,
                "pgid": 123,
            },
        )
        proc = _proc_from_outcome(claim, "claim_proc_supervisor")
        if proc is None or not isinstance(claim, dict):
            return False
        valid &= claim.get("matched") is True
        valid &= _expect_proc_fields(
            proc,
            "claim_proc_supervisor",
            {
                "status": "running",
                "started_at": "2026-08-15T00:00:01Z",
                "supervisor_id": "validator-supervisor",
                "supervisor_claimed_at": "2026-08-15T00:00:01Z",
                "pid": 123,
                "pgid": 123,
            },
        )

        stop = _call_proc_lifecycle_binding(
            module,
            "request_proc_stop",
            str(store),
            {
                "proc_id": "validator-proc",
                "requested_by": "validate_sase_core_rs",
                "requested_at": "2026-08-15T00:00:02Z",
                "reason": "probe",
            },
        )
        proc = _proc_from_outcome(stop, "request_proc_stop")
        if proc is None or not isinstance(stop, dict):
            return False
        valid &= stop.get("matched") is True
        valid &= _expect_proc_fields(
            proc,
            "request_proc_stop",
            {
                "status": "running",
                "stop_requested_by": "validate_sase_core_rs",
                "stop_requested_at": "2026-08-15T00:00:02Z",
                "stop_reason": "probe",
            },
        )

        settlement = _call_proc_lifecycle_binding(
            module,
            "begin_proc_settlement",
            str(store),
            {
                "proc_id": "validator-proc",
                "supervisor_id": "validator-supervisor",
                "settling_at": "2026-08-15T00:00:03Z",
                "exit_code": 0,
                "message": "settling",
            },
        )
        proc = _proc_from_outcome(settlement, "begin_proc_settlement")
        if proc is None or not isinstance(settlement, dict):
            return False
        valid &= settlement.get("matched") is True
        valid &= _expect_proc_fields(
            proc,
            "begin_proc_settlement",
            {
                "status": "settling",
                "exit_code": 0,
                "message": "settling",
                "settling_started_at": "2026-08-15T00:00:03Z",
            },
        )

        finish = _call_proc_lifecycle_binding(
            module,
            "finish_proc",
            str(store),
            {
                "proc_id": "validator-proc",
                "supervisor_id": "validator-supervisor",
                "status": "success",
                "finished_at": "2026-08-15T00:00:04Z",
                "exit_code": 0,
                "message": "done",
                "result": {"ok": True},
            },
        )
        proc = _proc_from_outcome(finish, "finish_proc")
        if proc is None or not isinstance(finish, dict):
            return False
        valid &= finish.get("matched") is True
        valid &= _expect_proc_fields(
            proc,
            "finish_proc",
            {
                "status": "success",
                "finished_at": "2026-08-15T00:00:04Z",
                "finished_by": "validator-supervisor",
                "settled_at": "2026-08-15T00:00:04Z",
                "settled_by": "validator-supervisor",
                "result": {"ok": True},
            },
        )
    return valid


_CONFIG_SCHEMA_PATH = REPO_ROOT / "src" / "sase" / "config" / "sase.schema.json"

# Minimal valid ``inhibit_if`` payload per guard provider the bundled schema
# advertises. Adding a provider to the schema without adding it here fails
# `_validate_axe_chop_guard_providers` instead of silently skipping it.
AXE_CHOP_GUARD_PROVIDER_PAYLOADS: dict[str, dict[str, Any]] = {
    "patch": {"name_prefix": "x"},
    # Legacy alias retained for the ``patch`` provider.
    "changespec": {"name_prefix": "x"},
    "agent_hood": {"hood": "h"},
    "agent_clan": {"name_prefix": "x"},
    "agent_runners": {"max": 0},
}


def _collect_inhibit_if_providers(node: Any, *, in_inhibit_if: bool) -> set[str]:
    """Recursively collect every ``provider`` enum value under ``inhibit_if``."""
    providers: set[str] = set()
    if isinstance(node, dict):
        for key, value in node.items():
            nested = in_inhibit_if or key == "inhibit_if"
            if in_inhibit_if and key == "provider" and isinstance(value, dict):
                enum_values = value.get("enum")
                if isinstance(enum_values, list):
                    providers.update(v for v in enum_values if isinstance(v, str))
            providers |= _collect_inhibit_if_providers(value, in_inhibit_if=nested)
    elif isinstance(node, list):
        for item in node:
            providers |= _collect_inhibit_if_providers(
                item, in_inhibit_if=in_inhibit_if
            )
    return providers


def _axe_chop_guard_providers(schema_path: Path) -> list[str] | None:
    """Return the sorted ``inhibit_if`` guard providers the schema advertises."""
    try:
        schema = json.loads(schema_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        _error(f"could not read bundled config schema at {schema_path}: {exc}")
        return None
    providers = _collect_inhibit_if_providers(schema, in_inhibit_if=False)
    if not providers:
        _error(f"found no inhibit_if guard providers in {schema_path}")
        return None
    return sorted(providers)


def _axe_chop_guard_request(
    provider: str, payload: dict[str, Any], schema_version: int
) -> dict[str, Any]:
    return {
        "schema_version": schema_version,
        "config": {
            "axe": {
                "lumberjacks": {
                    "probe": {
                        "interval": 60,
                        "description": "probe",
                        "chops": [
                            {
                                "name": "probe",
                                "description": "probe",
                                "inhibit_if": {provider: payload},
                            }
                        ],
                    }
                }
            }
        },
        "provenance": {},
        "require_descriptions": False,
        "require_description_shape": False,
    }


def _validate_provider_disable_first_writer(module: ModuleType) -> bool:
    """Prove the installed wheel's try-set is a real first-writer, not a replace.

    A binding-name check is not enough: an older wheel could grow the symbol
    while still replacing an active record, which would re-extend expiry and
    notify every losing caller. The probe writes, loses, then replaces only
    after expiry.
    """
    try_relative = getattr(module, "provider_disable_try_set_relative", None)
    try_until = getattr(module, "provider_disable_try_set_until", None)
    get_snapshot = getattr(module, "provider_disable_get", None)
    if (
        not callable(try_relative)
        or not callable(try_until)
        or not callable(get_snapshot)
    ):
        _error("provider-disable first-writer bindings missing; cannot probe")
        return False

    now = 1_800_000_000.0
    with tempfile.TemporaryDirectory(prefix="sase-core-rs-provider-disable-probe-") as tmp:
        try:
            first = try_relative(tmp, "claude", "usage_limit", duration_seconds=900.0, now=now)
            sibling = try_until(tmp, "codex", now + 1_200.0, "test", now=now)
            lost = try_until(tmp, "claude", now + 3_600.0, "ace", now=now)
            snapshot = get_snapshot(tmp, now)
            expired = try_relative(
                tmp, "claude", "usage_limit", duration_seconds=60.0, now=now + 900.0
            )
        except Exception as exc:
            _error(f"provider-disable first-writer probe failed: {exc}")
            return False

    if not _expect_provider_disable_outcome(
        first,
        inserted=True,
        provider="claude",
        source="usage_limit",
        created_at=now,
        expires_at=now + 900.0,
        label="first relative write",
    ):
        return False
    if not _expect_provider_disable_outcome(
        sibling,
        inserted=True,
        provider="codex",
        source="test",
        created_at=now,
        expires_at=now + 1_200.0,
        label="unrelated until write",
    ):
        return False
    if not _expect_provider_disable_outcome(
        lost,
        inserted=False,
        provider="claude",
        source="usage_limit",
        created_at=now,
        expires_at=now + 900.0,
        label="losing until write",
    ):
        return False
    if not isinstance(snapshot, dict) or snapshot.get("version") != 2:
        _error(f"provider-disable snapshot probe returned stale payload: {snapshot!r}")
        return False
    disables = snapshot.get("disables")
    if not isinstance(disables, list) or [
        record.get("provider") if isinstance(record, dict) else None for record in disables
    ] != ["claude", "codex"]:
        _error(
            "provider-disable snapshot probe did not preserve both records: "
            f"{disables!r}"
        )
        return False
    return _expect_provider_disable_outcome(
        expired,
        inserted=True,
        provider="claude",
        source="usage_limit",
        created_at=now + 900.0,
        expires_at=now + 960.0,
        label="expired-record replacement",
    )


def _expect_provider_disable_outcome(
    payload: object,
    *,
    inserted: bool,
    provider: str,
    source: str,
    created_at: float,
    expires_at: float,
    label: str,
    mode: str = "hard",
) -> bool:
    if not isinstance(payload, dict):
        _error(f"provider-disable {label} probe returned a non-dict payload")
        return False
    if payload.get("version") != 2:
        _error(
            f"provider-disable {label} probe returned stale outcome version: "
            f"{payload.get('version')!r}"
        )
        return False
    if payload.get("inserted") is not inserted:
        _error(
            f"provider-disable {label} probe inserted={payload.get('inserted')!r}, "
            f"expected {inserted!r}"
        )
        return False
    record = payload.get("record")
    if not isinstance(record, dict):
        _error(f"provider-disable {label} probe payload has no record dict")
        return False
    expected = {
        "version": 2,
        "provider": provider,
        "created_at": created_at,
        "expires_at": expires_at,
        "source": source,
        "mode": mode,
    }
    mismatches = [
        f"{name}={record.get(name)!r} (expected {value!r})"
        for name, value in expected.items()
        if record.get(name) != value
    ]
    if mismatches:
        _error(
            f"provider-disable {label} probe returned stale record fields: "
            + "; ".join(mismatches)
        )
        return False
    return True


def _validate_axe_chop_guard_providers(
    module: ModuleType, *, schema_path: Path = _CONFIG_SCHEMA_PATH
) -> bool:
    """Fail when the installed core rejects a guard provider this build advertises.

    Config validation gaining a new guard provider (``crates/sase_core/src/
    axe_chop/config.rs``) is a *behavioral* capability: the binding name and the
    Cargo version are unchanged, so only calling the validator with each
    advertised provider can tell an old core from a new one.
    """
    providers = _axe_chop_guard_providers(schema_path)
    if providers is None:
        return False

    uncovered = [
        name for name in providers if name not in AXE_CHOP_GUARD_PROVIDER_PAYLOADS
    ]
    if uncovered:
        _error(
            "bundled schema advertises inhibit_if guard provider(s) with no "
            "probe payload: " + ", ".join(sorted(uncovered))
        )
        return False

    validate_axe_config = getattr(module, "validate_axe_config", None)
    schema_version_fn = getattr(module, "chop_engine_schema_version", None)
    if not callable(validate_axe_config) or not callable(schema_version_fn):
        _error(
            "[axe-chop-guard] validate_axe_config/chop_engine_schema_version "
            "binding missing; cannot probe guard providers"
        )
        return False

    try:
        schema_version = int(schema_version_fn())
    except Exception as exc:
        _error(f"chop_engine_schema_version() probe failed: {exc}")
        return False

    valid = True
    for provider in providers:
        payload = AXE_CHOP_GUARD_PROVIDER_PAYLOADS[provider]
        request = _axe_chop_guard_request(provider, payload, schema_version)
        try:
            diagnostics = validate_axe_config(request)
        except Exception as exc:
            _error(f"[axe-chop-guard] {provider}(...) probe failed: {exc}")
            valid = False
            continue
        if diagnostics:
            _error(
                f"[axe-chop-guard] {provider}(...) rejected by the installed "
                f"core: {diagnostics!r}"
            )
            valid = False
    return valid


def _load_version_validator() -> ModuleType:
    """Load `tools/validate_sase_core_rs_version` to reuse its specifier parsing.

    That script has no `.py` suffix, so it cannot be `import`-ed normally.
    """
    script = Path(__file__).resolve().with_name("validate_sase_core_rs_version")
    loader = SourceFileLoader("validate_sase_core_rs_version_lib", str(script))
    spec = importlib.util.spec_from_file_location(
        "validate_sase_core_rs_version_lib", script, loader=loader
    )
    assert spec is not None
    assert spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _validate_installed_version(
    *,
    pyproject: Path,
    sase_core_dir: Path | None,
) -> bool:
    version_validator = _load_version_validator()
    try:
        installed_raw = importlib.metadata.version(DISTRIBUTION_NAME)
    except importlib.metadata.PackageNotFoundError:
        _error(f"{DISTRIBUTION_NAME} is not installed")
        return False

    try:
        installed = version_validator._parse_version(
            installed_raw, "installed sase-core-rs distribution"
        )
        specifier = version_validator._read_dependency_specifier(pyproject)
        minimum = version_validator._inclusive_minimum(
            version_validator._parse_specifier(specifier)
        )
    except version_validator.ValidationError as exc:
        _error(str(exc))
        return False

    if version_validator._compare_versions(installed, minimum) < 0:
        _error(
            f"installed {DISTRIBUTION_NAME} distribution version {installed.raw} is "
            f"behind sase's {DISTRIBUTION_NAME}{specifier} floor in {pyproject}. "
            "Rebuild the extension: run `just install`."
        )
        return False

    if sase_core_dir is not None and (sase_core_dir / "Cargo.toml").is_file():
        try:
            source_version = version_validator._read_source_version(sase_core_dir)
        except version_validator.ValidationError as exc:
            _error(str(exc))
            return False
        if version_validator._compare_versions(installed, source_version) != 0:
            _error(
                f"installed {DISTRIBUTION_NAME} distribution version {installed.raw} "
                f"disagrees with the {sase_core_dir / 'Cargo.toml'} checkout version "
                f"{source_version.raw}; the checkout moved and the extension was not "
                "rebuilt. Run `just install`."
            )
            return False

    return True


def _parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--sase-core-dir",
        type=Path,
        default=None,
        help=(
            "path to a local sase-core checkout; when given and it has a "
            "Cargo.toml, also fail if the installed sase-core-rs distribution "
            "version disagrees with the checkout's [workspace.package] version"
        ),
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    namespace = _parse_args(argv)
    if not _validate_installed_version(
        pyproject=DEFAULT_PYPROJECT, sase_core_dir=namespace.sase_core_dir
    ):
        return 1
    module = _load_extension()
    if module is None:
        return 1
    if not _validate_bindings(module):
        return 1
    if not _validate_artifact_ref_schemas(module):
        return 1
    if not _validate_artifact_link_schema(module):
        return 1
    if not _validate_vcs_log_wire_schema(module):
        return 1
    if not _validate_skill_reference_contract(module):
        return 1
    if not _validate_scalar_plan_timestamp(module):
        return 1
    if not _validate_agent_alias_history_schema(module):
        return 1
    if not _validate_agent_stats_work_schema(module):
        return 1
    if not _validate_saved_group_wire_fields(module):
        return 1
    if not _validate_project_lifecycle_contract(module):
        return 1
    if not _validate_proc_lifecycle_contract(module):
        return 1
    if not _validate_axe_chop_guard_providers(module):
        return 1
    if not _validate_provider_disable_first_writer(module):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
