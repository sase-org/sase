#!/usr/bin/env python3
"""Host-local cache for clean ``sase-core`` build artifacts.

The cache holds both the release wheel used by ``rust-install`` and the
``sase-xprompt-lsp`` binary used by ``rust-lsp-install``.  Entries are content
addressed and include the artifact kind, so both artifacts can share pruning,
root discovery, and per-identity build locks safely.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from collections.abc import Iterator, Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any


CACHE_SCHEMA_VERSION = 2
DEFAULT_MAX_BYTES = 4 * 1024 * 1024 * 1024
DEFAULT_MAX_ENTRIES = 12
DEFAULT_LOCK_TIMEOUT_SECONDS = 15 * 60
MISS_EXIT = 1

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _sase_core_source_identity import INPUT_PATHS  # noqa: E402


class CacheUnavailable(RuntimeError):
    """Raised when this checkout cannot safely use the wheel cache."""


@dataclass(frozen=True)
class CacheIdentity:
    digest: str
    payload: dict[str, Any]


@dataclass(frozen=True)
class CacheEntry:
    digest: str
    path: Path
    size: int
    last_used: float


def _default_cache_root() -> Path:
    configured = os.environ.get("SASE_CORE_ARTIFACT_CACHE_DIR") or os.environ.get(
        "SASE_CORE_WHEEL_CACHE_DIR"
    )
    if configured:
        return Path(configured).expanduser()
    return Path.home() / ".sase" / "cache" / "sase-core-artifacts"


def _env_int(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        parsed = int(raw)
    except ValueError:
        return default
    return parsed if parsed > 0 else default


def _env_float(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        parsed = float(raw)
    except ValueError:
        return default
    return parsed if parsed > 0 else default


def _run_text(
    command: Sequence[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    timeout: float = 60.0,
) -> str:
    completed = subprocess.run(
        list(command),
        cwd=cwd,
        env=env,
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    if completed.returncode != 0:
        command_text = " ".join(command)
        detail = completed.stderr.strip() or completed.stdout.strip()
        raise CacheUnavailable(f"{command_text} failed: {detail}")
    return completed.stdout


def _run_bytes(command: Sequence[str], *, cwd: Path, timeout: float = 60.0) -> bytes:
    completed = subprocess.run(
        list(command),
        cwd=cwd,
        check=False,
        capture_output=True,
        timeout=timeout,
    )
    if completed.returncode != 0:
        command_text = " ".join(command)
        detail = completed.stderr.decode(errors="replace").strip()
        raise CacheUnavailable(f"{command_text} failed: {detail}")
    return completed.stdout


def _git(core_dir: Path, *args: str) -> str:
    return _run_text(("git", "-C", str(core_dir), *args), timeout=30.0)


def _ensure_clean_git_checkout(core_dir: Path) -> None:
    inside = _git(core_dir, "rev-parse", "--is-inside-work-tree").strip()
    if inside != "true":
        raise CacheUnavailable("sase-core directory is not a git worktree")

    dirty = _git(
        core_dir,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
    )
    dirty_lines = [
        line
        for line in dirty.splitlines()
        if not line.startswith("?? target/")
    ]
    if dirty_lines:
        raise CacheUnavailable("sase-core checkout is dirty")

    upstream = subprocess.run(
        ["git", "-C", str(core_dir), "rev-parse", "--abbrev-ref", "@{upstream}"],
        check=False,
        capture_output=True,
        text=True,
        timeout=30.0,
    )
    if upstream.returncode != 0:
        return

    counts = _git(core_dir, "rev-list", "--left-right", "--count", "HEAD...@{upstream}")
    parts = counts.split()
    if len(parts) != 2:
        raise CacheUnavailable("could not compute sase-core upstream divergence")
    ahead, behind = (int(parts[0]), int(parts[1]))
    if ahead or behind:
        raise CacheUnavailable("sase-core checkout is ahead or behind its upstream")


def _crate_input_digest(core_dir: Path) -> str:
    output = _run_bytes(
        (
            "git",
            "-C",
            str(core_dir),
            "ls-tree",
            "-r",
            "--full-tree",
            "-z",
            "HEAD",
            "--",
            *INPUT_PATHS,
        ),
        cwd=core_dir,
        timeout=30.0,
    )
    paths: list[str] = []
    for record in output.split(b"\0"):
        if not record or b"\t" not in record:
            continue
        paths.append(record.split(b"\t", 1)[1].decode(errors="replace"))
    if not any(path.startswith("crates/sase_core_py/") for path in paths):
        raise CacheUnavailable("sase-core checkout has no crates/sase_core_py tree")
    return hashlib.sha256(output).hexdigest()


def _python_abi(python: Path) -> dict[str, Any]:
    script = """
import json
import platform
import sys
import sysconfig

print(json.dumps({
    "abiflags": getattr(sys, "abiflags", ""),
    "cache_tag": sys.implementation.cache_tag,
    "ext_suffix": sysconfig.get_config_var("EXT_SUFFIX") or "",
    "implementation": platform.python_implementation(),
    "platform": sysconfig.get_platform(),
    "soabi": sysconfig.get_config_var("SOABI") or "",
    "version": list(sys.version_info[:3]),
}, sort_keys=True))
"""
    raw = _run_text((str(python), "-c", script), timeout=15.0)
    loaded = json.loads(raw)
    if not isinstance(loaded, dict):
        raise CacheUnavailable("target Python ABI probe returned invalid JSON")
    return loaded


def _rustc_details(rustc: str) -> tuple[str, str]:
    rustc_version = _run_text((rustc, "-vV"), timeout=15.0).strip()
    for line in rustc_version.splitlines():
        if line.startswith("host: "):
            return rustc_version, line.removeprefix("host: ")
    raise CacheUnavailable("rustc -vV did not report a host target triple")


def _cache_identity(
    *,
    core_dir: Path,
    python: Path,
    rustc: str,
    artifact_kind: str,
    profile: str,
) -> CacheIdentity:
    core_dir = core_dir.resolve()
    _ensure_clean_git_checkout(core_dir)
    commit = _git(core_dir, "rev-parse", "HEAD").strip()
    rustc_version, target_triple = _rustc_details(rustc)
    payload: dict[str, Any] = {
        "schema_version": CACHE_SCHEMA_VERSION,
        "artifact_kind": artifact_kind,
        "cargo_profile": profile,
        "sase_core_commit": commit,
        "dirty_state": "clean",
        "rustc": rustc_version,
        "target_triple": target_triple,
        "sase_core_py_inputs": _crate_input_digest(core_dir),
    }
    if artifact_kind == "wheel":
        payload["python_abi"] = _python_abi(python)
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return CacheIdentity(
        digest=hashlib.sha256(encoded).hexdigest(),
        payload=payload,
    )


def _entry_dir(cache_root: Path, digest: str) -> Path:
    return cache_root / digest


def _metadata_path(entry_dir: Path) -> Path:
    return entry_dir / "metadata.json"


def _read_json(path: Path) -> dict[str, Any] | None:
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    return loaded if isinstance(loaded, dict) else None


def _write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(payload, sort_keys=True, indent=2) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary, path)


def _wheel_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while chunk := stream.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def _cached_artifact(
    cache_root: Path,
    identity: CacheIdentity,
    *,
    artifact_kind: str,
) -> Path | None:
    entry_dir = _entry_dir(cache_root, identity.digest)
    metadata = _read_json(_metadata_path(entry_dir))
    if metadata is None:
        return None
    if metadata.get("schema_version") != CACHE_SCHEMA_VERSION:
        return None
    if metadata.get("key_digest") != identity.digest:
        return None
    if metadata.get("key") != identity.payload:
        return None
    if metadata.get("artifact_kind") != artifact_kind:
        return None
    artifact_filename = metadata.get("artifact_filename")
    if (
        not isinstance(artifact_filename, str)
        or Path(artifact_filename).name != artifact_filename
    ):
        return None
    artifact = entry_dir / artifact_filename
    if not artifact.is_file():
        return None
    metadata["last_used"] = time.time()
    try:
        _write_json_atomic(_metadata_path(entry_dir), metadata)
    except OSError:
        pass
    return artifact


def lookup_cache(
    *,
    cache_root: Path,
    core_dir: Path,
    python: Path,
    rustc: str,
    artifact_kind: str,
    profile: str,
) -> Path | None:
    identity = _cache_identity(
        core_dir=core_dir,
        python=python,
        rustc=rustc,
        artifact_kind=artifact_kind,
        profile=profile,
    )
    return _cached_artifact(cache_root, identity, artifact_kind=artifact_kind)


def _venv_from_python(python: Path) -> Path | None:
    if python.name != "python":
        return None
    if python.parent.name not in {"bin", "Scripts"}:
        return None
    return python.parent.parent


def _run_maturin_build(
    *,
    core_dir: Path,
    python: Path,
    maturin: Path,
    out_dir: Path,
) -> Path:
    env = os.environ.copy()
    env.setdefault("PYO3_USE_ABI3_FORWARD_COMPATIBILITY", "1")
    env.setdefault("CARGO_NET_RETRY", "10")
    env.setdefault("CARGO_HTTP_MULTIPLEXING", "false")
    venv = _venv_from_python(python)
    if venv is not None:
        env["VIRTUAL_ENV"] = str(venv)

    crate_dir = core_dir / "crates" / "sase_core_py"
    completed = subprocess.run(
        [
            str(maturin),
            "build",
            "--release",
            "--out",
            str(out_dir),
            "--interpreter",
            str(python),
        ],
        cwd=crate_dir,
        env=env,
        check=False,
        text=True,
    )
    if completed.returncode != 0:
        raise CacheUnavailable(f"maturin build failed with exit {completed.returncode}")

    wheels = sorted(out_dir.glob("*.whl"))
    if len(wheels) != 1:
        raise CacheUnavailable(
            f"maturin build produced {len(wheels)} wheels; expected exactly one"
        )
    return wheels[0]


def _directory_size(path: Path) -> int:
    total = 0
    for candidate in path.rglob("*"):
        if candidate.is_file():
            try:
                total += candidate.stat().st_size
            except OSError:
                continue
    return total


def _cache_entries(cache_root: Path) -> list[CacheEntry]:
    entries: list[CacheEntry] = []
    if not cache_root.is_dir():
        return entries
    for child in cache_root.iterdir():
        if not child.is_dir() or child.name.startswith("."):
            continue
        metadata = _read_json(_metadata_path(child)) or {}
        last_used = metadata.get("last_used")
        if not isinstance(last_used, int | float):
            try:
                last_used = child.stat().st_mtime
            except OSError:
                last_used = 0.0
        entries.append(
            CacheEntry(
                digest=child.name,
                path=child,
                size=_directory_size(child),
                last_used=float(last_used),
            )
        )
    return entries


@contextlib.contextmanager
def _identity_lock(
    cache_root: Path,
    identity: CacheIdentity,
    *,
    timeout_seconds: float,
) -> Iterator[bool]:
    """Hold a bounded exclusive ``flock`` for a single artifact identity.

    A timeout deliberately yields ``False`` instead of failing.  The caller can
    build without the lock rather than making setup permanently unavailable if
    a crashed process leaves an unexpectedly long-running holder.
    """
    lock_dir = cache_root / ".locks"
    lock_dir.mkdir(parents=True, exist_ok=True)
    lock_path = lock_dir / f"{identity.digest}.lock"
    with lock_path.open("a+") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(
                "[sase-core-wheel-cache] Waiting for the shared build lock "
                f"for {identity.digest[:12]} (up to {timeout_seconds:.0f}s).",
                file=sys.stderr,
            )
            deadline = time.monotonic() + timeout_seconds
            while True:
                try:
                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        print(
                            "[sase-core-wheel-cache] Shared build lock timed out; "
                            "building without it.",
                            file=sys.stderr,
                        )
                        yield False
                        return
                    time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))
        try:
            yield True
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def prune_cache(
    cache_root: Path,
    *,
    keep_digest: str | None = None,
    max_entries: int,
    max_bytes: int,
) -> None:
    entries = sorted(_cache_entries(cache_root), key=lambda entry: entry.last_used)
    keep: set[str] = set()
    used_bytes = 0

    newest_first = list(reversed(entries))
    for entry in newest_first:
        if entry.digest == keep_digest:
            keep.add(entry.digest)
            used_bytes += entry.size
            break

    for entry in newest_first:
        if entry.digest in keep:
            continue
        if len(keep) >= max_entries:
            continue
        if used_bytes + entry.size > max_bytes:
            continue
        keep.add(entry.digest)
        used_bytes += entry.size

    for entry in entries:
        if entry.digest in keep:
            continue
        shutil.rmtree(entry.path, ignore_errors=True)


def _copy_into_cache(
    *,
    cache_root: Path,
    identity: CacheIdentity,
    artifact: Path,
    artifact_kind: str,
    max_entries: int,
    max_bytes: int,
) -> Path:
    entry_dir = _entry_dir(cache_root, identity.digest)
    entry_dir.mkdir(parents=True, exist_ok=True)
    final_artifact = entry_dir / artifact.name
    temporary = entry_dir / f".{artifact.name}.{os.getpid()}.tmp"
    shutil.copy2(artifact, temporary)
    os.replace(temporary, final_artifact)
    metadata = {
        "schema_version": CACHE_SCHEMA_VERSION,
        "artifact_kind": artifact_kind,
        "created_at": time.time(),
        "last_used": time.time(),
        "key_digest": identity.digest,
        "key": identity.payload,
        "artifact_filename": artifact.name,
        "artifact_sha256": _wheel_sha256(final_artifact),
        "artifact_size": final_artifact.stat().st_size,
    }
    _write_json_atomic(_metadata_path(entry_dir), metadata)
    for stale_artifact in entry_dir.iterdir():
        if stale_artifact in {final_artifact, _metadata_path(entry_dir)}:
            continue
        if stale_artifact.is_file():
            stale_artifact.unlink(missing_ok=True)
    prune_cache(
        cache_root,
        keep_digest=identity.digest,
        max_entries=max_entries,
        max_bytes=max_bytes,
    )
    return final_artifact


def _run_lsp_build(*, core_dir: Path, target_dir: Path, profile: str, cargo: str) -> Path:
    env = os.environ.copy()
    env["CARGO_TARGET_DIR"] = str(target_dir)
    env["CARGO_BUILD_BUILD_DIR"] = str(target_dir / "build")
    env["CARGO_INCREMENTAL"] = "0"
    env.setdefault("CARGO_NET_RETRY", "10")
    env.setdefault("CARGO_HTTP_MULTIPLEXING", "false")
    completed = subprocess.run(
        [cargo, "build", "--profile", profile, "-p", "sase_xprompt_lsp"],
        cwd=core_dir,
        env=env,
        check=False,
        text=True,
    )
    if completed.returncode != 0:
        raise CacheUnavailable(f"cargo build failed with exit {completed.returncode}")
    artifact = target_dir / profile / "sase-xprompt-lsp"
    if not artifact.is_file():
        raise CacheUnavailable(f"cargo build did not produce {artifact}")
    shutil.rmtree(target_dir / "build" / profile / "incremental", ignore_errors=True)
    shutil.rmtree(target_dir / profile / "incremental", ignore_errors=True)
    return artifact


def store_cache(
    *,
    cache_root: Path,
    core_dir: Path,
    python: Path,
    rustc: str,
    artifact_kind: str,
    profile: str,
    maturin: Path | None,
    cargo: str,
    cargo_target_dir: Path | None,
    max_entries: int,
    max_bytes: int,
) -> Path:
    identity = _cache_identity(
        core_dir=core_dir,
        python=python,
        rustc=rustc,
        artifact_kind=artifact_kind,
        profile=profile,
    )
    cache_root.mkdir(parents=True, exist_ok=True)
    timeout_seconds = _env_float(
        "SASE_CORE_ARTIFACT_CACHE_LOCK_TIMEOUT_SECONDS",
        DEFAULT_LOCK_TIMEOUT_SECONDS,
    )
    with _identity_lock(
        cache_root, identity, timeout_seconds=timeout_seconds
    ) as acquired_lock:
        if acquired_lock:
            cached = _cached_artifact(
                cache_root, identity, artifact_kind=artifact_kind
            )
            if cached is not None:
                return cached

        if artifact_kind == "wheel":
            if maturin is None:
                raise CacheUnavailable("--maturin is required for wheel cache stores")
            with tempfile.TemporaryDirectory(prefix=".build-", dir=cache_root) as raw_tmp_dir:
                artifact = _run_maturin_build(
                    core_dir=core_dir.resolve(),
                    python=python,
                    maturin=maturin,
                    out_dir=Path(raw_tmp_dir),
                )
                rebuilt_identity = _cache_identity(
                    core_dir=core_dir,
                    python=python,
                    rustc=rustc,
                    artifact_kind=artifact_kind,
                    profile=profile,
                )
                if rebuilt_identity != identity:
                    raise CacheUnavailable("sase-core inputs changed while building the wheel")
                return _copy_into_cache(
                    cache_root=cache_root,
                    identity=identity,
                    artifact=artifact,
                    artifact_kind=artifact_kind,
                    max_entries=max_entries,
                    max_bytes=max_bytes,
                )

        if cargo_target_dir is None:
            raise CacheUnavailable("--cargo-target-dir is required for lsp cache stores")
        artifact = _run_lsp_build(
            core_dir=core_dir.resolve(),
            target_dir=cargo_target_dir,
            profile=profile,
            cargo=cargo,
        )
        rebuilt_identity = _cache_identity(
            core_dir=core_dir,
            python=python,
            rustc=rustc,
            artifact_kind=artifact_kind,
            profile=profile,
        )
        if rebuilt_identity != identity:
            raise CacheUnavailable("sase-core inputs changed while building the LSP")
        return _copy_into_cache(
            cache_root=cache_root,
            identity=identity,
            artifact=artifact,
            artifact_kind=artifact_kind,
            max_entries=max_entries,
            max_bytes=max_bytes,
        )


def _positive_int(raw: str) -> int:
    parsed = int(raw)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return parsed


def _add_common_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--sase-core-dir", type=Path, required=True)
    parser.add_argument("--python", type=Path, required=True)
    parser.add_argument("--cache-dir", type=Path, default=_default_cache_root())
    parser.add_argument("--rustc", default="rustc")
    parser.add_argument("--kind", choices=("wheel", "lsp"), default="wheel")
    parser.add_argument("--profile", default="release")


def _parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    key_parser = subparsers.add_parser("key", help="print the cache key")
    _add_common_arguments(key_parser)
    key_parser.add_argument("--json", action="store_true")

    lookup_parser = subparsers.add_parser("lookup", help="print a cached wheel path")
    _add_common_arguments(lookup_parser)

    store_parser = subparsers.add_parser("store", help="build and store a wheel")
    _add_common_arguments(store_parser)
    store_parser.add_argument("--maturin", type=Path)
    store_parser.add_argument("--cargo", default="cargo")
    store_parser.add_argument("--cargo-target-dir", type=Path)
    store_parser.add_argument(
        "--max-entries",
        type=_positive_int,
        default=_env_int("SASE_CORE_WHEEL_CACHE_MAX_ENTRIES", DEFAULT_MAX_ENTRIES),
    )
    store_parser.add_argument(
        "--max-bytes",
        type=_positive_int,
        default=_env_int("SASE_CORE_WHEEL_CACHE_MAX_BYTES", DEFAULT_MAX_BYTES),
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    namespace = _parse_args(argv)
    try:
        if namespace.command == "key":
            identity = _cache_identity(
                core_dir=namespace.sase_core_dir,
                python=namespace.python,
                rustc=namespace.rustc,
                artifact_kind=namespace.kind,
                profile=namespace.profile,
            )
            if namespace.json:
                print(
                    json.dumps(
                        {"key_digest": identity.digest, "key": identity.payload},
                        sort_keys=True,
                    )
                )
            else:
                print(identity.digest)
            return 0
        if namespace.command == "lookup":
            wheel = lookup_cache(
                cache_root=namespace.cache_dir,
                core_dir=namespace.sase_core_dir,
                python=namespace.python,
                rustc=namespace.rustc,
                artifact_kind=namespace.kind,
                profile=namespace.profile,
            )
            if wheel is None:
                print("[sase-core-wheel-cache] miss: no exact cached wheel", file=sys.stderr)
                return MISS_EXIT
            print(wheel)
            return 0
        if namespace.command == "store":
            wheel = store_cache(
                cache_root=namespace.cache_dir,
                core_dir=namespace.sase_core_dir,
                python=namespace.python,
                maturin=namespace.maturin,
                rustc=namespace.rustc,
                artifact_kind=namespace.kind,
                profile=namespace.profile,
                cargo=namespace.cargo,
                cargo_target_dir=namespace.cargo_target_dir,
                max_entries=namespace.max_entries,
                max_bytes=namespace.max_bytes,
            )
            print(wheel)
            return 0
    except CacheUnavailable as exc:
        print(f"[sase-core-wheel-cache] miss: {exc}", file=sys.stderr)
        return MISS_EXIT
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
