#!/usr/bin/env python3
"""Run a pytest soak and verify the production bead store is unchanged."""

from __future__ import annotations

import argparse
import hashlib
import os
import subprocess
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_COMMAND = ("just", "test")
PLANS_DIR_ENV_VAR = "SASE_SDD_PLANS_DIR"


@dataclass(frozen=True)
class _Snapshot:
    issues_digest: str
    head: str
    status: str


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Run the test suite and fail if the production plans sidecar bead "
            "store moves."
        )
    )
    parser.add_argument(
        "--plans-dir",
        type=Path,
        default=None,
        help=(
            "Plans sidecar directory to guard. Defaults to "
            "SASE_SDD_PLANS_DIR, then `sase repo path plans`, then "
            "sase/repos/plans under this checkout."
        ),
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="Optional command to run after `--`; defaults to `just test`.",
    )
    args = parser.parse_args(argv)

    command = _normalize_command(args.command)
    plans_dir = _resolve_plans_dir(args.plans_dir)
    beads_dir = plans_dir / "beads"
    issues_path = beads_dir / "issues.jsonl"

    if not issues_path.is_file():
        print(
            f"error: production bead issues file is missing: {issues_path}",
            file=sys.stderr,
        )
        return 2

    before = _snapshot(plans_dir, issues_path)
    print(f"[bead-store-soak] guarding {issues_path}", flush=True)
    print(f"[bead-store-soak] sidecar HEAD before: {before.head}", flush=True)
    print(
        f"[bead-store-soak] issues.jsonl sha256 before: {before.issues_digest}",
        flush=True,
    )
    if before.status:
        print(
            "[bead-store-soak] refusing to start because bead state is already "
            "dirty:\n"
            f"{before.status}",
            file=sys.stderr,
        )
        return 1

    completed = subprocess.run(command, cwd=REPO_ROOT, check=False)
    after = _snapshot(plans_dir, issues_path)
    failures = _snapshot_failures(before, after)

    if failures:
        print(
            "[bead-store-soak] production bead store changed during the suite:",
            file=sys.stderr,
        )
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        return 1

    print("[bead-store-soak] production bead store remained unchanged")
    return completed.returncode


def _normalize_command(command: Sequence[str]) -> list[str]:
    if not command:
        return list(DEFAULT_COMMAND)
    if command[0] == "--":
        command = command[1:]
    if not command:
        return list(DEFAULT_COMMAND)
    return list(command)


def _resolve_plans_dir(explicit: Path | None) -> Path:
    if explicit is not None:
        return explicit.expanduser().resolve()

    from_env = os.environ.get(PLANS_DIR_ENV_VAR, "").strip()
    if from_env:
        return Path(from_env).expanduser().resolve()

    workspace_sidecar = REPO_ROOT / "sase" / "repos" / "plans"
    if workspace_sidecar.exists():
        return workspace_sidecar.resolve()

    command_result = subprocess.run(
        ["sase", "repo", "path", "plans"],
        cwd=REPO_ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    if command_result.returncode == 0:
        path = command_result.stdout.strip().splitlines()[-1]
        if path:
            return Path(path).expanduser().resolve()

    return workspace_sidecar.resolve()


def _snapshot(plans_dir: Path, issues_path: Path) -> _Snapshot:
    return _Snapshot(
        issues_digest=_sha256_file(issues_path),
        head=_git(plans_dir, "rev-parse", "HEAD").strip(),
        status=_git(plans_dir, "status", "--porcelain", "--", "beads").strip(),
    )


def _snapshot_failures(before: _Snapshot, after: _Snapshot) -> list[str]:
    failures: list[str] = []
    if after.issues_digest != before.issues_digest:
        failures.append(
            "beads/issues.jsonl digest moved: "
            f"{before.issues_digest} -> {after.issues_digest}"
        )
    if after.head != before.head:
        failures.append(f"plans sidecar HEAD moved: {before.head} -> {after.head}")
    if after.status != before.status:
        detail = after.status or "<clean>"
        failures.append(f"bead-state git status changed:\n{detail}")
    return failures


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while chunk := stream.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def _git(cwd: Path, *args: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(cwd), *args],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        command = " ".join(("git", "-C", str(cwd), *args))
        raise RuntimeError(
            f"{command} failed with exit code {result.returncode}:\n"
            f"{result.stderr.strip()}"
        )
    return result.stdout


if __name__ == "__main__":
    raise SystemExit(main())
