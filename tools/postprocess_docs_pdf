#!/usr/bin/env python3
"""Add metadata and outlines to the generated SASE handbook PDF."""

from __future__ import annotations

import re
import sys
from argparse import ArgumentParser, Namespace
from dataclasses import dataclass
from html.parser import HTMLParser
from pathlib import Path
from typing import Any

import yaml
from pypdf import PdfReader, PdfWriter


DEFAULT_SITE_DIR = Path("site")
MKDOCS_CONFIG = Path("mkdocs.yml")
IMAGE_JPEG_QUALITY = 95

METADATA = {
    "/Title": "SASE Handbook",
    "/Author": "SASE contributors",
    "/Subject": "Structured Agentic Software Engineering",
    "/Keywords": (
        "SASE, agentic software engineering, coding agents, workflows"
    ),
    "/Creator": "tools/postprocess_docs_pdf",
}


@dataclass(frozen=True)
class Heading:
    level: int
    text: str


@dataclass(frozen=True)
class Chapter:
    number: int
    nav_title: str
    source_path: str
    html_path: Path
    pdf_path: Path
    headings: tuple[Heading, ...]

    @property
    def title(self) -> str:
        for heading in self.headings:
            if heading.level == 1:
                return heading.text
        return self.nav_title


class _HeadingParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._current_level: int | None = None
        self._parts: list[str] = []
        self.headings: list[Heading] = []

    def handle_starttag(
        self, tag: str, attrs: list[tuple[str, str | None]]
    ) -> None:
        if tag in {"h1", "h2", "h3"}:
            self._current_level = int(tag[1])
            self._parts = []

    def handle_data(self, data: str) -> None:
        if self._current_level is not None:
            self._parts.append(data)

    def handle_endtag(self, tag: str) -> None:
        if self._current_level is None or tag != f"h{self._current_level}":
            return

        text = _clean_text(" ".join(self._parts))
        if text:
            self.headings.append(Heading(self._current_level, text))
        self._current_level = None
        self._parts = []


def _error(message: str) -> None:
    print(f"[postprocess_docs_pdf] {message}", file=sys.stderr)


def _clean_text(text: str) -> str:
    return re.sub(r"\s+", " ", text.replace("¶", " ")).strip()


def _normalize(text: str) -> str:
    return _clean_text(text).casefold()


def _compact(text: str) -> str:
    return re.sub(r"\s+", "", _normalize(text))


def _flatten_nav(items: list[Any]) -> list[tuple[str, str]]:
    pages: list[tuple[str, str]] = []

    for item in items:
        if isinstance(item, dict):
            for title, value in item.items():
                if isinstance(value, str) and value.endswith(".md"):
                    pages.append((str(title), value))
                elif isinstance(value, list):
                    pages.extend(_flatten_nav(value))
        elif isinstance(item, str) and item.endswith(".md"):
            pages.append((Path(item).stem.replace("_", " ").title(), item))

    return pages


def _site_path_for(site_dir: Path, source_path: str, suffix: str) -> Path:
    source = Path(source_path)
    if source.name == "index.md":
        relative = source.parent / f"index{suffix}"
    else:
        relative = source.with_suffix("") / f"index{suffix}"
    return site_dir / relative


def _headings_from_html(path: Path) -> tuple[Heading, ...]:
    parser = _HeadingParser()
    parser.feed(path.read_text(encoding="utf-8"))
    return tuple(parser.headings)


def _load_chapters(site_dir: Path) -> list[Chapter]:
    config = yaml.safe_load(MKDOCS_CONFIG.read_text(encoding="utf-8"))
    nav_pages = _flatten_nav(config["nav"])
    chapters: list[Chapter] = []

    for index, (nav_title, source_path) in enumerate(nav_pages, start=1):
        html_path = _site_path_for(site_dir, source_path, ".html")
        pdf_path = _site_path_for(site_dir, source_path, ".pdf")
        if not html_path.exists():
            raise FileNotFoundError(f"missing generated HTML: {html_path}")
        if not pdf_path.exists():
            raise FileNotFoundError(f"missing generated PDF: {pdf_path}")
        chapters.append(
            Chapter(
                number=index,
                nav_title=nav_title,
                source_path=source_path,
                html_path=html_path,
                pdf_path=pdf_path,
                headings=_headings_from_html(html_path),
            )
        )

    return chapters


def _extract_page_text(reader: PdfReader) -> list[str]:
    text: list[str] = []
    for page in reader.pages:
        text.append(_normalize(page.extract_text() or ""))
    return text


def _find_page(
    page_text: list[str],
    needle: str,
    *,
    start: int,
    stop: int | None = None,
) -> int | None:
    normalized = _normalize(needle)
    compact = _compact(needle)
    if not normalized:
        return None

    end = stop if stop is not None else len(page_text)
    for index in range(start, end):
        page = page_text[index]
        if normalized in page or compact in _compact(page):
            return index
    return None


_RUNNING_HEADER_RE = re.compile(r"^sase handbook\s+", re.IGNORECASE)
_LEADING_NUMBER_RE = re.compile(r"^\d+\s+")


def _find_chapter_start_page(
    page_text: list[str],
    title: str,
    *,
    start: int,
    stop: int | None = None,
) -> int | None:
    """Find a page whose text *begins* with the chapter title.

    The aggregated PDF has a running ``SASE Handbook`` header and a
    JS-injected chapter-number prefix on each chapter heading, so we
    strip both before testing for an exact prefix match. Anchoring the
    match prevents in-body mentions of the title (links, citations,
    blog cross-references) from being mistaken for the chapter's first
    page.
    """
    normalized = _normalize(title)
    compact_title = _compact(title)
    if not normalized:
        return None

    end = stop if stop is not None else len(page_text)
    for index in range(start, end):
        page = page_text[index]
        stripped = _RUNNING_HEADER_RE.sub("", page, count=1)
        stripped = _LEADING_NUMBER_RE.sub("", stripped, count=1)
        if stripped.startswith(normalized):
            return index
        if _compact(stripped).startswith(compact_title):
            return index
    return None


def _chapter_pages(
    chapters: list[Chapter], page_text: list[str]
) -> dict[int, int]:
    pages: dict[int, int] = {}
    search_start = 2

    for chapter in chapters:
        page = _find_chapter_start_page(
            page_text, chapter.title, start=search_start
        )
        if page is None:
            raise RuntimeError(
                f"could not find aggregate page for {chapter.source_path}"
            )

        pages[chapter.number] = page
        search_start = page + 1

    return pages


def _h2_headings(chapter: Chapter) -> list[Heading]:
    return [heading for heading in chapter.headings if heading.level == 2]


def _add_metadata(reader: PdfReader, writer: PdfWriter) -> None:
    current = dict(reader.metadata or {})
    producer = str(current.get("/Producer", "MkDocs Exporter"))
    current.update(METADATA)
    current["/Producer"] = f"{producer}; pypdf post-processing"
    writer.add_metadata(current)


def _optimize_images(writer: PdfWriter) -> int:
    """Re-encode large browser-emitted PNGs without touching shared objects twice."""

    optimized = 0
    seen_references: set[int] = set()
    for page in writer.pages:
        for image_file in page.images:
            reference = image_file.indirect_reference
            if reference is None or reference.idnum in seen_references:
                continue
            seen_references.add(reference.idnum)

            image = image_file.image
            if image.format != "PNG" or image.mode != "RGB":
                continue
            image_file.replace(
                image,
                quality=IMAGE_JPEG_QUALITY,
                optimize=True,
            )
            optimized += 1
    return optimized


def _add_outlines(
    writer: PdfWriter,
    chapters: list[Chapter],
    chapter_pages: dict[int, int],
    page_text: list[str],
) -> None:
    for chapter in chapters:
        page = chapter_pages[chapter.number]
        parent = writer.add_outline_item(
            f"{chapter.number} {chapter.title}",
            page,
        )
        next_page = chapter_pages.get(chapter.number + 1, len(page_text))

        for h2_index, heading in enumerate(_h2_headings(chapter), start=1):
            numbered = f"{chapter.number}.{h2_index} {heading.text}"
            target = _find_page(
                page_text,
                numbered,
                start=page,
                stop=next_page,
            )
            if target is None:
                target = _find_page(
                    page_text,
                    heading.text,
                    start=page,
                    stop=next_page,
                )
            if target is not None:
                writer.add_outline_item(numbered, target, parent=parent)


def _parse_args() -> Namespace:
    parser = ArgumentParser(
        description="Add metadata and outlines to the generated SASE handbook PDF."
    )
    parser.add_argument(
        "--site-dir",
        type=Path,
        default=DEFAULT_SITE_DIR,
        help="MkDocs output directory containing downloads/sase-handbook.pdf.",
    )
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    site_dir = args.site_dir
    pdf_path = site_dir / "downloads" / "sase-handbook.pdf"

    if not pdf_path.exists():
        _error(f"missing PDF: {pdf_path}")
        return 1

    try:
        chapters = _load_chapters(site_dir)
        reader = PdfReader(str(pdf_path))
        page_text = _extract_page_text(reader)
        chapter_pages = _chapter_pages(chapters, page_text)

        writer = PdfWriter()
        for page in reader.pages:
            writer.add_page(page)
            writer.pages[-1].compress_content_streams(level=9)
        optimized_images = _optimize_images(writer)

        _add_metadata(reader, writer)
        _add_outlines(writer, chapters, chapter_pages, page_text)
        writer.compress_identical_objects(
            remove_duplicates=True, remove_unreferenced=True
        )

        temp_path = pdf_path.with_suffix(".postprocess.tmp.pdf")
        with temp_path.open("wb") as handle:
            writer.write(handle)
        temp_path.replace(pdf_path)
    except Exception as exc:
        _error(str(exc))
        return 1

    print(
        f"[postprocess_docs_pdf] ok: {pdf_path} "
        f"({len(chapters)} chapter outlines, {optimized_images} optimized images)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
