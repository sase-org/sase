SCHEMA_VERSION = 1

OBSERVATION_KINDS = (
    "qualification",
    "exercise",
    "publication",
    "confirmation",
    "abandoned",
    "veto",
)

# Sealed fields only: the candidate ID is a digest of exactly these keys.
SEALED_KEYS = (
    "schema_version",
    "repository",
    "version",
    "tag",
    "sha",
    "tree",
    "generation",
    "builder_revision",
    "builder_run_id",
    "builder_attempt",
    "core_source_pin",
    "core_version",
    "core_files",
    "dists",
)

EXIT_OK = 0
EXIT_REFUSED = 2
EXIT_ERROR = 3


class Refusal(Exception):
    """A typed refusal: the candidate or request is red, not a crash."""


def _canonical(payload: Any) -> bytes:
    return json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")


def candidate_id(sealed: dict[str, Any]) -> str:
    """Derive the candidate ID from sealed fields only."""
    projection = {key: sealed[key] for key in SEALED_KEYS if key in sealed}
    return "candidate-" + hashlib.sha256(_canonical(projection)).hexdigest()[:32]


def observation_asset_name(
    generation: int, kind: str, run_id: int, attempt: int
) -> str:
    """Name one observation asset; re-appending it is idempotent."""
    if kind not in OBSERVATION_KINDS:
        raise Refusal(f"unknown observation kind: {kind!r}")
    return f"candidate-gen{generation}-{kind}-run{run_id}-attempt{attempt}.json"


def _core_files_complete(
    core_files: list[dict[str, Any]], expected_suffixes: Sequence[str]
) -> list[str]:
    """Return the expected suffixes with no live (non-yanked) file."""
    live = [
        entry
        for entry in core_files
        if isinstance(entry, dict) and not entry.get("yanked", False)
    ]
    missing = []
    for suffix in expected_suffixes:
        if not any(
            isinstance(entry.get("filename"), str)
            and entry["filename"].endswith(suffix)
            for entry in live
        ):
            missing.append(suffix)
    return missing


def seal_manifest(
    *,
    repository: str,
    version: str,
    tag: str,
    sha: str,
    tree: str,
    generation: int,
    builder_revision: str,
    builder_run_id: int,
    builder_attempt: int,
    core_source_pin: str,
    core_version: str,
    core_files: list[dict[str, Any]],
    expected_core_suffixes: Sequence[str],
    dists: list[dict[str, Any]],
) -> dict[str, Any]:
    """Build the sealed manifest, refusing incomplete or malformed input."""
    if not repository or not version or not tag or not sha:
        raise Refusal("repository, version, tag, and sha must all be non-empty")
    if generation < 1:
        raise Refusal(f"generation must be >= 1, got {generation}")
    wheels = [d for d in dists if d.get("packagetype") == "bdist_wheel"]
    sdists = [d for d in dists if d.get("packagetype") == "sdist"]
    if len(wheels) != 1 or len(sdists) != 1 or len(dists) != 2:
        raise Refusal(
            "dist set must be exactly one wheel plus one sdist, "
            f"got {len(wheels)} wheel(s) and {len(sdists)} sdist(s)"
        )
    for dist in dists:
        for key in ("filename", "size", "sha256", "asset"):
            if not dist.get(key):
                raise Refusal(f"dist {dist.get('filename', '?')!r} misses {key!r}")
        if version.replace("-", "_") not in dist["filename"].replace("-", "_"):
            raise Refusal(
                f"dist {dist['filename']!r} is not named for version {version!r}"
            )
    missing = _core_files_complete(core_files, expected_core_suffixes)
    if missing:
        raise Refusal(
            f"incomplete core file set for sase-core-rs=={core_version}: "
            f"no live file for suffixes {missing}"
        )
    manifest: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "repository": repository,
        "version": version,
        "tag": tag,
        "sha": sha,
        "tree": tree,
        "generation": generation,
        "builder_revision": builder_revision,
        "builder_run_id": builder_run_id,
        "builder_attempt": builder_attempt,
        "core_source_pin": core_source_pin,
        "core_version": core_version,
        "core_files": core_files,
        "dists": dists,
        "observations": [],
    }
    manifest["candidate_id"] = candidate_id(manifest)
    return manifest


def verify_manifest(manifest: dict[str, Any]) -> list[str]:
    """Recheck a sealed manifest; return a list of typed problems (empty OK)."""
    problems: list[str] = []
    if manifest.get("schema_version") != SCHEMA_VERSION:
        problems.append(f"SCHEMA_MISMATCH expected={SCHEMA_VERSION}")
    for key in SEALED_KEYS:
        if key not in manifest:
            problems.append(f"MISSING_FIELD field={key}")
    if problems:
        return problems
    if manifest.get("candidate_id") != candidate_id(manifest):
        problems.append("IDENTITY_MISMATCH candidate_id does not match sealed fields")
    try:
        seal_manifest(
            repository=manifest["repository"],
            version=manifest["version"],
            tag=manifest["tag"],
            sha=manifest["sha"],
            tree=manifest.get("tree", ""),
            generation=manifest["generation"],
            builder_revision=manifest.get("builder_revision", ""),
            builder_run_id=manifest.get("builder_run_id", 0),
            builder_attempt=manifest.get("builder_attempt", 1),
            core_source_pin=manifest.get("core_source_pin", ""),
            core_version=manifest["core_version"],
            core_files=manifest["core_files"],
            expected_core_suffixes=_suffixes_covered_by(manifest["core_files"]),
            dists=manifest["dists"],
        )
    except Refusal as exc:
        problems.append(f"SEAL_REFUSED {exc}")
    return problems


def _suffixes_covered_by(core_files: list[dict[str, Any]]) -> list[str]:
    """Derive one satisfied suffix per live file (verify-time self-check)."""
    suffixes = []
    for entry in core_files:
        if isinstance(entry, dict) and not entry.get("yanked", False):
            suffixes.append(entry.get("filename", ""))
    return suffixes


@dataclass
class Clause:
    name: str
    ok: bool
    detail: str


def evaluate_manifest(
    manifest: dict[str, Any],
    observations: Sequence[dict[str, Any]],
) -> dict[str, Any]:
    """Run the promotion predicate over a manifest plus observation assets.

    Qualification and exercise clauses read "required evidence missing" until
    those phases fill them in. Missing evidence is red: skipped, cancelled,
    missing, stale, zero-collected or unreadable evidence never satisfies a
    gate.
    """
    problems = verify_manifest(manifest)
    clauses = [
        Clause(
            "source_and_version_identity_match",
            not problems,
            "; ".join(problems) if problems else "candidate ID matches sealed fields",
        )
    ]

    core_files = manifest.get("core_files", [])
    live_core = [f for f in core_files if isinstance(f, dict) and not f.get("yanked")]
    core_ok = bool(manifest.get("core_version")) and bool(live_core) and not problems
    clauses.append(
        Clause(
            "public_dependency_contract_satisfied",
            core_ok,
            f"exact core pin {manifest.get('core_version')!r} with "
            f"{len(live_core)} live file(s)"
            if core_ok
            else "exact core pin missing, incomplete, or manifest red",
        )
    )

    dists_ok = not problems and len(manifest.get("dists", [])) == 2
    clauses.append(
        Clause(
            "exact_expected_files_retained_and_hashed",
            dists_ok,
            "sealed dist set retained (hash recheck runs at publish)"
            if dists_ok
            else "dist set missing or manifest red",
        )
    )

    by_kind: dict[str, list[dict[str, Any]]] = {}
    for obs in observations:
        if isinstance(obs, dict) and obs.get("kind") in OBSERVATION_KINDS:
            by_kind.setdefault(obs["kind"], []).append(obs)

    qualification_observations = [
        obs
        for obs in by_kind.get("qualification", [])
        if obs.get("candidate_id") == manifest.get("candidate_id")
        and obs.get("generation") == manifest.get("generation")
    ]
    qualification_report, qualification_error = _latest_qualification_report(
        manifest, qualification_observations
    )
    if (
        qualification_report is not None
        and qualification_error is None
        and qualification_report["verdict"] == "pass"
    ):
        clauses.append(
            Clause(
                "qualification",
                True,
                f"qualification passed for workflow run "
                f"{qualification_report.get('workflow_run_id')} attempt "
                f"{qualification_report.get('current_attempt')}",
            )
        )
    elif qualification_error:
        clauses.append(Clause("qualification", False, qualification_error))
    else:
        assert qualification_report is not None
        clauses.append(
            Clause(
                "qualification",
                False,
                _qualification.qualify_failure_summary(qualification_report),
            )
        )

    exercise_observations = [
        obs
        for obs in by_kind.get("exercise", [])
        if obs.get("candidate_id") == manifest.get("candidate_id")
        and obs.get("generation") == manifest.get("generation")
    ]
    exercise, exercise_error = _latest_candidate_observation(
        "exercise", manifest, exercise_observations
    )
    if exercise is None:
        clauses.append(
            Clause(
                "exercise",
                False,
                exercise_error or "required evidence missing: no exercise observation",
            )
        )
    elif exercise_error:
        clauses.append(Clause("exercise", False, exercise_error))
    elif exercise.get("verdict") == "pass":
        clauses.append(
            Clause(
                "exercise",
                True,
                f"exercise passed for workflow run {exercise.get('run_id')} "
                f"attempt {exercise.get('attempt')}",
            )
        )
    else:
        clauses.append(
            Clause(
                "exercise",
                False,
                f"exercise red: {exercise.get('reason', exercise.get('verdict'))}",
            )
        )

    vetoes = [
        o
        for o in by_kind.get("veto", [])
        if o.get("candidate_id") == manifest.get("candidate_id")
        and o.get("generation") == manifest.get("generation")
        if o.get("verdict") not in ("withdrawn", "pass")
    ]
    clauses.append(
        Clause(
            "no_confirmed_release_veto",
            not vetoes,
            f"{len(vetoes)} active veto(s)" if vetoes else "no active veto",
        )
    )

    publishable = all(clause.ok for clause in clauses)
    return {
        "candidate_id": manifest.get("candidate_id"),
        "publishable": publishable,
        "rerun_eligible": bool(
            qualification_report and qualification_report.get("rerun_eligible")
        ),
        "rerun_reason": (
            qualification_report.get("rerun_reason")
            if qualification_report
            else "qualification evidence missing or ambiguous"
        ),
        "clauses": [{"name": c.name, "ok": c.ok, "detail": c.detail} for c in clauses],
    }


def _latest_candidate_observation(
    kind: str,
    manifest: dict[str, Any],
    items: Sequence[dict[str, Any]],
) -> tuple[dict[str, Any] | None, str | None]:
    """Select one observation using run and attempt provenance, never generation sort."""
    if not items:
        return None, None
    run_ids: set[int] = set()
    attempts: dict[int, dict[str, Any]] = {}
    for item in items:
        attempt = item.get("attempt")
        run_id = item.get("run_id")
        if (
            not isinstance(attempt, int)
            or isinstance(attempt, bool)
            or attempt < 1
            or not isinstance(run_id, int)
            or isinstance(run_id, bool)
            or run_id < 1
        ):
            return None, f"{kind} observation has malformed run/attempt provenance"
        run_ids.add(run_id)
        generation = manifest.get("generation")
        if (
            not isinstance(generation, int)
            or isinstance(generation, bool)
            or generation < 1
        ):
            return None, f"{kind} cannot be bound to a malformed candidate generation"
        if item.get("asset") != observation_asset_name(generation, kind, run_id, attempt):
            return None, f"{kind} observation asset does not match its run/attempt identity"
        if attempt in attempts:
            return None, f"{kind} history has duplicate attempt {attempt}"
        attempts[attempt] = item
    if len(run_ids) != 1:
        return None, f"{kind} history is ambiguous across workflow runs"
    highest = max(attempts)
    if set(attempts) != set(range(1, highest + 1)):
        return None, f"{kind} history omits one or more earlier attempts"
    return attempts[highest], None


def _latest_qualification_report(
    manifest: dict[str, Any], items: Sequence[dict[str, Any]]
) -> tuple[dict[str, Any] | None, str | None]:
    latest, error = _latest_candidate_observation("qualification", manifest, items)
    if error or latest is None:
        return None, error or "required evidence missing: no qualification observation"
    # Validate every attempt. A malformed earlier green cannot be hidden by a
    # later asset, and a later red always supersedes an older pass.
    reports: dict[int, dict[str, Any]] = {}
    run_id = latest["run_id"]
    for observation in items:
        extra = observation.get("extra")
        payload = extra.get("qualification") if isinstance(extra, dict) else None
        result, validation_error = _qualification.verify_observation_payload(
            manifest, payload
        )
        if validation_error:
            return None, f"qualification observation is unverifiable: {validation_error}"
        assert result is not None
        if result.get("workflow_run_id") != run_id:
            return None, "qualification report workflow_run_id disagrees with observation"
        if result.get("current_attempt") != observation.get("attempt"):
            return None, "qualification report attempt disagrees with observation"
        expected_verdict = "pass" if result.get("verdict") == "pass" else "red"
        if observation.get("verdict") != expected_verdict:
            return None, "qualification observation verdict disagrees with its evidence"
        reports[observation["attempt"]] = result
    if set(reports) != set(range(1, latest["attempt"] + 1)):
        return None, "qualification observation history is incomplete"
    return reports[latest["attempt"]], None


def append_observation(
    manifest: dict[str, Any],
    *,
    kind: str,
    run_id: int,
    attempt: int,
    verdict: str,
    reason: str = "",
    extra: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Append one observation; re-appending the same asset is idempotent."""
    name = observation_asset_name(manifest["generation"], kind, run_id, attempt)
    observation: dict[str, Any] = {
        "asset": name,
        "kind": kind,
        "generation": manifest["generation"],
        "candidate_id": manifest["candidate_id"],
        "run_id": run_id,
        "attempt": attempt,
        "verdict": verdict,
        "reason": reason,
    }
    if extra:
        observation["extra"] = extra
    existing = manifest.setdefault("observations", [])
    for index, prior in enumerate(existing):
        if isinstance(prior, dict) and prior.get("asset") == name:
            if prior != observation:
                raise Refusal(
                    f"conflicting observation already exists for asset {name!r}"
                )
            return prior
    existing.append(observation)
    return observation


def cross_check_lock_hashes(
    core_files: list[dict[str, Any]],
    lock_path: Path,
    version: str,
) -> list[str]:
    """Cross-check PyPI digests against uv.lock hashes; return mismatches."""
    try:
        import tomllib
    except ImportError:  # pragma: no cover - Python 3.12+ always has tomllib
        return ["LOCK_UNREADABLE tomllib missing"]
    try:
        lock = tomllib.loads(lock_path.read_text(encoding="utf-8"))
    except OSError as exc:
        return [f"LOCK_UNREADABLE {exc}"]
    problems = []
    for package in lock.get("package", []):
        if package.get("name") != "sase-core-rs" or package.get("version") != version:
            continue
        locked: dict[str, str] = {}
        sdist = package.get("sdist")
        if isinstance(sdist, dict) and sdist.get("hash"):
            locked[sdist.get("url", "")] = sdist["hash"]
        wheels = package.get("wheels", [])
        if isinstance(wheels, list):
            for wheel in wheels:
                if isinstance(wheel, dict) and wheel.get("hash"):
                    locked[wheel.get("url", "")] = wheel["hash"]
        for entry in core_files:
            url = entry.get("url", "")
            if url in locked and locked[url] != "sha256:" + entry.get("sha256", ""):
                problems.append(f"HASH_MISMATCH {entry.get('filename')}")
    return problems


def parse_expected_suffixes(text: str) -> list[str]:
    """Read the core completeness set from sase-core's release-plz.yml text.

    The suffix set stays single-sourced in sase-core; this parses it, never
    copies it. Delegates to the shared block-form parser so ``release.yml``
    and ``build-core.yml`` accept the same ``EXPECTED_DIST_SUFFIXES: |``
    shape sase-core actually ships.
    """
    try:
        return list(_core.parse_expected_suffixes(text))
    except _core.CoreEnsureError as exc:
        raise Refusal(str(exc)) from exc


def resolve_locator(locator: str, dest: Path) -> Path:
    """Resolve an asset locator to local bytes.

    ``file:`` locators copy a local path; ``gh-release:`` locators download a
    draft-release asset with ``gh``. Anything else fails closed.
    """
    if locator.startswith("file:"):
        src = Path(locator[len("file:") :])
        if not src.is_file():
            raise Refusal(f"asset not found: {src}")
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(src.read_bytes())
        return dest
    if locator.startswith("gh-release:"):
        gh = shutil.which("gh")
        if gh is None:
            raise Refusal("gh is required to download gh-release: assets")
        spec = locator[len("gh-release:") :]
        tag, _, name = spec.partition("/")
        if not tag or not name:
            raise Refusal(f"malformed gh-release locator: {locator!r}")
        proc = subprocess.run(
            [
                gh,
                "release",
                "download",
                tag,
                "--pattern",
                name,
                "--dir",
                str(dest.parent),
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if proc.returncode != 0:
            raise Refusal(f"gh release download failed: {proc.stderr.strip()}")
        return dest.parent / name
    raise Refusal(f"unsupported asset locator: {locator!r}")


def fetch_pypi_core_files(
    version: str,
    urlopen: Any = None,
) -> list[dict[str, Any]]:
    """Fetch sase-core-rs's PyPI file list with digests for one version."""
    if urlopen is None:
        urlopen = urllib.request.urlopen
    url = "https://pypi.org/pypi/sase-core-rs/json"
    with urlopen(url, timeout=30) as response:
        payload = json.loads(response.read().decode("utf-8"))
    releases = payload.get("releases", {})
    if version not in releases:
        raise Refusal(f"sase-core-rs=={version} has no PyPI release")
    files = []
    for entry in releases[version]:
        digest = (entry.get("digests") or {}).get("sha256", "")
        files.append(
            {
                "filename": entry.get("filename", ""),
                "packagetype": entry.get("packagetype", ""),
                "yanked": bool(entry.get("yanked", False)),
                "sha256": digest,
                "size": entry.get("size", 0),
                "url": entry.get("url", ""),
            }
        )
    return files


CORE_FILENAME_STEM = "sase_core_rs"
PLATFORM_WHEEL_SUFFIX = "manylinux_2_28_x86_64"
PROBE_MARKER_FILENAME = "probe-core-version.txt"


def _live_entries(core_files: Any) -> list[dict[str, Any]]:
    """Return the non-yanked file records; anything else is not a candidate."""
    if not isinstance(core_files, list):
        return []
    return [
        entry
        for entry in core_files
        if isinstance(entry, dict) and not entry.get("yanked", False)
    ]


def _parse_dotted_version(value: Any, label: str = "version") -> tuple[int, ...]:
    """Parse a numeric dot-separated version; Refusal (never an exception)."""
    import re

    if not isinstance(value, str) or not re.fullmatch(r"\d+(?:\.\d+)*", value.strip()):
        raise Refusal(f"unsupported {label} {value!r}; expected numeric dot-separated")
    return tuple(int(part) for part in value.strip().split("."))


def select_published_wheel(
    core_files: list[dict[str, Any]],
    version: str,
    platform_suffix: str = PLATFORM_WHEEL_SUFFIX,
) -> dict[str, Any]:
    """Select exactly one live platform wheel for version; refuse otherwise.

    Missing (no live file under the version stem and platform suffix) and
    duplicate (more than one live match) are both refusals: the caller must
    never guess which bytes the sealed candidate binds.
    """
    stem = f"{CORE_FILENAME_STEM}-{version}-"
    wanted = f"{platform_suffix}.whl"
    matches = [
        entry
        for entry in _live_entries(core_files)
        if isinstance(entry.get("filename"), str)
        and entry["filename"].startswith(stem)
        and entry["filename"].endswith(wanted)
        and entry.get("packagetype") == "bdist_wheel"
    ]
    if not matches:
        raise Refusal(
            f"no live {platform_suffix} wheel for sase-core-rs=={version}"
        )
    if len(matches) > 1:
        names = sorted(str(entry.get("filename", "?")) for entry in matches)
        raise Refusal(
            f"duplicate live {platform_suffix} wheels "
            f"for sase-core-rs=={version}: {names}"
        )
    return matches[0]


def published_core_plan(
    manifest: dict[str, Any],
    core_files: list[dict[str, Any]],
    expected_suffixes: Sequence[str],
    *,
    expect_version: str = "",
    probe_version: str = "",
    platform_suffix: str = PLATFORM_WHEEL_SUFFIX,
) -> dict[str, Any]:
    """Validate a published-core request against the sealed manifest.

    Returns the download plan (effective version, probe flag, wheel filename,
    SHA-256, size, URL and ``v<version>`` tag). The manifest is only read,
    never modified. ``expect_version`` (the caller's required core version)
    must equal the sealed pin outside and inside the probe path; a declared
    probe must name a strictly older complete core and is recorded as a probe
    that can never qualify the original pair.
    """
    if not isinstance(manifest, dict):
        raise Refusal("manifest root must be an object")
    problems = verify_manifest(manifest)
    if problems:
        raise Refusal(f"sealed manifest is red: {'; '.join(problems)}")
    manifest_version = manifest["core_version"]
    if expect_version and expect_version != manifest_version:
        raise Refusal(
            f"expected core {expect_version!r} differs from "
            f"the sealed manifest core {manifest_version!r}"
        )
    probe = bool(probe_version)
    effective = probe_version or manifest_version
    if probe:
        if probe_version == manifest_version:
            raise Refusal("probe version must differ from the sealed manifest core")
        if _parse_dotted_version(probe_version, "probe version") >= (
            _parse_dotted_version(manifest_version, "manifest core version")
        ):
            raise Refusal(
                f"probe core {probe_version!r} must be older than "
                f"the sealed manifest core {manifest_version!r}"
            )
    missing = _core_files_complete(core_files, expected_suffixes)
    if missing:
        raise Refusal(
            f"incomplete core file set for sase-core-rs=={effective}: "
            f"no live file for suffixes {missing}"
        )
    wheel = select_published_wheel(core_files, effective, platform_suffix)
    if not probe:
        sealed = [
            entry
            for entry in _live_entries(manifest.get("core_files"))
            if entry.get("filename") == wheel.get("filename")
        ]
        if len(sealed) != 1:
            raise Refusal(
                f"sealed manifest has no live record of {wheel.get('filename')!r}"
            )
        if sealed[0].get("sha256", "") != wheel.get("sha256", ""):
            raise Refusal(
                f"SHA-256 mismatch for {wheel.get('filename')!r}: "
                "fresh PyPI file list differs from the sealed manifest"
            )
        for key in ("size",):
            sealed_size = sealed[0].get(key, 0)
            fresh_size = wheel.get(key, 0)
            if sealed_size and fresh_size and sealed_size != fresh_size:
                raise Refusal(
                    f"size mismatch for {wheel.get('filename')!r}: "
                    f"sealed {sealed_size} != fresh {fresh_size}"
                )
    size = wheel.get("size", 0)
    return {
        "version": effective,
        "probe": probe,
        "manifest_version": manifest_version,
        "filename": wheel.get("filename", ""),
        "sha256": wheel.get("sha256", ""),
        "size": size if isinstance(size, int) and size > 0 else 0,
        "url": wheel.get("url", ""),
        "tag": f"v{effective}",
    }


def fetch_and_verify_wheel(
    plan: dict[str, Any],
    out_dir: Path,
    urlopen: Any = None,
) -> Path:
    """Download the planned wheel and verify size and SHA-256; refuse red.

    Writes the wheel plus (probe only) the probe marker into ``out_dir``.
    """
    if urlopen is None:
        urlopen = urllib.request.urlopen
    filename = plan.get("filename", "")
    url = plan.get("url", "")
    if not filename or not url:
        raise Refusal("published-core plan has no wheel filename or download URL")
    try:
        with urlopen(url, timeout=60) as response:
            data = response.read()
    except Refusal:
        raise
    except Exception as exc:
        raise Refusal(f"cannot download {filename} from PyPI: {exc}") from exc
    digest = hashlib.sha256(data).hexdigest()
    if digest != plan.get("sha256", ""):
        raise Refusal(f"downloaded {filename} SHA-256 mismatch")
    if plan.get("size") and len(data) != plan["size"]:
        raise Refusal(
            f"downloaded {filename} size mismatch: "
            f"got {len(data)}, expected {plan['size']}"
        )
    out_dir.mkdir(parents=True, exist_ok=True)
    path = out_dir / filename
    path.write_bytes(data)
    if plan.get("probe"):
        (out_dir / PROBE_MARKER_FILENAME).write_text(
            f"{plan.get('version', '')}\n", encoding="utf-8"
        )
    return path


def _load_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def _dump_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def _add_common(sub: argparse.ArgumentParser) -> None:
    sub.add_argument("--manifest", required=True, help="sealed manifest JSON path")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="release_candidate",
        description="Seal and evaluate exact-candidate release manifests.",
    )
    subs = parser.add_subparsers(dest="command", required=True)

    seal = subs.add_parser("seal", help="write the sealed manifest")
    seal.add_argument("--repository", required=True)
    seal.add_argument("--version", required=True)
    seal.add_argument("--tag", required=True)
    seal.add_argument("--sha", required=True)
    seal.add_argument("--tree", default="")
    seal.add_argument("--generation", type=int, default=1)
    seal.add_argument("--builder-revision", default="")
    seal.add_argument("--builder-run-id", type=int, default=0)
    seal.add_argument("--builder-attempt", type=int, default=1)
    seal.add_argument("--core-source-pin", default="")
    seal.add_argument("--core-version", required=True)
    seal.add_argument("--core-files", required=True, help="PyPI core file list JSON")
    seal.add_argument(
        "--expected-core-suffixes",
        required=True,
        help="expected core dist suffixes JSON (from sase-core release-plz.yml)",
    )
    seal.add_argument("--dists", required=True, help="built dist set JSON")
    seal.add_argument("--out", required=True, help="manifest output path")

    verify = subs.add_parser("verify", help="recheck a sealed manifest")
    _add_common(verify)

    show = subs.add_parser("show", help="print a sealed manifest")
    _add_common(show)

    observe = subs.add_parser("observe", help="append one observation asset")
    _add_common(observe)
    observe.add_argument("--kind", required=True, choices=sorted(OBSERVATION_KINDS))
    observe.add_argument("--run-id", type=int, required=True)
    observe.add_argument("--attempt", type=int, default=1)
    observe.add_argument("--verdict", required=True)
    observe.add_argument("--reason", default="")
    observe.add_argument("--extra", default="", help="extra JSON object")
    observe.add_argument("--out", default="", help="observation asset output path")

    published_core = subs.add_parser(
        "published-core",
        help="select and verify the sealed manifest's published core wheel",
    )
    published_core.add_argument(
        "-m",
        "--manifest",
        required=True,
        help="sealed manifest JSON path (read-only, never modified)",
    )
    published_core.add_argument(
        "--core-files",
        required=True,
        help="fresh PyPI core file list JSON for the effective version",
    )
    published_core.add_argument(
        "--expected-core-suffixes",
        required=True,
        help="expected core dist suffixes JSON (from sase-core release-plz.yml)",
    )
    published_core.add_argument(
        "--out-dir",
        required=True,
        help="directory receiving the verified wheel",
    )
    published_core.add_argument(
        "-e",
        "--expect-version",
        default="",
        help="required caller core version; must equal the sealed pin",
    )
    published_core.add_argument(
        "-p",
        "--probe-version",
        default="",
        help="rehearse-only older probe core version (recorded as a probe)",
    )
    published_core.add_argument(
        "--platform-suffix",
        default=PLATFORM_WHEEL_SUFFIX,
        help="platform wheel suffix to select",
    )

    qualify = subs.add_parser(
        "qualify", help="evaluate candidate-bound N1 evidence and append an observation"
    )
    _add_common(qualify)
    qualify.add_argument(
        "--inventory",
        default=".github/release-qualification.json",
        help="exact versioned N1 inventory file",
    )
    qualify.add_argument(
        "--jobs",
        required=True,
        help="normalized attempt-aware workflow jobs JSON",
    )
    qualify.add_argument(
        "--evidence-dir",
        required=True,
        help="directory containing attempt-specific qualification evidence",
    )
    qualify.add_argument("--run-id", required=True, type=int)
    qualify.add_argument("--attempt", required=True, type=int)
    qualify.add_argument("--out", default="", help="qualification observation output path")

    evaluate = subs.add_parser("evaluate", help="run the promotion predicate")
    _add_common(evaluate)
    evaluate.add_argument(
        "--observations",
        default="",
        help="JSON list of observation assets (defaults to manifest's own)",
    )

    download = subs.add_parser("download", help="resolve an asset locator")
    download.add_argument("--locator", required=True)
    download.add_argument("--dest", required=True)

    core_files = subs.add_parser(
        "core-files", help="fetch the core PyPI file list and cross-check uv.lock"
    )
    core_files.add_argument("--version", required=True)
    core_files.add_argument("--lock", default="uv.lock")
    core_files.add_argument("--out", required=True)

    core_suffixes = subs.add_parser(
        "core-suffixes", help="parse EXPECTED_DIST_SUFFIXES from release-plz.yml"
    )
    group = core_suffixes.add_mutually_exclusive_group(required=True)
    group.add_argument("--url", default="")
    group.add_argument("--file", default="")
    core_suffixes.add_argument("--out", required=True)

    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "seal":
            manifest = seal_manifest(
                repository=args.repository,
                version=args.version,
                tag=args.tag,
                sha=args.sha,
                tree=args.tree,
                generation=args.generation,
                builder_revision=args.builder_revision,
                builder_run_id=args.builder_run_id,
                builder_attempt=args.builder_attempt,
                core_source_pin=args.core_source_pin,
                core_version=args.core_version,
                core_files=_load_json(Path(args.core_files)),
                expected_core_suffixes=_load_json(Path(args.expected_core_suffixes)),
                dists=_load_json(Path(args.dists)),
            )
            _dump_json(Path(args.out), manifest)
            print(manifest["candidate_id"])
            return EXIT_OK
        if args.command == "verify":
            manifest = _load_json(Path(args.manifest))
            problems = verify_manifest(manifest)
            if problems:
                for problem in problems:
                    print(problem)
                return EXIT_REFUSED
            print(f"OK {manifest.get('candidate_id')}")
            return EXIT_OK
        if args.command == "show":
            manifest = _load_json(Path(args.manifest))
            print(json.dumps(manifest, indent=2, sort_keys=True))
            return EXIT_OK
        if args.command == "observe":
            path = Path(args.manifest)
            manifest = _load_json(path)
            observation = append_observation(
                manifest,
                kind=args.kind,
                run_id=args.run_id,
                attempt=args.attempt,
                verdict=args.verdict,
                reason=args.reason,
                extra=_load_json(Path(args.extra)) if args.extra else None,
            )
            _dump_json(path, manifest)
            if args.out:
                _dump_json(Path(args.out), observation)
            print(observation["asset"])
            return EXIT_OK
        if args.command == "published-core":
            manifest = _load_json(Path(args.manifest))
            if not isinstance(manifest, dict):
                raise Refusal("manifest root must be an object")
            plan = published_core_plan(
                manifest,
                _load_json(Path(args.core_files)),
                _load_json(Path(args.expected_core_suffixes)),
                expect_version=args.expect_version,
                probe_version=args.probe_version,
                platform_suffix=args.platform_suffix,
            )
            path = fetch_and_verify_wheel(plan, Path(args.out_dir))
            print(json.dumps({**plan, "path": str(path)}, indent=2, sort_keys=True))
            return EXIT_OK
        if args.command == "qualify":
            if args.run_id < 1 or args.attempt < 1:
                raise Refusal("run-id and attempt must be positive integers")
            manifest_path = Path(args.manifest)
            manifest = _load_json(manifest_path)
            if not isinstance(manifest, dict):
                raise Refusal("manifest root must be an object")
            inventory_path = Path(args.inventory)
            inventory_error = ""
            try:
                inventory_bytes = inventory_path.read_bytes()
            except OSError as exc:
                inventory_bytes = b""
                inventory_error = f"cannot read inventory {inventory_path}: {exc}"
            job_bundle: dict[str, Any] | None = None
            job_bundle_error = ""
            try:
                job_bundle = _qualification.load_job_bundle_file(
                    Path(args.jobs), Path(args.evidence_dir)
                )
            except _qualification.QualificationInputError as exc:
                job_bundle_error = str(exc)
            payload = _qualification.make_observation_payload(
                manifest,
                inventory_bytes,
                job_bundle,
                job_bundle_error=job_bundle_error,
                inventory_error=inventory_error,
                expected_workflow_run_id=args.run_id,
                expected_attempt=args.attempt,
            )
            result = payload["result"]
            verdict = "pass" if result["verdict"] == "pass" else "red"
            reason = (
                ""
                if verdict == "pass"
                else _qualification.qualify_failure_summary(result)
            )
            observation = append_observation(
                manifest,
                kind="qualification",
                run_id=args.run_id,
                attempt=args.attempt,
                verdict=verdict,
                reason=reason,
                extra={"qualification": payload},
            )
            _dump_json(manifest_path, manifest)
            if args.out:
                _dump_json(Path(args.out), observation)
            print(json.dumps(result, indent=2, sort_keys=True))
            return EXIT_OK if verdict == "pass" else EXIT_REFUSED
        if args.command == "evaluate":
            manifest = _load_json(Path(args.manifest))
            observations: Sequence[dict[str, Any]]
            if args.observations:
                observations = _load_json(Path(args.observations))
            else:
                observations = manifest.get("observations", [])
            result = evaluate_manifest(manifest, observations)
            print(json.dumps(result, indent=2, sort_keys=True))
            return EXIT_OK if result["publishable"] else EXIT_REFUSED
        if args.command == "download":
            resolved = resolve_locator(args.locator, Path(args.dest))
            print(resolved)
            return EXIT_OK
        if args.command == "core-files":
            files = fetch_pypi_core_files(args.version)
            problems = cross_check_lock_hashes(files, Path(args.lock), args.version)
            if problems:
                for problem in problems:
                    print(problem, file=sys.stderr)
                return EXIT_REFUSED
            _dump_json(Path(args.out), files)
            print(f"{len(files)} files for sase-core-rs=={args.version}")
            return EXIT_OK
        if args.command == "core-suffixes":
            if args.url:
                with urllib.request.urlopen(args.url, timeout=30) as response:
                    text = response.read().decode("utf-8")
            else:
                text = Path(args.file).read_text(encoding="utf-8")
            suffixes = parse_expected_suffixes(text)
            if not suffixes:
                raise Refusal("no suffixes parsed from release-plz.yml")
            _dump_json(Path(args.out), suffixes)
            print(f"{len(suffixes)} expected suffixes")
            return EXIT_OK
    except Refusal as exc:
        print(f"REFUSED {exc}", file=sys.stderr)
        return EXIT_REFUSED
    except (OSError, ValueError, KeyError) as exc:
        print(f"ERROR {exc}", file=sys.stderr)
        return EXIT_ERROR
    raise AssertionError(f"unhandled command: {args.command}")


if __name__ == "__main__":
    raise SystemExit(main())
