#!/bin/bash

# Commit-orchestration stop hook.
# When $SASE_COMMIT_METHOD is set (i.e. we are inside a commit xprompt workflow),
# detects uncommitted changes and instructs the agent to use the appropriate
# /sase_<vcs>_commit skill. Blocks only once per session via a marker file.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# --- Early exits ---

# Not inside a commit workflow — nothing to do.
if [ -z "$SASE_COMMIT_METHOD" ]; then
    exit 0
fi

# Allow callers to disable this hook entirely (e.g. Gemini CLI)
if [ -n "$SASE_DISABLE_COMMIT_STOP_HOOK" ]; then
    exit 0
fi

# --- Helper functions ---

# Get list of uncommitted changed files (modified + untracked)
function get_changed_files() {
    {
        git diff --name-only HEAD 2>/dev/null
        git ls-files --others --exclude-standard 2>/dev/null
    } | sort -u
}

# Detect Codex hook runtime.
function is_codex_runtime() {
    [ -n "$CODEX_THREAD_ID" ] || [ -n "$CODEX_CI" ]
}

# Emit a hook "block" response that works for both Codex and Claude.
# - Codex: structured JSON on stdout + exit 0.
# - Claude: message on stderr + exit 2.
function emit_block() {
    local reason="$1"
    local details="${2:-}"

    if is_codex_runtime; then
        printf '{"decision":"block","reason":"%s"}\n' "$reason"
        if [ -n "$details" ]; then
            echo -e "$details" >&2
        fi
        return 0
    fi

    if [ -n "$details" ]; then
        echo -e "$details" >&2
    else
        echo "$reason" >&2
    fi
    return 2
}

# Map $SASE_VCS_PROVIDER to the correct commit skill name.
function resolve_commit_skill() {
    local provider="${SASE_VCS_PROVIDER:-}"

    # If not set, try auto-detection
    if [ -z "$provider" ]; then
        if [ -d .hg ]; then
            provider="hg"
        else
            provider="git"
        fi
    fi

    case "$provider" in
        github | bare_git | git)
            echo "/sase_git_commit"
            ;;
        hg | google)
            echo "/sase_hg_commit"
            ;;
        *)
            echo "/sase_git_commit"
            ;;
    esac
}

# Check sibling sase-* repos for uncommitted changes
function check_sibling_repos() {
    local sibling_repos_with_changes=()
    for repo_dir in "$PROJECT_DIR"/../sase-*/ "$HOME/.local/share/chezmoi"; do
        [ -d "$repo_dir/.git" ] || continue
        local repo_changes
        repo_changes=$(cd "$repo_dir" && { git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u)
        if echo "$repo_changes" | grep -q .; then
            sibling_repos_with_changes+=("$(basename "$repo_dir")")
        fi
    done

    if [ ${#sibling_repos_with_changes[@]} -gt 0 ]; then
        local repos_list
        repos_list=$(printf ', %s' "${sibling_repos_with_changes[@]}")
        repos_list=${repos_list:2} # Remove leading ', '
        local skill
        skill="$(resolve_commit_skill)"
        emit_block \
            "Stop hook blocked: sibling repos have uncommitted changes. Run ${skill} now." \
            "Uncommitted changes detected in sibling repo(s): ${repos_list}. Use your ${skill} skill to commit them before continuing."
        return $?
    fi

    return 0
}

# --- Main ---

function run() {
    cd "$PROJECT_DIR" || return 1

    # Log that this hook ran
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] sase_commit_stop_hook ran (method=$SASE_COMMIT_METHOD)" >>"$PROJECT_DIR/.claude/hooks.log"

    # Session-unique marker file for deduplication (block only once per cycle)
    if [ -n "$TMUX_PANE" ]; then
        TMUX_PANE_ID="${TMUX_PANE//[%]/}"
    else
        TMUX_PANE_ID="default"
    fi
    local marker_file="/tmp/sase_commit_stop_hook_${TMUX_PANE_ID}"

    # If marker file exists from a previous block, clear it and skip
    if [ -f "$marker_file" ]; then
        rm -f "$marker_file"
        return 0
    fi

    # Check for uncommitted changes in the main repo
    local changed_files
    changed_files="$(get_changed_files)"

    if echo "$changed_files" | grep -q .; then
        local skill
        skill="$(resolve_commit_skill)"

        # Create marker so we only block once per cycle
        touch "$marker_file"

        emit_block \
            "Stop hook blocked: uncommitted changes remain. Run ${skill} now." \
            "Uncommitted changes detected:\n${changed_files}\n\nUse your ${skill} skill to commit these changes now."
        return $?
    fi

    # No main repo changes — check sibling repos
    check_sibling_repos
    return $?
}

run "$@"
