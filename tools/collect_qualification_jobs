#!/usr/bin/env python3
"""Normalize paginated Actions jobs/artifacts responses into a job-history bundle.

Reads raw ``gh api`` responses for one release run's ``qualify-ci`` reusable
call and emits the normalized attempt-aware job history JSON consumed by
``tools/release_candidate qualify``. Jobs are scoped by the exact caller-job
prefix (``<caller> / <called>``), never by suffix matching, so an unrelated
job that happens to share a called name can never satisfy a requirement.

Evidence artifacts are per-attempt unique
(``qualify-evidence-<check>-attempt-<N>``) while payload filenames stay
``qualify-evidence-<check>.json``. Attempt snapshots are contiguous from 1; a
check with no fresh execution in a later attempt carries the previous
snapshot's identical record forward, which is exactly what the evaluator's
carry-forward proof requires. Absent uploads and expired artifacts become
record-scoped ``missing`` evidence errors; unreadable payloads become
``harness`` errors. Anything the evaluator must refuse (unknown jobs,
duplicates) is preserved verbatim so refusal stays typed downstream.

Stdlib-only so workflow steps can run it without a prepared virtualenv.
"""

from __future__ import annotations

import argparse
import copy
import importlib.util
import json
import os
import subprocess
import sys
import zipfile
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any


_inventory_path = Path(__file__).with_name("_release_qualification_inventory.py")
_inventory_loader = SourceFileLoader(
    "collect_qualification_jobs_inventory_tool", str(_inventory_path)
)
_inventory_spec = importlib.util.spec_from_file_location(
    "collect_qualification_jobs_inventory_tool",
    _inventory_path,
    loader=_inventory_loader,
)
if _inventory_spec is None or _inventory_spec.loader is None:
    raise RuntimeError(
        f"cannot load qualification inventory helpers at {_inventory_path}"
    )
_inventory = importlib.util.module_from_spec(_inventory_spec)
sys.modules[_inventory_spec.name] = _inventory
_inventory_spec.loader.exec_module(_inventory)

JOB_BUNDLE_SCHEMA_VERSION = _inventory.JOB_BUNDLE_SCHEMA_VERSION
QualificationInputError = _inventory.QualificationInputError
inventory_digest = _inventory.inventory_digest
load_inventory = _inventory.load_inventory
strict_json_loads = _inventory.strict_json_loads
_pairs_without_duplicates = _inventory._pairs_without_duplicates

EXIT_OK = 0
EXIT_REFUSED = 2
EXIT_ERROR = 3

#: Workflow whose jobs carry qualification evidence. Exercise verdicts stay
#: with the existing exercise machinery and are never mistaken for CI jobs.
QUALIFIED_WORKFLOW = ".github/workflows/ci.yml"

#: Evidence upload name prefix. Per-attempt unique artifact names bind payloads
#: to attempts; payload leaves stay ``qualify-evidence-<check>.json``.
EVIDENCE_ARTIFACT_PREFIX = "qualify-evidence-"


class Refusal(Exception):
    """A malformed input that must fail the workflow step, not crash it."""


def _parse_numbered_paths(values: list[str], *, flag: str) -> dict[int, list[Path]]:
    """Parse repeatable ``N=PATH`` arguments into attempt-ordered path lists."""
    grouped: dict[int, list[Path]] = {}
    for value in values:
        number, separator, path_text = value.partition("=")
        if not separator or not path_text:
            raise Refusal(f"{flag} entry {value!r} must look like N=PATH")
        try:
            attempt = int(number)
        except ValueError:
            raise Refusal(f"{flag} entry {value!r} has a non-integer attempt") from None
        if attempt < 1:
            raise Refusal(f"{flag} entry {value!r} has a non-positive attempt")
        grouped.setdefault(attempt, []).append(Path(path_text))
    return grouped


def _decode_json_documents(raw: bytes, *, source: str) -> list[Any]:
    """Decode one page object, a --slurp page array, or concatenated pages.

    ``gh api --paginate`` without ``--slurp`` streams one JSON document per
    page; the fetcher and this consumer must agree, so every envelope is
    accepted here instead of failing the second page with ``Extra data``.
    """
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise QualificationInputError(f"{source} is unreadable JSON: {exc}") from exc
    decoder = json.JSONDecoder(object_pairs_hook=_pairs_without_duplicates)
    values: list[Any] = []
    index = 0
    length = len(text)
    try:
        while True:
            while index < length and text[index].isspace():
                index += 1
            if index >= length:
                break
            value, end = decoder.raw_decode(text, index)
            values.append(value)
            index = end
    except json.JSONDecodeError as exc:
        raise QualificationInputError(f"{source} is unreadable JSON: {exc}") from exc
    if not values:
        raise QualificationInputError(f"{source} is unreadable JSON: empty document")
    return values


def _load_pages(paths: list[Path], *, key: str, flag: str) -> list[dict[str, Any]]:
    """Read raw API responses: one page object, a page list, or a page stream."""
    pages: list[dict[str, Any]] = []
    for path in paths:
        try:
            raw = path.read_bytes()
        except OSError as exc:
            raise Refusal(f"cannot read {flag} file {path}: {exc}") from exc
        try:
            documents = _decode_json_documents(raw, source=f"{flag} file {path}")
        except QualificationInputError as exc:
            raise Refusal(str(exc)) from exc
        candidates: list[Any] = []
        for document in documents:
            if isinstance(document, list):
                candidates.extend(document)
            elif isinstance(document, dict):
                candidates.append(document)
            else:
                raise Refusal(
                    f"{flag} file {path} must hold page objects or page lists"
                )
        for candidate in candidates:
            if not isinstance(candidate, dict) or not isinstance(
                candidate.get(key), list
            ):
                raise Refusal(
                    f"{flag} file {path} has a page without a {key!r} list"
                )
            pages.append(candidate)
    return pages


def _is_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _collect_scoped_rows(
    pages: list[dict[str, Any]], *, caller_job: str
) -> tuple[list[dict[str, Any]], int]:
    """Return exact-scope rows plus the count of rows that could not match."""
    prefix = f"{caller_job} / "
    rows: list[dict[str, Any]] = []
    ignored = 0
    seen: set[str] = set()
    for page in pages:
        for row in page["jobs"]:
            if not isinstance(row, dict):
                ignored += 1
                continue
            if not isinstance(row.get("id"), int) or not isinstance(
                row.get("name"), str
            ):
                ignored += 1
                continue
            if not row["name"].startswith(prefix):
                ignored += 1
                continue
            fingerprint = json.dumps(row, sort_keys=True, default=str)
            if fingerprint in seen:
                continue
            seen.add(fingerprint)
            rows.append(row)
    return rows, ignored


def _artifact_index(pages: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    """Index raw artifact rows by name.

    Identical rows repeated across pages are pagination overlap and collapse.
    A live row supersedes an expired same-name tombstone. Two live rows under
    one name are an ambiguous identity and refuse instead of silently winning.
    """
    index: dict[str, dict[str, Any]] = {}
    seen: set[str] = set()
    for page in pages:
        for row in page["artifacts"]:
            if not isinstance(row, dict) or not isinstance(row.get("name"), str):
                continue
            fingerprint = json.dumps(row, sort_keys=True, default=str)
            if fingerprint in seen:
                continue
            seen.add(fingerprint)
            name = row["name"]
            prior = index.get(name)
            if prior is None or prior == row:
                index[name] = row
                continue
            if prior.get("expired") is True and row.get("expired") is not True:
                index[name] = row
                continue
            if row.get("expired") is True and prior.get("expired") is not True:
                continue
            raise Refusal(
                f"duplicate artifact identity {name!r}: ids "
                f"{prior.get('id')!r} and {row.get('id')!r}"
            )
    return index


def _step_outcomes(raw_steps: Any) -> list[dict[str, Any]]:
    steps: list[dict[str, Any]] = []
    if not isinstance(raw_steps, list):
        return steps
    for raw in raw_steps:
        if not isinstance(raw, dict):
            continue
        steps.append(
            {
                "name": raw.get("name"),
                "status": raw.get("status"),
                "conclusion": raw.get("conclusion"),
            }
        )
    return steps


def _evidence_binding(
    *,
    check_id: str,
    attempt: int,
    artifacts: dict[str, dict[str, Any]],
    evidence_root: Path,
) -> dict[str, Any]:
    """Locate the attempt payload or describe typed evidence absence."""
    slug = f"qualify-evidence-{check_id}-attempt-{attempt}"
    payload_name = f"qualify-evidence-{check_id}.json"
    row = artifacts.get(slug)
    if row is None:
        return {
            "evidence_error": f"evidence upload {slug} is missing",
            "evidence_error_class": "missing",
        }
    if row.get("expired") is True:
        return {
            "evidence_error": f"evidence upload {slug} has expired",
            "evidence_error_class": "missing",
        }
    relative = Path(f"attempt-{attempt}") / payload_name
    if ".." in relative.parts:
        return {
            "evidence_error": f"evidence payload {payload_name} escapes its directory",
            "evidence_error_class": "harness",
        }
    path = evidence_root / relative
    try:
        raw = path.read_bytes()
    except OSError as exc:
        return {
            "evidence_error": (
                f"evidence payload {relative} is missing or unreadable: {exc}"
            ),
            "evidence_error_class": "missing",
        }
    try:
        payload = strict_json_loads(raw, source=f"evidence payload {relative}")
    except QualificationInputError as exc:
        return {"evidence_error": str(exc), "evidence_error_class": "harness"}
    if not isinstance(payload, dict):
        return {
            "evidence_error": f"evidence payload {relative} must be an object",
            "evidence_error_class": "harness",
        }
    return {"evidence_file": relative.as_posix()}


def _fresh_record(
    *,
    row: dict[str, Any],
    entry: dict[str, Any],
    workflow_run_id: int,
    attempt: int,
    artifacts: dict[str, dict[str, Any]],
    evidence_root: Path,
) -> dict[str, Any]:
    job = entry["job"]
    execution_attempt = row.get("run_attempt")
    if not _is_int(execution_attempt):
        execution_attempt = attempt
    record: dict[str, Any] = {
        "workflow_file": entry["workflow"],
        "workflow_job_id": job["id"],
        "matrix": copy.deepcopy(job["matrix"]),
        "job_id": row["id"],
        "job_name": row["name"].split(" / ", 1)[-1],
        "workflow_run_id": (
            row["run_id"] if _is_int(row.get("run_id")) else workflow_run_id
        ),
        "execution_attempt": execution_attempt,
        "status": row.get("status"),
        "conclusion": row.get("conclusion"),
        "url": row.get("html_url", ""),
        "started_at": row.get("started_at"),
        "completed_at": row.get("completed_at"),
        "steps": _step_outcomes(row.get("steps")),
    }
    if entry.get("required_reporting_steps"):
        record.update(
            _evidence_binding(
                check_id=entry["id"],
                attempt=attempt,
                artifacts=artifacts,
                evidence_root=evidence_root,
            )
        )
    return record


def collect_bundle(
    *,
    inventory_bytes: bytes,
    manifest: dict[str, Any],
    jobs_pages: dict[int, list[Path]],
    artifact_pages: dict[int, list[Path]],
    evidence_root: Path,
    workflow_run_id: int,
    caller_job: str,
) -> tuple[dict[str, Any], dict[str, int]]:
    """Build the normalized job-history bundle from raw API responses."""
    inventory = load_inventory(inventory_bytes)
    digest = inventory_digest(inventory_bytes)
    attempts = sorted(jobs_pages)
    if [number for number in attempts] != list(range(1, len(attempts) + 1)):
        raise Refusal("attempt snapshots must be contiguous from 1")
    entries = [
        entry
        for entry in inventory["checks"]
        if entry.get("workflow") == QUALIFIED_WORKFLOW
    ]
    if not entries:
        raise Refusal("inventory carries no qualification workflow checks")
    snapshots: list[dict[str, Any]] = []
    stats = {"scoped_rows": 0, "ignored_rows": 0, "carried_records": 0}
    previous: dict[str, dict[str, Any]] = {}
    for attempt in attempts:
        pages = _load_pages(jobs_pages[attempt], key="jobs", flag="--attempt-jobs")
        rows, ignored = _collect_scoped_rows(pages, caller_job=caller_job)
        stats["scoped_rows"] += len(rows)
        stats["ignored_rows"] += ignored
        artifact_rows: list[dict[str, Any]] = []
        for paths in artifact_pages.get(attempt, []):
            artifact_rows.extend(
                _load_pages([paths], key="artifacts", flag="--attempt-artifacts")
            )
        artifacts = _artifact_index(artifact_rows)
        by_name: dict[str, list[dict[str, Any]]] = {}
        for row in rows:
            stripped = row["name"].split(" / ", 1)[-1]
            by_name.setdefault(stripped, []).append(row)
        snapshot_jobs: list[dict[str, Any]] = []
        current: dict[str, dict[str, Any]] = {}
        for entry in entries:
            candidates = by_name.get(entry["job"]["name"], [])
            if candidates:
                for row in candidates:
                    record = _fresh_record(
                        row=row,
                        entry=entry,
                        workflow_run_id=workflow_run_id,
                        attempt=attempt,
                        artifacts=artifacts,
                        evidence_root=evidence_root,
                    )
                    snapshot_jobs.append(record)
                    current[entry["id"]] = record
            elif attempt > 1 and entry["id"] in previous:
                snapshot_jobs.append(copy.deepcopy(previous[entry["id"]]))
                current[entry["id"]] = copy.deepcopy(previous[entry["id"]])
                stats["carried_records"] += 1
        snapshots.append({"attempt": attempt, "jobs": snapshot_jobs})
        previous = current
    bundle = {
        "schema_version": JOB_BUNDLE_SCHEMA_VERSION,
        "repository": manifest.get("repository"),
        "candidate_id": manifest.get("candidate_id"),
        "generation": manifest.get("generation"),
        "sha": manifest.get("sha"),
        "expected_core_version": manifest.get("core_version"),
        "inventory_digest": digest,
        "workflow_run_id": workflow_run_id,
        "current_attempt": len(attempts),
        "attempts": snapshots,
    }
    return bundle, stats


def _run_gh(api_args: list[str]) -> tuple[int, bytes, str]:
    """Run ``gh api ...`` from PATH; returns (returncode, stdout, stderr)."""
    try:
        proc = subprocess.run(
            ["gh", "api", *api_args], capture_output=True, check=False
        )
    except OSError as exc:
        return 127, b"", str(exc)
    return (
        proc.returncode,
        proc.stdout,
        proc.stderr.decode("utf-8", "replace"),
    )


def fetch_evidence(
    *,
    repo: str,
    run_id: int,
    max_attempt: int,
    jobs_dir: Path,
    artifacts_file: Path,
    evidence_root: Path,
    zips_dir: Path,
) -> int:
    """Fetch attempt jobs, run-scoped artifacts, and evidence zips via ``gh``.

    Jobs stay attempt-scoped (that endpoint exists per attempt); artifacts are
    fetched once at the run scope (no per-attempt artifacts endpoint exists).
    API failures fail closed with EXIT_ERROR so the caller records typed red.
    Zip download failures only warn: the missing payloads evaluate red
    downstream. A payload filename claimed by two artifacts with different
    bytes is a conflicting identity and fails closed.
    """
    jobs_dir.mkdir(parents=True, exist_ok=True)
    artifacts_file.parent.mkdir(parents=True, exist_ok=True)
    evidence_root.mkdir(parents=True, exist_ok=True)
    zips_dir.mkdir(parents=True, exist_ok=True)
    for attempt in range(1, max_attempt + 1):
        code, out, err = _run_gh(
            [
                f"repos/{repo}/actions/runs/{run_id}/attempts/{attempt}/jobs",
                "--paginate",
                "--slurp",
            ]
        )
        if code != 0:
            print(
                f"::error::failed to fetch qualify-ci jobs for attempt {attempt}: "
                f"{err.strip() or f'gh api exited {code}'}",
                file=sys.stderr,
            )
            return EXIT_ERROR
        (jobs_dir / f"attempt-{attempt}.json").write_bytes(out)
    code, out, err = _run_gh(
        [f"repos/{repo}/actions/runs/{run_id}/artifacts", "--paginate", "--slurp"]
    )
    if code != 0:
        print(
            "::error::failed to fetch qualify-ci artifacts for run "
            f"{run_id}: {err.strip() or f'gh api exited {code}'}",
            file=sys.stderr,
        )
        return EXIT_ERROR
    artifacts_file.write_bytes(out)
    try:
        documents = _decode_json_documents(out, source=str(artifacts_file))
    except QualificationInputError as exc:
        print(f"::error::qualify-ci artifacts response is unreadable: {exc}")
        return EXIT_ERROR
    rows: list[dict[str, Any]] = []
    for document in documents:
        candidates = document if isinstance(document, list) else [document]
        for candidate in candidates:
            if isinstance(candidate, dict) and isinstance(
                candidate.get("artifacts"), list
            ):
                rows.extend(
                    row for row in candidate["artifacts"] if isinstance(row, dict)
                )
    failed = False
    for attempt in range(1, max_attempt + 1):
        suffix = f"-attempt-{attempt}"
        target = evidence_root / f"attempt-{attempt}"
        target.mkdir(parents=True, exist_ok=True)
        for row in rows:
            name = row.get("name", "")
            if (
                not isinstance(name, str)
                or not name.startswith(EVIDENCE_ARTIFACT_PREFIX)
                or not name.endswith(suffix)
                or row.get("expired") is True
            ):
                continue
            code, zipped, err = _run_gh(
                [f"repos/{repo}/actions/artifacts/{row['id']}/zip"]
            )
            if code != 0:
                print(
                    f"::warning::download of evidence artifact {name} failed: "
                    f"{err.strip() or f'gh api exited {code}'}"
                )
                failed = True
                continue
            dest = zips_dir / f"attempt-{attempt}-{name}.zip"
            dest.write_bytes(zipped)
            try:
                with zipfile.ZipFile(dest) as archive:
                    for member in archive.namelist():
                        leaf = member.rsplit("/", 1)[-1]
                        if not (
                            leaf.startswith(EVIDENCE_ARTIFACT_PREFIX)
                            and leaf.endswith(".json")
                        ):
                            continue
                        payload = archive.read(member)
                        path = target / leaf
                        if path.is_file() and path.read_bytes() != payload:
                            print(
                                "::error::conflicting evidence payload "
                                f"{path} from artifact {name}; refusing to overwrite"
                            )
                            return EXIT_ERROR
                        path.write_bytes(payload)
            except zipfile.BadZipFile as exc:
                print(f"::warning::evidence artifact {name} is not a zip: {exc}")
                failed = True
    if failed:
        print(
            "::warning::some qualification evidence downloads failed; "
            "the evaluator records them as typed red"
        )
    return EXIT_OK


def build_fetch_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=fetch_evidence.__doc__)
    parser.add_argument("--repo", required=True, help="owner/name repository")
    parser.add_argument("--run-id", required=True, type=int)
    parser.add_argument(
        "--attempts", required=True, type=int, help="highest workflow attempt to fetch"
    )
    parser.add_argument("--jobs-dir", required=True, help="attempt jobs pages directory")
    parser.add_argument(
        "--artifacts-file", required=True, help="run-scoped artifacts response path"
    )
    parser.add_argument(
        "--evidence-root",
        required=True,
        help="directory receiving attempt-N/qualify-evidence-<check>.json payloads",
    )
    parser.add_argument("--zips-dir", required=True, help="artifact zip staging directory")
    return parser


def fetch_evidence_main(argv: list[str]) -> int:
    args = build_fetch_parser().parse_args(argv)
    if args.run_id < 1 or args.attempts < 1:
        print("REFUSED run-id and attempts must be positive integers", file=sys.stderr)
        return EXIT_REFUSED
    try:
        return fetch_evidence(
            repo=args.repo,
            run_id=args.run_id,
            max_attempt=args.attempts,
            jobs_dir=Path(args.jobs_dir),
            artifacts_file=Path(args.artifacts_file),
            evidence_root=Path(args.evidence_root),
            zips_dir=Path(args.zips_dir),
        )
    except OSError as exc:
        print(f"ERROR {exc}", file=sys.stderr)
        return EXIT_ERROR


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--inventory",
        default=".github/release-qualification.json",
        help="exact versioned N1 inventory file",
    )
    parser.add_argument("--manifest", required=True, help="sealed manifest JSON path")
    parser.add_argument("--run-id", required=True, type=int)
    parser.add_argument(
        "--caller-job",
        default="qualify-ci",
        help="reusable-call job whose scoped jobs carry qualification evidence",
    )
    parser.add_argument(
        "--attempt-jobs",
        action="append",
        default=[],
        metavar="N=PATH",
        help="repeatable raw jobs API responses per workflow attempt",
    )
    parser.add_argument(
        "--attempt-artifacts",
        action="append",
        default=[],
        metavar="N=PATH",
        help="repeatable raw artifacts API responses per workflow attempt",
    )
    parser.add_argument(
        "--evidence-root",
        default="evidence",
        help="directory holding attempt-N/qualify-evidence-<check>.json payloads",
    )
    parser.add_argument("--out", required=True, help="normalized bundle output path")
    return parser


def main(argv: list[str] | None = None) -> int:
    words = list(argv) if argv is not None else sys.argv[1:]
    if words[:1] == ["fetch-evidence"]:
        return fetch_evidence_main(words[1:])
    args = build_parser().parse_args(argv)
    try:
        if args.run_id < 1:
            raise Refusal("run-id must be a positive integer")
        if not args.attempt_jobs:
            raise Refusal("at least one --attempt-jobs N=PATH entry is required")
        jobs_pages = _parse_numbered_paths(args.attempt_jobs, flag="--attempt-jobs")
        artifact_pages = _parse_numbered_paths(
            args.attempt_artifacts, flag="--attempt-artifacts"
        )
        try:
            inventory_bytes = Path(args.inventory).read_bytes()
        except OSError as exc:
            raise Refusal(f"cannot read inventory {args.inventory}: {exc}") from exc
        try:
            manifest_raw = Path(args.manifest).read_bytes()
        except OSError as exc:
            raise Refusal(f"cannot read manifest {args.manifest}: {exc}") from exc
        manifest = strict_json_loads(manifest_raw, source=f"manifest {args.manifest}")
        if not isinstance(manifest, dict):
            raise Refusal("manifest root must be an object")
        bundle, stats = collect_bundle(
            inventory_bytes=inventory_bytes,
            manifest=manifest,
            jobs_pages=jobs_pages,
            artifact_pages=artifact_pages,
            evidence_root=Path(args.evidence_root),
            workflow_run_id=args.run_id,
            caller_job=args.caller_job,
        )
        out_path = Path(args.out)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        temporary = out_path.with_name(out_path.name + ".tmp")
        temporary.write_text(
            json.dumps(bundle, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        os.replace(temporary, out_path)
        print(
            "wrote"
            f" {out_path} with {len(bundle['attempts'])} attempt(s),"
            f" {stats['scoped_rows']} scoped row(s),"
            f" {stats['carried_records']} carried record(s),"
            f" {stats['ignored_rows']} ignored row(s)"
        )
        return EXIT_OK
    except Refusal as exc:
        print(f"REFUSED {exc}", file=sys.stderr)
        return EXIT_REFUSED
    except (OSError, ValueError) as exc:
        print(f"ERROR {exc}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    raise SystemExit(main())
