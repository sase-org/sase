#!/usr/bin/env python3
"""Refresh the committed whole-suite shard timing table.

``tests/shard_timings.json`` is what lets the master gate's six shards start
balanced on a CI runner that has never run this suite before: the host-local
per-test-file duration store :mod:`tests._test_selection_timings` reads
cannot travel with a checkout, so the slowest files' durations are folded
into the repository instead. Only the 800 (by default) slowest files are
retained individually; the rest are summarized by one ``default_duration``
so the file stays small while an unmeasured — or newly added — test file
still gets a sane, non-zero estimate. See ``tests/_test_shards.py`` for how
the table is consumed.
"""

from __future__ import annotations

import argparse
import json
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from tests._test_selection_health_store import store_directory  # noqa: E402
from tests._test_selection_timings import (  # noqa: E402
    load_timing_table,
    recording_host,
    timings_directory,
)
from tests._test_shards import (  # noqa: E402
    DEFAULT_TIMINGS_PATH,
    FALLBACK_DURATION,
    SHARD_TIMINGS_SCHEMA,
    ShardSpec,
    ShardTimingTable,
    assign_shards,
    discover_test_files,
    format_shard_summary,
)


DEFAULT_LIMIT = 800
TIMINGS_PATH = REPO_ROOT / DEFAULT_TIMINGS_PATH


class ShardTimingsRefreshError(RuntimeError):
    """Raised when the source table cannot be trusted enough to refresh from."""


def _default_source_directory() -> Path:
    return timings_directory(store_directory(REPO_ROOT))


def build_shard_timings(
    *,
    limit: int = DEFAULT_LIMIT,
    now: datetime | None = None,
    host: str | None = None,
    source_directory: Path | None = None,
) -> dict[str, Any]:
    """The full committed-table payload, derived from local recordings.

    The slowest ``limit`` files are retained with their own rounded
    duration; every other measured file is folded into ``default_duration``,
    the mean of exactly the files this table does *not* name individually —
    not the mean of the retained (slowest) files, which would badly
    overestimate the ordinary file this default actually stands in for.
    """
    directory = source_directory or _default_source_directory()
    table = load_timing_table(directory, host=host)
    if table.empty:
        raise ShardTimingsRefreshError(
            f"no recorded timing data in {directory}; run `just test` or "
            "`just check-full` at least once before refreshing"
        )

    ranked = sorted(table.durations.items(), key=lambda item: (-item[1], item[0]))
    retained = ranked[:limit]
    omitted = ranked[limit:]

    if retained:
        slowest_path = retained[-1][0]
        if not (REPO_ROOT / slowest_path).is_file():
            raise ShardTimingsRefreshError(
                "refusing a stale source table: its slowest retained file "
                f"{slowest_path!r} no longer exists"
            )

    if omitted:
        default_duration = sum(seconds for _, seconds in omitted) / len(omitted)
    elif retained:
        default_duration = sum(seconds for _, seconds in retained) / len(retained)
    else:
        default_duration = FALLBACK_DURATION

    stamp = now or datetime.now(UTC)
    return {
        "schema": SHARD_TIMINGS_SCHEMA,
        "generated_at": stamp.astimezone(UTC).isoformat(),
        "host": recording_host() if host is None else host,
        "measured_file_count": len(table.durations),
        "default_duration": round(default_duration, 4),
        "durations": {path: round(seconds, 1) for path, seconds in retained},
    }


def _document(payload: dict[str, Any]) -> str:
    return json.dumps(payload, indent=2, sort_keys=True) + "\n"


def _load_committed() -> dict[str, Any] | None:
    if not TIMINGS_PATH.exists():
        return None
    try:
        payload = json.loads(TIMINGS_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return payload if isinstance(payload, dict) else None


def _check(payload: dict[str, Any]) -> int:
    """Compare the freshly computed table against the committed one.

    ``generated_at`` and ``host`` are expected to differ on every run and are
    therefore excluded; only the numbers that would change the shard
    assignment — the retained durations and the default — decide drift.
    """
    committed = _load_committed()
    if committed is None:
        print(
            f"[refresh_shard_timings] {DEFAULT_TIMINGS_PATH} is missing or "
            "unreadable; run `just refresh-shard-timings`",
            file=sys.stderr,
        )
        return 1
    if (
        committed.get("durations") == payload["durations"]
        and committed.get("default_duration") == payload["default_duration"]
    ):
        return 0
    print(
        f"[refresh_shard_timings] {DEFAULT_TIMINGS_PATH} is stale relative to "
        "this host's local recordings; run `just refresh-shard-timings`",
        file=sys.stderr,
    )
    return 1


def _print_plan(count: int, payload: dict[str, Any]) -> None:
    files = discover_test_files(REPO_ROOT)
    table = ShardTimingTable(
        default_duration=float(payload["default_duration"]),
        durations={
            str(path): float(seconds) for path, seconds in payload["durations"].items()
        },
    )
    bins = assign_shards(files, count, table)
    for index, shard_bin in enumerate(bins, start=1):
        spec = ShardSpec(index=index, count=count)
        print(format_shard_summary(spec, shard_bin, total_files=len(files)))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--limit",
        type=int,
        default=DEFAULT_LIMIT,
        help=f"number of slowest files to retain individually (default {DEFAULT_LIMIT})",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--check",
        action="store_true",
        help="check the committed table for drift instead of writing it",
    )
    mode.add_argument(
        "--print-plan",
        type=int,
        metavar="N",
        default=None,
        help="print an N-shard plan from the freshly computed table and exit",
    )
    args = parser.parse_args(argv)

    if args.limit < 1:
        parser.error("--limit must be a positive integer")
    if args.print_plan is not None and args.print_plan < 1:
        parser.error("--print-plan must be a positive integer")

    try:
        payload = build_shard_timings(limit=args.limit)
    except ShardTimingsRefreshError as error:
        print(f"[refresh_shard_timings] {error}", file=sys.stderr)
        return 1

    if args.print_plan is not None:
        _print_plan(args.print_plan, payload)
        return 0

    if args.check:
        return _check(payload)

    TIMINGS_PATH.write_text(_document(payload), encoding="utf-8")
    print(
        f"[refresh_shard_timings] wrote {len(payload['durations'])} of "
        f"{payload['measured_file_count']} measured file(s) to "
        f"{DEFAULT_TIMINGS_PATH}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
