#!/usr/bin/env python3
"""Validate the generated SASE handbook PDF."""

from __future__ import annotations

import re
import sys
from argparse import ArgumentParser, Namespace
from pathlib import Path

from pypdf import PdfReader


DEFAULT_SITE_DIR = Path("site")
MAX_SIZE_BYTES = 22 * 1024 * 1024
MIN_PAGE_COUNT = 8

REQUIRED_SENTINELS = (
    "Structured Agentic Software Engineering",
    "ACE TUI",
    "AXE Automation",
    "Spec-Driven Development",
    "Patches",
    "Why Coding Agents Need Orchestration",
)

BLOG_SENTINELS = (
    "The SASE Blog is the publishing surface for essays",
    "SASE is a local orchestration layer above coding-agent CLIs",
)

FORBIDDEN_FRONT_MATTER_TOKENS = (
    "{{",
    "{%",
    "config.site_name",
    "pdf_meta.build_date",
)

REQUIRED_METADATA = {
    "/Title": "SASE Handbook",
    "/Author": "SASE contributors",
}

REQUIRED_OUTLINE_TITLES = (
    "ACE TUI User Guide",
    "Configuration",
)


def _normalize(text: str) -> str:
    return re.sub(r"\s+", " ", text).casefold()


def _compact(text: str) -> str:
    return re.sub(r"\s+", "", _normalize(text))


def _error(message: str) -> None:
    print(f"[validate_docs_pdf] {message}", file=sys.stderr)


def _extract_text(reader: PdfReader) -> str:
    chunks: list[str] = []
    for index, page in enumerate(reader.pages, start=1):
        try:
            chunks.append(page.extract_text() or "")
        except Exception as exc:
            _error(f"failed to extract text from page {index}: {exc}")
            raise
    return "\n".join(chunks)


def _extract_front_text(reader: PdfReader, page_limit: int = 4) -> str:
    chunks: list[str] = []
    for page in reader.pages[:page_limit]:
        chunks.append(page.extract_text() or "")
    return "\n".join(chunks)


def _outline_titles(outline: list[object]) -> list[str]:
    titles: list[str] = []
    for item in outline:
        if isinstance(item, list):
            titles.extend(_outline_titles(item))
            continue

        title = getattr(item, "title", "")
        if title:
            titles.append(str(title))
    return titles


def _parse_args() -> Namespace:
    parser = ArgumentParser(description="Validate the generated SASE handbook PDF.")
    parser.add_argument(
        "--site-dir",
        type=Path,
        default=DEFAULT_SITE_DIR,
        help="MkDocs output directory containing downloads/sase-handbook.pdf.",
    )
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    pdf_path = args.site_dir / "downloads" / "sase-handbook.pdf"

    if not pdf_path.exists():
        _error(f"missing PDF: {pdf_path}")
        return 1

    size = pdf_path.stat().st_size
    if size <= 0:
        _error(f"empty PDF: {pdf_path}")
        return 1

    if size > MAX_SIZE_BYTES:
        _error(
            f"PDF is {size / 1024 / 1024:.1f} MiB, "
            f"above the {MAX_SIZE_BYTES / 1024 / 1024:.0f} MiB limit"
        )
        return 1

    reader = PdfReader(str(pdf_path))
    page_count = len(reader.pages)
    if page_count < MIN_PAGE_COUNT:
        _error(
            f"PDF has {page_count} page(s), expected at least {MIN_PAGE_COUNT}"
        )
        return 1

    front_text = _extract_front_text(reader)
    leaked_tokens = [
        token for token in FORBIDDEN_FRONT_MATTER_TOKENS if token in front_text
    ]
    if leaked_tokens:
        _error("raw template token(s) leaked into front matter:")
        for token in leaked_tokens:
            _error(f"  - {token}")
        return 1

    text = _normalize(_extract_text(reader))

    missing = [
        sentinel
        for sentinel in REQUIRED_SENTINELS
        if _normalize(sentinel) not in text
    ]
    if missing:
        _error("missing required sentinel text:")
        for sentinel in missing:
            _error(f"  - {sentinel}")
        return 1

    if not any(_normalize(sentinel) in text for sentinel in BLOG_SENTINELS):
        _error("missing blog-post sentinel text")
        return 1

    if "1structuredagenticsoftwareengineering" not in _compact(text):
        _error("missing numbered handbook title")
        return 1

    if _normalize("4.1 Overview") not in text:
        _error("missing representative nested heading number")
        return 1

    metadata = reader.metadata or {}
    missing_metadata = [
        (key, expected)
        for key, expected in REQUIRED_METADATA.items()
        if metadata.get(key) != expected
    ]
    if missing_metadata:
        _error("missing or incorrect PDF metadata:")
        for key, expected in missing_metadata:
            _error(f"  - {key}: expected {expected!r}")
        return 1

    outline_titles = _outline_titles(reader.outline)
    if not outline_titles:
        _error("missing PDF outline/bookmarks")
        return 1

    missing_outline_titles = [
        title
        for title in REQUIRED_OUTLINE_TITLES
        if not any(title in outline_title for outline_title in outline_titles)
    ]
    if missing_outline_titles:
        _error("missing representative PDF outline entries:")
        for title in missing_outline_titles:
            _error(f"  - {title}")
        return 1

    print(
        f"[validate_docs_pdf] ok: {pdf_path} "
        f"({page_count} pages, {size / 1024 / 1024:.1f} MiB)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
