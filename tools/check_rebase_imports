#!/usr/bin/env python3
"""After-rebase first-party import checker.

Reads ``SASE_REBASE_CONTEXT`` and writes ``SASE_REBASE_RESULT`` using the
shared rebase-gate report protocol. This is repo-local tooling, not a public
``sase`` CLI command.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import _check_rebase_imports as check_rebase_imports


def main() -> int:
    """Dispatch to the stdlib helper."""

    return check_rebase_imports.main()


if __name__ == "__main__":
    raise SystemExit(main())
