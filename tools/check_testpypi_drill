#!/usr/bin/env python3
"""TestPyPI yank-and-fix-forward drill check (phase sase-1my.5).

Asserts the registry state for one step of the E1 runbook drill, in which a
throwaway package walks through a yank and a fix-forward on TestPyPI:

- ``good``: 0.0.1 published, installable.
- ``broken``: 0.0.2 published with a dependency nothing can satisfy.
- ``yanked``: a human yanked 0.0.2 in the TestPyPI UI; unpinned resolution
  must skip it while ``==0.0.2`` still lists files (exact pins keep working).
- ``fixed``: 0.0.3 published as the fix-forward and winning unpinned
  resolution, with 0.0.2 still yanked.

Only the stdlib plus ``packaging`` is used. The workflow runs this through
``uv run --no-project --with packaging`` so the runner needs no checkout
install. Unreadable, malformed or partial registry evidence never yields
green: the check fails closed.
"""

from __future__ import annotations

import argparse
import json
import sys
import urllib.error
import urllib.request
from collections.abc import Callable, Mapping
from dataclasses import dataclass, field
from typing import Any

from packaging.version import InvalidVersion, Version


#: The drill's fixed version ladder. The workflow publishes exactly these.
DRILL_VERSIONS = ("0.0.1", "0.0.2", "0.0.3")

#: The broken release the drill yanks.
BROKEN_VERSION = "0.0.2"

#: Assertion steps, in drill order.
STEPS = ("good", "broken", "yanked", "fixed")

DEFAULT_API_URL = "https://test.pypi.org/pypi/"


class DrillFetchError(RuntimeError):
    """Registry evidence is missing, unreachable, or malformed (fail closed)."""


@dataclass(frozen=True)
class ReleaseState:
    """One drill version's registry state."""

    present: bool = False
    yanked: bool = False
    files: tuple[str, ...] = ()
    requires_dist: tuple[str, ...] = ()


@dataclass(frozen=True)
class ProjectState:
    """The drill project's registry state, keyed by version string."""

    releases: Mapping[str, ReleaseState] = field(default_factory=dict)


@dataclass(frozen=True)
class Verdict:
    """One step assertion outcome."""

    ok: bool
    reason: str


def _project_url(api_url: str, project: str) -> str:
    return f"{api_url.rstrip('/')}/{project}/json"


def _version_url(api_url: str, project: str, version: str) -> str:
    return f"{api_url.rstrip('/')}/{project}/{version}/json"


def _default_fetch(url: str) -> Any:
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        raise DrillFetchError(f"GET {url}: HTTP {exc.code}") from exc
    except urllib.error.URLError as exc:
        raise DrillFetchError(f"GET {url}: unreachable ({exc.reason})") from exc
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise DrillFetchError(f"GET {url}: malformed JSON ({exc})") from exc


def fetch_state(
    project: str,
    api_url: str = DEFAULT_API_URL,
    fetch: Callable[[str], Any] = _default_fetch,
) -> ProjectState:
    """Read the drill project's registry state, failing closed on any gap."""
    try:
        payload = fetch(_project_url(api_url, project))
    except KeyError as exc:
        raise DrillFetchError(f"fixture has no project document ({exc})") from exc
    if not isinstance(payload, dict):
        raise DrillFetchError("project document is not a JSON object")
    releases = payload.get("releases")
    if not isinstance(releases, dict):
        raise DrillFetchError("project document has no releases map")

    states: dict[str, ReleaseState] = {}
    for version, files in releases.items():
        if not isinstance(files, list):
            raise DrillFetchError(f"release {version}: file list is malformed")
        names: list[str] = []
        for entry in files:
            if not isinstance(entry, dict) or "filename" not in entry:
                raise DrillFetchError(f"release {version}: file entry is malformed")
            names.append(str(entry["filename"]))
        file_yanked = [bool(entry.get("yanked", False)) for entry in files]
        states[str(version)] = ReleaseState(
            present=True,
            yanked=bool(file_yanked) and all(file_yanked),
            files=tuple(names),
        )

    for version in DRILL_VERSIONS:
        if version not in states:
            continue
        try:
            version_payload = fetch(_version_url(api_url, project, version))
        except KeyError as exc:
            raise DrillFetchError(
                f"fixture has no document for {version} ({exc})"
            ) from exc
        if not isinstance(version_payload, dict):
            raise DrillFetchError(f"document for {version} is not a JSON object")
        info = version_payload.get("info")
        if not isinstance(info, dict):
            raise DrillFetchError(f"document for {version} has no info map")
        requires = info.get("requires_dist")
        if requires is None:
            requires = []
        if not isinstance(requires, list) or not all(
            isinstance(item, str) for item in requires
        ):
            raise DrillFetchError(f"document for {version}: requires_dist is malformed")
        current = states[version]
        states[version] = ReleaseState(
            present=current.present,
            yanked=current.yanked or bool(info.get("yanked", False)),
            files=current.files,
            requires_dist=tuple(requires),
        )
    return ProjectState(releases=states)


def newest_unyanked(state: ProjectState) -> str | None:
    """Newest release with at least one unyanked file, or None when empty."""
    best: Version | None = None
    best_raw: str | None = None
    for raw, release in state.releases.items():
        if not release.present or release.yanked:
            continue
        try:
            parsed = Version(raw)
        except InvalidVersion:
            continue
        if best is None or parsed > best:
            best = parsed
            best_raw = raw
    return best_raw


def evaluate(state: ProjectState, step: str) -> Verdict:
    """Assert one drill step's registry state (pure; fixtures welcome)."""
    releases = state.releases

    def _release(version: str) -> ReleaseState:
        return releases.get(version, ReleaseState())

    good = _release("0.0.1")
    broken = _release(BROKEN_VERSION)
    fixed = _release("0.0.3")

    if step == "good":
        if not good.present:
            return Verdict(False, "DRILL_NOT_PUBLISHED 0.0.1 is absent")
        if good.yanked:
            return Verdict(False, "DRILL_YANKED 0.0.1 is yanked")
        return Verdict(True, "0.0.1 published and unyanked")

    if step == "broken":
        if not good.present or good.yanked:
            return Verdict(False, "DRILL_NOT_PUBLISHED 0.0.1 is absent or yanked")
        if not broken.present:
            return Verdict(False, "DRILL_NOT_PUBLISHED 0.0.2 is absent")
        if broken.yanked:
            return Verdict(False, "DRILL_YANKED 0.0.2 is already yanked")
        if not broken.requires_dist:
            return Verdict(
                False, "DRILL_NOT_BROKEN 0.0.2 declares no dependency to fail on"
            )
        return Verdict(
            True,
            f"0.0.2 published with unsatisfiable dependency "
            f"({', '.join(broken.requires_dist)})",
        )

    if step == "yanked":
        if not broken.present:
            return Verdict(False, "DRILL_NOT_PUBLISHED 0.0.2 is absent")
        if not broken.yanked:
            return Verdict(False, "DRILL_NOT_YANKED 0.0.2 is still installable")
        if not broken.files:
            return Verdict(
                False, "DRILL_FILES_GONE 0.0.2 lists no files; ==0.0.2 must resolve"
            )
        winner = newest_unyanked(state)
        if winner != "0.0.1":
            return Verdict(
                False,
                f"DRILL_WRONG_WINNER newest unyanked is {winner}; expected 0.0.1",
            )
        return Verdict(True, "0.0.2 yanked; unpinned resolution falls back to 0.0.1")

    if step == "fixed":
        if not fixed.present:
            return Verdict(False, "DRILL_NOT_PUBLISHED 0.0.3 is absent")
        if fixed.yanked:
            return Verdict(False, "DRILL_YANKED 0.0.3 is yanked")
        if not broken.yanked:
            return Verdict(False, "DRILL_NOT_YANKED 0.0.2 was un-yanked mid-drill")
        winner = newest_unyanked(state)
        if winner != "0.0.3":
            return Verdict(
                False,
                f"DRILL_WRONG_WINNER newest unyanked is {winner}; expected 0.0.3",
            )
        return Verdict(True, "0.0.3 published and winning; 0.0.2 stays yanked")

    raise ValueError(f"unknown drill step: {step!r}")


def check(
    project: str,
    step: str,
    api_url: str = DEFAULT_API_URL,
    fetch: Callable[[str], Any] = _default_fetch,
) -> Verdict:
    """Fetch registry state and assert one drill step, failing closed."""
    try:
        state = fetch_state(project, api_url, fetch)
    except DrillFetchError as exc:
        return Verdict(False, f"DRILL_FETCH_ERROR {exc}")
    return evaluate(state, step)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Assert one TestPyPI yank-and-fix-forward drill step."
    )
    parser.add_argument("--project", required=True, help="TestPyPI project name")
    parser.add_argument("--step", required=True, choices=STEPS, help="drill step")
    parser.add_argument("--api-url", default=DEFAULT_API_URL, help="JSON API root")
    parser.add_argument(
        "--fixture",
        default=None,
        help="project JSON document file for offline runs (also needs "
        "<fixture-dir>/<version>.json per drill version present)",
    )
    args = parser.parse_args(argv)

    fetch: Callable[[str], Any] = _default_fetch
    if args.fixture is not None:
        from pathlib import Path

        fixture = Path(args.fixture)
        try:
            project_payload = json.loads(fixture.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            print(f"DRILL_FETCH_ERROR cannot read fixture ({exc})")
            return 1

        def _fixture_fetch(url: str) -> Any:
            if url == _project_url(args.api_url, args.project):
                return project_payload
            for version in DRILL_VERSIONS:
                if url == _version_url(args.api_url, args.project, version):
                    path = fixture.parent / f"{version}.json"
                    return json.loads(path.read_text(encoding="utf-8"))
            raise DrillFetchError(f"fixture has no document for {url}")

        fetch = _fixture_fetch

    verdict = check(args.project, args.step, args.api_url, fetch)
    print(f"DRILL_{args.step.upper()} {args.project}: {verdict.reason}")
    return 0 if verdict.ok else 1


if __name__ == "__main__":
    sys.exit(main())
