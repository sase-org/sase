#!/usr/bin/env python3
"""Measure the TUI startup import closure and diff it against a revision.

With no arguments, imports ``sase.ace.tui.app`` in a fresh interpreter and
prints the first-party (``sase`` / ``sase.*``) module count the import-budget
guard enforces. With ``--diff REV``, the same import is measured at ``REV``
from a temporary detached worktree (using this interpreter with
``PYTHONPATH`` pointed at the worktree's ``src``), and the first-party
modules added and removed since ``REV`` are printed. The worktree is
removed afterwards.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
import textwrap
from dataclasses import dataclass
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
MEASURE_SNIPPET = textwrap.dedent(
    """
    import importlib
    import json
    import sys
    import time

    started = time.process_time()
    importlib.import_module("sase.ace.tui.app")
    elapsed = time.process_time() - started

    print(json.dumps({
        "elapsed_seconds": elapsed,
        "module_count": len(sys.modules),
        "sase_modules": sorted(
            name
            for name in sys.modules
            if name == "sase" or name.startswith("sase.")
        ),
    }))
    """
)


def is_first_party_module(name: str) -> bool:
    """Return True for the ``sase`` package and its submodules."""
    return name == "sase" or name.startswith("sase.")


@dataclass(frozen=True)
class ClosureMeasurement:
    elapsed_seconds: float
    module_count: int
    sase_modules: tuple[str, ...]

    @property
    def sase_module_count(self) -> int:
        return len(self.sase_modules)


def _measure(cwd: Path, extra_src: Path | None = None) -> ClosureMeasurement:
    """Import the TUI app in a fresh interpreter and measure its closure."""
    env = dict(os.environ)
    if extra_src is not None:
        path = str(extra_src)
        previous = env.get("PYTHONPATH", "")
        env["PYTHONPATH"] = f"{path}{os.pathsep}{previous}" if previous else path
    result = subprocess.run(
        [sys.executable, "-c", MEASURE_SNIPPET],
        check=False,
        text=True,
        capture_output=True,
        cwd=cwd,
        env=env,
    )
    if result.returncode != 0:
        detail = (result.stderr + result.stdout).strip().splitlines()
        tail = "\n".join(detail[-15:])
        raise SystemExit(f"TUI app import failed:\n{tail}")
    payload = json.loads(result.stdout)
    return ClosureMeasurement(
        elapsed_seconds=float(payload["elapsed_seconds"]),
        module_count=int(payload["module_count"]),
        sase_modules=tuple(
            name for name in payload["sase_modules"] if is_first_party_module(name)
        ),
    )


def _resolve_rev(rev: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", rev],
        check=False,
        text=True,
        capture_output=True,
        cwd=REPO_ROOT,
    )
    if result.returncode != 0:
        raise SystemExit(f"unknown revision {rev!r}: {result.stderr.strip()}")
    return result.stdout.strip()


def _measure_at_rev(rev: str, sha: str) -> ClosureMeasurement:
    """Measure the closure at *sha* from a temporary detached worktree."""
    worktree = Path(tempfile.mkdtemp(prefix="tui-import-closure-"))
    worktree.rmdir()
    try:
        add = subprocess.run(
            ["git", "worktree", "add", "--detach", str(worktree), sha],
            check=False,
            text=True,
            capture_output=True,
            cwd=REPO_ROOT,
        )
        if add.returncode != 0:
            raise SystemExit(
                f"cannot check out {rev!r}: {(add.stderr or add.stdout).strip()}"
            )
        return _measure(REPO_ROOT, extra_src=worktree / "src")
    finally:
        subprocess.run(
            ["git", "worktree", "remove", "--force", str(worktree)],
            check=False,
            capture_output=True,
            cwd=REPO_ROOT,
        )


def _colored(text: str, code: str) -> str:
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{code}m{text}\033[0m"


def format_current_line(measurement: ClosureMeasurement) -> str:
    """Return the bare-form summary line (first-party count first)."""
    return (
        f"TUI app import closure: {measurement.sase_module_count} sase.* "
        f"modules ({measurement.module_count} total, "
        f"{measurement.elapsed_seconds:.2f}s CPU)"
    )


def format_base_line(rev: str, sha: str, measurement: ClosureMeasurement) -> str:
    """Return the ``--diff`` baseline summary line."""
    return (
        f"at {rev} ({sha[:12]}): {measurement.sase_module_count} sase.* "
        f"modules ({measurement.module_count} total)"
    )


def format_change_line(current: ClosureMeasurement, base: ClosureMeasurement) -> str:
    """Return the ``--diff`` first-party delta line."""
    sase_delta = current.sase_module_count - base.sase_module_count
    total_delta = current.module_count - base.module_count
    return f"change: {sase_delta:+d} sase.* modules ({total_delta:+d} total)"


def format_diff_lines(
    current: ClosureMeasurement,
    base: ClosureMeasurement,
    *,
    rev: str,
    sha: str,
) -> list[str]:
    """Return ``--diff`` body lines after the current-closure summary."""
    lines = [
        format_base_line(rev, sha, base),
        format_change_line(current, base),
    ]
    added = sorted(set(current.sase_modules) - set(base.sase_modules))
    removed = sorted(set(base.sase_modules) - set(current.sase_modules))
    if added:
        lines.append(_colored(f"added ({len(added)}):", "32"))
        for name in added:
            lines.append(f"  {_colored('+' + name, '32')}")
    if removed:
        lines.append(_colored(f"removed ({len(removed)}):", "31"))
        for name in removed:
            lines.append(f"  {_colored('-' + name, '31')}")
    if not added and not removed:
        lines.append("no sase.* module changes")
    return lines


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Print the fresh-interpreter first-party (sase / sase.*) "
            "module count for `import sase.ace.tui.app`, optionally "
            "diffing that closure against a revision."
        ),
    )
    parser.add_argument(
        "-d",
        "--diff",
        metavar="REV",
        default=None,
        help=(
            "diff the current first-party closure against REV (measured "
            "from a temporary detached worktree) and list added/removed "
            "sase.* modules"
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    current = _measure(REPO_ROOT)
    print(format_current_line(current))
    if args.diff is None:
        return 0
    sha = _resolve_rev(args.diff)
    base = _measure_at_rev(args.diff, sha)
    for line in format_diff_lines(current, base, rev=args.diff, sha=sha):
        print(line)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
