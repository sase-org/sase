#!/usr/bin/env python3
"""Measure the TUI startup import closure and diff it against a revision.

With no arguments, imports ``sase.ace.tui.app`` in a fresh interpreter and
prints the first-party (``sase`` / ``sase.*``) module count, the normalized
source footprint the import-budget guard enforces, the total module count, and
import CPU time. With ``--diff REV``, the same import is measured at ``REV``
from a temporary detached worktree (using this interpreter with
``PYTHONPATH`` pointed at the worktree's ``src``), and the signed footprint
change, the sources that contributed to it (including modules present on both
sides whose contents changed), and the first-party modules added and removed
since ``REV`` are printed. The worktree is removed afterwards.

The footprint is defined by ``tools/_tui_import_footprint.py``: imported
first-party source minus import statements, docstrings, literal ``__all__``
lists, comments, and whitespace. A mechanical module split therefore leaves it
unchanged while additional imported implementation grows it.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
_TOOLS_DIR = str(Path(__file__).resolve().parent)
if _TOOLS_DIR not in sys.path:
    sys.path.insert(0, _TOOLS_DIR)

import _tui_import_footprint as footprint  # noqa: E402


ClosureMeasurement = footprint.ImportMeasurement


def is_first_party_module(name: str) -> bool:
    """Return True for the ``sase`` package and its submodules."""
    return footprint.is_first_party_module(name)


@dataclass(frozen=True)
class FootprintChange:
    """One imported source whose footprint differs between two closures."""

    name: str
    base_bytes: int | None
    current_bytes: int | None

    @property
    def delta(self) -> int:
        return (self.current_bytes or 0) - (self.base_bytes or 0)

    @property
    def detail(self) -> str:
        if self.base_bytes is None:
            return "added"
        if self.current_bytes is None:
            return "removed"
        return f"changed: {self.base_bytes:,} -> {self.current_bytes:,}"


def footprint_changes(
    current: ClosureMeasurement, base: ClosureMeasurement
) -> list[FootprintChange]:
    """Return per-source footprint differences, largest absolute change first."""
    current_bytes = current.footprint.module_bytes
    base_bytes = base.footprint.module_bytes
    changes = [
        FootprintChange(name, base_bytes.get(name), current_bytes.get(name))
        for name in sorted(set(current_bytes) | set(base_bytes))
    ]
    return sorted(
        (change for change in changes if change.delta != 0),
        key=lambda change: (-abs(change.delta), change.name),
    )


def _measure(
    cwd: Path,
    extra_src: Path | None = None,
    cache: footprint.FootprintCache | None = None,
) -> ClosureMeasurement:
    """Import the TUI app in a fresh interpreter and measure its closure."""
    try:
        return footprint.measure_import(
            cwd=cwd,
            extra_paths=[] if extra_src is None else [extra_src],
            cache=cache,
        )
    except (footprint.ImportProbeError, footprint.FootprintError) as error:
        raise SystemExit(f"TUI app measurement failed: {error}") from error


def _resolve_rev(rev: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", rev],
        check=False,
        text=True,
        capture_output=True,
        cwd=REPO_ROOT,
    )
    if result.returncode != 0:
        raise SystemExit(f"unknown revision {rev!r}: {result.stderr.strip()}")
    return result.stdout.strip()


def _measure_at_rev(
    rev: str, sha: str, cache: footprint.FootprintCache | None = None
) -> ClosureMeasurement:
    """Measure the closure at *sha* from a temporary detached worktree."""
    worktree = Path(tempfile.mkdtemp(prefix="tui-import-closure-"))
    worktree.rmdir()
    try:
        add = subprocess.run(
            ["git", "worktree", "add", "--detach", str(worktree), sha],
            check=False,
            text=True,
            capture_output=True,
            cwd=REPO_ROOT,
        )
        if add.returncode != 0:
            raise SystemExit(
                f"cannot check out {rev!r}: {(add.stderr or add.stdout).strip()}"
            )
        return _measure(REPO_ROOT, extra_src=worktree / "src", cache=cache)
    finally:
        subprocess.run(
            ["git", "worktree", "remove", "--force", str(worktree)],
            check=False,
            capture_output=True,
            cwd=REPO_ROOT,
        )


def _colored(text: str, code: str) -> str:
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{code}m{text}\033[0m"


def format_current_line(measurement: ClosureMeasurement) -> str:
    """Return the bare-form summary line (first-party count first)."""
    return (
        f"TUI app import closure: {measurement.first_party_count} sase.* "
        f"modules ({measurement.module_count} total, "
        f"{measurement.elapsed_seconds:.2f}s CPU), "
        f"footprint {measurement.footprint_bytes:,} bytes"
    )


def format_base_line(rev: str, sha: str, measurement: ClosureMeasurement) -> str:
    """Return the ``--diff`` baseline summary line."""
    return (
        f"at {rev} ({sha[:12]}): {measurement.first_party_count} sase.* "
        f"modules ({measurement.module_count} total), "
        f"footprint {measurement.footprint_bytes:,} bytes"
    )


def format_change_line(current: ClosureMeasurement, base: ClosureMeasurement) -> str:
    """Return the ``--diff`` first-party and footprint delta line."""
    sase_delta = current.first_party_count - base.first_party_count
    total_delta = current.module_count - base.module_count
    footprint_delta = current.footprint_bytes - base.footprint_bytes
    return (
        f"change: {sase_delta:+d} sase.* modules ({total_delta:+d} total), "
        f"footprint {footprint_delta:+,d} bytes"
    )


def format_diff_lines(
    current: ClosureMeasurement,
    base: ClosureMeasurement,
    *,
    rev: str,
    sha: str,
) -> list[str]:
    """Return ``--diff`` body lines after the current-closure summary."""
    lines = [
        format_base_line(rev, sha, base),
        format_change_line(current, base),
    ]
    changes = footprint_changes(current, base)
    if not changes:
        lines.append("no source footprint changes")
    else:
        if current.footprint_bytes == base.footprint_bytes:
            lines.append(
                f"footprint unchanged overall; source moved across {len(changes)} "
                "modules (largest first):"
            )
        else:
            lines.append(f"footprint contributors ({len(changes)}, largest first):")
        for change in changes:
            code = "32" if change.delta > 0 else "31"
            lines.append(
                f"  {_colored(f'{change.delta:+,d}', code)} {change.name} "
                f"({change.detail})"
            )
    added = sorted(set(current.first_party_modules) - set(base.first_party_modules))
    removed = sorted(set(base.first_party_modules) - set(current.first_party_modules))
    if added:
        lines.append(_colored(f"added ({len(added)}):", "32"))
        for name in added:
            lines.append(f"  {_colored('+' + name, '32')}")
    if removed:
        lines.append(_colored(f"removed ({len(removed)}):", "31"))
        for name in removed:
            lines.append(f"  {_colored('-' + name, '31')}")
    if not added and not removed:
        lines.append("no sase.* module changes")
    return lines


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Print the fresh-interpreter first-party (sase / sase.*) "
            "module count and normalized source footprint for "
            "`import sase.ace.tui.app`, optionally diffing that closure "
            "against a revision."
        ),
    )
    parser.add_argument(
        "-d",
        "--diff",
        metavar="REV",
        default=None,
        help=(
            "diff the current closure against REV (measured from a "
            "temporary detached worktree): signed footprint change, the "
            "sources that contributed to it, and the added/removed "
            "sase.* modules"
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    cache = footprint.FootprintCache()
    current = _measure(REPO_ROOT, cache=cache)
    print(format_current_line(current))
    if args.diff is None:
        return 0
    sha = _resolve_rev(args.diff)
    base = _measure_at_rev(args.diff, sha, cache)
    for line in format_diff_lines(current, base, rev=args.diff, sha=sha):
        print(line)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
