#!/usr/bin/env python3
"""Report per-instance TUI frozen share and GC share from ``tui_stalls.jsonl``.

The stall watchdog writes loop/pump hitch and stall rows, the GC telemetry
service writes ``tui_gc_pause`` and ``tui_memory_heartbeat`` rows, all into
the same JSONL log. This read-only script turns those rows into the
acceptance numbers for the freeze epic, split per ``app_instance_id``:

- the loop-only frozen share, preferring the heartbeat's exact
  ``loop_hitch_seconds`` (plus suppressed totals) and falling back to the
  hitch-interval union on old logs;
- median, p90, and max hitch duration;
- the late (whole-process, ``watchdog_lateness``) versus on-time split;
- GC share by generation and trigger, from heartbeats and pause rows;
- pause p50/p95/max split by ``idle`` / ``backstop`` / ``rss_backstop`` /
  ``startup_freeze`` / ``automatic``;
- automatic and backstop gen-2 collections that started within 2 s of input;
- the RSS/swap trajectory from heartbeats;
- ``--acceptance``, which marks each sase-1f3 target pass or fail.

Rows that predate instance IDs are bucketed into ``tui_startup`` record
windows (``startup-<n>``) instead of being dropped; rows outside every
window land in ``unknown``. Real startup rows carry an ISO ``timestamp``,
not ``ts``. The rotated ``tui_stalls.jsonl.1`` generation is read by
default (``--no-rotated`` opts out). Missing additive fields on old rows
default to the on-time, zero-overlap reading.
"""

from __future__ import annotations

import argparse
import json
import os
from collections.abc import Sequence
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, TypeGuard


REPO_ROOT = Path(__file__).resolve().parents[1]

STALLS_ENV_VAR = "SASE_TUI_STALL_PATH"
STARTUP_ENV_VAR = "SASE_TUI_STARTUP_PATH"

NEAR_INPUT_MAX_S = 2.0
NEAR_INPUT_TRIGGERS = frozenset({"automatic", "backstop", "rss_backstop"})
KNOWN_TRIGGERS = (
    "idle",
    "backstop",
    "rss_backstop",
    "startup_freeze",
    "automatic",
)
IDLE_P95_LIMIT_S = 0.5
GC_SHARE_LIMIT = 0.03
HITCH_SHARE_LIMIT = 0.005
RSS_GROWTH_LIMIT_BYTES = int(0.5 * 1024**3)
JK_P95_LIMIT_MS = 16.0
FOUR_HOURS_S = 4 * 3600.0


def _default_stalls_path() -> Path:
    override = os.environ.get(STALLS_ENV_VAR)
    if override:
        return Path(override)
    return Path.home() / ".sase" / "logs" / "tui_stalls.jsonl"


def _default_startup_path() -> Path:
    override = os.environ.get(STARTUP_ENV_VAR)
    if override:
        return Path(override)
    return Path.home() / ".sase" / "logs" / "tui_startup.jsonl"


def parse_time(value: str) -> float:
    """Parse an epoch float or ISO-8601 timestamp into epoch seconds."""
    try:
        return float(value)
    except ValueError:
        pass
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.timestamp()


def load_rows(path: Path) -> list[dict]:
    """Load JSONL rows, skipping blank lines and corrupt records."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    rows: list[dict] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            rows.append(record)
    return rows


def rotated_path(path: Path) -> Path:
    """Return the single rotated generation kept beside *path*."""
    return Path(f"{path}.1")


def load_stall_rows(path: Path, *, include_rotated: bool = True) -> list[dict]:
    """Load the active stall log and, by default, its ``.1`` rotation."""
    rows = load_rows(path)
    if include_rotated:
        rows.extend(load_rows(rotated_path(path)))
    return rows


def _row_ts(row: dict) -> float | None:
    """Return the row's epoch seconds from ``ts`` or ISO ``timestamp``."""
    ts = row.get("ts")
    if isinstance(ts, bool):
        pass
    elif isinstance(ts, (int, float)):
        return float(ts)
    timestamp = row.get("timestamp")
    if isinstance(timestamp, bool):
        return None
    if isinstance(timestamp, (int, float)):
        return float(timestamp)
    if isinstance(timestamp, str):
        try:
            parsed = datetime.fromisoformat(timestamp)
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed.timestamp()
    return None


def bucket_by_instance(
    rows: list[dict], startups: list[dict]
) -> dict[str, list[dict]]:
    """Group rows per app instance, windowing ID-less rows by startup.

    Rows carrying ``app_instance_id`` keep it. Rows without one are placed
    in the ``tui_startup`` window containing their timestamp
    (``startup-<n>``); rows outside every window land in ``unknown``.
    """
    windows: list[tuple[float, float, str]] = []
    starts = sorted(
        (ts, index)
        for index, row in enumerate(startups)
        if (ts := _row_ts(row)) is not None
    )
    for position, (start_ts, _) in enumerate(starts):
        end_ts = starts[position + 1][0] if position + 1 < len(starts) else float("inf")
        windows.append((start_ts, end_ts, f"startup-{position}"))

    buckets: dict[str, list[dict]] = {}
    for row in rows:
        instance = row.get("app_instance_id")
        if isinstance(instance, str) and instance:
            key = instance
        else:
            key = "unknown"
            ts = _row_ts(row)
            if ts is not None:
                for start_ts, end_ts, name in windows:
                    if start_ts <= ts < end_ts:
                        key = name
                        break
        buckets.setdefault(key, []).append(row)
    return buckets


def _percentile(sorted_values: list[float], rank: float) -> float | None:
    if not sorted_values:
        return None
    if len(sorted_values) == 1:
        return sorted_values[0]
    position = rank * (len(sorted_values) - 1)
    lower = int(position)
    upper = min(lower + 1, len(sorted_values) - 1)
    fraction = position - lower
    return sorted_values[lower] + (sorted_values[upper] - sorted_values[lower]) * fraction


def _median(values: list[float]) -> float | None:
    return _percentile(sorted(values), 0.5)


def _merge_union(intervals: list[tuple[float, float]]) -> float:
    """Total covered seconds of possibly overlapping [start, end] intervals."""
    total = 0.0
    cursor_start: float | None = None
    cursor_end = 0.0
    for start, end in sorted(intervals):
        if end <= start:
            continue
        if cursor_start is None:
            cursor_start, cursor_end = start, end
        elif start <= cursor_end:
            cursor_end = max(cursor_end, end)
        else:
            total += cursor_end - cursor_start
            cursor_start, cursor_end = start, end
    if cursor_start is not None:
        total += cursor_end - cursor_start
    return total


def _is_number(value: object) -> TypeGuard[int | float]:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _pause_stats(values: list[float]) -> dict[str, Any]:
    sorted_values = sorted(values)
    return {
        "count": len(values),
        "p50": _median(values),
        "p95": _percentile(sorted_values, 0.95),
        "max": max(values) if values else None,
    }


def _pause_near_input(
    row: dict, context_rows: list[tuple[float, float]]
) -> bool:
    age = row.get("input_age_s")
    if _is_number(age):
        return float(age) <= NEAR_INPUT_MAX_S
    pause_ts = _row_ts(row)
    if pause_ts is None:
        return False
    for ctx_ts, age_s in context_rows:
        if abs(pause_ts - ctx_ts) <= NEAR_INPUT_MAX_S and age_s <= NEAR_INPUT_MAX_S:
            return True
    return False


def summarize_instance(
    rows: list[dict], *, since: float | None = None, until: float | None = None
) -> dict:
    """Compute the acceptance numbers for one instance bucket."""
    ordered = sorted(
        (row for row in rows if _row_ts(row) is not None),
        key=lambda row: _row_ts(row) or 0.0,
    )
    if since is None:
        since = (_row_ts(ordered[0]) or 0.0) if ordered else 0.0
    if until is None:
        until = (_row_ts(ordered[-1]) or since) if ordered else since
    window_s = max(0.0, until - since)
    windowed = [
        row
        for row in ordered
        if since <= (_row_ts(row) or 0.0) <= until
    ]

    # Loop-tier hitch episodes. Pump rows never enter the union, so a freeze
    # seen by both tiers counts once.
    open_hitch: dict[str, dict] = {}
    episodes: list[dict] = []
    for row in windowed:
        event = row.get("event")
        if event == "tui_hitch" and "hitch" not in open_hitch:
            open_hitch["hitch"] = row
        elif event == "tui_hitch_recovered" and "hitch" in open_hitch:
            episodes.append({"hitch": open_hitch.pop("hitch"), "recovery": row})
    for leftover in open_hitch.values():
        episodes.append({"hitch": leftover, "recovery": None})

    intervals: list[tuple[float, float]] = []
    durations: list[float] = []
    late_episodes = 0
    late_seconds = 0.0
    ontime_episodes = 0
    ontime_seconds = 0.0
    for episode in episodes:
        hitch = episode["hitch"]
        recovery = episode["recovery"]
        start = _row_ts(hitch) or 0.0
        if recovery is not None and _is_number(recovery.get("duration_seconds")):
            duration = float(recovery["duration_seconds"])
        else:
            stall_seconds = hitch.get("stall_seconds")
            duration = float(stall_seconds) if _is_number(stall_seconds) else 0.0
        duration = max(0.0, duration)
        intervals.append((start, start + duration))
        durations.append(duration)
        late = bool(hitch.get("late", False)) or bool(
            (recovery or {}).get("late", False)
        )
        if late:
            late_episodes += 1
            late_seconds += duration
        else:
            ontime_episodes += 1
            ontime_seconds += duration

    union_frozen_s = _merge_union(intervals)
    sorted_durations = sorted(durations)

    # GC share from heartbeats (exact per-window totals) and pause rows.
    gc_seconds_by_gen: dict[str, float] = {}
    gc_seconds_by_trigger: dict[str, float] = {}
    loop_hitch_s = 0.0
    loop_suppressed_s = 0.0
    has_exact_hitch = False
    for row in windowed:
        if row.get("event") != "tui_memory_heartbeat":
            continue
        generations = row.get("gc_generations")
        if isinstance(generations, dict):
            for gen, stats in generations.items():
                if isinstance(stats, dict) and _is_number(stats.get("total_s")):
                    gc_seconds_by_gen[str(gen)] = gc_seconds_by_gen.get(
                        str(gen), 0.0
                    ) + float(stats["total_s"])
        hitch_seconds = row.get("loop_hitch_seconds")
        if _is_number(hitch_seconds):
            has_exact_hitch = True
            loop_hitch_s += float(hitch_seconds)
        suppressed_seconds = row.get("loop_suppressed_seconds")
        if _is_number(suppressed_seconds):
            loop_suppressed_s += float(suppressed_seconds)
    pause_rows = [row for row in windowed if row.get("event") == "tui_gc_pause"]
    pauses_by_trigger: dict[str, list[float]] = {name: [] for name in KNOWN_TRIGGERS}
    for row in pause_rows:
        pause_duration = row.get("duration_s")
        if not _is_number(pause_duration):
            continue
        gen = row.get("generation")
        trigger = row.get("trigger")
        key = f"gen-{gen}/{trigger}"
        gc_seconds_by_trigger[key] = gc_seconds_by_trigger.get(key, 0.0) + float(
            pause_duration
        )
        if isinstance(trigger, str):
            pauses_by_trigger.setdefault(trigger, []).append(float(pause_duration))
    gc_total_s = sum(gc_seconds_by_gen.values())
    idle_pauses = list(pauses_by_trigger.get("idle", []))
    pause_stats_by_trigger = {
        trigger: _pause_stats(values)
        for trigger, values in sorted(pauses_by_trigger.items())
    }

    frozen_s = loop_hitch_s if has_exact_hitch else union_frozen_s

    # Automatic and backstop gen-2 collections near input. Prefer the pause
    # row's ``input_age_s``; fall back to a hitch-row heuristic on old logs.
    context_rows = [
        (_row_ts(row) or 0.0, float(row["last_keypress_age_s"]))
        for row in windowed
        if _is_number(row.get("last_keypress_age_s")) and _row_ts(row) is not None
    ]
    near_input_totals: dict[str, dict[str, int]] = {
        trigger: {"total": 0, "near_input": 0} for trigger in NEAR_INPUT_TRIGGERS
    }
    for row in pause_rows:
        if row.get("generation") != 2:
            continue
        trigger = row.get("trigger")
        if trigger not in NEAR_INPUT_TRIGGERS:
            continue
        bucket = near_input_totals[str(trigger)]
        bucket["total"] += 1
        if _pause_near_input(row, context_rows):
            bucket["near_input"] += 1

    heartbeats = sorted(
        (row for row in windowed if row.get("event") == "tui_memory_heartbeat"),
        key=lambda row: _row_ts(row) or 0.0,
    )
    rss_first = heartbeats[0].get("rss_bytes") if heartbeats else None
    rss_last = heartbeats[-1].get("rss_bytes") if heartbeats else None
    swap_first = heartbeats[0].get("vmswap_bytes") if heartbeats else None
    swap_last = heartbeats[-1].get("vmswap_bytes") if heartbeats else None

    return {
        "row_count": len(windowed),
        "episodes": len(episodes),
        "window_s": round(window_s, 3),
        "frozen_s": round(frozen_s, 3),
        "frozen_share": (frozen_s / window_s) if window_s > 0 else 0.0,
        "hitch_duration_median": _median(durations),
        "hitch_duration_p90": _percentile(sorted_durations, 0.9),
        "hitch_duration_max": max(durations) if durations else None,
        "late_episodes": late_episodes,
        "late_seconds": round(late_seconds, 3),
        "ontime_episodes": ontime_episodes,
        "ontime_seconds": round(ontime_seconds, 3),
        "gc_total_s": round(gc_total_s, 3),
        "gc_share": (gc_total_s / window_s) if window_s > 0 else 0.0,
        "gc_seconds_by_generation": {
            gen: round(total, 3) for gen, total in sorted(gc_seconds_by_gen.items())
        },
        "gc_seconds_by_gen_trigger": {
            key: round(total, 3)
            for key, total in sorted(gc_seconds_by_trigger.items())
        },
        "idle_pause_count": len(idle_pauses),
        "idle_pause_p50": _median(idle_pauses),
        "idle_pause_p95": _percentile(idle_pauses, 0.95),
        "idle_pause_max": max(idle_pauses) if idle_pauses else None,
        "pause_stats_by_trigger": pause_stats_by_trigger,
        "auto_gen2_total": near_input_totals["automatic"]["total"],
        "auto_gen2_near_input": near_input_totals["automatic"]["near_input"],
        "backstop_gen2_total": near_input_totals["backstop"]["total"],
        "backstop_gen2_near_input": near_input_totals["backstop"]["near_input"],
        "rss_backstop_gen2_total": near_input_totals["rss_backstop"]["total"],
        "rss_backstop_gen2_near_input": near_input_totals["rss_backstop"]["near_input"],
        "loop_hitch_seconds": round(loop_hitch_s, 3),
        "loop_suppressed_seconds": round(loop_suppressed_s, 3),
        "rss_first_bytes": rss_first,
        "rss_last_bytes": rss_last,
        "swap_first_bytes": swap_first,
        "swap_last_bytes": swap_last,
        "heartbeat_count": len(heartbeats),
    }


def _verdict(passed: bool | None) -> str:
    if passed is None:
        return "n/a"
    return "PASS" if passed else "FAIL"


def evaluate_acceptance(summary: dict) -> dict[str, Any]:
    """Mark each sase-1f3 target pass, fail, or n/a for one instance."""
    idle_p95 = summary["idle_pause_p95"]
    idle_ok = True if idle_p95 is None else idle_p95 <= IDLE_P95_LIMIT_S
    gc_ok = summary["gc_share"] < GC_SHARE_LIMIT
    hitch_ok = summary["frozen_share"] < HITCH_SHARE_LIMIT
    near_input = (
        int(summary["auto_gen2_near_input"])
        + int(summary["backstop_gen2_near_input"])
        + int(summary["rss_backstop_gen2_near_input"])
    )
    near_ok = near_input == 0
    rss_first = summary["rss_first_bytes"]
    rss_last = summary["rss_last_bytes"]
    rss_growth: float | None = None
    rss_ok: bool | None
    if _is_number(rss_first) and _is_number(rss_last):
        rss_growth = float(rss_last) - float(rss_first)
        rss_ok = rss_growth < RSS_GROWTH_LIMIT_BYTES
    else:
        rss_ok = None
    swap_last = summary["swap_last_bytes"]
    if _is_number(swap_last):
        swap_ok: bool | None = float(swap_last) == 0.0
    else:
        swap_ok = None
    targets = {
        "idle_p95": {
            "pass": idle_ok,
            "value": idle_p95,
            "limit": IDLE_P95_LIMIT_S,
            "label": "idle-collection p95 <= 500 ms",
        },
        "gc_share": {
            "pass": gc_ok,
            "value": summary["gc_share"],
            "limit": GC_SHARE_LIMIT,
            "label": "total GC < 3% of wall time",
        },
        "hitch_share": {
            "pass": hitch_ok,
            "value": summary["frozen_share"],
            "limit": HITCH_SHARE_LIMIT,
            "label": "hitches < 0.5% of wall time",
        },
        "near_input_gen2": {
            "pass": near_ok,
            "value": near_input,
            "limit": 0,
            "label": "no automatic or backstop gen-2 within 2 s of input",
        },
        "rss_growth": {
            "pass": rss_ok,
            "value": rss_growth,
            "limit": RSS_GROWTH_LIMIT_BYTES,
            "label": "RSS growth < 0.5 GiB over 4 h",
        },
        "vmswap": {
            "pass": swap_ok,
            "value": swap_last if _is_number(swap_last) else None,
            "limit": 0,
            "label": "VmSwap about 0",
        },
        "jk_p95": {
            "pass": None,
            "value": None,
            "limit": JK_P95_LIMIT_MS,
            "label": "j/k p95 < 16 ms",
        },
    }
    fails = [name for name, spec in targets.items() if spec["pass"] is False]
    return {
        "targets": targets,
        "failed": fails,
        "all_pass": not fails,
        "window_s": summary["window_s"],
        "window_short_of_4h": summary["window_s"] < FOUR_HOURS_S,
    }


def _format_bytes(value: object) -> str:
    if not _is_number(value):
        return "n/a"
    total = float(value)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if total < 1024.0 or unit == "GiB":
            return f"{total:.1f} {unit}"
        total /= 1024.0
    return f"{total:.1f} GiB"


def _format_seconds(value: object) -> str:
    if not _is_number(value):
        return "n/a"
    return f"{float(value):.3f} s"


def _format_percent(value: object) -> str:
    if not _is_number(value):
        return "n/a"
    return f"{float(value) * 100:.2f}%"


def _format_trigger_line(stats_by_trigger: dict[str, dict[str, Any]]) -> str:
    parts: list[str] = []
    for trigger in KNOWN_TRIGGERS:
        stats = stats_by_trigger.get(trigger) or {}
        count = int(stats.get("count") or 0)
        if count == 0:
            continue
        parts.append(
            f"{trigger} {count} p95 {_format_seconds(stats.get('p95'))}"
        )
    return "; ".join(parts) if parts else "none"


def _format_acceptance_line(spec: dict[str, Any]) -> str:
    verdict = _verdict(spec["pass"])
    value = spec["value"]
    label = spec["label"]
    if label.startswith("j/k"):
        rendered = "n/a (no SASE_TUI_PERF log)"
    elif label.startswith("RSS") or label.startswith("VmSwap"):
        rendered = _format_bytes(value)
    elif "GC" in label or "hitches" in label:
        rendered = _format_percent(value)
    elif "p95" in label:
        rendered = _format_seconds(value)
    elif value is None:
        rendered = "n/a"
    else:
        rendered = str(value)
    return f"    {verdict}  {label}  ({rendered})"


def format_report(
    summaries: dict[str, dict], *, acceptance: bool = False
) -> str:
    """Render per-instance summaries as human-readable text."""
    if not summaries:
        return "tui_freeze_report: no rows in window\n"
    lines: list[str] = []
    for instance in sorted(summaries):
        summary = summaries[instance]
        lines.append(f"instance {instance}")
        lines.append(
            f"  window: {_format_seconds(summary['window_s'])} "
            f"frozen: {_format_seconds(summary['frozen_s'])} "
            f"({summary['frozen_share'] * 100:.2f}%, "
            f"{summary['episodes']} loop episodes)"
        )
        lines.append(
            f"  hitch duration: median {_format_seconds(summary['hitch_duration_median'])} "
            f"p90 {_format_seconds(summary['hitch_duration_p90'])} "
            f"max {_format_seconds(summary['hitch_duration_max'])}"
        )
        lines.append(
            f"  late: {summary['late_episodes']} episodes "
            f"({_format_seconds(summary['late_seconds'])}) "
            f"on-time: {summary['ontime_episodes']} episodes "
            f"({_format_seconds(summary['ontime_seconds'])})"
        )
        lines.append(
            f"  hitch totals: loop {_format_seconds(summary['loop_hitch_seconds'])} "
            f"suppressed {_format_seconds(summary['loop_suppressed_seconds'])}"
        )
        lines.append(
            f"  gc: {_format_seconds(summary['gc_total_s'])} "
            f"({summary['gc_share'] * 100:.2f}% of window) "
            f"by generation {json.dumps(summary['gc_seconds_by_generation'])}"
        )
        lines.append(
            f"  gc by gen/trigger {json.dumps(summary['gc_seconds_by_gen_trigger'])}"
        )
        lines.append(
            f"  idle collections: {summary['idle_pause_count']} pauses "
            f"p50 {_format_seconds(summary['idle_pause_p50'])} "
            f"p95 {_format_seconds(summary['idle_pause_p95'])} "
            f"max {_format_seconds(summary['idle_pause_max'])}"
        )
        lines.append(
            "  collections by trigger: "
            + _format_trigger_line(summary["pause_stats_by_trigger"])
        )
        lines.append(
            f"  gen-2 near input: automatic {summary['auto_gen2_near_input']}/"
            f"{summary['auto_gen2_total']}; "
            f"backstop {summary['backstop_gen2_near_input']}/"
            f"{summary['backstop_gen2_total']}; "
            f"rss_backstop {summary['rss_backstop_gen2_near_input']}/"
            f"{summary['rss_backstop_gen2_total']}"
        )
        lines.append(
            f"  rss: {_format_bytes(summary['rss_first_bytes'])} -> "
            f"{_format_bytes(summary['rss_last_bytes'])} "
            f"swap: {_format_bytes(summary['swap_first_bytes'])} -> "
            f"{_format_bytes(summary['swap_last_bytes'])} "
            f"({summary['heartbeat_count']} heartbeats)"
        )
        if acceptance:
            result = evaluate_acceptance(summary)
            lines.append("  acceptance (sase-1f3):")
            for spec in result["targets"].values():
                lines.append(_format_acceptance_line(spec))
            if result["window_short_of_4h"]:
                lines.append(
                    "    note: window is shorter than 4 h; RSS growth is the "
                    "observed delta, not a 4-hour rate."
                )
            overall = "PASS" if result["all_pass"] else "FAIL"
            lines.append(f"    overall {overall}")
    return "\n".join(lines) + "\n"


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Report per-app-instance TUI frozen share and GC share from "
            "tui_stalls.jsonl."
        )
    )
    parser.add_argument(
        "--acceptance",
        action="store_true",
        help="Mark each sase-1f3 target pass or fail per instance.",
    )
    parser.add_argument(
        "--instance",
        action="append",
        default=None,
        help="Only report this instance (repeatable).",
    )
    parser.add_argument(
        "--no-rotated",
        action="store_true",
        help="Do not read the rotated tui_stalls.jsonl.1 generation.",
    )
    parser.add_argument(
        "--path",
        type=Path,
        default=None,
        help="Stall JSONL path. Defaults to $SASE_TUI_STALL_PATH or ~/.sase/logs/tui_stalls.jsonl.",
    )
    parser.add_argument(
        "--since",
        default=None,
        help="Window start as epoch seconds or ISO-8601.",
    )
    parser.add_argument(
        "--startup-path",
        type=Path,
        default=None,
        help="Startup JSONL path used to window rows without app_instance_id.",
    )
    parser.add_argument(
        "--until",
        default=None,
        help="Window end as epoch seconds or ISO-8601.",
    )
    args = parser.parse_args(list(argv) if argv is not None else None)

    stalls_path = args.path or _default_stalls_path()
    startup_path = args.startup_path or _default_startup_path()
    rows = load_stall_rows(stalls_path, include_rotated=not args.no_rotated)
    startups = load_rows(startup_path)
    try:
        since = parse_time(args.since) if args.since is not None else None
        until = parse_time(args.until) if args.until is not None else None
    except ValueError as exc:
        parser.error(f"invalid --since/--until: {exc}")
        return 2
    if since is not None and until is not None and until < since:
        parser.error("--until must not precede --since")
        return 2

    buckets = bucket_by_instance(rows, startups)
    summaries = {}
    for instance, bucket in buckets.items():
        if args.instance is not None and instance not in args.instance:
            continue
        summary = summarize_instance(bucket, since=since, until=until)
        if summary["row_count"] == 0:
            continue
        summaries[instance] = summary
    print(format_report(summaries, acceptance=args.acceptance), end="")
    if args.acceptance and summaries:
        failed = any(
            not evaluate_acceptance(summary)["all_pass"]
            for summary in summaries.values()
        )
        if failed:
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
