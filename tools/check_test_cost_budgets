#!/usr/bin/env python3
"""Fail when a test-cost recording exceeds committed suite-cost budgets."""

from __future__ import annotations

import argparse
import json
import math
import os
import statistics
import sys
from collections.abc import Mapping, Sequence
from pathlib import Path
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from tests._test_cost import (  # noqa: E402
    CostBudgetFailure,
    TEST_COST_DIR_ENV,
    TEST_COST_SCHEMA,
    check_cost_budgets,
    cost_directory,
    cost_recording_paths,
    format_cost_budget_failure,
    latest_cost_record,
    load_cost_budgets,
    load_cost_record,
    worker_divisor,
)
from tests._test_selection_health_store import store_directory  # noqa: E402


DEFAULT_BUDGET_PATH = (
    REPO_ROOT / "tests" / "perf" / "baselines" / "test_cost_budgets.json"
)

# Summary metrics whose family is CPU: hard by default, checked against the
# `cpu` tolerance. Kept in sync with tests/_test_cost_budgets.py.
CPU_SUMMARY_METRICS = frozenset({"total_file_cpu_seconds", "collection_cpu_seconds"})
# Summary metrics whose family is memory: hard by default, wall tolerance.
# Kept in sync with tests/_test_cost_budgets.py.
MEMORY_SUMMARY_METRICS = frozenset(
    {"peak_worker_rss_kib", "median_worker_rss_kib", "post_collection_worker_rss_kib"}
)

# (metric, per_worker) pairs suggested from recorded history. Per-worker metrics
# are summed across xdist workers by build_cost_record(), so they must be
# divided back down before a limit derived from a single worker's cost is
# meaningful.
SUGGESTED_SUMMARY_METRICS: tuple[tuple[str, bool], ...] = (
    ("total_file_wall_seconds", False),
    ("total_file_cpu_seconds", False),
    ("idle_seconds", False),
    ("peak_worker_rss_kib", False),
    ("median_worker_rss_kib", False),
    ("post_collection_worker_rss_kib", False),
    ("collection_seconds", True),
    ("collection_cpu_seconds", True),
)


def _default_recording_path() -> Path:
    directory = cost_directory(store_directory(REPO_ROOT))
    path = latest_cost_record(directory)
    if path is None:
        raise SystemExit(
            "no test-cost recordings found; run `just test-cost` first or pass "
            f"--recording (override directory with {TEST_COST_DIR_ENV})"
        )
    return path


def _history_recording_paths(directory: Path, history: int | None) -> list[Path]:
    paths = cost_recording_paths(directory)
    if not paths:
        raise SystemExit(
            "no test-cost recordings found; run `just test-cost` first (override "
            f"directory with {TEST_COST_DIR_ENV})"
        )
    if history is not None and history > 0:
        return paths[-history:]
    return paths


def _local_tolerance(budgets: Mapping[str, Any]) -> float:
    raw = budgets.get("tolerance", 0.15)
    if isinstance(raw, Mapping):
        raw = raw.get("local", raw.get("default", 0.15))
    try:
        return max(float(raw), 0.0)
    except (TypeError, ValueError):
        return 0.15


def _local_cpu_tolerance(budgets: Mapping[str, Any]) -> float:
    raw = budgets.get("tolerance", {})
    raw_cpu = raw.get("cpu", 0.25) if isinstance(raw, Mapping) else 0.25
    try:
        return max(float(raw_cpu), 0.0)
    except (TypeError, ValueError):
        return 0.25


def _summary_default_severity(metric: str) -> str:
    if metric in CPU_SUMMARY_METRICS or metric in MEMORY_SUMMARY_METRICS:
        return "hard"
    return "advisory"


def _round_up_nice(value: float) -> float:
    """Round ``value`` up to a round number carrying about 2 significant figures."""

    if value <= 0:
        return 0.0
    magnitude = math.floor(math.log10(value))
    step = 10 ** max(magnitude - 1, 0)
    return float(math.ceil(value / step) * step)


def _suggest_limit(values: Sequence[float], tolerance: float) -> float | None:
    if not values:
        return None
    return _round_up_nice(max(values) / (1.0 + tolerance))


def _suggest_count_limit(values: Sequence[int]) -> int | None:
    """25% headroom on the max observed count, with no runtime tolerance.

    Counts are near-deterministic, so the headroom belongs in the limit
    itself rather than in a check-time tolerance (see check_cost_budgets()).
    """

    if not values:
        return None
    return int(_round_up_nice(max(values) * 1.25))


def _summary_metric_values(
    records: Sequence[Mapping[str, Any]], metric: str, *, per_worker: bool
) -> list[float]:
    values: list[float] = []
    for record in records:
        summary = record.get("summary")
        if not isinstance(summary, Mapping):
            continue
        raw = summary.get(metric)
        if raw is None:
            continue
        try:
            value = float(raw)
        except (TypeError, ValueError):
            continue
        if per_worker:
            value = value / worker_divisor(record)
        values.append(value)
    return values


def _cause_names(records: Sequence[Mapping[str, Any]]) -> list[str]:
    names: set[str] = set()
    for record in records:
        summary = record.get("summary")
        causes = summary.get("causes") if isinstance(summary, Mapping) else None
        if isinstance(causes, Mapping):
            names.update(str(name) for name in causes)
    return sorted(names)


def _cause_values(records: Sequence[Mapping[str, Any]], name: str) -> list[float]:
    values: list[float] = []
    for record in records:
        summary = record.get("summary")
        causes = summary.get("causes") if isinstance(summary, Mapping) else None
        payload = causes.get(name) if isinstance(causes, Mapping) else None
        if isinstance(payload, Mapping) and payload.get("seconds") is not None:
            try:
                values.append(float(payload["seconds"]))
            except (TypeError, ValueError):
                continue
    return values


def _cause_cpu_values(records: Sequence[Mapping[str, Any]], name: str) -> list[float]:
    values: list[float] = []
    for record in records:
        summary = record.get("summary")
        causes = summary.get("causes") if isinstance(summary, Mapping) else None
        payload = causes.get(name) if isinstance(causes, Mapping) else None
        if isinstance(payload, Mapping) and payload.get("cpu_seconds") is not None:
            try:
                values.append(float(payload["cpu_seconds"]))
            except (TypeError, ValueError):
                continue
    return values


def _cause_count_values(records: Sequence[Mapping[str, Any]], name: str) -> list[int]:
    values: list[int] = []
    for record in records:
        summary = record.get("summary")
        causes = summary.get("causes") if isinstance(summary, Mapping) else None
        payload = causes.get(name) if isinstance(causes, Mapping) else None
        if isinstance(payload, Mapping) and payload.get("count") is not None:
            try:
                values.append(int(payload["count"]))
            except (TypeError, ValueError):
                continue
    return values


def _provenance_notes(records: Sequence[Mapping[str, Any]]) -> list[str]:
    hosts = sorted({str(record["host"]) for record in records if record.get("host")})
    recorded_ats = sorted(
        str(record["recorded_at"]) for record in records if record.get("recorded_at")
    )
    worker_counts = [
        int(record["worker_count"])
        for record in records
        if isinstance(record.get("worker_count"), int)
    ]
    node_counts = [
        int(record["summary"]["node_count"])
        for record in records
        if isinstance(record.get("summary"), Mapping)
        and isinstance(record["summary"].get("node_count"), int)
    ]
    return [
        f"sample: {len(records)} recording(s) from {', '.join(hosts) or 'unknown host'}",
        "date range (UTC): "
        f"{recorded_ats[0] if recorded_ats else 'n/a'} to "
        f"{recorded_ats[-1] if recorded_ats else 'n/a'}",
        "worker counts: "
        + (f"{min(worker_counts)}-{max(worker_counts)}" if worker_counts else "n/a"),
        "node counts: "
        + (f"{min(node_counts)}-{max(node_counts)}" if node_counts else "n/a"),
    ]


def suggest_budgets(
    directory: Path, history: int | None, current_budgets: Mapping[str, Any]
) -> dict[str, Any]:
    """Derive suggested suite-cost budgets from recent recorded history."""

    paths = _history_recording_paths(directory, history)
    records = [load_cost_record(path) for path in paths]
    tolerance = _local_tolerance(current_budgets)
    cpu_tolerance = _local_cpu_tolerance(current_budgets)

    summary: dict[str, Any] = {}
    metric_notes: list[str] = []
    for metric, per_worker in SUGGESTED_SUMMARY_METRICS:
        values = _summary_metric_values(records, metric, per_worker=per_worker)
        metric_tolerance = cpu_tolerance if metric in CPU_SUMMARY_METRICS else tolerance
        limit = _suggest_limit(values, metric_tolerance)
        if limit is None:
            continue
        entry: dict[str, Any] = {"limit": limit}
        if per_worker:
            entry["per_worker"] = True
        entry["enforce"] = _summary_default_severity(metric)
        summary[metric] = entry
        label = f"summary.{metric}" + (" (per worker)" if per_worker else "")
        metric_notes.append(
            f"{label}: min={min(values):.3f} median={statistics.median(values):.3f} "
            f"max={max(values):.3f}"
        )

    causes: dict[str, Any] = {}
    for name in _cause_names(records):
        entry = {}

        wall_values = _cause_values(records, name)
        wall_limit = _suggest_limit(wall_values, tolerance)
        if wall_limit is not None:
            entry["limit"] = wall_limit
            entry["enforce"] = "advisory"
            metric_notes.append(
                f"causes.{name}: min={min(wall_values):.3f} "
                f"median={statistics.median(wall_values):.3f} "
                f"max={max(wall_values):.3f}"
            )

        cpu_values = _cause_cpu_values(records, name)
        cpu_limit = _suggest_limit(cpu_values, cpu_tolerance)
        if cpu_limit is not None:
            entry["cpu_limit"] = cpu_limit
            entry["cpu_enforce"] = "hard"
            metric_notes.append(
                f"causes.{name}.cpu: min={min(cpu_values):.3f} "
                f"median={statistics.median(cpu_values):.3f} "
                f"max={max(cpu_values):.3f}"
            )

        count_values = _cause_count_values(records, name)
        count_limit = _suggest_count_limit(count_values)
        if count_limit is not None:
            entry["count_limit"] = count_limit
            entry["count_enforce"] = "hard"
            metric_notes.append(
                f"causes.{name}.count: min={min(count_values)} "
                f"median={statistics.median(count_values):.1f} "
                f"max={max(count_values)}"
            )

        if entry:
            causes[name] = entry

    notes = [
        "Suggested by `tools/check_test_cost_budgets --suggest`: wall/cpu limit = "
        "ceil(worst recorded value / (1 + tolerance)) using the local (wall) or "
        "cpu tolerance; count_limit = ceil(max observed count * 1.25) with no "
        "runtime tolerance; each rounded up to a round number. `enforce` / "
        "`cpu_enforce` / `count_enforce` are always written explicitly so the "
        "committed file never depends on the implicit family default (wall "
        "advisory, cpu/count/memory hard).",
        *_provenance_notes(records),
        *metric_notes,
    ]

    return {
        "schema": TEST_COST_SCHEMA,
        "tolerance": current_budgets.get(
            "tolerance", {"ci": 0.2, "local": 0.15, "cpu": 0.25}
        ),
        "summary": summary,
        "causes": causes,
        "notes": notes,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--recording",
        type=Path,
        help="cost recording to check; defaults to the newest host-local one",
    )
    parser.add_argument(
        "--budgets",
        type=Path,
        default=DEFAULT_BUDGET_PATH,
        help="committed budget JSON to enforce",
    )
    parser.add_argument(
        "--ci",
        action="store_true",
        default=os.environ.get("GITHUB_ACTIONS") == "true",
        help="use the CI tolerance from the budget file",
    )
    parser.add_argument(
        "--suggest",
        action="store_true",
        help=(
            "print suggested budgets (with provenance) derived from recorded "
            "history instead of checking the newest recording"
        ),
    )
    parser.add_argument(
        "--history",
        type=int,
        default=None,
        help="with --suggest, use only the newest N recordings (default: all retained)",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help=(
            "treat advisory metrics as fatal too, for deliberate investigation on "
            "a quiet host"
        ),
    )
    parser.add_argument(
        "--report-advisories",
        action="store_true",
        help=(
            "re-read the newest recording, print only the advisory section, and "
            "always exit 0 (used after `just test-cost` to surface advisories "
            "that tools/run_silent would otherwise swallow on success)"
        ),
    )
    args = parser.parse_args(argv)

    budget_path = args.budgets

    if args.suggest:
        try:
            current_budgets = load_cost_budgets(budget_path)
        except (OSError, ValueError):
            current_budgets = {}
        directory = cost_directory(store_directory(REPO_ROOT))
        suggested = suggest_budgets(directory, args.history, current_budgets)
        print(json.dumps(suggested, indent=2, sort_keys=True))
        return 0

    budgets = load_cost_budgets(budget_path)
    record_path = args.recording or _default_recording_path()
    record = load_cost_record(record_path)
    failures = check_cost_budgets(record, budgets, ci=args.ci)
    hard = [failure for failure in failures if failure.severity == "hard"]
    advisories = [failure for failure in failures if failure.severity == "advisory"]

    if args.report_advisories:
        if not advisories:
            print(f"test cost budgets: no advisories: {record_path}")
            return 0
        _print_advisories(record_path, advisories, record=record)
        return 0

    if advisories:
        _print_advisories(record_path, advisories, record=record)

    fatal = failures if args.strict else hard
    if not fatal:
        suffix = " (see advisories above)" if advisories else ""
        print(f"test cost budgets passed{suffix}: {record_path}")
        return 0

    print(f"test cost budget regression: {record_path}", file=sys.stderr)
    print(f"budgets: {budget_path}", file=sys.stderr)
    for failure in fatal:
        print(f"- {format_cost_budget_failure(record, failure)}", file=sys.stderr)
    return 1


def _print_advisories(
    record_path: Path,
    advisories: Sequence[CostBudgetFailure],
    *,
    record: Mapping[str, Any],
) -> None:
    print(f"test cost budget advisories: {record_path}")
    print(
        "wall-clock overages usually mean the host was busy, not that the suite "
        "got more expensive; the cpu/count figures alongside each entry are "
        "contention-stable, so compare them to tell the two apart."
    )
    for failure in advisories:
        print(f"- {format_cost_budget_failure(record, failure)}")


if __name__ == "__main__":
    raise SystemExit(main())
