ROOT = Path(__file__).resolve().parents[1]
TOOLS_DIR = Path(__file__).resolve().parent
_CHECK_DOCS_LOADER = SourceFileLoader(
    "docs_split_check_docs", str(TOOLS_DIR / "check_docs")
)
_CHECK_DOCS_SPEC = importlib.util.spec_from_loader(
    _CHECK_DOCS_LOADER.name, _CHECK_DOCS_LOADER
)
if (
    _CHECK_DOCS_SPEC is None
):  # pragma: no cover - the source file is part of this checkout.
    raise ImportError("could not load tools/check_docs")
_CHECK_DOCS = importlib.util.module_from_spec(_CHECK_DOCS_SPEC)
sys.modules[_CHECK_DOCS_LOADER.name] = _CHECK_DOCS
