SCHEMA_RELPATH = Path("src/sase/config/sase.schema.json")
DEFAULT_BD_COMMAND = "tools/sase_bead"
LIVE_STATUSES = frozenset({"open", "claimed", "ready", "snoozed", "in_progress"})
SKIP_DIR_NAMES = frozenset(
