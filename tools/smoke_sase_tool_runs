#!/usr/bin/env python3
"""Black-box ToolRun harness: drive the real ``sase`` CLI and inspect the real store.

Every case runs the executable under test against an isolated ``SASE_HOME``, a private
``HOME`` (so the caller's user config and plugin overlays cannot leak in), a temporary
git project and a known fixture catalog. Facts come from versioned queries
(``tool runs -j``, ``tool show -j``, ``tool list -j``); nothing substitutes a fake store
or a mocked ``Popen``. The expensive SASE catalog is never executed.

Default mode runs every hermetic case and labels the live cases (real monitor and proc
supervisors, cold-start overhead timing) ``not-run``; ``--live`` runs them too.

  tools/smoke_sase_tool_runs --sase .venv/bin/sase -j     # workspace binary
  tools/smoke_sase_tool_runs -j                           # `sase` from PATH
  tools/smoke_sase_tool_runs --live --keep                # live cases, keep fixtures

``--keep`` leaves the temp directory in place; its path is printed in the report
(``kept``). Inspect it with ``SASE_HOME=<kept>/sase-home HOME=<kept>/user-home sase
tool runs -a``; each ``world-*`` directory holds one case's own store and user config.
"""

from __future__ import annotations

import argparse
import json
import shutil
import sys
from collections.abc import Callable, Sequence
from pathlib import Path
from typing import Any


sys.path.insert(0, str(Path(__file__).resolve().parent))

import _smoke_tool_runs_cases_basic as basic  # noqa: E402
import _smoke_tool_runs_cases_evidence as evidence  # noqa: E402
import _smoke_tool_runs_cases_owners as owners  # noqa: E402
from _smoke_tool_runs_lib import FAIL, NOT_RUN, PASS, Harness, case  # noqa: E402


Group = tuple[tuple[str, ...], Callable[[Harness], Any]]

GROUPS: tuple[Group, ...] = (
    (("core-ledger-round-trip",), basic.core_round_trip),
    (("dod-1-catalog-sase", "dod-1-catalog-fixture", "dod-1-malformed"), basic.catalog),
    (
        ("dod-2-exact-execution", "dod-2-literal-argv", "dod-2-launch-errors"),
        basic.exact_execution,
    ),
    (("dod-3-signals",), basic.signals),
    (("dod-4-lost",), basic.lost),
    (("dod-4-liveness",), basic.liveness),
    (
        ("dod-5-fail-open", "dod-5-lock", "dod-5-mid-write", "dod-5-log-failure"),
        basic.fail_open,
    ),
    (("dod-5-running-before-spawn",), basic.handshake),
    (
        (
            "dod-6-timeline",
            "dod-6-evidence",
            "dod-6-path-independence",
            "dod-6-incomplete-evidence",
        ),
        evidence.timeline_and_evidence,
    ),
    (("dod-6-typical",), evidence.typical_cohorts),
    (("dod-6-samples",), evidence.samples),
    (
        ("dod-7-agent-output", "dod-7-modes", "dod-7-owner-precedence"),
        evidence.agent_output,
    ),
    (("dod-7-truncation",), evidence.truncation),
    (("dod-8-enclosing-owner",), owners.enclosing_owner),
    (("dod-8-nested",), owners.nested_runs),
    (("dod-8-live-monitor",), owners.live_monitor),
    (("dod-8-live-proc",), owners.live_proc),
    (("dod-9-disk-list", "dod-9-retention"), owners.disk_retention),
    (("dod-9-aggregate-cap",), owners.aggregate_cap),
    (("dod-10-concurrent",), evidence.concurrency),
    (("dod-10-torn-replay",), evidence.torn_replay),
    (("dod-13-overhead",), owners.overhead),
)


def dod_summary(cases: Sequence[dict[str, Any]]) -> list[dict[str, Any]]:
    by_dod: dict[str, list[dict[str, Any]]] = {}
    for item in cases:
        for dod in item.get("dod") or ():
            by_dod.setdefault(dod, []).append(item)
    out = []
    for dod in sorted(by_dod, key=lambda value: int(value.split("-")[1])):
        statuses = {item["status"] for item in by_dod[dod]}
        status = FAIL if FAIL in statuses else NOT_RUN if NOT_RUN in statuses else PASS
        out.append(
            {
                "id": dod,
                "status": status,
                "case_ids": [item["id"] for item in by_dod[dod]],
            }
        )
    return out


def _selected(ids: tuple[str, ...], only: Sequence[str] | None) -> bool:
    return only is None or any(item in only for item in ids)


def run_harness(
    *,
    sase: str,
    live: bool,
    keep: bool,
    only: Sequence[str] | None = None,
) -> dict[str, Any]:
    """Run the harness. ``only`` restricts the run to the named case ids."""

    h = Harness.create(sase=sase, live=live, keep=keep)
    cases: list[dict[str, Any]] = []
    try:
        loaded = _loaded_modules(h)
        for ids, group in GROUPS:
            if not _selected(ids, only):
                continue
            try:
                produced = group(h)
            except Exception as exc:  # noqa: BLE001 - one broken case must not hide the rest.
                produced = [case(ids[0], False, error=f"{type(exc).__name__}: {exc}")]
            cases.extend(produced if isinstance(produced, list) else [produced])
        if only is not None:
            cases = [item for item in cases if item["id"] in only]
        failed = [item for item in cases if item["status"] == FAIL]
        report: dict[str, Any] = {
            "schema_version": 1,
            "sase": sase,
            "loaded_modules": loaded,
            "live": live,
            "cases": cases,
            "dod": dod_summary(cases),
            "failed": len(failed),
            "not_run": sum(1 for item in cases if item["status"] == NOT_RUN),
            "runs": h.run_log,
            "snapshots": h.snapshots,
        }
        overhead = next((c for c in cases if c["id"] == "dod-13-overhead"), None)
        if overhead is not None and overhead["status"] != NOT_RUN:
            report["overhead"] = overhead["observed"]
        if keep:
            report["kept"] = str(h.tmp)
        return report
    finally:
        h.cleanup()


def _loaded_modules(h: Harness) -> dict[str, Any]:
    try:
        return h.helper("identity")
    except Exception as exc:  # noqa: BLE001 - reported, not fatal.
        return {"error": str(exc), "python": h.python}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-j", "--json", action="store_true", help="print the full JSON report"
    )
    parser.add_argument(
        "-k",
        "--keep",
        action="store_true",
        help="keep the temp fixtures for inspection",
    )
    parser.add_argument(
        "-l",
        "--live",
        action="store_true",
        help="also run live cases (real monitor and proc owners, cold-start overhead)",
    )
    parser.add_argument(
        "-s",
        "--sase",
        default="sase",
        help="sase executable to inspect (default: PATH lookup)",
    )
    args = parser.parse_args(argv)
    sase = shutil.which(args.sase) or args.sase
    if not Path(sase).exists():
        print(
            f"[tool-runs-harness] sase executable not found: {args.sase}",
            file=sys.stderr,
        )
        return 2
    report = run_harness(
        sase=str(Path(sase).absolute()), live=args.live, keep=args.keep
    )
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for item in report["cases"]:
            print(f"{item['id']}: {item['status']}")
        for item in report["dod"]:
            print(f"{item['id']}: {item['status']}")
        print(f"failed={report['failed']} not-run={report['not_run']}")
        if report.get("kept"):
            print(f"kept={report['kept']}")
    return 1 if report["failed"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
