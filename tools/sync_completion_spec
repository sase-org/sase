#!/usr/bin/env python3
"""Check or rewrite the checked-in structural completion spec snapshot."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT / "src"))

from sase.completion.snapshot import completion_spec_drift, current_structural_view


SNAPSHOT_PATH = REPO_ROOT / "tests" / "completion" / "snapshots" / "cli_spec.json"


def _load_snapshot(path: Path = SNAPSHOT_PATH) -> dict[str, object] | None:
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def _write_snapshot(path: Path = SNAPSHOT_PATH) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    document = json.dumps(current_structural_view(), indent=2, sort_keys=True)
    path.write_text(f"{document}\n", encoding="utf-8")


def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--check",
        action="store_true",
        help="check for drift and exit non-zero when found (default)",
    )
    mode.add_argument(
        "--write",
        action="store_true",
        help="rewrite the snapshot in place",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv)
    if args.write:
        _write_snapshot()
        return 0

    drift = completion_spec_drift(_load_snapshot())
    if drift is None:
        return 0
    print(drift, file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
