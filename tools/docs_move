#!/usr/bin/env python3
"""Move a whole docs page while preserving links and the old URL."""

from __future__ import annotations

import argparse
import json
from pathlib import Path, PurePosixPath
import re
import sys

import yaml  # type: ignore[import-untyped]

from docs_moves import (
    GENERATED_FILE_RE,
    MOVES_PATH,
    REPO_ROOT,
    _rewrite_handwritten,
    load_moves,
    page_anchors,
)


MOVES_FILE = REPO_ROOT / MOVES_PATH
BUDGETS_FILE = REPO_ROOT / "docs/_meta/budgets.yml"
MKDOCS_FILE = REPO_ROOT / "mkdocs.yml"
FRONTMATTER_SEPARATOR = "---"


def _doc_path(value: str, label: str) -> str:
    path = PurePosixPath(value)
    if path.parts and path.parts[0] == "docs":
        path = PurePosixPath(*path.parts[1:])
    if path.is_absolute() or ".." in path.parts or path.suffix.lower() != ".md":
        raise ValueError(f"{label} must be a safe docs-relative .md path")
    return path.as_posix()


def _frontmatter(text: str, title: str | None, description: str | None) -> str:
    lines = text.splitlines(keepends=True)
    has_frontmatter = bool(lines and lines[0].strip() == FRONTMATTER_SEPARATOR)
    if has_frontmatter:
        end = next(
            (
                index
                for index in range(1, len(lines))
                if lines[index].strip() == FRONTMATTER_SEPARATOR
            ),
            None,
        )
        if end is None:
            raise ValueError("source page has unterminated YAML frontmatter")
        metadata = yaml.safe_load("".join(lines[1:end]))
        if metadata is None:
            metadata = {}
        if not isinstance(metadata, dict):
            raise ValueError("source page frontmatter must be a YAML mapping")
        additions: list[str] = []
        for key, value in (("title", title), ("description", description)):
            if key not in metadata:
                if value is None:
                    raise ValueError(
                        f"--{key} is required when frontmatter omits {key}"
                    )
                additions.append(f"{key}: {json.dumps(value, ensure_ascii=False)}\n")
            elif not isinstance(metadata[key], str) or not metadata[key]:
                raise ValueError(
                    f"source page frontmatter {key} must be non-empty text"
                )
        effective_description = metadata.get("description", description or "")
        if isinstance(effective_description, str) and len(effective_description) > 160:
            raise ValueError("page description must be at most 160 characters")
        return "".join(lines[:end] + additions + lines[end:])

    if title is None or description is None:
        raise ValueError("--title and --description are required without frontmatter")
    if len(description) > 160:
        raise ValueError("page description must be at most 160 characters")
    return (
        f"---\ntitle: {json.dumps(title, ensure_ascii=False)}\n"
        f"description: {json.dumps(description, ensure_ascii=False)}\n---\n" + text
    )


def _page_title(text: str, fallback: str) -> str:
    frontmatter_title: str | None = None
    lines = text.splitlines()
    if lines and lines[0].strip() == FRONTMATTER_SEPARATOR:
        for index in range(1, len(lines)):
            if lines[index].strip() == FRONTMATTER_SEPARATOR:
                metadata = yaml.safe_load("\n".join(lines[1:index])) or {}
                if isinstance(metadata, dict) and isinstance(
                    metadata.get("title"), str
                ):
                    frontmatter_title = metadata["title"]
                break
    if frontmatter_title:
        return frontmatter_title
    match = re.search(r"^#\s+(.+?)\s*#*\s*$", text, flags=re.MULTILINE)
    return match.group(1).strip() if match else fallback


def _yaml_move_append(text: str, entry: dict[str, object]) -> str:
    payload = yaml.safe_load(text)
    if not isinstance(payload, dict) or not isinstance(payload.get("moves"), list):
        raise ValueError(f"{MOVES_FILE} must contain a moves list")
    rows = yaml.safe_dump(
        [entry], sort_keys=False, allow_unicode=True, default_flow_style=False
    ).rstrip("\n")
    if text.rstrip().endswith("moves: []"):
        text = re.sub(r"moves:\s*\[\]\s*$", "moves:\n", text.rstrip()) + "\n"
    return (
        text.rstrip("\n")
        + "\n"
        + "\n".join(f"  {line}" for line in rows.splitlines())
        + "\n"
    )


def _drop_budget(text: str, source: str) -> str:
    lines = text.splitlines(keepends=True)
    in_ceilings = False
    kept: list[str] = []
    pattern = re.compile(rf"^  {re.escape(source)}:\s*\d+\s*(?:#.*)?\n?$")
    for line in lines:
        if re.match(r"^ceilings:\s*$", line):
            in_ceilings = True
            kept.append(line)
            continue
        if in_ceilings and line.strip() and not line.startswith((" ", "\t", "#")):
            in_ceilings = False
        if not (in_ceilings and pattern.match(line)):
            kept.append(line)
    return "".join(kept)


def _nav_link_count(value: object, source: str) -> int:
    if isinstance(value, str):
        return int(value == source)
    if isinstance(value, list):
        return sum(_nav_link_count(item, source) for item in value)
    if isinstance(value, dict):
        return sum(_nav_link_count(item, source) for item in value.values())
    return 0


def _rewrite_nav(text: str, source: str, target: str) -> str:
    payload = yaml.safe_load(text)
    if not isinstance(payload, dict) or "nav" not in payload:
        raise ValueError("mkdocs.yml has no nav section")
    count = _nav_link_count(payload["nav"], source)
    if count == 0:
        raise ValueError(f"mkdocs.yml nav does not contain docs/{source}")

    lines = text.splitlines(keepends=True)
    start = next(
        (
            index
            for index, line in enumerate(lines)
            if re.match(r"^nav:\s*(?:#.*)?$", line)
        ),
        None,
    )
    if start is None:
        raise ValueError("could not locate the mkdocs.yml nav section")
    end = len(lines)
    for index in range(start + 1, len(lines)):
        line = lines[index]
        if line.strip() and not line.startswith((" ", "\t", "#")):
            end = index
            break
    region = "".join(lines[start:end])
    path_pattern = re.compile(
        rf"(?P<prefix>:\s*|-[ \t]*)(?P<quote>['\"]?){re.escape(source)}(?P=quote)(?=$|[ \t#])"
    )
    rewritten, replacements = path_pattern.subn(
        lambda match: (
            f"{match.group('prefix')}{match.group('quote')}{target}"
            f"{match.group('quote')}"
        ),
        region,
    )
    if replacements != count:
        raise ValueError(f"could not safely rewrite all nav entries for docs/{source}")
    return "".join(lines[:start]) + rewritten + "".join(lines[end:])


def move_page(
    source_value: str,
    target_value: str,
    *,
    title: str | None = None,
    description: str | None = None,
    stub: bool = False,
    root: Path = REPO_ROOT,
) -> list[str]:
    """Move one page and return renderer warnings for generated inbound links."""
    source = _doc_path(source_value, "source")
    target = _doc_path(target_value, "target")
    if source == target:
        raise ValueError("source and target pages must differ")
    source_file = root / "docs" / source
    target_file = root / "docs" / target
    if not source_file.is_file():
        raise ValueError(f"source page docs/{source} does not exist")
    if target_file.exists():
        raise ValueError(f"target page docs/{target} already exists")

    original = source_file.read_text(encoding="utf-8")
    if GENERATED_FILE_RE.search(original):
        raise ValueError("cannot move a generated page")
    moves = load_moves(root)
    if any(item.from_path == source for item in moves):
        raise ValueError(f"docs/{source} already appears in moves.yml")
    if any(item.to_path == target for item in moves):
        raise ValueError(f"docs/{target} is already a move destination")

    anchor_map = {anchor: (target, anchor) for anchor in page_anchors(original)}
    moved_text = _frontmatter(original, title, description)
    page_title = _page_title(moved_text, Path(target).stem.replace("-", " ").title())

    writes: dict[Path, str] = {}
    warnings: list[str] = []
    docs_root = root / "docs"
    for path in docs_root.rglob("*.md"):
        relative = path.relative_to(docs_root).as_posix()
        if path == source_file:
            authored_text = moved_text
            origin = source
            destination = target
        else:
            authored_text = path.read_text(encoding="utf-8")
            origin = relative
            destination = relative
        rewritten, generated_warning = _rewrite_handwritten(
            authored_text,
            origin=origin,
            destination=destination,
            source=source,
            moved_anchors=anchor_map,
            rewrite_source=True,
            source_destination=target,
        )
        if generated_warning:
            warnings.append(
                f"docs/{relative}: update its renderer for links to docs/{source}"
            )
        if path == source_file:
            writes[target_file] = rewritten
        elif rewritten != authored_text:
            writes[path] = rewritten

    moves_text = (root / MOVES_PATH).read_text(encoding="utf-8")
    move_entry: dict[str, object] = {
        "from": source,
        "to": target,
        "kind": "stub" if stub else "redirect",
    }
    if stub:
        move_entry["title"] = page_title
        move_entry["anchors"] = {anchor: f"{target}#{anchor}" for anchor in anchor_map}
    new_moves_text = _yaml_move_append(moves_text, move_entry)

    budgets_path = root / "docs/_meta/budgets.yml"
    budgets_text = budgets_path.read_text(encoding="utf-8")
    new_budgets_text = _drop_budget(budgets_text, source)
    mkdocs_path = root / "mkdocs.yml"
    mkdocs_text = mkdocs_path.read_text(encoding="utf-8")
    new_mkdocs_text = _rewrite_nav(mkdocs_text, source, target)

    target_file.parent.mkdir(parents=True, exist_ok=True)
    source_file.unlink()
    for path, content in writes.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
    (root / MOVES_PATH).write_text(new_moves_text, encoding="utf-8")
    budgets_path.write_text(new_budgets_text, encoding="utf-8")
    mkdocs_path.write_text(new_mkdocs_text, encoding="utf-8")
    return warnings


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", help="source page path relative to docs/")
    parser.add_argument("target", help="destination page path relative to docs/")
    parser.add_argument(
        "-d",
        "--description",
        help="description to add when source frontmatter has none",
    )
    parser.add_argument(
        "-s",
        "--stub",
        action="store_true",
        help="keep an anchor-preserving stub at the old page URL",
    )
    parser.add_argument(
        "-t", "--title", help="title to add when source frontmatter has none"
    )
    args = parser.parse_args(argv)
    try:
        warnings = move_page(
            args.source,
            args.target,
            title=args.title,
            description=args.description,
            stub=args.stub,
        )
    except (OSError, ValueError, yaml.YAMLError) as exc:
        print(f"[docs_move] {exc}", file=sys.stderr)
        return 1
    print(
        f"Move docs/{_doc_path(args.source, 'source')} → docs/{_doc_path(args.target, 'target')}"
    )
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
