#!/bin/bash

# sase_stop_hook: runs xprompt hook commands for sase agents.
#
# Xprompt hooks only run when:
#   1. SASE_AGENT is set (running as a sase agent)
#   2. SASE_XPROMPT_HOOKS_FILE is set and points to an existing JSON file
#   3. The file contains at least one hook command
#
# Exit codes (for Claude Code / Codex / Gemini):
#   0 = success (all hooks passed, or no hooks to run)
#   2 = failure (blocks the agent and shows stderr with details)

_MAX_ERROR_LINES=80
function truncate_output() {
    local output="$1"
    local total_lines
    total_lines=$(echo "$output" | wc -l)
    if [ "$total_lines" -gt "$_MAX_ERROR_LINES" ]; then
        local skipped=$((total_lines - _MAX_ERROR_LINES))
        echo "[... truncated $skipped lines ...]"
        echo "$output" | tail -n "$_MAX_ERROR_LINES"
    else
        echo "$output"
    fi
}

function run() {
    # Only run when inside a sase agent session
    if [ -z "$SASE_AGENT" ]; then
        return 0
    fi

    # Check for hooks file
    if [ -z "$SASE_XPROMPT_HOOKS_FILE" ] || [ ! -f "$SASE_XPROMPT_HOOKS_FILE" ]; then
        return 0
    fi

    # Parse hook commands from the JSON array
    local hooks
    hooks=$(python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    hooks = json.load(f)
for h in hooks:
    print(h)
" "$SASE_XPROMPT_HOOKS_FILE" 2>/dev/null)

    if [ -z "$hooks" ]; then
        return 0
    fi

    # Run each hook command, collecting failures
    local failed_commands=()
    local failed_outputs=()

    while IFS= read -r hook_cmd; do
        echo "[sase_stop_hook:xprompt_hooks] Running \`$hook_cmd\`..."
        local output
        if ! output=$(eval "$hook_cmd" 2>&1); then
            failed_commands+=("$hook_cmd")
            failed_outputs+=("$(truncate_output "$output")")
        fi
    done <<< "$hooks"

    # Report failures
    if [ ${#failed_commands[@]} -gt 0 ]; then
        local error_msg="The following xprompt hook command(s) failed:\n\n"
        for i in "${!failed_commands[@]}"; do
            error_msg+="  Command: ${failed_commands[$i]}\n"
            error_msg+="  Output:\n${failed_outputs[$i]}\n\n"
        done
        error_msg+="Please fix the issues reported by the failed hook command(s) above and try again."
        echo -e "$error_msg" >&2
        return 2
    fi

    return 0
}

run "$@"
