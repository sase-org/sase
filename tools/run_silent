#!/usr/bin/env bash
# Context-efficient command wrapper for agent-driven pipelines.
#
# Usage: tools/run_silent <description> <cmd> [args...]
#
# Runs <cmd> with combined stdout+stderr captured to a tempfile.
# On success (exit 0): prints "✓ <description>" and discards the captured output.
# On failure (nonzero): prints "✗ <description>", dumps the captured output,
#                       and exits with the same code.

set -uo pipefail

if [ $# -lt 2 ]; then
    printf 'Usage: %s <description> <cmd> [args...]\n' "$0" >&2
    exit 2
fi

description="$1"
shift

tmp_file=$(mktemp)
trap 'rm -f "$tmp_file"' EXIT

record_diagnostic() {
    artifacts_dir="${SASE_ARTIFACTS_DIR:-}"
    if [ -z "$artifacts_dir" ] || ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    python3 - "$artifacts_dir" "$description" "$1" "$tmp_file" <<'PY' || true
import json
import pathlib
import sys
import time

artifacts_dir, description, exit_code_raw, output_path = sys.argv[1:5]
try:
    output = pathlib.Path(output_path).read_bytes()
    record = {
        "schema_version": 1,
        "producer": "tools/run_silent",
        "description": description,
        "exit_code": int(exit_code_raw),
        "status": "passed" if int(exit_code_raw) == 0 else "failed",
        "output_bytes": len(output),
        "output_lines": output.count(b"\n"),
        "recorded_at_epoch": time.time(),
    }
    root = pathlib.Path(artifacts_dir)
    root.mkdir(parents=True, exist_ok=True)
    with (root / "continuation_stage_diagnostics.jsonl").open(
        "a", encoding="utf-8"
    ) as stream:
        json.dump(record, stream, sort_keys=True)
        stream.write("\n")
except Exception:
    pass
PY
}

if "$@" >"$tmp_file" 2>&1; then
    record_diagnostic 0
    printf '✓ %s\n' "$description"
    exit 0
else
    exit_code=$?
    record_diagnostic "$exit_code"
    printf '✗ %s\n' "$description"
    cat "$tmp_file"
    exit "$exit_code"
fi
