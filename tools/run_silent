#!/usr/bin/env bash
# Context-efficient command wrapper for agent-driven pipelines.
#
# Usage: tools/run_silent <description> <cmd> [args...]
#
# Runs <cmd> with combined stdout+stderr captured to a tempfile.
# On success (exit 0): prints "✓ <description>" and discards the captured output.
# On failure (nonzero): prints "✗ <description>", dumps the captured output,
#                       and exits with the same code.

set -uo pipefail

if [ $# -lt 2 ]; then
    printf 'Usage: %s <description> <cmd> [args...]\n' "$0" >&2
    exit 2
fi

description="$1"
shift

tmp_file=$(mktemp)
state_file=$(mktemp)
helper="$(dirname "$0")/_run_silent_record.py" # tools/_run_silent_record.py
trap 'rm -f "$tmp_file" "$state_file"' EXIT

started_at=$(date +%s.%N 2>/dev/null || date +%s)

need_python() {
    [ -n "${SASE_TOOL_RUN_EVENTS:-}" ] \
        || [ -n "${SASE_ARTIFACTS_DIR:-}" ] \
        || [ -n "${SASE_MONITOR_DIAGNOSTICS_DIR:-}" ]
}

if [ -n "${SASE_TOOL_RUN_EVENTS:-}" ] && command -v python3 >/dev/null 2>&1; then
    python3 "$helper" start --state "$state_file" --description "$description" >/dev/null 2>&1 || true
fi

if "$@" >"$tmp_file" 2>&1; then
    exit_code=0
else
    exit_code=$?
fi

if need_python && command -v python3 >/dev/null 2>&1; then
    python3 "$helper" finish \
        --state "$state_file" \
        --description "$description" \
        --exit-code "$exit_code" \
        --output "$tmp_file" \
        --started-at "$started_at" >/dev/null 2>&1 || true
fi

if [ "$exit_code" -eq 0 ]; then
    printf '✓ %s\n' "$description"
    exit 0
else
    printf '✗ %s\n' "$description"
    cat "$tmp_file"
    exit "$exit_code"
fi
