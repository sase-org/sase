#!/usr/bin/env python3
"""Smoke the ToolRun ledger API from a real sase_core_rs wheel."""

from __future__ import annotations

import argparse
import importlib
import sys
import tempfile
from pathlib import Path
from types import ModuleType
from typing import Any


TOOL_RUN_BINDINGS = (
    "tool_run_wire_schema_version",
    "tool_run_normalize_definition",
    "tool_run_canonicalize_fingerprint",
    "tool_run_unknown_evidence",
    "tool_run_begin",
    "tool_run_append_event",
    "tool_run_finish",
    "tool_run_observe",
    "tool_run_reconcile",
    "tool_run_claim",
    "tool_run_request_stop",
    "tool_run_list",
    "tool_run_show",
    "tool_run_summary",
    "tool_run_retention_preview",
    "tool_run_retention_apply",
    "tool_run_triage_extract",
    "tool_run_triage_record",
    "tool_run_triage_show",
    "tool_run_triage_classify",
    "tool_run_triage_verdict",
    "tool_run_triage_stage",
    "tool_run_triage_settle",
    "tool_run_failures",
    "tool_run_store_stats",
)


def _require_bindings(module: ModuleType) -> None:
    missing = [
        name for name in TOOL_RUN_BINDINGS if not callable(getattr(module, name, None))
    ]
    if missing:
        raise RuntimeError("missing tool_run binding(s): " + ", ".join(missing))


def validate_round_trip(module: ModuleType) -> dict[str, Any]:
    """Exercise the ToolRun store against a temporary SQLite path."""

    _require_bindings(module)
    if int(module.tool_run_wire_schema_version()) != 1:
        raise RuntimeError("unexpected tool_run schema version")
    unknown = module.tool_run_unknown_evidence("not observed")
    if unknown.get("completeness", {}).get("complete") is not False:
        raise RuntimeError(f"unknown evidence must stay explicit: {unknown!r}")

    definition = {
        "schema_version": 1,
        "name": "check",
        "argv": ["just", "check"],
        "description": "check",
        "stages": "run_silent",
        "inputs": ["Justfile"],
        "env": [],
        "args": "deny",
        "fingerprint": {"repos": [], "toolchain": {}},
    }
    normalized = module.tool_run_normalize_definition(definition)
    digest = normalized["digest"]
    fingerprint: dict[str, Any] = {
        "schema_version": 1,
        "project_identity": None,
        "definition_digest": None,
        "extra_args_digest": None,
        "repos": [
            {
                "identity": "sase",
                "head": "triage-smoke-head",
                "index_tree": None,
                "dirty_paths": [],
                "incomplete": None,
            }
        ],
        "inputs": [],
        "env": {},
        "toolchain": {},
        "completeness": {"complete": True, "missing": []},
        "diagnostics": [],
    }
    with tempfile.TemporaryDirectory(prefix="sase-core-rs-tool-runs-smoke-") as tmp:
        store_path = str(Path(tmp) / "tools" / "runs.sqlite")
        started = module.tool_run_begin(
            store_path,
            {
                "schema_version": 1,
                "tool_name": "check",
                "definition": definition,
                "display_argv": ["just", "check"],
                "project": "sase",
                "now_ts": 10,
                "commit_running": True,
            },
            1_000,
        )
        run = started["run"]
        if run.get("state") != "running":
            raise RuntimeError(f"expected running begin, got {started!r}")
        run_id = run["run_id"]
        observed = module.tool_run_observe(
            store_path,
            {
                "schema_version": 1,
                "run_id": run_id,
                "child_pid": 4242,
                "child_pgid": 4242,
                "child_process_start_identity": "boot-1:12345",
                "fingerprint_before": fingerprint,
            },
            1_000,
        )
        if observed.get("replayed") is not False:
            raise RuntimeError(f"first observe must not replay: {observed!r}")
        if observed["run"].get("child_pgid") != 4242:
            raise RuntimeError(f"observe did not persist pgid: {observed!r}")
        replayed = module.tool_run_observe(
            store_path,
            {
                "schema_version": 1,
                "run_id": run_id,
                "child_pid": 4242,
                "child_pgid": 4242,
                "child_process_start_identity": "boot-1:12345",
                "fingerprint_before": fingerprint,
            },
            1_000,
        )
        if replayed.get("replayed") is not True:
            raise RuntimeError(f"repeat observe must replay: {replayed!r}")
        finished = module.tool_run_finish(
            store_path,
            {
                "schema_version": 1,
                "run_id": run_id,
                "state": "succeeded",
                "exit_code": 0,
                "duration_ms": 12,
                "now_ts": 22,
            },
            1_000,
        )
        if finished["run"].get("state") != "succeeded":
            raise RuntimeError(f"unexpected finish: {finished!r}")
        if finished["run"].get("child_pgid") != 4242:
            raise RuntimeError(f"finish dropped observed child facts: {finished!r}")
        extracted = module.tool_run_triage_extract(
            {
                "schema_version": 1,
                "stage_key": "lint (mypy)",
                "output": "src/sase/example.py:1: error: boom  [arg-type]",
            }
        )
        items = extracted.get("items") or []
        if extracted.get("status") != "parsed" or len(items) != 1:
            raise RuntimeError(f"triage extraction did not parse: {extracted!r}")
        recorded = module.tool_run_triage_record(
            store_path,
            {
                "schema_version": 1,
                "run_id": run_id,
                "stages": [
                    {
                        "schema_version": 1,
                        "stage_key": "lint (mypy)",
                        "extraction_status": extracted["status"],
                        "items": items,
                    }
                ],
            },
            1_000,
        )
        if recorded.get("items_inserted") != 1:
            raise RuntimeError(f"triage record did not insert: {recorded!r}")
        triage_shown = module.tool_run_triage_show(
            store_path,
            {"schema_version": 1, "run_id": run_id},
            1_000,
        )
        if not triage_shown.get("triaged") or len(triage_shown.get("items") or []) != 1:
            raise RuntimeError(f"triage show did not round-trip: {triage_shown!r}")
        settled = module.tool_run_triage_settle(
            store_path,
            {
                "schema_version": 1,
                "run_id": run_id,
                "ancestry": ["triage-smoke-head"],
                "knobs": {
                    "min_witnesses": 1,
                    "touched_requires_clean_witness": False,
                },
                "recipe_finished_ts": 23,
                "now_ts": 23,
            },
            1_000,
        )
        if not settled.get("triaged"):
            raise RuntimeError(f"triage settle did not complete: {settled!r}")
        failures = module.tool_run_failures(
            store_path,
            {"schema_version": 1, "project": "sase"},
            1_000,
        )
        if not isinstance(failures.get("groups"), list):
            raise RuntimeError(f"triage failures omitted groups: {failures!r}")
        listed = module.tool_run_list(
            store_path,
            {"schema_version": 1, "limit": 10, "project": "sase"},
            1_000,
        )
        if not listed.get("runs"):
            raise RuntimeError(f"list returned no runs: {listed!r}")
        shown = module.tool_run_show(
            store_path,
            {"schema_version": 1, "run_id": run_id},
            1_000,
        )
        if shown.get("run", {}).get("run_id") != run_id:
            raise RuntimeError(f"show missed run: {shown!r}")
        summary = module.tool_run_summary(
            store_path,
            {
                "schema_version": 1,
                "project": "sase",
                "tool_name": "check",
                "definition_digest": digest,
                "now_ts": 22,
            },
            1_000,
        )
        if summary.get("typical_duration_ms") != 12:
            raise RuntimeError(f"unexpected typical duration: {summary!r}")
        stats = module.tool_run_store_stats(store_path, 1_000)
        if stats.get("run_count") != 1:
            raise RuntimeError(f"unexpected stats: {stats!r}")
        preview = module.tool_run_retention_preview(
            store_path,
            {"schema_version": 1, "now_ts": 22},
            1_000,
        )
        if preview.get("dry_run") is not True:
            raise RuntimeError(f"preview must be dry-run: {preview!r}")
        handoff_started = module.tool_run_begin(
            store_path,
            {
                "schema_version": 1,
                "tool_name": "check",
                "definition": definition,
                "display_argv": ["just", "check"],
                "project": "sase",
                "now_ts": 30,
                "commit_running": False,
                "launch_mode": "handoff",
                "owner_kind": "proc",
                "owner_id": "proc-1",
                "owner_log_path": "logs/proc-1.log",
                "wrapper_pid": 111,
                "boot_id": "boot-1",
                "process_start_identity": "boot-1:111",
                "launch": {
                    "argv": ["just", "check"],
                    "tool_name": "check",
                    "extra_args": [],
                    "display_argv": ["just", "check"],
                    "definition": definition,
                    "digest": digest,
                    "adhoc": False,
                },
            },
            1_000,
        )
        handoff_run = handoff_started["run"]
        handoff_id = handoff_run["run_id"]
        if handoff_run.get("state") != "created":
            raise RuntimeError(f"expected created handoff: {handoff_started!r}")
        handoff_shown = module.tool_run_show(
            store_path,
            {"schema_version": 1, "run_id": handoff_id},
            1_000,
        )
        if "launch" in (handoff_shown.get("run") or {}):
            raise RuntimeError(f"show must not expose launch: {handoff_shown!r}")
        claimed = module.tool_run_claim(
            store_path,
            {
                "schema_version": 1,
                "run_id": handoff_id,
                "owner_kind": "proc",
                "owner_id": "proc-1",
                "wrapper_pid": 4242,
                "boot_id": "boot-1",
                "process_start_identity": "boot-1:4242",
                "now_ts": 31,
            },
            1_000,
        )
        if claimed.get("outcome") != "claimed":
            raise RuntimeError(f"claim failed: {claimed!r}")
        if (claimed.get("launch") or {}).get("argv") != ["just", "check"]:
            raise RuntimeError(f"claim envelope mismatch: {claimed!r}")
        replayed_claim = module.tool_run_claim(
            store_path,
            {
                "schema_version": 1,
                "run_id": handoff_id,
                "owner_kind": "proc",
                "owner_id": "proc-1",
                "wrapper_pid": 4242,
                "boot_id": "boot-1",
                "process_start_identity": "boot-1:4242",
                "now_ts": 31,
            },
            1_000,
        )
        if replayed_claim.get("replayed") is not True:
            raise RuntimeError(f"replayed claim must replay: {replayed_claim!r}")
        stopped = module.tool_run_request_stop(
            store_path,
            {
                "schema_version": 1,
                "run_id": handoff_id,
                "requested_by": "agent-1",
                "now_ts": 32,
            },
            1_000,
        )
        if stopped.get("outcome") != "recorded":
            raise RuntimeError(f"stop must record: {stopped!r}")
        handoff_finished = module.tool_run_finish(
            store_path,
            {
                "schema_version": 1,
                "run_id": handoff_id,
                "state": "signaled",
                "terminal_cause": "stop_requested",
                "diagnostics": ["stopped by request"],
                "now_ts": 33,
            },
            1_000,
        )
        if handoff_finished["run"].get("terminal_cause") != "stop_requested":
            raise RuntimeError(f"finish must persist cause: {handoff_finished!r}")
        if "stopped by request" not in handoff_finished["run"].get("diagnostics", []):
            raise RuntimeError(f"finish must persist diagnostics: {handoff_finished!r}")
    return {
        "schema_version": 1,
        "run_state": finished["run"]["state"],
        "run_count": stats["run_count"],
        "typical_duration_ms": summary["typical_duration_ms"],
        "unknown_complete": unknown["completeness"]["complete"],
        "triage_items": len(triage_shown["items"]),
        "triage_settled": settled["triaged"],
        "failure_groups": len(failures["groups"]),
        "handoff_outcome": claimed["outcome"],
        "handoff_replayed": replayed_claim["replayed"],
        "handoff_stop": stopped["outcome"],
        "handoff_cause": handoff_finished["run"]["terminal_cause"],
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.parse_args(argv)
    try:
        module = importlib.import_module("sase_core_rs")
        result = validate_round_trip(module)
    except Exception as error:
        print(f"[tool-run-smoke] {error}", file=sys.stderr)
        return 1
    version = getattr(module, "__version__", "<unknown>")
    print(f"[tool-run-smoke] sase-core-rs {version}: {result}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
