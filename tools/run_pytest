#!/usr/bin/env python3
"""Run pytest for Justfile recipes with caller-relative test selectors."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

import pytest


REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from tests._suite_gate import (  # noqa: E402
    WorkerTokenLease,
    automatic_worker_range,
    configured_token_budget,
    gate_directory,
    gate_timeout,
)


PYTEST_ENV_UNSET_KEYS = (
    "SASE_COMMIT_METHOD",
    "SASE_COMMIT_METHOD_ALLOW_OVERRIDE",
    "SASE_PR_NAME",
    "SASE_PR_STATUS",
)
FAST_MARKER_EXPRESSION = "not slow"
FAST_NON_VISUAL_MARKER_EXPRESSION = "not slow and not visual"
SLOW_MARKER_EXPRESSION = "slow"
VISUAL_MARKER_EXPRESSION = "visual"
EXCLUDE_VISUAL_ENV = "SASE_PYTEST_EXCLUDE_VISUAL"
PYTEST_DIST_ENV = "SASE_PYTEST_DIST"
DEFAULT_PYTEST_DIST = "worksteal"
SUPPORTED_PYTEST_DIST_MODES = ("loadfile", "worksteal")
INLINE_SNAPSHOT_OPTION = "--inline-snapshot"
INLINE_SNAPSHOT_SERIAL_SHORTCUTS = frozenset({"--fix", "--review"})
NON_PATH_VALUE_OPTIONS = frozenset(
    {
        "-k",
        "-m",
        "-n",
        "--numprocesses",
        "--dist",
        "--tb",
        "--maxfail",
        "--durations",
        "--import-mode",
        "--color",
        "--capture",
        INLINE_SNAPSHOT_OPTION,
        "--log-level",
    }
)


def _split_nodeid(value: str) -> tuple[str, str]:
    path_part, separator, node_part = value.partition("::")
    return path_part, f"{separator}{node_part}" if separator else ""


def _repo_relative(path: Path) -> str:
    try:
        return path.resolve().relative_to(REPO_ROOT).as_posix()
    except ValueError:
        return str(path.resolve())


def _normalize_selector(value: str, invocation_dir: Path) -> str:
    path_part, node_part = _split_nodeid(value)
    if not path_part:
        return value

    candidate = Path(path_part)
    if candidate.is_absolute():
        return value

    invocation_candidate = invocation_dir / candidate
    if invocation_dir != REPO_ROOT and invocation_candidate.exists():
        return f"{_repo_relative(invocation_candidate)}{node_part}"

    repo_candidate = REPO_ROOT / candidate
    if repo_candidate.exists():
        return value

    return value


def _normalize_args(args: list[str], invocation_dir: Path) -> list[str]:
    if args and args[0] == "--":
        args = args[1:]

    normalized: list[str] = []
    skip_next = False
    for arg in args:
        if skip_next:
            normalized.append(arg)
            skip_next = False
            continue

        option_name = arg.split("=", 1)[0]
        if option_name in NON_PATH_VALUE_OPTIONS:
            normalized.append(arg)
            skip_next = "=" not in arg
            continue

        if arg.startswith("-"):
            normalized.append(arg)
            continue

        normalized.append(_normalize_selector(arg, invocation_dir))

    return normalized


def _resolve_mode_and_args(mode: str, args: list[str]) -> tuple[str, list[str]]:
    resolved_args: list[str] = []
    for arg in args:
        if arg == "--visual":
            mode = "visual"
            continue
        resolved_args.append(arg)

    return mode, resolved_args


def _fast_marker_expression() -> str:
    """Return the broad-suite marker expression selected by the caller."""
    exclude_visual = os.environ.get(EXCLUDE_VISUAL_ENV, "").strip().lower()
    if exclude_visual in {"1", "true", "yes", "on"}:
        return FAST_NON_VISUAL_MARKER_EXPRESSION
    return FAST_MARKER_EXPRESSION


def _inline_snapshot_value_requires_serial(value: str) -> bool:
    modes = [mode.strip() for mode in value.split(",") if mode.strip()]
    if not modes:
        return True
    return any(mode != "disable" for mode in modes)


def _requires_serial_pytest(args: list[str]) -> bool:
    for index, arg in enumerate(args):
        if arg in INLINE_SNAPSHOT_SERIAL_SHORTCUTS:
            return True

        if arg == INLINE_SNAPSHOT_OPTION:
            if index + 1 >= len(args):
                return True
            if _inline_snapshot_value_requires_serial(args[index + 1]):
                return True
            continue

        prefix = f"{INLINE_SNAPSHOT_OPTION}="
        if arg.startswith(prefix) and _inline_snapshot_value_requires_serial(
            arg.removeprefix(prefix)
        ):
            return True

    return False


def _configured_distribution_mode() -> str:
    raw_value = os.environ.get(PYTEST_DIST_ENV)
    if raw_value is None:
        return DEFAULT_PYTEST_DIST

    distribution_mode = raw_value.strip()
    if distribution_mode not in SUPPORTED_PYTEST_DIST_MODES:
        accepted = ", ".join(SUPPORTED_PYTEST_DIST_MODES)
        raise pytest.UsageError(
            f"{PYTEST_DIST_ENV} must be one of: {accepted}; got {raw_value!r}"
        )
    return distribution_mode


def _pytest_command(
    mode: str,
    args: list[str],
    *,
    worker_count: int = 1,
    distribution_mode: str | None = None,
) -> list[str]:
    command = [
        sys.executable,
        "-m",
        "pytest",
    ]
    if not _requires_serial_pytest(args):
        if worker_count < 1:
            raise ValueError("worker_count must be positive for a parallel run")
        if distribution_mode is None:
            distribution_mode = _configured_distribution_mode()
        command.extend(["-n", str(worker_count), f"--dist={distribution_mode}"])

    if mode == "slow":
        command.extend(["-m", SLOW_MARKER_EXPRESSION])
    elif mode == "visual":
        command.extend(["-m", VISUAL_MARKER_EXPRESSION])
    elif mode == "fast":
        command.extend(["-m", _fast_marker_expression()])
    elif mode == "cov":
        command.extend(
            [
                "-m",
                _fast_marker_expression(),
                "--cov=src/sase",
                "--cov-branch",
                "--cov-report=term-missing:skip-covered",
                "--cov-report=html",
                "--cov-report=xml",
                "--cov-fail-under=50",
            ]
        )

    command.extend(args)
    return command


def _sanitize_pytest_environment() -> None:
    for key in PYTEST_ENV_UNSET_KEYS:
        os.environ.pop(key, None)


def _configured_worker_count() -> int | None:
    raw_value = os.environ.get("SASE_PYTEST_WORKERS")
    if raw_value is None:
        return None
    try:
        worker_count = int(raw_value)
    except ValueError as error:
        raise pytest.UsageError(
            "SASE_PYTEST_WORKERS must be a positive integer"
        ) from error
    if worker_count < 1:
        raise pytest.UsageError("SASE_PYTEST_WORKERS must be a positive integer")
    return worker_count


def _reject_numprocesses_args(args: list[str]) -> None:
    for arg in args:
        if (
            arg in {"-n", "--numprocesses"}
            or arg.startswith("-n=")
            or arg.startswith("--numprocesses=")
            or (arg.startswith("-n") and len(arg) > 2)
        ):
            raise pytest.UsageError(
                "tools/run_pytest governs its xdist count from the shared token "
                "pool; use SASE_PYTEST_WORKERS for an exact worker request "
                "instead of passing -n/--numprocesses."
            )


def _parallel_worker_grant() -> tuple[int, WorkerTokenLease | None]:
    budget, capacity_is_explicit = configured_token_budget()
    exact_worker_count = _configured_worker_count()
    gate_disabled = os.environ.get("SASE_TEST_GATE_DISABLED") == "1"

    if exact_worker_count is not None:
        if gate_disabled:
            return exact_worker_count, None
        floor = ceiling = exact_worker_count
        exact = True
    else:
        floor, ceiling = automatic_worker_range(budget)
        if gate_disabled:
            return ceiling, None
        exact = False

    lease = WorkerTokenLease(
        directory=gate_directory(),
        budget=budget,
        timeout=gate_timeout(),
        capacity_is_explicit=capacity_is_explicit,
        governed=True,
    )
    granted = lease.acquire(floor, ceiling, exact=exact)
    lease.make_inheritable()
    return granted, lease


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("fast", "slow", "visual", "cov"))
    parser.add_argument("pytest_args", nargs=argparse.REMAINDER)
    namespace = parser.parse_args(argv)

    invocation_dir = Path(
        os.environ.get("SASE_JUST_INVOCATION_DIR", str(REPO_ROOT))
    ).resolve()
    mode, pytest_args = _resolve_mode_and_args(namespace.mode, namespace.pytest_args)
    pytest_args = _normalize_args(pytest_args, invocation_dir)

    lease: WorkerTokenLease | None = None
    try:
        if _requires_serial_pytest(pytest_args):
            worker_count = 1
            distribution_mode = None
        else:
            distribution_mode = _configured_distribution_mode()
            _reject_numprocesses_args(pytest_args)
            worker_count, lease = _parallel_worker_grant()
        command = _pytest_command(
            mode,
            pytest_args,
            worker_count=worker_count,
            distribution_mode=distribution_mode,
        )

        _sanitize_pytest_environment()
        os.chdir(REPO_ROOT)
        os.execv(sys.executable, command)
        raise AssertionError("unreachable")
    except pytest.UsageError as error:
        print(f"pytest runner configuration error: {error}", file=sys.stderr)
        return int(pytest.ExitCode.USAGE_ERROR)
    finally:
        if lease is not None:
            lease.release()


if __name__ == "__main__":
    raise SystemExit(main())
