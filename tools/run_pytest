PYTEST_ENV_UNSET_KEYS = (
    "SASE_COMMIT_METHOD",
    "SASE_COMMIT_METHOD_ALLOW_OVERRIDE",
    "SASE_PR_NAME",
    "SASE_PR_STATUS",
)
FAST_MARKER_EXPRESSION = "not slow and not visual"
SLOW_MARKER_EXPRESSION = "slow"
VISUAL_MARKER_EXPRESSION = "visual"
TERMINAL_SMOKE_MARKER_EXPRESSION = "terminal_smoke"
# `scoped` is serial by construction: `-n 1` makes `_xdist_worker_count` return
# None, so no suite-gate path runs at all and the run never queues for tokens.
SERIAL_MODES = frozenset({"terminal-smoke", "scoped"})
SCOPED_MODE = "scoped"
#: Records the per-test coverage baseline the diff-scoped selector consumes.
CONTEXTS_MODE = "cov-contexts"
CONTEXTS_COVERAGE_CONFIG = "coverage_contexts.toml"
#: coverage's measurement-core selector, and the one value that attributes every
#: line to every test that ran it. See `_apply_contexts_environment`.
COVERAGE_CORE_ENV = "COVERAGE_CORE"
CONTEXTS_COVERAGE_CORE = "ctrace"
SCOPED_WORKER_REMEDY = (
    "a governed parallel run of an arbitrary subset is exactly the "
    "unaccounted-demand shape the suite gate exists to prevent; use "
    "`just check-full` (or `just test`) for a governed parallel run."
)
#: Modes that run the whole fast suite, and whose failures are therefore
#: evidence about what a scoped run should not have skipped.
FULL_LANE_MODES = frozenset({"fast", "cov", CONTEXTS_MODE})
HEALTH_PLUGIN_MODULE = "tests._test_selection_health_plugin"
HEALTH_DISABLED_ENV = "SASE_TEST_SELECTION_HEALTH_DISABLED"
TIMINGS_PLUGIN_MODULE = "tests._test_selection_timings_plugin"
#: Modes that contribute per-test-file durations to the cost model. The full
#: lanes cover every test file in one pass, which is what bootstraps the table;
#: a scoped run refreshes the handful of files the lane touches most.
TIMINGS_RECORDING_MODES = frozenset({*FULL_LANE_MODES, SCOPED_MODE})
PYTEST_DIST_ENV = "SASE_PYTEST_DIST"
DEFAULT_PYTEST_DIST = "worksteal"
SUPPORTED_PYTEST_DIST_MODES = ("loadfile", "worksteal")
PYTEST_TMPDIR_ENV = "SASE_PYTEST_TMPDIR"
PYTEST_TMP_REDIRECTED_ENV = "SASE_PYTEST_TMP_REDIRECTED"
# Stay outside repository/workspace-store ancestry without making tmp_path so deep
# that AF_UNIX socket tests exceed Linux's 108-byte path limit.
DEFAULT_PYTEST_TMPDIR = Path("/var/tmp") / (
    "sase-" + hashlib.sha256(os.fsencode(REPO_ROOT)).hexdigest()[:8]
)
PYTEST_TMP_REAP_HORIZON_SECONDS = 12 * 60 * 60
INLINE_SNAPSHOT_OPTION = "--inline-snapshot"
INLINE_SNAPSHOT_SERIAL_SHORTCUTS = frozenset({"--fix", "--review"})
NON_PATH_VALUE_OPTIONS = frozenset(
    {
        "-k",
        "-m",
        "-n",
        "--numprocesses",
        "--dist",
        "--tb",
        "--maxfail",
        "--durations",
        "--import-mode",
        "--color",
        "--capture",
        INLINE_SNAPSHOT_OPTION,
        "--log-level",
    }
)


def _split_nodeid(value: str) -> tuple[str, str]:
    path_part, separator, node_part = value.partition("::")
    return path_part, f"{separator}{node_part}" if separator else ""


def _repo_relative(path: Path) -> str:
    try:
        return path.resolve().relative_to(REPO_ROOT).as_posix()
    except ValueError:
        return str(path.resolve())


def _normalize_selector(value: str, invocation_dir: Path) -> str:
    path_part, node_part = _split_nodeid(value)
    if not path_part:
        return value

    candidate = Path(path_part)
    if candidate.is_absolute():
        return value

    invocation_candidate = invocation_dir / candidate
    if invocation_dir != REPO_ROOT and invocation_candidate.exists():
        return f"{_repo_relative(invocation_candidate)}{node_part}"

    repo_candidate = REPO_ROOT / candidate
    if repo_candidate.exists():
        return value

    return value


def _normalize_args(args: list[str], invocation_dir: Path) -> list[str]:
    if args and args[0] == "--":
        args = args[1:]

    normalized: list[str] = []
    skip_next = False
    for arg in args:
        if skip_next:
            normalized.append(arg)
            skip_next = False
            continue

        option_name = arg.split("=", 1)[0]
        if option_name in NON_PATH_VALUE_OPTIONS:
            normalized.append(arg)
            skip_next = "=" not in arg
            continue

        if arg.startswith("-"):
            normalized.append(arg)
            continue

        normalized.append(_normalize_selector(arg, invocation_dir))

    return normalized


def _resolve_mode_and_args(mode: str, args: list[str]) -> tuple[str, list[str]]:
    resolved_args: list[str] = []
    for arg in args:
        if arg == "--visual":
            mode = "visual"
            continue
        resolved_args.append(arg)

    return mode, resolved_args


def _inline_snapshot_value_requires_serial(value: str) -> bool:
    modes = [mode.strip() for mode in value.split(",") if mode.strip()]
    if not modes:
        return True
    return any(mode != "disable" for mode in modes)


def _requires_serial_pytest(args: list[str]) -> bool:
    for index, arg in enumerate(args):
        if arg in INLINE_SNAPSHOT_SERIAL_SHORTCUTS:
            return True

        if arg == INLINE_SNAPSHOT_OPTION:
            if index + 1 >= len(args):
                return True
            if _inline_snapshot_value_requires_serial(args[index + 1]):
                return True
            continue

        prefix = f"{INLINE_SNAPSHOT_OPTION}="
        if arg.startswith(prefix) and _inline_snapshot_value_requires_serial(
            arg.removeprefix(prefix)
        ):
            return True

    return False


def _requires_serial_run(mode: str, args: list[str]) -> bool:
    return mode in SERIAL_MODES or _requires_serial_pytest(args)


def _configured_distribution_mode() -> str:
    raw_value = os.environ.get(PYTEST_DIST_ENV)
    if raw_value is None:
        return DEFAULT_PYTEST_DIST

    distribution_mode = raw_value.strip()
    if distribution_mode not in SUPPORTED_PYTEST_DIST_MODES:
        accepted = ", ".join(SUPPORTED_PYTEST_DIST_MODES)
        raise pytest.UsageError(
            f"{PYTEST_DIST_ENV} must be one of: {accepted}; got {raw_value!r}"
        )
    return distribution_mode


def _pytest_command(
    mode: str,
    args: list[str],
    *,
    worker_count: int = 1,
    distribution_mode: str | None = None,
) -> list[str]:
    command = [
        sys.executable,
        "-m",
        "pytest",
    ]
    if not _requires_serial_run(mode, args):
        if worker_count < 1:
            raise ValueError("worker_count must be positive for a parallel run")
        if distribution_mode is None:
            distribution_mode = _configured_distribution_mode()
        command.extend(["-n", str(worker_count), f"--dist={distribution_mode}"])

    if mode == "slow":
        command.extend(["-m", SLOW_MARKER_EXPRESSION])
    elif mode == "visual":
        command.extend(["-m", VISUAL_MARKER_EXPRESSION])
    elif mode == "terminal-smoke":
        command.extend(["-m", TERMINAL_SMOKE_MARKER_EXPRESSION])
    elif mode in ("fast", SCOPED_MODE):
        command.extend(["-m", FAST_MARKER_EXPRESSION])
    elif mode == "cov":
        command.extend(
            [
                "-m",
                FAST_MARKER_EXPRESSION,
                "--cov=src/sase",
                "--cov-branch",
                "--cov-report=term-missing:skip-covered",
                "--cov-report=html",
                "--cov-report=xml",
                "--cov-fail-under=50",
            ]
        )
    elif mode == CONTEXTS_MODE:
        # `--cov-context=test` records *which test* executed each line: the
        # per-test ground truth `tests._test_selection_contexts` consumes. It
        # deliberately does not share the `cov` lane. Branch coverage stores
        # every arc per context, which measured at 906 MB against 49 MB for
        # line coverage over the same suite, and selection never asks a
        # branch question. See `coverage_contexts.toml`.
        command.extend(
            [
                "-m",
                FAST_MARKER_EXPRESSION,
                f"--cov-config={CONTEXTS_COVERAGE_CONFIG}",
                "--cov=src/sase",
                "--cov-context=test",
                "--cov-report=",
            ]
        )

    command.extend(args)
    return command


def _sanitize_pytest_environment() -> None:
    for key in PYTEST_ENV_UNSET_KEYS:
        os.environ.pop(key, None)


def _apply_contexts_environment(mode: str) -> None:
    """Pin the measurement core that records per-test contexts faithfully.

    On Python 3.14 coverage defaults to the ``sysmon`` core, which disables
    monitoring for a code location once it has been seen. That is a large speed
    win and it is wrong for this lane: the *second* test to execute a line is
    never attributed to it, so per-test contexts thin out as the suite runs.
    Measured on athena at ``6b0976bcb``, `tests/test_agent_lanes.py` recorded 6
    contexts against `agent_lanes.py` under ``sysmon`` in a full-suite run and
    32 under ``ctrace`` — the same 32 CI's Python 3.12 leg records, since
    ``ctrace`` is already the default there. A baseline is ground truth or it is
    nothing, so the core is pinned rather than left to the interpreter version.
    """
    if mode != CONTEXTS_MODE or COVERAGE_CORE_ENV in os.environ:
        return
    os.environ[COVERAGE_CORE_ENV] = CONTEXTS_COVERAGE_CORE


def _configured_pytest_tmpdir() -> Path:
    override = os.environ.get(PYTEST_TMPDIR_ENV)
    if override is None:
        return DEFAULT_PYTEST_TMPDIR
    if not override:
        raise pytest.UsageError(f"{PYTEST_TMPDIR_ENV} must not be empty")
    scratch_root = Path(override).expanduser()
    if not scratch_root.is_absolute():
        scratch_root = REPO_ROOT / scratch_root
    resolved = scratch_root.resolve()
    broad_roots = {Path("/"), Path("/tmp"), Path("/var/tmp")}
    if resolved in broad_roots or resolved == REPO_ROOT or resolved in REPO_ROOT.parents:
        raise pytest.UsageError(
            f"{PYTEST_TMPDIR_ENV} must name a dedicated scratch directory, "
            f"not broad target {resolved}"
        )
    return resolved


def _is_pytest_run_directory(path: Path) -> bool:
    name = path.name
    return name.startswith("garbage-") or (
        name.startswith("pytest-") and name.removeprefix("pytest-").isdigit()
    )


def _stale_scratch_entry_kind(path: Path, cutoff: float) -> str | None:
    try:
        entry_stat = path.stat(follow_symlinks=False)
    except OSError:
        return None
    if stat.S_ISLNK(entry_stat.st_mode):
        return None
    if entry_stat.st_mtime >= cutoff:
        return None

    if stat.S_ISDIR(entry_stat.st_mode):
        lock_path = path / ".lock"
        try:
            lock_mtime = lock_path.stat(follow_symlinks=False).st_mtime
        except FileNotFoundError:
            lock_mtime = None
        except OSError:
            return None
        if lock_mtime is not None and lock_mtime >= cutoff:
            return None
        return "directory"

    if stat.S_ISREG(entry_stat.st_mode):
        return "file"
    return None


def _remove_stale_scratch_entry(path: Path, cutoff: float) -> None:
    entry_kind = _stale_scratch_entry_kind(path, cutoff)
    if entry_kind is None:
        return
    try:
        if entry_kind == "directory":
            shutil.rmtree(path)
        else:
            path.unlink()
    except OSError:
        pass


def _reap_pytest_user_root(user_root: Path, cutoff: float) -> None:
    try:
        user_root_stat = user_root.stat(follow_symlinks=False)
    except OSError:
        return
    if not stat.S_ISDIR(user_root_stat.st_mode):
        return

    try:
        run_directories = list(user_root.iterdir())
    except OSError:
        return

    for run_directory in run_directories:
        if _is_pytest_run_directory(run_directory):
            _remove_stale_scratch_entry(run_directory, cutoff)


def _reap_stale_pytest_runs(
    scratch_root: Path,
    *,
    now: float | None = None,
    horizon_seconds: float = PYTEST_TMP_REAP_HORIZON_SECONDS,
) -> None:
    cutoff = (time.time() if now is None else now) - horizon_seconds
    try:
        scratch_entries = list(scratch_root.iterdir())
    except OSError:
        return

    for scratch_entry in scratch_entries:
        if scratch_entry.name.startswith("pytest-of-"):
            _reap_pytest_user_root(scratch_entry, cutoff)
            continue
        _remove_stale_scratch_entry(scratch_entry, cutoff)


def _prepare_pytest_tmpdir() -> Path:
    scratch_root = _configured_pytest_tmpdir()
    try:
        scratch_root.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise pytest.UsageError(
            f"cannot prepare {PYTEST_TMPDIR_ENV} directory {scratch_root}: {error}"
        ) from error
    _reap_stale_pytest_runs(scratch_root)
    os.environ["TMPDIR"] = str(scratch_root)
    os.environ[PYTEST_TMP_REDIRECTED_ENV] = "1"
    return scratch_root


def _configured_worker_count() -> int | None:
    raw_value = os.environ.get("SASE_PYTEST_WORKERS")
    if raw_value is None:
        return None
    try:
        worker_count = int(raw_value)
    except ValueError as error:
        raise pytest.UsageError(
            "SASE_PYTEST_WORKERS must be a positive integer"
        ) from error
    if worker_count < 1:
        raise pytest.UsageError("SASE_PYTEST_WORKERS must be a positive integer")
    return worker_count


DEFAULT_WORKER_REMEDY = (
    "use SASE_PYTEST_WORKERS for an exact worker request instead of passing "
    "-n/--numprocesses."
)


def _reject_numprocesses_args(
    args: list[str], *, remedy: str = DEFAULT_WORKER_REMEDY
) -> None:
    for arg in args:
        if (
            arg in {"-n", "--numprocesses"}
            or arg.startswith("-n=")
            or arg.startswith("--numprocesses=")
            or (arg.startswith("-n") and len(arg) > 2)
        ):
            raise pytest.UsageError(
                "tools/run_pytest governs its xdist count from the shared token "
                f"pool; {remedy}"
            )


def _parallel_worker_grant() -> tuple[int, WorkerTokenLease | None]:
    budget, capacity_is_explicit = configured_token_budget()
    exact_worker_count = _configured_worker_count()
    gate_disabled = os.environ.get("SASE_TEST_GATE_DISABLED") == "1"

    if exact_worker_count is not None:
        if gate_disabled:
            return exact_worker_count, None
        floor = ceiling = exact_worker_count
        exact = True
    else:
        floor, ceiling = automatic_worker_range(budget)
        if gate_disabled:
            return ceiling, None
        exact = False

    lease = WorkerTokenLease(
        directory=gate_directory(),
        budget=budget,
        timeout=gate_timeout(),
        capacity_is_explicit=capacity_is_explicit,
        governed=True,
    )
    granted = lease.acquire(floor, ceiling, exact=exact)
    lease.make_inheritable()
    return granted, lease


def _scoped_manifest_path() -> Path:
    return REPO_ROOT / SELECTION_DIRECTORY / MANIFEST_FILENAME


def _scoped_selection(manifest_path: Path) -> Selection:
    """Compute and persist the diff-scoped selection for a `scoped` run.

    Configuration problems (a bad depth or ratio, an unusable graph) are usage
    errors. An unresolvable base ref is *not* one: the engine escalates on it,
    so a stale remote fails toward more testing rather than less.
    """
    try:
        selection = select_tests(REPO_ROOT, SelectionOptions.from_environment())
    except SelectionError as error:
        raise pytest.UsageError(f"test selection failed: {error}") from error
    write_manifest(manifest_path, selection.manifest)
    return selection


def _complete_scoped_manifest(
    manifest_path: Path,
    manifest: dict[str, object],
    *,
    duration: float,
    outcome: str,
) -> None:
    """Append the two fields only the runner knows to the selection manifest."""
    completed = {**manifest, "duration": round(duration, 3), "outcome": outcome}
    write_manifest(manifest_path, completed)
    _record_scoped_run(completed)


def _health_recording_enabled() -> bool:
    return os.environ.get(HEALTH_DISABLED_ENV) != "1"


def _health_store() -> Path:
    return store_directory(REPO_ROOT)


def _record_scoped_run(manifest: dict[str, object]) -> None:
    """Copy a completed scoped manifest into the durable, host-local store.

    ``.pytest_cache`` dies with the workspace; the durable store is what lets a
    land agent in one workspace see what phase agents in the others skipped.
    Failing to record is never worth failing a run over.
    """
    if not _health_recording_enabled():
        return
    try:
        record_selection(
            _health_store(), manifest, workspace=workspace_identity(REPO_ROOT)
        )
    except OSError:
        pass


def _head_sha() -> str | None:
    try:
        return run_git(REPO_ROOT, "rev-parse", "HEAD").strip() or None
    except SelectionError:
        return None


def _full_lane_change_set() -> ChangeSet | None:
    """The change set this full run is testing, as the selector computes it.

    Correlation compares a full run's change set against a scoped run's, so it
    has to be the *same* computation — same merge-base, same working-tree
    union — not an approximation of it. Git trouble yields ``None``, which
    makes the record uncorrelatable rather than wrongly correlated.
    """
    try:
        return compute_change_set(
            REPO_ROOT, SelectionOptions.from_environment().base_ref
        )
    except SelectionError:
        return None


def _full_lane_recording_args(mode: str) -> list[str]:
    """Arm the full-lane failure recorder, returning the pytest args it needs.

    The full lanes hand off with ``execv``, so the record has to be written
    from inside pytest. The runner still picks the path here, in the parent,
    where ``SASE_HOME`` is the real one rather than a per-test redirect, and
    where the working tree is still the one being tested.
    """
    if mode not in FULL_LANE_MODES or not _health_recording_enabled():
        return []
    change_set = _full_lane_change_set()
    head = change_set.head if change_set is not None else _head_sha()
    try:
        record_path = allocate_record_path(
            _health_store(), KIND_FULL_RUN, head=head, pid=os.getpid()
        )
    except OSError:
        return []
    os.environ[RECORD_ENV] = json.dumps(
        {
            "path": str(record_path),
            "head": head,
            "mode": mode,
            "workspace": workspace_identity(REPO_ROOT),
            "changed_files": (
                None if change_set is None else sorted(set(change_set.paths))
            ),
        }
    )
    return ["-p", HEALTH_PLUGIN_MODULE]


def _timings_pytest_args(mode: str) -> list[str]:
    """The pytest args that load the duration recorder, if this mode records.

    Only the args here. The recorder's request carries the granted worker
    count, which the runner does not know until after the gate has answered,
    so arming it is a second step — see `_arm_timings_recorder`.
    """
    if mode not in TIMINGS_RECORDING_MODES or not timings_enabled():
        return []
    return ["-p", TIMINGS_PLUGIN_MODULE]


def _arm_timings_recorder(mode: str, *, worker_count: int | None) -> None:
    """Hand the loaded recorder its store, resolved here in the parent.

    Same reason the health recorder resolves its path here: this process sees
    the real ``SASE_HOME``, while the suite's own fixtures redirect it per test.
    """
    os.environ[TIMINGS_RECORD_ENV] = json.dumps(
        {
            "directory": str(timings_directory(_health_store())),
            "mode": mode,
            "worker_count": worker_count,
        }
    )


def _reject_scoped_worker_overrides(args: list[str]) -> None:
    _reject_numprocesses_args(args, remedy=SCOPED_WORKER_REMEDY)
    if os.environ.get("SASE_PYTEST_WORKERS") is not None:
        raise pytest.UsageError(
            f"scoped runs are serial and take no suite-gate lease, so "
            f"SASE_PYTEST_WORKERS does not apply; {SCOPED_WORKER_REMEDY}"
        )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "mode",
        choices=(
            "fast",
            "slow",
            "visual",
            "cov",
            CONTEXTS_MODE,
            "terminal-smoke",
            SCOPED_MODE,
        ),
    )
    parser.add_argument("pytest_args", nargs=argparse.REMAINDER)
    namespace = parser.parse_args(argv)

    invocation_dir = Path(
        os.environ.get("SASE_JUST_INVOCATION_DIR", str(REPO_ROOT))
    ).resolve()
    mode, pytest_args = _resolve_mode_and_args(namespace.mode, namespace.pytest_args)
    pytest_args = _normalize_args(pytest_args, invocation_dir)

    lease: WorkerTokenLease | None = None
    scoped_manifest: dict[str, object] | None = None
    manifest_path = _scoped_manifest_path()
    try:
        if mode == SCOPED_MODE:
            _reject_scoped_worker_overrides(pytest_args)
            selection = _scoped_selection(manifest_path)
            # `tools/run_silent` swallows stdout on success, so the summary goes
            # to stderr where a failure dump will carry it.
            print(summary_line(selection), file=sys.stderr)
            print(context_line(selection.contexts), file=sys.stderr)
            if selection.escalated:
                # Never let the fast path become the slow path: a large or
                # broadened selection runs the governed full lane instead of a
                # serial partial one.
                print(
                    "escalating to the governed full test lane "
                    f"(rules: {', '.join(selection.rules) or 'none'})",
                    file=sys.stderr,
                )
                # Record the escalation before handing off: the full lane
                # `execv`s away, and an unrecorded escalation would read as an
                # escalation rate of zero.
                _complete_scoped_manifest(
                    manifest_path, selection.manifest, duration=0.0, outcome="escalated"
                )
                mode = "fast"
            elif not selection.selected:
                print(
                    "no test files selected; skipping pytest entirely",
                    file=sys.stderr,
                )
                _complete_scoped_manifest(
                    manifest_path, selection.manifest, duration=0.0, outcome="empty"
                )
                return 0
            else:
                scoped_manifest = selection.manifest
                pytest_args = [*pytest_args, *selection.selected]

        pytest_args = [*_full_lane_recording_args(mode), *pytest_args]
        timings_args = _timings_pytest_args(mode)
        pytest_args = [*timings_args, *pytest_args]

        if _requires_serial_run(mode, pytest_args):
            worker_count = 1
            distribution_mode = None
        else:
            distribution_mode = _configured_distribution_mode()
            _reject_numprocesses_args(pytest_args)
            worker_count, lease = _parallel_worker_grant()
        command = _pytest_command(
            mode,
            pytest_args,
            worker_count=worker_count,
            distribution_mode=distribution_mode,
        )

        _prepare_pytest_tmpdir()
        _sanitize_pytest_environment()
        _apply_contexts_environment(mode)
        if timings_args:
            _arm_timings_recorder(mode, worker_count=worker_count)
        os.chdir(REPO_ROOT)
        if scoped_manifest is not None:
            # Belt-and-braces against subprocess-spawning tests: `-n 1` already
            # keeps every gate path dormant.
            environment = {**os.environ, "SASE_TEST_GATE_DISABLED": "1"}
            # `execv` cannot come back to finish the manifest, so scoped mode is
            # the one mode that keeps a parent process alive.
            started = time.monotonic()
            returncode = subprocess.run(command, env=environment).returncode
            _complete_scoped_manifest(
                manifest_path,
                scoped_manifest,
                duration=time.monotonic() - started,
                outcome="passed" if returncode == 0 else "failed",
            )
            return returncode
        os.execv(sys.executable, command)
        raise AssertionError("unreachable")
    except pytest.UsageError as error:
        print(f"pytest runner configuration error: {error}", file=sys.stderr)
        return int(pytest.ExitCode.USAGE_ERROR)
    finally:
        if lease is not None:
            lease.release()


if __name__ == "__main__":
    raise SystemExit(main())
