def _ace_page_group_manifest_paths() -> list[str]:
    manifest_path = REPO_ROOT / ACE_PAGE_GROUP_MANIFEST
    try:
        lines = manifest_path.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise pytest.UsageError(
            f"cannot read ACE page-group manifest {manifest_path}: {error}"
        ) from error

    paths: list[str] = []
    for line_number, line in enumerate(lines, start=1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("-") or "::" in stripped:
            raise pytest.UsageError(
                f"{manifest_path}:{line_number} must be a repo-relative test file, "
                f"not {stripped!r}"
            )
        path = REPO_ROOT / stripped
        try:
            path.resolve().relative_to(REPO_ROOT.resolve())
        except ValueError as error:
            raise pytest.UsageError(
                f"{manifest_path}:{line_number} escapes the repo: {stripped!r}"
            ) from error
        if not path.is_file():
            raise pytest.UsageError(
                f"{manifest_path}:{line_number} does not name a file: {stripped!r}"
            )
        paths.append(stripped)

    if not paths:
        raise pytest.UsageError(f"{manifest_path} does not list any test files")
    return paths


def _apply_ace_page_group_isolation_mode(
    mode: str,
    pytest_args: list[str],
) -> list[str]:
    if mode != ACE_PAGE_GROUP_ISOLATION_MODE:
        return pytest_args
    if pytest_args:
        raise pytest.UsageError(
            f"{ACE_PAGE_GROUP_ISOLATION_MODE} runs its manifest exactly and "
            "does not accept extra pytest args"
        )
    os.environ[ACE_PAGE_GROUP_ISOLATION_ENV] = "1"
    return _ace_page_group_manifest_paths()


def _reject_scoped_worker_overrides(args: list[str]) -> None:
    """Keep rejecting the width knobs, now that scoped runs are not all serial.

    The middle gear made "scoped runs are serial" false, and it did not make
    these overrides meaningful: the gear's width is whatever the gate grants
    without waiting, so a request for eight workers is not something a scoped
    run can honour or usefully clamp.
    """
    _reject_numprocesses_args(args, remedy=SCOPED_WORKER_REMEDY)
    if os.environ.get("SASE_PYTEST_WORKERS") is not None:
        raise pytest.UsageError(
            f"scoped runs never request an exact worker count, so "
            f"SASE_PYTEST_WORKERS does not apply; {SCOPED_WORKER_REMEDY}"
        )


def _gear_manifest(
    selection: Selection,
    gear: ScopedGear,
    *,
    selected: Sequence[str] | None = None,
) -> dict[str, object]:
    """The selection's manifest, carrying a ``gear`` block only if it earned one.

    A run the gear was never offered — nothing escalated, or a change-set rule
    escalated it — records no ``gear`` block at all, rather than one whose
    every field says "not this run".
    """
    if not gear.attempted:
        return dict(selection.manifest)
    return manifest_with_gear(selection.manifest, gear, selected=selected)


def _positive_environment_int(name: str, default: int) -> int:
    """A positive-integer knob, where unset and empty both mean the default.

    Empty is the default too because these knobs are read through shell
    parameter expansion in the ``Justfile``, where an exported-but-empty
    variable is the normal way an override is absent.
    """
    raw_value = os.environ.get(name)
    if raw_value is None or not raw_value.strip():
        return default
    try:
        value = int(raw_value)
    except ValueError as error:
        raise pytest.UsageError(f"{name} must be a positive integer") from error
    if value < 1:
        raise pytest.UsageError(f"{name} must be a positive integer")
    return value


def _contention_worker_count() -> int:
    """The soak's oversubscription width for the pinned CPU set.

    `SASE_PYTEST_WORKERS` still works, so a caller who already exports the
    general width knob gets what it says; `SASE_CONTENTION_WORKERS` is the
    lane-specific name and wins when both are set.
    """
    if os.environ.get(CONTENTION_WORKERS_ENV, "").strip():
        return _positive_environment_int(
            CONTENTION_WORKERS_ENV, DEFAULT_CONTENTION_WORKERS
        )
    return _configured_worker_count() or DEFAULT_CONTENTION_WORKERS


def _contention_artifact_directory() -> Path:
    """A cleared directory for this soak's per-repeat failure records.

    Cleared, because a stale ``repeat-04.json`` from a longer previous soak
    would otherwise be read as this soak's fourth repeat.
    """
    directory = REPO_ROOT / CONTENTION_ARTIFACT_DIRECTORY
    shutil.rmtree(directory, ignore_errors=True)
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def _contention_environment(failures_path: Path) -> dict[str, str]:
    """The child environment for one soak repeat.

    The gate is disabled rather than leased: the soak exists to oversubscribe a
    pinned CPU set, which is demand no token pool can account for, and waiting
    for tokens it would then ignore only delays the diagnostic. Health
    recording is disabled for the same reason -- a deliberately starved run is
    not evidence about what a scoped run should have selected.
    """
    return {
        **os.environ,
        "SASE_TEST_GATE_DISABLED": "1",
        HEALTH_DISABLED_ENV: "1",
        FAILURES_ENV: str(failures_path),
    }


def _run_contention(args: list[str]) -> int:
    """Run the default lane R times under contention and tally per-node failures.

    Unlike every other parallel mode this cannot ``execv``: the tally is the
    deliverable, and only a surviving parent can fold R repeats into one.
    Returns the first repeat's non-zero exit status, so a red soak fails with
    pytest's own code rather than a synthetic one.
    """
    _reject_numprocesses_args(args, remedy=CONTENTION_WORKER_REMEDY)
    worker_count = _contention_worker_count()
    repeat_count = _positive_environment_int(
        CONTENTION_REPEAT_ENV, DEFAULT_CONTENTION_REPEAT
    )
    distribution_mode = _configured_distribution_mode()
    command = _pytest_command(
        CONTENTION_MODE,
        ["-p", CONTENTION_PLUGIN_MODULE, *args],
        worker_count=worker_count,
        distribution_mode=distribution_mode,
        serial=False,
    )
    artifacts = _contention_artifact_directory()
    _prepare_pytest_tmpdir()
    _sanitize_pytest_environment()
    os.chdir(REPO_ROOT)

    print(
        f"contention soak: {repeat_count} repeat(s), {worker_count} workers, "
        f"dist={distribution_mode}",
        flush=True,
    )
    repeats: list[tuple[str, ...]] = []
    red_repeats: list[int] = []
    first_failure = 0
    started = time.monotonic()
    for index in range(1, repeat_count + 1):
        failures_path = artifacts / f"repeat-{index:02d}.json"
        print(
            f"\n---------- contention repeat {index}/{repeat_count} ----------",
            flush=True,
        )
        try:
            returncode = subprocess.run(
                command, env=_contention_environment(failures_path)
            ).returncode
        except KeyboardInterrupt:
            # A soak is long enough that an operator interrupting it still
            # wants the tally for the repeats that did finish.
            print("\ncontention soak interrupted", file=sys.stderr, flush=True)
            red_repeats.append(index)
            first_failure = first_failure or int(pytest.ExitCode.INTERRUPTED)
            break
        repeats.append(read_failures(failures_path))
        if returncode != 0:
            red_repeats.append(index)
            first_failure = first_failure or returncode

    print(
        "\n"
        + format_tally(
            tally_failures(repeats),
            repeat_count=repeat_count,
            red_repeats=red_repeats,
            duration=time.monotonic() - started,
        ),
        flush=True,
    )
    print(f"per-repeat failure records: {_repo_relative(artifacts)}", flush=True)
    return first_failure


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "mode",
        choices=(
            "fast",
            "slow",
            "visual",
            "cov",
            CONTEXTS_MODE,
            TEST_COST_MODE,
            ACE_PAGE_GROUP_ISOLATION_MODE,
            "terminal-smoke",
            SCOPED_MODE,
            CONTENTION_MODE,
        ),
    )
    parser.add_argument("pytest_args", nargs=argparse.REMAINDER)
    namespace = parser.parse_args(argv)

    invocation_dir = Path(
        os.environ.get("SASE_JUST_INVOCATION_DIR", str(REPO_ROOT))
    ).resolve()
    mode, pytest_args = _resolve_mode_and_args(namespace.mode, namespace.pytest_args)
    pytest_args = _normalize_args(pytest_args, invocation_dir)

    lease: WorkerTokenLease | None = None
    scoped_manifest: dict[str, object] | None = None
    scoped_worker_count: int | None = None
    manifest_path = _scoped_manifest_path()
    try:
        pytest_args = _apply_ace_page_group_isolation_mode(mode, pytest_args)
        if mode == CONTENTION_MODE:
            # Never reaches the gate paths below: the soak is ungoverned by
            # design, and it needs a surviving parent to emit the tally.
            return _run_contention(pytest_args)
        if mode == SCOPED_MODE:
            _reject_scoped_worker_overrides(pytest_args)
            selection = _scoped_selection(manifest_path)
            # `tools/run_silent` swallows stdout on success, so the summary goes
            # to stderr where a failure dump will carry it.
            print(summary_line(selection), file=sys.stderr)
            print(context_line(selection.contexts), file=sys.stderr)
            gear = ScopedGear()
            if selection.escalated and selection.gear_candidate:
                # The selection the serial budget rejected is sound, only slow.
                # Try the middle gear before giving up on it: a few tokens the
                # gate can spare right now beat both a 1,000s serial run and a
                # whole-suite handoff. Refused means escalate, never wait.
                gear, lease = engage_scoped_gear(
                    serial_required=_requires_serial_pytest(pytest_args)
                )
                print(gear_line(gear), file=sys.stderr)
            if gear.granted:
                scoped_worker_count = gear.worker_count
                scoped_manifest = _gear_manifest(
                    selection, gear, selected=selection.gear_candidate
                )
                pytest_args = [*pytest_args, *selection.gear_candidate]
            elif selection.escalated:
                # Never let the fast path become the slow path: a large or
                # broadened selection runs the governed full lane instead of a
                # serial partial one.
                print(
                    "escalating to the governed full test lane "
                    f"(rules: {', '.join(selection.rules) or 'none'})",
                    file=sys.stderr,
                )
                # Record the escalation before handing off: the full lane
                # `execv`s away, and an unrecorded escalation would read as an
                # escalation rate of zero.
                _complete_scoped_manifest(
                    manifest_path,
                    _gear_manifest(selection, gear),
                    duration=0.0,
                    outcome="escalated",
                )
                mode = "fast"
            elif not selection.selected:
                print(
                    "no test files selected; skipping pytest entirely",
                    file=sys.stderr,
                )
                _complete_scoped_manifest(
                    manifest_path, selection.manifest, duration=0.0, outcome="empty"
                )
                return 0
            else:
                scoped_manifest = selection.manifest
                pytest_args = [*pytest_args, *selection.selected]

        pytest_args = [*_full_lane_recording_args(mode), *pytest_args]
        timings_args = _timings_pytest_args(mode)
        pytest_args = [*timings_args, *pytest_args]
        cost_args = _test_cost_pytest_args(mode)
        pytest_args = [*cost_args, *pytest_args]
        leak_detector_args = _global_state_leak_detector_pytest_args(mode)
        pytest_args = [*leak_detector_args, *pytest_args]

        if scoped_worker_count is not None:
            # The gear already holds `lease`; the width is the gate's answer.
            serial = False
            worker_count = scoped_worker_count
            distribution_mode = _configured_distribution_mode()
        elif _requires_serial_run(mode, pytest_args):
            serial = True
            worker_count = 1
            distribution_mode = None
        else:
            serial = False
            distribution_mode = _configured_distribution_mode()
            _reject_numprocesses_args(pytest_args)
            worker_count, lease = _parallel_worker_grant()
        command = _pytest_command(
            mode,
            pytest_args,
            worker_count=worker_count,
            distribution_mode=distribution_mode,
            serial=serial,
        )

        _prepare_pytest_tmpdir()
        _sanitize_pytest_environment()
        _apply_contexts_environment(mode)
        if timings_args:
            _arm_timings_recorder(mode, worker_count=worker_count)
        if cost_args:
            _arm_test_cost_recorder(mode, worker_count=worker_count)
        os.chdir(REPO_ROOT)
        if scoped_manifest is not None:
            if scoped_worker_count is None:
                # Belt-and-braces against subprocess-spawning tests: `-n 1`
                # already keeps every gate path dormant.
                environment = {**os.environ, "SASE_TEST_GATE_DISABLED": "1"}
            else:
                # Now that the workers are real, the belt-and-braces flag would
                # be a claim of exemption rather than a statement of one. The
                # gear's lease already marked this process's descendants
                # governed and exempt, exactly as the full lane's lease does,
                # and it is the lease — not the flag — that paid for the width.
                environment = dict(os.environ)
            # `execv` cannot come back to finish the manifest, so scoped mode is
            # the one mode that keeps a parent process alive.
            started = time.monotonic()
            returncode = subprocess.run(command, env=environment).returncode
            _complete_scoped_manifest(
                manifest_path,
                scoped_manifest,
                duration=time.monotonic() - started,
                outcome="passed" if returncode == 0 else "failed",
            )
            return returncode
        os.execv(sys.executable, command)
        raise AssertionError("unreachable")
    except pytest.UsageError as error:
        print(f"pytest runner configuration error: {error}", file=sys.stderr)
        return int(pytest.ExitCode.USAGE_ERROR)
    finally:
        if lease is not None:
            lease.release()


if __name__ == "__main__":
    raise SystemExit(main())
