#!/usr/bin/env python3
"""Reject private bounded-wait idioms in tests that have shared helpers."""

from __future__ import annotations

import ast
import sys
from pathlib import Path
from typing import NamedTuple


REPO_ROOT = Path(__file__).resolve().parents[1]
SCANNED_ROOTS = (REPO_ROOT / "tests",)
FORBIDDEN_FUNCTION = "_wait_until"
PROMPT_PANEL_SELECTORS = {"#agent-prompt-panel"}


class Finding(NamedTuple):
    path: Path
    line_number: int
    kind: str


def _python_files(root: Path) -> list[Path]:
    try:
        return sorted(path for path in root.rglob("*.py") if path.is_file())
    except OSError:
        return []


def _function_defs(tree: ast.AST) -> list[ast.FunctionDef | ast.AsyncFunctionDef]:
    return [
        node
        for node in ast.walk(tree)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
    ]


def _is_range_call(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "range"
    )


def _is_pilot_pause_await(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Await)
        and isinstance(node.value, ast.Call)
        and isinstance(node.value.func, ast.Attribute)
        and node.value.func.attr == "pause"
        and isinstance(node.value.func.value, ast.Name)
        and node.value.func.value.id == "pilot"
    )


def _has_conditional_break(node: ast.AST) -> bool:
    return any(
        isinstance(child, ast.If)
        and any(isinstance(descendant, ast.Break) for descendant in ast.walk(child))
        for child in ast.walk(node)
    )


def _inline_pilot_pause_waits(tree: ast.AST) -> list[ast.For]:
    return [
        node
        for node in ast.walk(tree)
        if isinstance(node, ast.For)
        and isinstance(node.target, ast.Name)
        and node.target.id == "_"
        and _is_range_call(node.iter)
        and any(_is_pilot_pause_await(child) for child in ast.walk(node))
        and _has_conditional_break(node)
    ]


def _is_page_app_prompt_panel_query(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "query_one"
        and isinstance(node.func.value, ast.Attribute)
        and node.func.value.attr == "app"
        and isinstance(node.func.value.value, ast.Name)
        and node.func.value.value.id == "page"
        and bool(node.args)
        and isinstance(node.args[0], ast.Constant)
        and node.args[0].value in PROMPT_PANEL_SELECTORS
    )


def _is_text_constructor(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "Text"
    )


class _RawPromptPanelTextUpdateVisitor(ast.NodeVisitor):
    def __init__(self) -> None:
        self.findings: list[ast.Call] = []
        self._aliases_by_scope: list[set[str]] = [set()]

    @property
    def _aliases(self) -> set[str]:
        return self._aliases_by_scope[-1]

    def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
        self._visit_scoped(node)

    def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
        self._visit_scoped(node)

    def visit_Assign(self, node: ast.Assign) -> None:
        if _is_page_app_prompt_panel_query(node.value):
            self._aliases.update(
                target.id for target in node.targets if isinstance(target, ast.Name)
            )
        self.generic_visit(node)

    def visit_Call(self, node: ast.Call) -> None:
        if (
            isinstance(node.func, ast.Attribute)
            and node.func.attr == "update"
            and isinstance(node.func.value, ast.Name)
            and node.func.value.id in self._aliases
            and bool(node.args)
            and _is_text_constructor(node.args[0])
        ):
            self.findings.append(node)
        self.generic_visit(node)

    def _visit_scoped(self, node: ast.AST) -> None:
        self._aliases_by_scope.append(set())
        self.generic_visit(node)
        self._aliases_by_scope.pop()


def _raw_prompt_panel_text_updates(tree: ast.AST) -> list[ast.Call]:
    visitor = _RawPromptPanelTextUpdateVisitor()
    visitor.visit(tree)
    return visitor.findings


def find_forbidden_helpers(
    roots: tuple[Path, ...] = SCANNED_ROOTS,
) -> list[Finding]:
    findings: list[Finding] = []
    for root in roots:
        for path in _python_files(root):
            try:
                tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
            except SyntaxError:
                continue
            for node in _function_defs(tree):
                if node.name == FORBIDDEN_FUNCTION:
                    findings.append(Finding(path, node.lineno, "private-wait-until"))
            findings.extend(
                Finding(path, node.lineno, "inline-pilot-pause-wait")
                for node in _inline_pilot_pause_waits(tree)
            )
            findings.extend(
                Finding(path, node.lineno, "raw-agent-prompt-panel-text")
                for node in _raw_prompt_panel_text_updates(tree)
            )
    return findings


def main() -> int:
    findings = find_forbidden_helpers()
    if not findings:
        return 0
    print(
        "Private test bounded waits are retired. Use "
        "sase.ace.testing.wait.wait_for for raw Textual pilots, "
        "sase.ace.testing.set_agent_prompt_document for ACE prompt-panel "
        "document injection, or give non-pilot harness waits a "
        "domain-specific name.",
        file=sys.stderr,
    )
    for finding in findings:
        print(
            f"{finding.path.relative_to(REPO_ROOT)}:"
            f"{finding.line_number}: {finding.kind}",
            file=sys.stderr,
        )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
