#!/usr/bin/env python3
"""Reject private bounded-wait idioms in tests that have shared helpers."""

from __future__ import annotations

import ast
import sys
from pathlib import Path
from typing import NamedTuple


REPO_ROOT = Path(__file__).resolve().parents[1]
SCANNED_ROOTS = (REPO_ROOT / "tests",)
LEGACY_FORBIDDEN_FUNCTION = "_wait_until"
PROMPT_PANEL_SELECTORS = {"#agent-prompt-panel"}
WAIT_PRAGMA = "sase-test-wait:"


class Finding(NamedTuple):
    path: Path
    line_number: int
    kind: str


def _python_files(root: Path) -> list[Path]:
    try:
        return sorted(path for path in root.rglob("*.py") if path.is_file())
    except OSError:
        return []


def _function_defs(tree: ast.AST) -> list[ast.FunctionDef | ast.AsyncFunctionDef]:
    return [
        node
        for node in ast.walk(tree)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
    ]


def _is_range_call(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "range"
    )


def _is_zero_literal(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Constant)
        and isinstance(node.value, int | float)
        and not isinstance(node.value, bool)
        and float(node.value) == 0.0
    )


def _is_positive_literal(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Constant)
        and isinstance(node.value, int | float)
        and not isinstance(node.value, bool)
        and float(node.value) > 0.0
    )


def _is_named_call(node: ast.AST, name: str) -> bool:
    return isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and (
        node.func.id == name
    )


def _contains_deadline(node: ast.AST) -> bool:
    return any(
        isinstance(child, ast.Name) and child.id == "deadline"
        for child in ast.walk(node)
    )


def _is_deadline_clamped_backoff(node: ast.AST) -> bool:
    if not _is_named_call(node, "min"):
        return False
    assert isinstance(node, ast.Call)
    for arg in node.args:
        if not _is_named_call(arg, "max"):
            continue
        assert isinstance(arg, ast.Call)
        has_zero_floor = any(_is_zero_literal(max_arg) for max_arg in arg.args)
        has_deadline_delta = any(
            isinstance(child, ast.BinOp)
            and isinstance(child.op, ast.Sub)
            and _contains_deadline(child)
            for child in ast.walk(arg)
        )
        if has_zero_floor and has_deadline_delta:
            return True
    return False


def _is_sleep_call(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "sleep"
        and isinstance(node.func.value, ast.Name)
        and node.func.value.id in {"asyncio", "time"}
    )


def _requires_wait_pragma(node: ast.Call) -> bool:
    if not node.args:
        return False
    delay = node.args[0]
    if _is_zero_literal(delay) or _is_deadline_clamped_backoff(delay):
        return False
    return _is_positive_literal(delay)


def _inline_wait_pragma_reason(line: str) -> str | None:
    marker = f"# {WAIT_PRAGMA}"
    if marker not in line:
        return None
    return line.split(marker, 1)[1].strip()


def _has_detached_wait_pragma(lines: list[str], line_number: int) -> bool:
    if line_number <= 1:
        return False
    previous = lines[line_number - 2].strip()
    return previous.startswith("#") and WAIT_PRAGMA in previous


def _fixed_sleep_findings(tree: ast.AST, path: Path, lines: list[str]) -> list[Finding]:
    findings: list[Finding] = []
    for node in ast.walk(tree):
        if not _is_sleep_call(node):
            continue
        assert isinstance(node, ast.Call)
        if not _requires_wait_pragma(node):
            continue
        line = lines[node.lineno - 1] if 0 < node.lineno <= len(lines) else ""
        reason = _inline_wait_pragma_reason(line)
        if reason is not None:
            if not reason:
                findings.append(Finding(path, node.lineno, "fixed-sleep-empty-pragma"))
            continue
        if _has_detached_wait_pragma(lines, node.lineno):
            findings.append(Finding(path, node.lineno, "fixed-sleep-detached-pragma"))
        else:
            findings.append(Finding(path, node.lineno, "fixed-sleep-missing-pragma"))
    return findings


def _is_pause_await(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Await)
        and isinstance(node.value, ast.Call)
        and isinstance(node.value.func, ast.Attribute)
        and node.value.func.attr == "pause"
    )


def _has_conditional_loop_exit(node: ast.AST) -> bool:
    return any(
        isinstance(child, ast.If)
        and any(
            isinstance(descendant, ast.Break | ast.Return)
            for descendant in ast.walk(child)
        )
        for child in ast.walk(node)
    )


def _is_bounded_pause_loop(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.For)
        and isinstance(node.target, ast.Name)
        and node.target.id == "_"
        and _is_range_call(node.iter)
        and any(_is_pause_await(child) for child in ast.walk(node))
    )


def _is_pause_only_loop(node: ast.For) -> bool:
    return all(
        isinstance(statement, ast.Expr) and _is_pause_await(statement.value)
        for statement in node.body
    )


def _has_trailing_bare_assert(body: list[ast.stmt], index: int) -> bool:
    return any(isinstance(statement, ast.Assert) for statement in body[index + 1 :])


def _child_statement_bodies(statement: ast.stmt) -> list[list[ast.stmt]]:
    bodies: list[list[ast.stmt]] = []
    for field_name in ("body", "orelse", "finalbody"):
        body = getattr(statement, field_name, None)
        if isinstance(body, list) and all(isinstance(item, ast.stmt) for item in body):
            bodies.append(body)
    if isinstance(statement, ast.Try):
        bodies.extend(handler.body for handler in statement.handlers)
    return bodies


def _pause_wait_loops(tree: ast.AST) -> list[ast.For]:
    loops: list[ast.For] = []

    def visit_body(body: list[ast.stmt]) -> None:
        for index, statement in enumerate(body):
            if isinstance(statement, ast.For) and _is_bounded_pause_loop(statement):
                if _has_conditional_loop_exit(statement) or (
                    _is_pause_only_loop(statement)
                    and _has_trailing_bare_assert(body, index)
                ):
                    loops.append(statement)
            for child_body in _child_statement_bodies(statement):
                visit_body(child_body)

    if isinstance(tree, ast.Module | ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef):
        visit_body(tree.body)
    return sorted(loops, key=lambda node: node.lineno)


def _arg_names(node: ast.FunctionDef | ast.AsyncFunctionDef) -> set[str]:
    args = node.args
    return {
        arg.arg
        for arg in (
            *args.posonlyargs,
            *args.args,
            *args.kwonlyargs,
        )
    }


def _is_private_name(name: str) -> bool:
    return name.startswith("_") and not (name.startswith("__") and name.endswith("__"))


def _private_wait_helpers(tree: ast.AST) -> list[ast.AsyncFunctionDef]:
    helpers: list[ast.AsyncFunctionDef] = []
    for node in _function_defs(tree):
        if not isinstance(node, ast.AsyncFunctionDef) or not _is_private_name(node.name):
            continue
        if node.name == LEGACY_FORBIDDEN_FUNCTION:
            helpers.append(node)
            continue
        if "predicate" in _arg_names(node) and _pause_wait_loops(node):
            helpers.append(node)
    return helpers


def _is_page_app_prompt_panel_query(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "query_one"
        and isinstance(node.func.value, ast.Attribute)
        and node.func.value.attr == "app"
        and isinstance(node.func.value.value, ast.Name)
        and node.func.value.value.id == "page"
        and bool(node.args)
        and isinstance(node.args[0], ast.Constant)
        and node.args[0].value in PROMPT_PANEL_SELECTORS
    )


def _is_text_constructor(node: ast.AST) -> bool:
    return (
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "Text"
    )


class _RawPromptPanelTextUpdateVisitor(ast.NodeVisitor):
    def __init__(self) -> None:
        self.findings: list[ast.Call] = []
        self._aliases_by_scope: list[set[str]] = [set()]

    @property
    def _aliases(self) -> set[str]:
        return self._aliases_by_scope[-1]

    def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
        self._visit_scoped(node)

    def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
        self._visit_scoped(node)

    def visit_Assign(self, node: ast.Assign) -> None:
        if _is_page_app_prompt_panel_query(node.value):
            self._aliases.update(
                target.id for target in node.targets if isinstance(target, ast.Name)
            )
        self.generic_visit(node)

    def visit_Call(self, node: ast.Call) -> None:
        if (
            isinstance(node.func, ast.Attribute)
            and node.func.attr == "update"
            and isinstance(node.func.value, ast.Name)
            and node.func.value.id in self._aliases
            and bool(node.args)
            and _is_text_constructor(node.args[0])
        ):
            self.findings.append(node)
        self.generic_visit(node)

    def _visit_scoped(self, node: ast.AST) -> None:
        self._aliases_by_scope.append(set())
        self.generic_visit(node)
        self._aliases_by_scope.pop()


def _raw_prompt_panel_text_updates(tree: ast.AST) -> list[ast.Call]:
    visitor = _RawPromptPanelTextUpdateVisitor()
    visitor.visit(tree)
    return visitor.findings


def find_forbidden_helpers(
    roots: tuple[Path, ...] = SCANNED_ROOTS,
) -> list[Finding]:
    findings: list[Finding] = []
    for root in roots:
        for path in _python_files(root):
            try:
                source = path.read_text(encoding="utf-8")
                tree = ast.parse(source, filename=str(path))
            except SyntaxError:
                continue
            lines = source.splitlines()
            private_helpers = _private_wait_helpers(tree)
            private_helper_loop_ids = {
                id(loop)
                for helper in private_helpers
                for loop in _pause_wait_loops(helper)
            }
            findings.extend(
                Finding(path, node.lineno, "private-wait-helper")
                for node in private_helpers
            )
            findings.extend(
                Finding(path, node.lineno, "inline-pause-wait")
                for node in _pause_wait_loops(tree)
                if id(node) not in private_helper_loop_ids
            )
            findings.extend(
                Finding(path, node.lineno, "raw-agent-prompt-panel-text")
                for node in _raw_prompt_panel_text_updates(tree)
            )
            findings.extend(_fixed_sleep_findings(tree, path, lines))
    return findings


def main() -> int:
    findings = find_forbidden_helpers()
    if not findings:
        return 0
    print(
        "Private test bounded waits are retired. Use "
        "sase.ace.testing.wait.wait_for for raw Textual pilots, "
        "sase.ace.testing.set_agent_prompt_document for ACE prompt-panel "
        "document injection, or give non-pilot harness waits a "
        "domain-specific name. Positive literal test sleeps must use "
        "an inline '# sase-test-wait: <reason>' pragma, or be replaced by "
        "an observable wait.",
        file=sys.stderr,
    )
    for finding in findings:
        print(
            f"{finding.path.relative_to(REPO_ROOT)}:"
            f"{finding.line_number}: {finding.kind}",
            file=sys.stderr,
        )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
