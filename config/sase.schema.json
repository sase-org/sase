{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SASE Configuration",
  "description": "Configuration schema for sase.yml files",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ace": {
      "type": "object",
      "description": "Configuration for the ace TUI",
      "additionalProperties": false,
      "properties": {
        "inactive_seconds": {
          "type": "integer",
          "description": "Seconds of inactivity before auto-sleep",
          "default": 600
        },
        "repro_output_dir": {
          "type": "string",
          "description": "Directory where ACE agent repro captures are written. Empty string uses the runtime default.",
          "default": ""
        },
        "snippets": {
          "type": "object",
          "description": "Snippet expansions for the prompt input (trigger string to expansion text)",
          "additionalProperties": {
            "type": "string"
          }
        },
        "keymaps": {
          "type": "object",
          "description": "Keymap configuration for the TUI",
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "object",
              "description": "Top-level application keybindings (action name to key string)",
              "additionalProperties": {
                "type": "string"
              }
            },
            "modes": {
              "type": "object",
              "description": "Named prefix-key mode definitions",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prefix": {
                    "type": "string",
                    "description": "Key that activates this mode"
                  },
                  "keys": {
                    "type": "object",
                    "description": "Keybindings within this mode",
                    "additionalProperties": {
                      "oneOf": [
                        { "type": "string" },
                        {
                          "type": "object",
                          "description": "Nested key group (e.g., copy mode per-tab keys)",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "axe": {
      "type": "object",
      "description": "Configuration for the axe scheduler daemon",
      "additionalProperties": false,
      "properties": {
        "full_check_interval": {
          "type": "integer",
          "description": "Full check interval in seconds",
          "default": 300
        },
        "comment_check_interval": {
          "type": "integer",
          "description": "Comment check interval in seconds",
          "default": 60
        },
        "hook_interval": {
          "type": "integer",
          "description": "Hook check interval in seconds",
          "default": 1
        },
        "zombie_timeout_seconds": {
          "type": "integer",
          "description": "Zombie detection timeout in seconds. Hooks and CRS workflows running longer than this are marked as ZOMBIE.",
          "default": 7200
        },
        "max_hook_runners": {
          "type": "integer",
          "description": "Maximum concurrent hook runners (non-$ hooks)",
          "default": 3
        },
        "max_agent_runners": {
          "type": "integer",
          "description": "Maximum concurrent agent runners (agents and mentors)",
          "default": 3
        },
        "query": {
          "type": "string",
          "description": "Default query filter for axe operations",
          "default": ""
        },
        "chop_script_dirs": {
          "type": "array",
          "description": "Additional directories to search for chop scripts (searched before PATH lookup)",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "lumberjack_log_max_bytes": {
          "type": "integer",
          "description": "Maximum bytes retained for each bounded lumberjack log.",
          "default": 52428800,
          "minimum": 1
        },
        "verbose_lumberjack_diagnostics": {
          "type": "boolean",
          "description": "Include verbose lumberjack diagnostics in chop script contexts.",
          "default": false
        },
        "lumberjacks": {
          "type": "object",
          "description": "Named lumberjack definitions. Each key is a lumberjack name with interval and chops config.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interval": {
                "type": "integer",
                "description": "Tick interval in seconds for this lumberjack",
                "default": 1
              },
              "chop_timeout": {
                "type": "string",
                "description": "Default duration string (e.g., '30s', '5m', '1h') controlling the maximum runtime for chops in this lumberjack",
                "pattern": "^\\d+(s|m|h)$"
              },
              "chops": {
                "type": "array",
                "description": "List of chop scripts to run on each tick",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["name"],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Name of the chop script"
                        },
                        "description": {
                          "type": "string",
                          "description": "Description of what this chop does"
                        },
                        "agent": {
                          "type": "string",
                          "description": "Agent reference to run instead of a chop script"
                        },
                        "xprompt": {
                          "type": "string",
                          "description": "XPrompt reference to run instead of a chop script"
                        },
                        "run_every": {
                          "type": "string",
                          "description": "Duration string (e.g., '60m', '30s', '2h') controlling how often this chop runs",
                          "pattern": "^\\d+(s|m|h)$"
                        },
                        "env": {
                          "type": "object",
                          "description": "Environment variables to set when running the chop",
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "timeout": {
                          "type": "string",
                          "description": "Duration string (e.g., '30s', '5m', '1h') controlling the maximum runtime for this chop",
                          "pattern": "^\\d+(s|m|h)$"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "mobile_gateway": {
      "type": "object",
      "description": "Configuration for the workstation-hosted mobile gateway",
      "additionalProperties": false,
      "properties": {
        "bind_address": {
          "type": "string",
          "description": "Host address to bind the mobile gateway.",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "description": "TCP port for the mobile gateway HTTP API.",
          "default": 7629,
          "minimum": 0,
          "maximum": 65535
        },
        "state_dir": {
          "type": "string",
          "description": "State directory passed to the gateway as the SASE home. Empty string uses the runtime default.",
          "default": ""
        },
        "allow_non_loopback": {
          "type": "boolean",
          "description": "Allow explicit non-loopback gateway binds.",
          "default": false
        },
        "command": {
          "type": "string",
          "description": "Gateway command override, parsed without a shell. Empty string uses PATH/sibling-repo discovery.",
          "default": ""
        },
        "agent_bridge_command": {
          "type": "string",
          "description": "Agent bridge command override passed through to the gateway.",
          "default": ""
        },
        "helper_bridge_command": {
          "type": "string",
          "description": "Helper bridge command override passed through to the gateway.",
          "default": ""
        },
        "push_provider": {
          "type": "string",
          "description": "Push notification provider for mobile clients.",
          "enum": ["disabled", "test", "fcm"],
          "default": "disabled"
        },
        "fcm_project_id": {
          "type": "string",
          "description": "Firebase Cloud Messaging project ID.",
          "default": ""
        },
        "fcm_service_account_json": {
          "type": "string",
          "description": "Path to a Firebase service account JSON file. Empty string disables file credentials.",
          "default": ""
        },
        "fcm_credential_env": {
          "type": "string",
          "description": "Environment variable containing Firebase credentials JSON.",
          "default": ""
        },
        "fcm_dry_run": {
          "type": "boolean",
          "description": "Send FCM notifications in dry-run mode.",
          "default": false
        },
        "push_timeout_seconds": {
          "type": "number",
          "description": "Seconds to wait for each push notification request.",
          "default": 5,
          "exclusiveMinimum": 0
        },
        "push_retry_limit": {
          "type": "integer",
          "description": "Number of push notification retry attempts.",
          "default": 1,
          "minimum": 0
        },
        "startup_timeout_seconds": {
          "type": "number",
          "description": "Seconds to wait for the gateway to become ready.",
          "default": 10,
          "exclusiveMinimum": 0
        }
      }
    },
    "chat_install": {
      "type": "object",
      "description": "Configuration for chat-driven update workflows",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command to run from the registered sase primary workspace. Empty string disables use.",
          "default": ""
        },
        "sync_workspace": {
          "type": "boolean",
          "description": "Sync the registered sase primary workspace via the selected VCS provider before updating.",
          "default": true
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "Maximum runtime for the update command before returning exit code 124.",
          "default": 900,
          "minimum": 1
        },
        "restart_attempts": {
          "type": "integer",
          "description": "Number of axe restart attempts after the update command completes or fails.",
          "default": 3,
          "minimum": 1
        }
      }
    },
    "daemon": {
      "type": "object",
      "description": "Configuration for the local daemon and daemon-backed reads",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "description": "Daemon gateway command override, parsed without a shell. Empty string uses PATH/sibling-repo discovery.",
          "default": ""
        },
        "sase_home": {
          "type": "string",
          "description": "SASE home directory for daemon state. Empty string uses the runtime default.",
          "default": ""
        },
        "run_root": {
          "type": "string",
          "description": "Daemon runtime directory. Empty string uses the runtime default.",
          "default": ""
        },
        "socket_path": {
          "type": "string",
          "description": "Daemon Unix socket path. Empty string uses the runtime default.",
          "default": ""
        },
        "disable_mobile_http": {
          "type": "boolean",
          "description": "Disable the mobile HTTP API when starting daemon mode.",
          "default": false
        },
        "startup_timeout_seconds": {
          "type": "number",
          "description": "Seconds to wait for daemon background startup metadata.",
          "default": 5,
          "exclusiveMinimum": 0
        },
        "rollout": {
          "type": "object",
          "description": "Daemon rollout milestone controls.",
          "additionalProperties": false,
          "properties": {
            "milestones": {
              "type": "object",
              "description": "Milestone-level daemon rollout switches.",
              "additionalProperties": false,
              "properties": {
                "m0_shadow_indexing": {
                  "type": "boolean",
                  "description": "Enable M0 shadow indexing, rebuild, verify, and diff diagnostics.",
                  "default": true
                },
                "m1_read_through": {
                  "type": "boolean",
                  "description": "Enable M1 selected CLI/editor daemon read-through surfaces.",
                  "default": true
                }
              }
            }
          }
        },
        "provider_host": {
          "type": "object",
          "description": "Rollout controls for isolated provider/plugin host routing",
          "additionalProperties": false,
          "properties": {
            "default_mode": {
              "type": "string",
              "description": "Default provider-host routing mode for operations not listed in modes.",
              "enum": ["direct", "shadow", "host-preferred", "host-required"],
              "default": "direct"
            },
            "shadow_compare": {
              "type": "boolean",
              "description": "Record diagnostics for safe host-vs-direct shadow comparisons.",
              "default": true
            },
            "modes": {
              "type": "object",
              "description": "Per-operation provider-host rollout modes.",
              "additionalProperties": {
                "type": "string",
                "enum": ["direct", "shadow", "host-preferred", "host-required"]
              },
              "properties": {
                "llm_metadata": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "host-preferred"
                },
                "xprompt_catalog": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "host-preferred"
                },
                "vcs_query": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "host-preferred"
                },
                "workspace_metadata": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "host-preferred"
                },
                "workspace_resolve_ref": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "host-preferred"
                },
                "llm_invoke": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "direct"
                },
                "workflow_step": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "direct"
                },
                "vcs_mutation": {
                  "type": "string",
                  "enum": ["direct", "shadow", "host-preferred", "host-required"],
                  "default": "direct"
                }
              }
            }
          }
        },
        "scheduler": {
          "type": "object",
          "description": "Daemon scheduler rollout modes.",
          "additionalProperties": false,
          "properties": {
            "launch_mode": {
              "type": "string",
              "description": "Rollout mode for agent launch scheduling.",
              "enum": ["direct", "shadow", "daemon"],
              "default": "direct"
            },
            "lifecycle_mode": {
              "type": "string",
              "description": "Rollout mode for agent lifecycle mutation scheduling.",
              "enum": ["direct", "shadow", "daemon"],
              "default": "direct"
            },
            "axe_mode": {
              "type": "string",
              "description": "Rollout mode for axe task scheduling.",
              "enum": ["direct", "daemon"],
              "default": "direct"
            }
          }
        },
        "reads": {
          "type": "object",
          "description": "Read-through routing from CLI, editor, and ACE surfaces to local daemon projections",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Globally enable daemon read-through routing when a surface and daemon capability are available.",
              "default": true
            },
            "force_direct": {
              "type": "boolean",
              "description": "Force all daemon-capable read surfaces to use direct source-store loaders.",
              "default": false
            },
            "fallback_diagnostics": {
              "type": "boolean",
              "description": "Allow daemon-aware commands and UIs to expose fallback reason metadata in debug output.",
              "default": false
            },
            "surfaces": {
              "type": "object",
              "description": "Per-surface daemon read-through switches. Disabled surfaces always use direct loaders.",
              "additionalProperties": false,
              "properties": {
                "changespecs": {
                  "type": "boolean",
                  "description": "Enable daemon-backed ChangeSpec list/search/detail reads.",
                  "default": true
                },
                "notifications": {
                  "type": "boolean",
                  "description": "Enable daemon-backed notification list/detail/count reads.",
                  "default": true
                },
                "agents": {
                  "type": "boolean",
                  "description": "Enable daemon-backed project-scoped agent CLI reads.",
                  "default": true
                },
                "beads": {
                  "type": "boolean",
                  "description": "Enable daemon-backed bead reads when the selected store matches the daemon project.",
                  "default": true
                },
                "catalogs": {
                  "type": "boolean",
                  "description": "Enable daemon-backed xprompt, snippet, editor catalog, and file-history reads.",
                  "default": true
                },
                "ace_agents": {
                  "type": "boolean",
                  "description": "Enable the daemon-backed ACE Agents data provider by default.",
                  "default": false
                },
                "ace_changespecs": {
                  "type": "boolean",
                  "description": "Enable the daemon-backed ACE ChangeSpecs data provider by default.",
                  "default": false
                },
                "ace_notifications": {
                  "type": "boolean",
                  "description": "Enable the daemon-backed ACE Notifications data provider by default.",
                  "default": false
                },
                "ace_artifacts": {
                  "type": "boolean",
                  "description": "Enable the daemon-backed ACE Artifacts data provider by default.",
                  "default": false
                },
                "ace_archive_search": {
                  "type": "boolean",
                  "description": "Enable the daemon-backed ACE archive search provider by default.",
                  "default": false
                }
              }
            }
          }
        }
      }
    },
    "metahooks": {
      "type": "array",
      "description": "Metahooks intercept failing hooks before the summarize agent runs",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hook_command", "output_regex"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique identifier for this metahook"
          },
          "hook_command": {
            "type": "string",
            "description": "The command that this metahook intercepts"
          },
          "output_regex": {
            "type": "string",
            "description": "Regex pattern to match in the hook output"
          }
        }
      }
    },
    "mentor_profiles": {
      "type": "array",
      "description": "Mentor profiles define which mentors to apply to which files",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_name", "mentors"],
        "anyOf": [
          { "required": ["file_globs"] },
          { "required": ["diff_regexes"] },
          { "required": ["amend_note_regexes"] },
          { "required": ["first_commit"] }
        ],
        "properties": {
          "profile_name": {
            "type": "string",
            "description": "Unique name for this mentor profile"
          },
          "mentors": {
            "type": "array",
            "description": "List of mentors to apply",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "oneOf": [
                { "required": ["xprompt"] },
                { "required": ["prompt"] },
                { "required": ["mentor_name", "role", "focus_areas"] }
              ],
              "properties": {
                "xprompt": {
                  "type": "string",
                  "description": "Reference to an xprompt (e.g., #mentor/aaa)"
                },
                "prompt": {
                  "type": "string",
                  "description": "Inline prompt text for the mentor"
                },
                "mentor_name": {
                  "type": "string",
                  "description": "Name for the mentor"
                },
                "role": {
                  "type": "string",
                  "description": "Description of the mentor's role"
                },
                "focus_areas": {
                  "type": "array",
                  "description": "Specific areas this mentor should focus on during review",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["focus_name", "description"],
                    "properties": {
                      "focus_name": {
                        "type": "string",
                        "description": "Unique identifier for this focus area"
                      },
                      "description": {
                        "type": "string",
                        "description": "Detailed description of what to look for"
                      }
                    }
                  }
                }
              }
            }
          },
          "file_globs": {
            "type": "array",
            "description": "Glob patterns to match files for this profile",
            "items": {
              "type": "string"
            }
          },
          "diff_regexes": {
            "type": "array",
            "description": "Regex patterns to match in the diff output",
            "items": {
              "type": "string"
            }
          },
          "amend_note_regexes": {
            "type": "array",
            "description": "Regex patterns to match in the amend note",
            "items": {
              "type": "string"
            }
          },
          "first_commit": {
            "type": "boolean",
            "description": "Whether to match on the first commit of a ChangeSpec",
            "default": false
          },
          "projects": {
            "type": "array",
            "description": "Only match changespecs belonging to these projects. Auto-populated for local sase.yml profiles.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "llm_provider": {
      "type": "object",
      "description": "Configuration for the LLM provider abstraction layer",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Name of the LLM provider to use (e.g., 'gemini', 'claude')",
          "default": "gemini"
        },
        "model_tier_map": {
          "type": "object",
          "description": "Mapping from model tiers to specific model identifiers",
          "properties": {
            "large": {
              "type": "string",
              "description": "Model identifier for the 'large' tier"
            },
            "small": {
              "type": "string",
              "description": "Model identifier for the 'small' tier"
            }
          }
        },
        "model_aliases": {
          "type": "object",
          "description": "Configurable model aliases usable from %model/%m directives",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retry": {
          "type": "object",
          "description": "Per-provider retry configuration. Keys are provider names (e.g., 'gemini', 'claude').",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_retries": {
                "type": "integer",
                "description": "Maximum number of retries on matching errors",
                "default": 0
              },
              "error_patterns": {
                "type": "array",
                "description": "Substrings to match against error output (case-insensitive)",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "wait_times": {
                "type": "array",
                "description": "Wait times in seconds for each retry attempt. Last value is reused if retries exceed list length.",
                "items": {
                  "type": "integer"
                },
                "default": [30]
              },
              "fallback_model": {
                "type": "string",
                "description": "Model to fall back to after all retries are exhausted"
              }
            }
          }
        }
      }
    },
    "vcs_provider": {
      "type": "object",
      "description": "Configuration for the VCS provider abstraction layer",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Name of the VCS provider ('git', 'hg', or 'auto' for auto-detection)",
          "enum": ["git", "hg", "auto"],
          "default": "auto"
        },
        "default_hooks": {
          "type": "array",
          "description": "Override the default required hooks added to new ChangeSpecs. Each entry is a hook command string (supports '!' and '$' prefixes).",
          "items": {
            "type": "string"
          }
        },
        "workspace_root": {
          "type": "string",
          "description": "Root directory for workspaces. Overridden by SASE_WORKSPACE_ROOT env var. Defaults to $HOME/workspace for git."
        },
        "pr_tags": {
          "type": "object",
          "description": "Key-value tags appended as TAG=VALUE lines to PR commit messages",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "use_project_pr_prefix": {
          "type": "boolean",
          "description": "Prepend [<project>] to PR titles or CL descriptions.",
          "default": false
        }
      }
    },
    "github_orgs": {
      "description": "GitHub organization/user names the user has push access to, used for cloning and PR submission",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "sdd": {
      "type": "object",
      "description": "Configuration for Structured Design Documents",
      "additionalProperties": false,
      "properties": {
        "version_controlled": {
          "type": "boolean",
          "description": "Whether SDD files are stored in version-controlled project root (true) or in .sase/sdd (false)",
          "default": false
        }
      }
    },
    "xprompt_aliases": {
      "type": "object",
      "description": "Aliases for xprompt references, substituted before any other xprompt processing (e.g., {\"#gh_sase\": \"#gh:sase\"})",
      "additionalProperties": {
        "type": "string"
      }
    },
    "precommit_command": {
      "type": "string",
      "description": "Command to run before commits (e.g., 'just fix'). Empty string means no precommit command.",
      "default": ""
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone name used for all dates/datetimes (e.g., 'America/New_York', 'US/Pacific')",
      "default": "America/New_York"
    },
    "use_chezmoi": {
      "type": "boolean",
      "description": "Remap home xprompt paths to chezmoi-managed equivalents under ~/.local/share/chezmoi/home/",
      "default": false
    },
    "xprompts": {
      "type": "object",
      "description": "Reusable text templates that can be referenced in prompts",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["content"],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "object",
                "description": "Input parameters for the xprompt template"
              },
              "content": {
                "type": "string",
                "description": "Template content with Jinja2 placeholders"
              },
              "tags": {
                "description": "Semantic role tags for tag-based xprompt lookup",
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "snippet": {
                "oneOf": [
                  { "type": "boolean" },
                  { "type": "string" }
                ],
                "description": "Opt-in snippet expansion: true for auto trigger word, or a custom trigger string"
              },
              "description": {
                "type": "string",
                "description": "Human-readable xprompt description"
              },
              "skill": {
                "description": "Skill deployment metadata for generated skills",
                "oneOf": [
                  { "type": "boolean" },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "keywords": {
                "type": "array",
                "description": "Keywords used to match dynamic memory xprompts",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "telemetry": {
      "type": "object",
      "description": "Prometheus telemetry settings",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether telemetry collection is enabled",
          "default": false
        },
        "prometheus": {
          "type": "object",
          "description": "Prometheus connection settings",
          "additionalProperties": false,
          "properties": {
            "exposition_port": {
              "type": "integer",
              "description": "Port for the Prometheus metrics exposition endpoint",
              "default": 9464
            },
            "pushgateway_url": {
              "type": "string",
              "description": "URL of the Prometheus Pushgateway",
              "default": "localhost:9091"
            },
            "url": {
              "type": "string",
              "description": "URL of the Prometheus server",
              "default": "localhost:9090"
            }
          }
        },
        "health_thresholds": {
          "type": "object",
          "description": "Thresholds for the telemetry health traffic-light check",
          "additionalProperties": false,
          "properties": {
            "error_rate_warn": {
              "type": "number",
              "description": "Error rate percentage to trigger a warning",
              "default": 10.0
            },
            "error_rate_critical": {
              "type": "number",
              "description": "Error rate percentage to trigger a critical alert",
              "default": 25.0
            },
            "retry_rate_warn": {
              "type": "number",
              "description": "Retry rate percentage to trigger a warning",
              "default": 10.0
            },
            "retry_rate_critical": {
              "type": "number",
              "description": "Retry rate percentage to trigger a critical alert",
              "default": 25.0
            },
            "p95_latency_warn": {
              "type": "number",
              "description": "P95 latency in seconds to trigger a warning",
              "default": 300.0
            },
            "p95_latency_critical": {
              "type": "number",
              "description": "P95 latency in seconds to trigger a critical alert",
              "default": 600.0
            }
          }
        }
      }
    }
  }
}
