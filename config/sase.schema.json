{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SASE Configuration",
  "description": "Configuration schema for sase.yml files",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ace": {
      "type": "object",
      "description": "Configuration for the ace TUI",
      "additionalProperties": false,
      "properties": {
        "inactive_seconds": {
          "type": "integer",
          "description": "Seconds of inactivity before auto-sleep",
          "default": 600
        },
        "snippets": {
          "type": "object",
          "description": "Snippet expansions for the prompt input (trigger string to expansion text)",
          "additionalProperties": {
            "type": "string"
          }
        },
        "keymaps": {
          "type": "object",
          "description": "Keymap configuration for the TUI",
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "object",
              "description": "Top-level application keybindings (action name to key string)",
              "additionalProperties": {
                "type": "string"
              }
            },
            "modes": {
              "type": "object",
              "description": "Named prefix-key mode definitions",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prefix": {
                    "type": "string",
                    "description": "Key that activates this mode"
                  },
                  "keys": {
                    "type": "object",
                    "description": "Keybindings within this mode",
                    "additionalProperties": {
                      "oneOf": [
                        { "type": "string" },
                        {
                          "type": "object",
                          "description": "Nested key group (e.g., copy mode per-tab keys)",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "axe": {
      "type": "object",
      "description": "Configuration for the axe scheduler daemon",
      "additionalProperties": false,
      "properties": {
        "full_check_interval": {
          "type": "integer",
          "description": "Full check interval in seconds",
          "default": 300
        },
        "comment_check_interval": {
          "type": "integer",
          "description": "Comment check interval in seconds",
          "default": 60
        },
        "hook_interval": {
          "type": "integer",
          "description": "Hook check interval in seconds",
          "default": 1
        },
        "zombie_timeout_seconds": {
          "type": "integer",
          "description": "Zombie detection timeout in seconds. Hooks and CRS workflows running longer than this are marked as ZOMBIE.",
          "default": 7200
        },
        "max_hook_runners": {
          "type": "integer",
          "description": "Maximum concurrent hook runners (non-$ hooks)",
          "default": 3
        },
        "max_agent_runners": {
          "type": "integer",
          "description": "Maximum concurrent agent runners (agents and mentors)",
          "default": 3
        },
        "query": {
          "type": "string",
          "description": "Default query filter for axe operations",
          "default": ""
        },
        "chop_script_dirs": {
          "type": "array",
          "description": "Additional directories to search for chop scripts (searched before PATH lookup)",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "lumberjacks": {
          "type": "object",
          "description": "Named lumberjack definitions. Each key is a lumberjack name with interval and chops config.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interval": {
                "type": "integer",
                "description": "Tick interval in seconds for this lumberjack",
                "default": 1
              },
              "chops": {
                "type": "array",
                "description": "List of chop scripts to run on each tick",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["name"],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Name of the chop script"
                        },
                        "description": {
                          "type": "string",
                          "description": "Description of what this chop does"
                        },
                        "agent": {
                          "type": "string",
                          "description": "Agent reference to run instead of a chop script"
                        },
                        "xprompt": {
                          "type": "string",
                          "description": "XPrompt reference to run instead of a chop script"
                        },
                        "run_every": {
                          "type": "string",
                          "description": "Duration string (e.g., '60m', '30s', '2h') controlling how often this chop runs",
                          "pattern": "^\\d+(s|m|h)$"
                        },
                        "env": {
                          "type": "object",
                          "description": "Environment variables to set when running the chop",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "metahooks": {
      "type": "array",
      "description": "Metahooks intercept failing hooks before the summarize agent runs",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hook_command", "output_regex"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique identifier for this metahook"
          },
          "hook_command": {
            "type": "string",
            "description": "The command that this metahook intercepts"
          },
          "output_regex": {
            "type": "string",
            "description": "Regex pattern to match in the hook output"
          }
        }
      }
    },
    "mentor_profiles": {
      "type": "array",
      "description": "Mentor profiles define which mentors to apply to which files",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_name", "mentors"],
        "anyOf": [
          { "required": ["file_globs"] },
          { "required": ["diff_regexes"] },
          { "required": ["amend_note_regexes"] },
          { "required": ["first_commit"] }
        ],
        "properties": {
          "profile_name": {
            "type": "string",
            "description": "Unique name for this mentor profile"
          },
          "mentors": {
            "type": "array",
            "description": "List of mentors to apply",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "oneOf": [
                { "required": ["xprompt"] },
                { "required": ["prompt"] },
                { "required": ["mentor_name", "role", "focus_areas"] }
              ],
              "properties": {
                "xprompt": {
                  "type": "string",
                  "description": "Reference to an xprompt (e.g., #mentor/aaa)"
                },
                "prompt": {
                  "type": "string",
                  "description": "Inline prompt text for the mentor"
                },
                "mentor_name": {
                  "type": "string",
                  "description": "Name for the mentor"
                },
                "role": {
                  "type": "string",
                  "description": "Description of the mentor's role"
                },
                "focus_areas": {
                  "type": "array",
                  "description": "Specific areas this mentor should focus on during review",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["focus_name", "description"],
                    "properties": {
                      "focus_name": {
                        "type": "string",
                        "description": "Unique identifier for this focus area"
                      },
                      "description": {
                        "type": "string",
                        "description": "Detailed description of what to look for"
                      }
                    }
                  }
                }
              }
            }
          },
          "file_globs": {
            "type": "array",
            "description": "Glob patterns to match files for this profile",
            "items": {
              "type": "string"
            }
          },
          "diff_regexes": {
            "type": "array",
            "description": "Regex patterns to match in the diff output",
            "items": {
              "type": "string"
            }
          },
          "amend_note_regexes": {
            "type": "array",
            "description": "Regex patterns to match in the amend note",
            "items": {
              "type": "string"
            }
          },
          "first_commit": {
            "type": "boolean",
            "description": "Whether to match on the first commit of a ChangeSpec",
            "default": false
          },
          "projects": {
            "type": "array",
            "description": "Only match changespecs belonging to these projects. Auto-populated for local sase.yml profiles.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Configuration for the git-versioned agent memory system",
      "additionalProperties": false,
      "properties": {
        "auto_inject": {
          "type": "boolean",
          "description": "Automatically inject memory context into all agent prompts",
          "default": false
        },
        "max_system_tokens": {
          "type": "integer",
          "description": "Approximate token budget for system/ file injection (1 token ≈ 4 chars)",
          "default": 4000
        }
      }
    },
    "llm_provider": {
      "type": "object",
      "description": "Configuration for the LLM provider abstraction layer",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Name of the LLM provider to use (e.g., 'gemini', 'claude')",
          "default": "gemini"
        },
        "model_tier_map": {
          "type": "object",
          "description": "Mapping from model tiers to specific model identifiers",
          "properties": {
            "large": {
              "type": "string",
              "description": "Model identifier for the 'large' tier"
            },
            "small": {
              "type": "string",
              "description": "Model identifier for the 'small' tier"
            }
          }
        },
        "retry": {
          "type": "object",
          "description": "Per-provider retry configuration. Keys are provider names (e.g., 'gemini', 'claude').",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_retries": {
                "type": "integer",
                "description": "Maximum number of retries on matching errors",
                "default": 0
              },
              "error_patterns": {
                "type": "array",
                "description": "Substrings to match against error output (case-insensitive)",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "wait_times": {
                "type": "array",
                "description": "Wait times in seconds for each retry attempt. Last value is reused if retries exceed list length.",
                "items": {
                  "type": "integer"
                },
                "default": [30]
              },
              "fallback_model": {
                "type": "string",
                "description": "Model to fall back to after all retries are exhausted"
              }
            }
          }
        }
      }
    },
    "vcs_provider": {
      "type": "object",
      "description": "Configuration for the VCS provider abstraction layer",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Name of the VCS provider ('git', 'hg', or 'auto' for auto-detection)",
          "enum": ["git", "hg", "auto"],
          "default": "auto"
        },
        "default_hooks": {
          "type": "array",
          "description": "Override the default required hooks added to new ChangeSpecs. Each entry is a hook command string (supports '!' and '$' prefixes).",
          "items": {
            "type": "string"
          }
        },
        "workspace_root": {
          "type": "string",
          "description": "Root directory for workspaces. Overridden by SASE_WORKSPACE_ROOT env var. Defaults to $HOME/workspace for git."
        }
      }
    },
    "github_orgs": {
      "description": "GitHub organization/user names the user has push access to, used for cloning and PR submission",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "sdd": {
      "type": "object",
      "description": "Configuration for Structured Design Documents",
      "additionalProperties": false,
      "properties": {
        "version_controlled": {
          "type": "boolean",
          "description": "Whether SDD files are stored in version-controlled project root (true) or in .sase/sdd (false)",
          "default": false
        }
      }
    },
    "xprompt_aliases": {
      "type": "object",
      "description": "Aliases for xprompt references, substituted before any other xprompt processing (e.g., {\"#gh_sase\": \"#gh:sase\"})",
      "additionalProperties": {
        "type": "string"
      }
    },
    "precommit_command": {
      "type": "string",
      "description": "Command to run before commits (e.g., 'just fix'). Empty string means no precommit command.",
      "default": ""
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone name used for all dates/datetimes (e.g., 'America/New_York', 'US/Pacific')",
      "default": "America/New_York"
    },
    "use_chezmoi": {
      "type": "boolean",
      "description": "Remap home xprompt paths to chezmoi-managed equivalents under ~/.local/share/chezmoi/home/",
      "default": false
    },
    "xprompts": {
      "type": "object",
      "description": "Reusable text templates that can be referenced in prompts",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["content"],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "object",
                "description": "Input parameters for the xprompt template"
              },
              "content": {
                "type": "string",
                "description": "Template content with Jinja2 placeholders"
              },
              "snippet": {
                "oneOf": [
                  { "type": "boolean" },
                  { "type": "string" }
                ],
                "description": "Opt-in snippet expansion: true for auto trigger word, or a custom trigger string"
              }
            }
          }
        ]
      }
    }
  }
}
