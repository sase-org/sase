# Copy this file to .env to pin an exact historical smoke run.
# Leave values unpinned to test the latest packages currently available on PyPI.

SASE_SPEC=sase
SASE_GITHUB_SPEC=sase-github
SASE_TELEGRAM_SPEC=sase-telegram

# Assertion only. sase-core-rs is pulled in as a dependency of sase, not installed
# as a separate top-level tool package.
SASE_CORE_RS_SPEC=

# Example pinned release set from 2026-06-12:
# SASE_SPEC=sase==0.1.6
# SASE_GITHUB_SPEC=sase-github==0.1.1
# SASE_TELEGRAM_SPEC=sase-telegram==0.1.0
# SASE_CORE_RS_SPEC=sase-core-rs==0.1.2

# Uncomment when the interactive shell should inherit credentials.
# GH_TOKEN=
# GITHUB_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Override only if the host user is not UID/GID 1000 and reports are owned by
# the wrong user after a run.
# USER_ID=1000
# GROUP_ID=1000
